{"storyMeta":{"storyReviewType":"NONE","storyId":"act38side_level_act38side_01_beg","storyGroup":"act38side","storySort":2,"storyDependence":"act38side_level_act38side_st01","storyCanShow":1,"storyCode":"PV-1","storyName":"失途","storyPic":null,"storyInfo":"受拉维妮娅委托，卡车工会主席伊雷妮协助追查逃逸车辆，却得知肇事者正是自己的好友——卡车司机索默尔。与此同时，拉维妮娅将怀疑的目光投向了邀请莱昂图索赴宴的德米特里。","storyCanEnter":1,"storyTxt":"activities/act38side/level_act38side_01_beg","avgTag":"行动前","unLockType":"STAGE_CLEAR","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act38side_01","minState":"PLAYED","maxState":"COMPLETE"}],"prev":0,"next":2,"characters":["码头工人","家族成员","伊雷妮","卡车司机A","卡车司机B","拉维妮娅","警察","私人医生","莱昂图索","啰嗦的护理师","安东尼奥","？？？","甘比诺","卡车司机","惶恐的卡车司机","索默尔"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"stopmusic","id":1},{"type":"dialog","id":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":3},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":4},{"type":"charslot","id":5},{"type":"background","image":"https://media.prts.wiki/0/0b/Avg_bg_56_g11_newvolsiniipier.png","screenadapt":"coverall","id":6},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":7},{"type":"playmusic","intro":"$ponder_intro","key":"https://static.prts.wiki/music/music/act15d0d0/m_avg_ponder_loop.mp3","volume":"0.6","id":8,"musicid":0},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":9},{"type":"animtext","id":10,"name":"group_location_stamp","style":"avg_only_medium","pos":"-400,-200","block":"false","text":"<p=2>1099年12月5日</>"},{"type":"delay","time":"3","id":11},{"type":"animtextclean","id":12},{"type":"delay","time":"1","id":13},{"type":"soundvolume","volume":"0.4","channel":"s","fadetime":"2","id":14},{"type":"playsound","key":"$d_avg_craneworking","volume":"1","id":15},{"type":"delay","time":"1","id":16},{"type":"charslot","slot":"m","name":"avg_npc_1550_1#1$1","duration":"1","isblock":"true","id":17},{"type":"dialogue","name":"码头工人","text":"运的什么东西？","id":18,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_698_1#1$1","id":19},{"type":"dialogue","name":"家族成员","text":"葡萄酒。","id":20,"figure":"https://media.prts.wiki/6/68/Avg_avg_npc_698_1$1.png"},{"type":"dialog","id":21},{"type":"charslot","slot":"m","name":"avg_npc_1550_1#1$1","id":22},{"type":"dialogue","name":"码头工人","text":"货运单号。","id":23,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_698_1#1$1","id":24},{"type":"dialogue","name":"家族成员","text":"SZ990183。","id":25,"figure":"https://media.prts.wiki/6/68/Avg_avg_npc_698_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1550_1#1$1","id":26},{"type":"dialogue","name":"码头工人","text":"所属公司名称？","id":27,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_698_1#1$1","id":28},{"type":"dialogue","name":"家族成员","text":"抱歉，我没有听懂你的问题。","id":29,"figure":"https://media.prts.wiki/6/68/Avg_avg_npc_698_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1550_1#1$1","id":30},{"type":"dialogue","name":"码头工人","text":"你车上装的货物，属于哪一家公司？这有什么听不懂的。","id":31,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_698_1#1$1","id":32},{"type":"dialogue","name":"家族成员","text":"哈哈......看起来，这位先生应该刚工作不久，还不懂规矩。","id":33,"figure":"https://media.prts.wiki/6/68/Avg_avg_npc_698_1$1.png"},{"type":"dialog","id":34},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","loop":"true","channel":"w","id":35},{"type":"stopsound","channel":"w","fadetime":"1","id":36},{"type":"charslot","slot":"m","name":"avg_npc_698_1#1$1","posfrom":"0,0","posto":"200,0","afrom":"1","ato":"1","duration":"1","id":37},{"type":"delay","time":"0.5","id":38},{"type":"charslot","slot":"l","name":"avg_npc_698_1#1$1","posfrom":"-200,0","posto":"0,0","duration":"1","id":39},{"type":"delay","time":"1.5","id":40},{"type":"charslot","slot":"m","focus":"m","id":41},{"type":"dialogue","name":"家族成员","text":"没关系，我可以耐心地教你。这种时候，你应该恭敬地问：“您属于哪个家族？”","id":42,"figure":"https://media.prts.wiki/6/68/Avg_avg_npc_698_1$1.png"},{"type":"charslot","id":43},{"type":"charslot","slot":"m","name":"avg_npc_1550_1#3$1","id":44},{"type":"dialogue","name":"码头工人","text":"......","id":45,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1550_1-3$1.png"},{"type":"dialog","id":46},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":47},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#1$1","posfrom":"200,0","posto":"50,0","duration":"1.5","id":48},{"type":"charslot","slot":"l","name":"avg_npc_1547_1#1$1","posfrom":"-200,0","posto":"-50,0","duration":"1.5","id":49},{"type":"delay","time":"2","id":50},{"type":"charslot","id":51},{"type":"charslot","slot":"m","name":"avg_npc_698_1#1$1","id":52},{"type":"dialogue","name":"家族成员","text":"你们......","id":53,"figure":"https://media.prts.wiki/6/68/Avg_avg_npc_698_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#8$1","id":54},{"type":"dialogue","name":"伊雷妮","text":"抱歉先生，所属公司名称？","id":55,"figure":"https://media.prts.wiki/8/8f/Avg_avg_npc_1542_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_698_1#1$1","id":56},{"type":"dialogue","name":"家族成员","text":"......萨卢佐酒业。","id":57,"figure":"https://media.prts.wiki/6/68/Avg_avg_npc_698_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#4$1","id":58},{"type":"dialogue","name":"伊雷妮","text":"嗯......行了，信息核对无误，可以通过。","id":59,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1542_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_698_1#1$1","id":60},{"type":"dialogue","name":"家族成员","text":"......","id":61,"figure":"https://media.prts.wiki/6/68/Avg_avg_npc_698_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#4$1","id":62},{"type":"dialogue","name":"伊雷妮","text":"不要这样看着我，也不要带着老一套的思路在这里处理问题。看看关口上面的标志吧。","id":63,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1542_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#1$1","id":64},{"type":"dialogue","name":"伊雷妮","text":"欢迎来到新沃尔西尼。","id":65,"figure":"https://media.prts.wiki/4/4d/Avg_avg_npc_1542_1-1$1.png"},{"type":"dialog","id":66},{"type":"stopmusic","fadetime":"2","id":67},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":68},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":69},{"type":"charslot","id":70},{"type":"bgeffect","name":"$eb_tvnoise","layer":"1","id":71},{"type":"delay","time":"1","id":72},{"type":"image","image":"https://media.prts.wiki/b/b6/Avg_56_i22.png","screenadapt":"coverall","id":73},{"type":"playsound","key":"$d_avg_filmprojection","id":74},{"type":"playsound","key":"$d_avg_filmprojection_loop","loop":"true","channel":"bgs","delay":"0.5","id":75},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":76},{"type":"sticker","id":77,"text":"新都会","delay":"0.001","width":"800","x":"250","y":"520","duration":"2","alignment":"center","size":"42"},{"type":"delay","time":"1","id":78},{"type":"sticker","id":79,"duration":"2","block":"false"},{"type":"stopsound","channel":"bgs","fadetime":"2","id":80},{"type":"musicvolume","volume":"0.6","fadetime":"2","id":81},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":82},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":83},{"type":"image","id":84},{"type":"charslot","id":85},{"type":"bgeffect","id":86},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_normal_loop.mp3","volume":"0.6","id":87,"musicid":1},{"type":"background","image":"https://media.prts.wiki/d/d7/Avg_bg_56_g9_truckcamp.png","screenadapt":"coverall","id":88},{"type":"delay","time":"1","id":89},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":90},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":91},{"type":"animtext","id":92,"name":"group_location_stamp","style":"avg_only_medium","pos":"-400,-200","block":"false","text":"<p=2>1100年11月6日    7:00 A.M.</>"},{"type":"delay","time":"3","id":93},{"type":"animtextclean","id":94},{"type":"delay","time":"1","id":95},{"type":"playsound","key":"$d_gen_walk_n","id":96},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#2$1","duration":"1.5","isblock":"true","id":97},{"type":"delay","time":"0.5","id":98},{"type":"charslot","id":99},{"type":"playsound","key":"$rungeneral","volume":"1","id":100},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","posfrom":"-200,0","posto":"0,0","duration":"0.5","id":101},{"type":"delay","time":"0.5","id":102},{"type":"charslot","slot":"r","name":"avg_npc_1561_1#1$1","posfrom":"200,0","posto":"0,0","duration":"0.5","id":103},{"type":"delay","time":"0.8","id":104},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","focus":"l","id":105},{"type":"dialogue","name":"卡车司机A","text":"头儿，你来得正好，有点事要和你商量。","id":106,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"dialogue","name":"卡车司机A","text":"我们几个今天不出车，打算把营地的路面整个都规整一遍。","id":107,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"dialogue","name":"卡车司机A","text":"要是山德罗下次倒车的时候再扎爆胎，就只能怪他自己实在是交不到好运了，哈哈。","id":108,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1561_1#1$1","focus":"r","id":109},{"type":"dialogue","name":"卡车司机B","text":"另外，定制的帐篷也到了，我们打算搭在靠西的出口。","id":110,"figure":"https://media.prts.wiki/c/c0/Avg_avg_npc_1561_1-1$1.png"},{"type":"dialogue","name":"卡车司机B","text":"空间大，雨棚、净水装置、烧烤架都有地方安置。那边也更安静，到时候新加入的伙计们也能适应得更快一些。","id":111,"figure":"https://media.prts.wiki/c/c0/Avg_avg_npc_1561_1-1$1.png"},{"type":"dialogue","name":"卡车司机B","text":"我还顺便添置了一块露天屏幕，以后大家伙在营地又多了个娱乐项目。","id":112,"figure":"https://media.prts.wiki/c/c0/Avg_avg_npc_1561_1-1$1.png"},{"type":"dialogue","name":"卡车司机B","text":"我改天去租一些蓝卡坞的超级大片......我知道你要说什么——记得不要黑帮电影。","id":113,"figure":"https://media.prts.wiki/c/c0/Avg_avg_npc_1561_1-1$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","focus":"l","id":114},{"type":"dialogue","name":"卡车司机A","text":"对了，听说市政厅已经在着手建设新的安置区了？","id":115,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1561_1#1$1","focus":"r","id":116},{"type":"dialogue","name":"卡车司机B","text":"哈哈，那他们最好动作快一点，要不然到时候我可能都舍不得搬走了。","id":117,"figure":"https://media.prts.wiki/c/c0/Avg_avg_npc_1561_1-1$1.png"},{"type":"dialogue","name":"卡车司机B","text":"虽然现在卡车只能停在营地里，大家伙只能住在卡车上，拖家带口的有很多不方便......","id":118,"figure":"https://media.prts.wiki/c/c0/Avg_avg_npc_1561_1-1$1.png"},{"type":"dialogue","name":"卡车司机B","text":"但起码再也不用受那些家族的人欺负。这些卡车真的属于我们，和大家伙一起守着它们，安心。","id":119,"figure":"https://media.prts.wiki/c/c0/Avg_avg_npc_1561_1-1$1.png"},{"type":"charslot","id":120},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#1$1","id":121},{"type":"dialogue","name":"伊雷妮","text":"......是啊。","id":122,"figure":"https://media.prts.wiki/4/4d/Avg_avg_npc_1542_1-1$1.png"},{"type":"dialogue","name":"伊雷妮","text":"有时候看看眼前的营地，谁敢相信一年前这里还只是一块荒地呢？","id":123,"figure":"https://media.prts.wiki/4/4d/Avg_avg_npc_1542_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1550_1#1$1","id":124},{"type":"dialogue","name":"卡车司机A","text":"对了，头儿，你为什么一晚上没回来？","id":125,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#3$1","id":126},{"type":"dialogue","name":"伊雷妮","text":"啊，被你们一打岔，差点忘了正事！","id":127,"figure":"https://media.prts.wiki/f/f9/Avg_avg_npc_1542_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#2$1","id":128},{"type":"dialogue","name":"伊雷妮","text":"把几个城区的负责人都叫过来，山德罗、金特、索默尔......","id":129,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1550_1#1$1","id":130},{"type":"dialogue","name":"卡车司机A","text":"索默尔不在。","id":131,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#5$1","id":132},{"type":"dialogue","name":"伊雷妮","text":"嗯？今天他不是休息吗？","id":133,"figure":"https://media.prts.wiki/a/ae/Avg_avg_npc_1542_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#7$1","id":134},{"type":"dialogue","name":"伊雷妮","text":"都跟他说过好几次了，想给小古莉治病，想早点把她接到新沃尔西尼来，我能理解......","id":135,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1542_1-7$1.png"},{"type":"dialogue","name":"伊雷妮","text":"小古莉也是我的妹妹，我会一起想办法，不要老给自己多加出车任务。","id":136,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1542_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1550_1#2$1","id":137},{"type":"dialogue","name":"卡车司机A","text":"头儿，别生气，应、应该不是你想的这样。","id":138,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1550_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#2$1","id":139},{"type":"dialogue","name":"伊雷妮","text":"倒霉蛋呢？","id":140,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1561_1#1$1","id":141},{"type":"dialogue","name":"卡车司机B","text":"倒霉蛋也不在，从昨天晚上开始就没怎么看见她。","id":142,"figure":"https://media.prts.wiki/c/c0/Avg_avg_npc_1561_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#4$1","id":143},{"type":"dialogue","name":"伊雷妮","text":"奇怪。算了，让还在营地的人集合......我们得帮着拉维妮娅法官去查一些事情。","id":144,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1542_1-4$1.png"},{"type":"dialog","id":145},{"type":"stopmusic","fadetime":"2","id":146},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":147},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":148},{"type":"charslot","id":149},{"type":"background","image":"https://media.prts.wiki/f/f3/Avg_bg_56_g1_newvolsiniistreet_d.png","screenadapt":"coverall","id":150},{"type":"delay","time":"1","id":151},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_darkness_03_loop.mp3","volume":"0.6","id":152,"musicid":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":153},{"type":"delay","time":"1","id":154},{"type":"text","text":"艳阳高照。","id":155},{"type":"text","text":"拉起的警戒线让热闹的街道变得冷清，地面上的血迹与锐利的车辙混杂，警察们来回忙碌着。","id":156},{"type":"text","text":"新沃尔西尼并不像叙拉古的其他城市那样经常下雨，没有了掩人耳目的雨，事故现场显得格外醒目。","id":157},{"type":"dialog","id":158},{"type":"playsound","key":"$d_gen_walk_n","id":159},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#1$1","duration":"1.5","isblock":"true","id":160},{"type":"dialogue","name":"拉维妮娅","text":"......有什么新的进展吗？","id":161,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1553_1#1$2","id":162},{"type":"dialogue","name":"警察","text":"这条路附近的监控坏了，我们没法搜集到关键的视频证据，只能做进一步的痕迹鉴定。","id":163,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"dialogue","name":"警察","text":"您看，这就是莱昂图索先生驾驶的私家车和那辆已经消失在现场的载具所留下的车辙印......","id":164,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"dialogue","name":"警察","text":"撞车的地方是一个拐角，虽然存在视觉盲区，但根据当时信号灯的情况，两辆车本不会相撞，可它们却几乎在同时发生了诡异的偏移——","id":165,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"dialogue","name":"警察","text":"随后，莱昂图索先生被撞，另一辆车逃离了现场。","id":166,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#8$1","id":167},{"type":"dialogue","name":"拉维妮娅","text":"可能是意外交通事故，但也不排除......","id":168,"figure":"https://media.prts.wiki/8/84/Avg_avg_4065_judge_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1553_1#1$2","id":169},{"type":"dialogue","name":"警察","text":"是的。","id":170,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#1$1","id":171},{"type":"dialogue","name":"拉维妮娅","text":"另一辆车的信息确认了吗？","id":172,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1553_1#1$2","id":173},{"type":"dialogue","name":"警察","text":"和我们昨晚的判断一致——一辆重型厢式载具。","id":174,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#8$1","id":175},{"type":"dialogue","name":"拉维妮娅","text":"嗯。货车、接驳车、消防车和特殊工程装置......这种体积的厢式载具在新沃尔西尼能出现的地方并不多。","id":176,"figure":"https://media.prts.wiki/8/84/Avg_avg_4065_judge_1-8$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"我已经拜托伊雷妮帮我们一起去查了，在这方面，卡车司机们能找的线索比我们多。","id":177,"figure":"https://media.prts.wiki/8/84/Avg_avg_4065_judge_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1553_1#1$2","id":178},{"type":"dialogue","name":"警察","text":"拉维妮娅法官，莱昂图索先生他......","id":179,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#7$1","id":180},{"type":"dialogue","name":"拉维妮娅","text":"......","id":181,"figure":"https://media.prts.wiki/d/d0/Avg_avg_4065_judge_1-7$1.png"},{"type":"dialog","id":182},{"type":"playsound","key":"$flashback","volume":"0.8","id":183},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":184},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.5","block":"true","id":185},{"type":"charslot","id":186},{"type":"background","image":"https://media.prts.wiki/2/27/Avg_bg_bg_vipward.png","screenadapt":"coverall","id":187},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":188},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":189},{"type":"delay","time":"1","id":190},{"type":"playsound","key":"$d_avg_heartratemonitor","volume":"1","loop":"true","channel":"h","id":191},{"type":"stopsound","channel":"h","fadetime":"6","id":192},{"type":"charslot","slot":"m","name":"avg_npc_697_1#1$1","id":193},{"type":"dialogue","name":"私人医生","text":"骨折和内出血的问题已经通过手术处理了，但是剧烈的脑震荡导致病人还没有办法恢复意识。","id":194,"figure":"https://media.prts.wiki/7/79/Avg_avg_npc_697_1$1.png"},{"type":"dialogue","name":"私人医生","text":"从某种意义上来说，伤者还不能算脱离了生命危险。","id":195,"figure":"https://media.prts.wiki/7/79/Avg_avg_npc_697_1$1.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#6$1","id":196},{"type":"dialogue","name":"拉维妮娅","text":"他......他还能醒来吗？","id":197,"figure":"https://media.prts.wiki/6/62/Avg_avg_4065_judge_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_697_1#1$1","id":198},{"type":"dialogue","name":"私人医生","text":"从医生的角度，我不敢给出任何保证......但从一个新沃尔西尼市民的角度，我衷心希望莱昂图索先生能恢复健康，我们会尽全力。","id":199,"figure":"https://media.prts.wiki/7/79/Avg_avg_npc_697_1$1.png"},{"type":"dialogue","name":"私人医生","text":"祝你们好运，拉维妮娅法官。","id":200,"figure":"https://media.prts.wiki/7/79/Avg_avg_npc_697_1$1.png"},{"type":"dialog","id":201},{"type":"playsound","key":"$flashback","volume":"0.8","id":202},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":203},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.5","block":"true","id":204},{"type":"charslot","id":205},{"type":"background","image":"https://media.prts.wiki/f/f3/Avg_bg_56_g1_newvolsiniistreet_d.png","screenadapt":"coverall","id":206},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":207},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#7$1","id":208},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":209},{"type":"delay","time":"1","id":210},{"type":"dialogue","name":"拉维妮娅","text":"......他们还是动手了。","id":211,"figure":"https://media.prts.wiki/d/d0/Avg_avg_4065_judge_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1553_1#1$2","id":212},{"type":"dialogue","name":"警察","text":"拉维妮娅法官，您说，我们要不要先去找到那些和家族有关的人，先把他们通通抓起来，然后再——","id":213,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#15$1","id":214},{"type":"dialogue","name":"拉维妮娅","text":"不要想这种事。","id":215,"figure":"https://media.prts.wiki/1/1c/Avg_avg_4065_judge_1-15$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"这是家族的行事逻辑，不是我们的。","id":216,"figure":"https://media.prts.wiki/1/1c/Avg_avg_4065_judge_1-15$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1553_1#1$2","id":217},{"type":"dialogue","name":"警察","text":"对不起！可我觉得，要说谁有理由对莱昂图索先生动手，那也只有家族那些坏家伙了！","id":218,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#7$1","id":219},{"type":"dialogue","name":"拉维妮娅","text":"无论是谁，我们一定会把凶手找出来。他一定会受到审判。","id":220,"figure":"https://media.prts.wiki/d/d0/Avg_avg_4065_judge_1-7$1.png"},{"type":"dialog","id":221},{"type":"delay","time":"1","id":222},{"type":"dialogue","name":"拉维妮娅","text":"会是谁......","id":223,"figure":"https://media.prts.wiki/d/d0/Avg_avg_4065_judge_1-7$1.png"},{"type":"dialog","id":224},{"type":"musicvolume","volume":"0.2","fadetime":"2","id":225},{"type":"playsound","key":"$d_avg_humanchange","volume":"1","id":226},{"type":"delay","time":"0.4","id":227},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":228},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":229},{"type":"charslot","id":230},{"type":"background","image":"https://media.prts.wiki/3/31/Avg_bg_33_g7_reception.png","screenadapt":"coverall","id":231},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":232},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":233},{"type":"delay","time":"1","id":234},{"type":"dialogue","name":"拉维妮娅","text":"萨卢佐？","id":235},{"type":"dialogue","name":"拉维妮娅","text":"威尼斯？","id":236},{"type":"dialogue","name":"拉维妮娅","text":"美第奇？","id":237},{"type":"dialogue","name":"拉维妮娅","text":"雷欧帝？","id":238},{"type":"dialogue","name":"拉维妮娅","text":"......","id":239},{"type":"dialog","id":240},{"type":"musicvolume","volume":"0.6","fadetime":"2","id":241},{"type":"playsound","key":"$d_avg_humanchange","volume":"1","id":242},{"type":"delay","time":"0.4","id":243},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":244},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":245},{"type":"background","image":"https://media.prts.wiki/f/f3/Avg_bg_56_g1_newvolsiniistreet_d.png","screenadapt":"coverall","id":246},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#8$1","id":247},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":248},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":249},{"type":"delay","time":"1","id":250},{"type":"charslot","slot":"m","focus":"n","id":251},{"type":"text","text":"拉维妮娅的目光落在了街角的一家餐馆。","id":252},{"type":"text","text":"餐馆不大，临窗的座位正对着马路中央。","id":253},{"type":"dialog","id":254},{"type":"playsound","key":"$d_avg_humanchange","volume":"1","id":255},{"type":"delay","time":"0.4","id":256},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":257},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":258},{"type":"background","image":"https://media.prts.wiki/6/65/Avg_bg_56_g6_courtsquare_n.png","screenadapt":"coverall","id":259},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":260},{"type":"charslot","slot":"m","name":"avg_npc_1541_1#2$1","id":261},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":262},{"type":"delay","time":"1","id":263},{"type":"dialogue","name":"莱昂图索","text":"今晚，我答应了德米特里的饭局邀约......拉维妮娅，我不可能一直对他避而不见。","id":264,"figure":"https://media.prts.wiki/7/79/Avg_avg_npc_1541_1-2$1.png"},{"type":"dialog","id":265},{"type":"musicvolume","volume":"0.6","fadetime":"2","id":266},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":267},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":268},{"type":"background","image":"https://media.prts.wiki/f/f3/Avg_bg_56_g1_newvolsiniistreet_d.png","screenadapt":"coverall","id":269},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#6$1","id":270},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":271},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":272},{"type":"delay","time":"1","id":273},{"type":"dialogue","name":"拉维妮娅","text":"莱昂，这到底是为什么......","id":274,"figure":"https://media.prts.wiki/6/62/Avg_avg_4065_judge_1-6$1.png"},{"type":"dialog","id":275},{"type":"stopmusic","fadetime":"2","id":276},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":277},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":278},{"type":"charslot","id":279},{"type":"background","image":"https://media.prts.wiki/7/74/Avg_bg_33_g11_mansionhall.png","screenadapt":"coverall","id":280},{"type":"delay","time":"1","id":281},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":282},{"type":"playsound","key":"$d_avg_groomingsoft","volume":"1","id":283},{"type":"delay","time":"1","id":284},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","id":285},{"type":"dialogue","name":"啰嗦的护理师","text":"安东尼奥先生，我已经帮您修剪了耳朵和尾巴上的杂毛，接下来的步骤是涂抹养护液。","id":286,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"dialogue","name":"啰嗦的护理师","text":"时间可能会比较久，您可以闭上眼睛小睡一会儿。","id":287,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","focus":"n","id":288},{"type":"dialogue","name":"安东尼奥","text":"没关系，忙你的就好。","id":289},{"type":"dialogue","name":"安东尼奥","text":"你是第一次过来吧？","id":290},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","id":291},{"type":"dialogue","name":"啰嗦的护理师","text":"是、是的。卡尔说要不是您的专属护理师生病了，我......总之能有机会为您服务，是我的荣幸。","id":292,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","focus":"n","id":293},{"type":"dialogue","name":"安东尼奥","text":"别紧张，你的手艺确实很好。","id":294},{"type":"playsound","key":"$d_avg_groomingsoft","volume":"1","id":295},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","id":296},{"type":"dialogue","name":"啰嗦的护理师","text":"多谢夸奖。","id":297,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"dialogue","name":"啰嗦的护理师","text":"我们家祖祖辈辈都在研究鲁珀毛发，从走街串巷的护理匠到开起第一家护理中心，也好几百年了，还算有些心得！","id":298,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"dialogue","name":"啰嗦的护理师","text":"鲁珀的毛发一般比较粗硬，而且内外分层，佩洛的则要细软很多，乍一看很相似，但实际天差地别。","id":299,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"dialogue","name":"啰嗦的护理师","text":"所以我特地为您调配了这款养护液，多重萃取精华可以使毛发的质感变得硬一些，但营养并不会流失。","id":300,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"dialogue","name":"啰嗦的护理师","text":"不知道您还满意吗？","id":301,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","focus":"n","id":302},{"type":"dialogue","name":"安东尼奥","text":"当然。都这么用心了，我没有不满意的道理。","id":303},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","id":304},{"type":"dialogue","name":"啰嗦的护理师","text":"安东尼奥先生，原来您很和善啊，根本不像卡尔说的那么可怕......","id":305,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","focus":"n","id":306},{"type":"dialogue","name":"安东尼奥","text":"我觉得这应该是有些什么误会，我只是一个生意人。谁会愿意和一个很可怕的人做生意呢？","id":307},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","id":308},{"type":"dialogue","name":"啰嗦的护理师","text":"哈哈......对啦，安东尼奥先生，您要不要给耳朵和尾巴做一次半永久定型？","id":309,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"dialogue","name":"啰嗦的护理师","text":"这样它们的轮廓可以更立体，更好看，而且，别人就看不出您和鲁珀的区别——","id":310,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","focus":"n","id":311},{"type":"dialogue","name":"安东尼奥","text":"哦......等一下。","id":312},{"type":"dialog","id":313},{"type":"playmusic","intro":"$mist_intro","key":"https://static.prts.wiki/music/music/beta1_180603/m_dia_mist_loop.mp3","volume":"0.6","id":314,"musicid":3},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","posfrom":"0,0","posto":"200,0","afrom":"1","ato":"1","duration":"1","id":315},{"type":"delay","time":"0.5","id":316},{"type":"playsound","key":"$d_avg_clothmovement","volume":"1","id":317},{"type":"charslot","slot":"l","name":"avg_npc_1544_1#4$1","posfrom":"0,-30","posto":"0,0","duration":"1","id":318},{"type":"delay","time":"1.5","id":319},{"type":"charslot","slot":"l","name":"avg_npc_1544_1#10$1","focus":"l","id":320},{"type":"dialogue","name":"安东尼奥","text":"听起来，你对我的耳朵和尾巴有很多看法。","id":321,"figure":"https://media.prts.wiki/a/a8/Avg_avg_npc_1544_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","focus":"m","id":322},{"type":"dialogue","name":"啰嗦的护理师","text":"因为我听卡尔说，您喜欢让自己看上去比较像鲁珀。","id":323,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1544_1#10$1","focus":"l","id":324},{"type":"dialogue","name":"安东尼奥","text":"喔喔喔，你的意思是，我作为一个卑贱的佩洛，不应该冒充高贵的鲁珀？","id":325,"figure":"https://media.prts.wiki/a/a8/Avg_avg_npc_1544_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1563_1#1$1","focus":"m","id":326},{"type":"dialogue","name":"啰嗦的护理师","text":"......","id":327,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"dialog","id":328},{"type":"charslot","id":329},{"type":"playsound","key":"$d_avg_walkfast","volume":"1","id":330},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","posfrom":"200,0","posto":"0,0","duration":"0.5","isblock":"true","id":331},{"type":"dialogue","name":"家族成员","text":"你在这说什么呢！","id":332,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"dialog","id":333},{"type":"charslot","id":334},{"type":"charslot","slot":"l","name":"avg_npc_1544_1#10$1","focus":"n","id":335},{"type":"charslot","slot":"r","name":"avg_npc_1563_1#1$1","focus":"r","id":336},{"type":"dialogue","name":"啰嗦的护理师","text":"卡尔？","id":337,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"dialogue","name":"啰嗦的护理师","text":"我......我只是想向安东尼奥先生介绍一下——","id":338,"figure":"https://media.prts.wiki/0/0f/Avg_avg_npc_1563_1$1.png"},{"type":"charslot","id":339},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":340},{"type":"dialogue","name":"家族成员","text":"够了，闭嘴！赶快出去！","id":341,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"dialog","id":342},{"type":"charslot","id":343},{"type":"playsound","key":"$rungeneral","volume":"1","id":344},{"type":"charslot","slot":"l","name":"avg_npc_1544_1#10$1","id":345},{"type":"charslot","slot":"r","name":"avg_npc_1563_1#1$1","posfrom":"0,0","posto":"200,0","afrom":"1","ato":"0","duration":"0.5","isblock":"true","id":346},{"type":"delay","time":"1.5","id":347},{"type":"charslot","id":348},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":349},{"type":"dialogue","name":"家族成员","text":"抱歉，安东尼奥......","id":350,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":351},{"type":"dialogue","name":"安东尼奥","text":"没事，没有关系。这不是你的错。","id":352,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":353},{"type":"dialogue","name":"家族成员","text":"这是本月公司的货运单，请过目。","id":354,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","id":355},{"type":"text","text":"安东尼奥接过货运单，快速地扫过一眼，用钢笔在签名处画上了一个叉。","id":356},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":357},{"type":"dialogue","name":"安东尼奥","text":"今天会有一批“轮胎”到库，是你负责验收吧，为什么这个时间点你还留在宅邸？","id":358,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":359},{"type":"dialogue","name":"家族成员","text":"我马上就去。您放心，出不了岔子。","id":360,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"dialog","id":361},{"type":"charslot","id":362},{"type":"playsound","key":"$d_avg_walkfast","volume":"0.6","id":363},{"type":"delay","time":"1.5","id":364},{"type":"dialogue","name":"？？？","text":"这里是......","id":365},{"type":"dialogue","name":"？？？","text":"放开我！你们为什么带我来这里？","id":366},{"type":"dialogue","name":"甘比诺","text":"把嘴闭上，小子。","id":367},{"type":"dialogue","name":"甘比诺","text":"再乱叫的话，我就把你的整张脸都揍得跟你的眼影一样花哨。","id":368},{"type":"dialogue","name":"甘比诺","text":"卡彭，你盯着他，我进去向老板汇报。","id":369},{"type":"dialog","id":370},{"type":"playsound","key":"$d_gen_walk_n","id":371},{"type":"charslot","slot":"m","name":"avg_npc_542_1#4$1","duration":"1.5","isblock":"true","id":372},{"type":"dialogue","name":"甘比诺","text":"老板，出事了。","id":373,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_542_1-4$1.png"},{"type":"dialogue","name":"甘比诺","text":"昨天晚上，港口区发生了一起车祸，莱昂图索被撞伤了。","id":374,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_542_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":375},{"type":"dialogue","name":"家族成员","text":"代理市长......大新闻，不过这和我们有什么关系？","id":376,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_542_1#6$1","id":377},{"type":"dialogue","name":"甘比诺","text":"......肇事的那辆车，就是帮我们运“轮胎”的。","id":378,"figure":"https://media.prts.wiki/e/e2/Avg_avg_npc_542_1-6$1.png"},{"type":"dialogue","name":"甘比诺","text":"我们还没来得及反应，车就跑了。","id":379,"figure":"https://media.prts.wiki/e/e2/Avg_avg_npc_542_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":380},{"type":"dialogue","name":"家族成员","text":"......","id":381,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#8$1","id":382},{"type":"dialogue","name":"安东尼奥","text":"......","id":383,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_1544_1-8$1.png"},{"type":"dialog","id":384},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":385},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"200,0","afrom":"1","ato":"0","duration":"1.5","isblock":"true","id":386},{"type":"text","text":"男人在房间里踱着步子，沉重的脚步声盖过了他粗重的呼吸声。","id":387},{"type":"text","text":"他走到酒桶边，接连喝了三杯白兰地。","id":388},{"type":"dialog","id":389},{"type":"charslot","id":390},{"type":"playsound","key":"$pourwater","volume":"1","id":391},{"type":"delay","time":"1","id":392},{"type":"playsound","key":"$d_avg_winglssice","volume":"1","id":393},{"type":"delay","time":"1.5","id":394},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":395},{"type":"dialogue","name":"家族成员","text":"安东尼奥，我们现在该......","id":396,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"dialog","id":397},{"type":"charslot","id":398},{"type":"playsound","key":"$d_gen_walk_n","id":399},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#2$1","duration":"1.5","isblock":"true","id":400},{"type":"dialogue","name":"安东尼奥","text":"等一下，等一下。任何时候，我都不喜欢急躁，这会让我们失去判断力。","id":401,"figure":"https://media.prts.wiki/0/0c/Avg_avg_npc_1544_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":402},{"type":"dialogue","name":"安东尼奥","text":"现场有其他目击者吗？","id":403,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_542_1#6$1","id":404},{"type":"dialogue","name":"甘比诺","text":"有一个，被我和卡彭带回来了。","id":405,"figure":"https://media.prts.wiki/e/e2/Avg_avg_npc_542_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":406},{"type":"dialogue","name":"安东尼奥","text":"做得好。","id":407,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"dialogue","name":"安东尼奥","text":"接下来，按我说的去做。","id":408,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"dialogue","name":"安东尼奥","text":"首先，看住家里所有人。在这个时候，要是有人去了不该去的地方，或是出现在不合适的岗位，立刻带他来见我。","id":409,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"dialogue","name":"安东尼奥","text":"盯紧城里的其他家族，萨卢佐、美第奇、雷欧帝......这个时候，谁最着急，那就是谁动的手。","id":410,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":411},{"type":"dialogue","name":"安东尼奥","text":"我倒是好奇，在这个时间点上，是谁急着掀了牌桌。","id":412,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":413},{"type":"dialogue","name":"家族成员","text":"那肇事的车辆......我们难道不找了？","id":414,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":415},{"type":"dialogue","name":"安东尼奥","text":"找，但别在明面上做过分的事。","id":416,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"dialogue","name":"安东尼奥","text":"只要不是卡车出了质量问题，开车的是谁，运的是什么货，和威尼斯载具公司又有什么关系呢？","id":417,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#3$1","id":418},{"type":"dialogue","name":"安东尼奥","text":"去安抚一下其他和我们有联系的卡车司机。那些常年和刹车离合打交道的朋友，往往比普通人更容易乱了阵脚。","id":419,"figure":"https://media.prts.wiki/e/ec/Avg_avg_npc_1544_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":420},{"type":"dialogue","name":"家族成员","text":"好，我这就去。","id":421,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#8$1","id":422},{"type":"dialogue","name":"安东尼奥","text":"等等，卡尔。","id":423,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_1544_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":424},{"type":"dialogue","name":"安东尼奥","text":"甘比诺，你带人去做吧。","id":425,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_542_1#6$1","id":426},{"type":"dialogue","name":"甘比诺","text":"好的，老板。","id":427,"figure":"https://media.prts.wiki/e/e2/Avg_avg_npc_542_1-6$1.png"},{"type":"dialog","id":428},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":429},{"type":"charslot","duration":"1.5","isblock":"true","id":430},{"type":"delay","time":"0.5","id":431},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":432},{"type":"dialogue","name":"家族成员","text":"安东尼奥，对、对不起，是我的疏忽......","id":433,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":434},{"type":"dialogue","name":"安东尼奥","text":"谁也料想不到会发生这样的意外。","id":435,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#1$1","id":436},{"type":"dialogue","name":"安东尼奥","text":"你很优秀，卡尔。你跟着老家主的时间比我久，蒙特卢佩半数的载具维修工厂都是你负责。","id":437,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1544_1-1$1.png"},{"type":"dialogue","name":"安东尼奥","text":"我要是你也难免会想，那个叫安东尼奥的佩洛如果不是仗着娶了老家主的女儿，凭什么能有那么多机会，甚至能独立负责新城市的业务。","id":438,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1544_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":439},{"type":"dialogue","name":"家族成员","text":"我、我没有......","id":440,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#8$1","id":441},{"type":"dialogue","name":"安东尼奥","text":"听好，卡尔，不管是新沃尔西尼，还是其他任何一座城市，都要遵守规则。读不懂规则的人，是没有办法体面地走下牌桌的。","id":442,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_1544_1-8$1.png"},{"type":"dialogue","name":"安东尼奥","text":"这句话是老家主告诉我的，现在我也告诉你。","id":443,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_1544_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":444},{"type":"dialogue","name":"家族成员","text":"再给我一次机会，安东尼奥。","id":445,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":446},{"type":"dialogue","name":"安东尼奥","text":"老家主这两天应该会到达新沃尔西尼，我不希望这些小事会麻烦到他老人家，可以吗？","id":447,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":448},{"type":"dialogue","name":"家族成员","text":"遵、遵命，谢谢！","id":449,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"dialog","id":450},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":451},{"type":"delay","time":"1","id":452},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#2$1","id":453},{"type":"dialogue","name":"安东尼奥","text":"等一下......还有一件事。","id":454,"figure":"https://media.prts.wiki/0/0c/Avg_avg_npc_1544_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#3$1","id":455},{"type":"dialogue","name":"安东尼奥","text":"刚刚那位护理师......我很不喜欢。","id":456,"figure":"https://media.prts.wiki/e/ec/Avg_avg_npc_1544_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":457},{"type":"dialogue","name":"家族成员","text":"明白了，我这就去解雇他。","id":458,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":459},{"type":"dialogue","name":"安东尼奥","text":"不不......我不是说不喜欢他的服务，我是说，这个人，我很不喜欢。","id":460,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1555_1#1$1","id":461},{"type":"dialogue","name":"家族成员","text":"......明白了，您不会再看到他了。","id":462,"figure":"https://media.prts.wiki/f/f8/Avg_avg_npc_1555_1$1.png"},{"type":"dialog","id":463},{"type":"stopmusic","fadetime":"2","id":464},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":465},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":466},{"type":"charslot","id":467},{"type":"background","image":"https://media.prts.wiki/d/d7/Avg_bg_56_g9_truckcamp.png","screenadapt":"coverall","id":468},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#2$1","id":469},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_formal_loop.mp3","volume":"0.6","id":470,"musicid":4},{"type":"delay","time":"1","id":471},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":472},{"type":"delay","time":"1","id":473},{"type":"playsound","key":"$d_gen_walk_n","id":474},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","posfrom":"-200,0","posto":"0,0","duration":"1.5","id":475},{"type":"delay","time":"2","id":476},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#2$1","focus":"r","id":477},{"type":"dialogue","name":"伊雷妮","text":"找到了吗？","id":478,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","focus":"l","id":479},{"type":"dialogue","name":"卡车司机","text":"没有......我们把几个停车点都找了一遍，没有发现看起来像是刚刚出过车祸的卡车。","id":480,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"dialogue","name":"卡车司机","text":"互助会名下有几千辆车，这几天几乎没有一辆闲着，要挨个查......查到狂欢节结束也查不完啊。","id":481,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#3$1","focus":"r","id":482},{"type":"dialogue","name":"伊雷妮","text":"......","id":483,"figure":"https://media.prts.wiki/f/f9/Avg_avg_npc_1542_1-3$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","focus":"l","id":484},{"type":"dialogue","name":"卡车司机","text":"头儿，拉维妮娅法官让你帮忙找线索，你怎么反倒开始查咱们互助会了啊，搞得好像是咱们的人撞了代理市长一样......","id":485,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#2$1","focus":"r","id":486},{"type":"dialogue","name":"伊雷妮","text":"论起和“重型厢式载具”的关系，新沃尔西尼还有谁比我们更有说头呢？","id":487,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","focus":"l","id":488},{"type":"dialogue","name":"卡车司机","text":"多的是！还有载具工厂、检修站、新沃尔西尼货运港......","id":489,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"dialogue","name":"卡车司机","text":"而且从车祸时间来看，当时我们根本没有车从那个路口过！","id":490,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#2$1","focus":"r","id":491},{"type":"dialogue","name":"伊雷妮","text":"好了，彼得罗，我当然相信互助会的伙计们不会去干那样的事，只是图个心安。","id":492,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"dialogue","name":"伊雷妮","text":"莱昂图索先生和拉维妮娅法官都是好人，不是吗？","id":493,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#1$1","focus":"r","id":494},{"type":"dialogue","name":"伊雷妮","text":"证明咱们和整件事没有关系，也算是给他们省了不少调查的功夫，能帮助警察早点破案，找到真正的凶手嘛！","id":495,"figure":"https://media.prts.wiki/4/4d/Avg_avg_npc_1542_1-1$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#2$1","focus":"l","id":496},{"type":"dialogue","name":"卡车司机","text":"也是......","id":497,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1550_1-2$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#4$1","focus":"r","id":498},{"type":"dialogue","name":"伊雷妮","text":"对了，索默尔联系上了吗？南边的几个城区都是他在跑，让他去查能快一点。","id":499,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1542_1-4$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","focus":"l","id":500},{"type":"dialogue","name":"卡车司机","text":"还没有。","id":501,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#2$1","focus":"r","id":502},{"type":"dialogue","name":"伊雷妮","text":"奇怪......算了，先忙正事吧。","id":503,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1550_1#1$1","focus":"l","id":504},{"type":"dialogue","name":"卡车司机","text":"那我们接着找去了。","id":505,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1550_1-1$1.png"},{"type":"dialog","id":506},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":507},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"-200,0","afrom":"1","ato":"0","duration":"1.5","id":508},{"type":"delay","time":"3","id":509},{"type":"playsound","key":"$d_avg_grass","volume":"1","id":510},{"type":"delay","time":"1","id":511},{"type":"stopmusic","fadetime":"1","id":512},{"type":"camerashake","duration":"0.3","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":513},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#8$1","focus":"r","id":514},{"type":"dialogue","name":"伊雷妮","text":"谁？","id":515,"figure":"https://media.prts.wiki/8/8f/Avg_avg_npc_1542_1-8$1.png"},{"type":"dialog","id":516},{"type":"playsound","key":"$d_avg_snowstormflp","volume":"0","loop":"true","channel":"s","id":517},{"type":"soundvolume","volume":"0.8","channel":"s","fadetime":"2","id":518},{"type":"playsound","key":"$d_avg_reedmarshes","volume":"0","loop":"true","channel":"r","id":519},{"type":"soundvolume","volume":"0.2","channel":"r","fadetime":"2","id":520},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":521},{"type":"charslot","slot":"l","name":"avg_npc_1547_1#10$1","posfrom":"0,0","posto":"0,0","duration":"1.5","id":522},{"type":"delay","time":"2","id":523},{"type":"charslot","slot":"l","name":"avg_npc_1547_1#10$1","focus":"l","id":524},{"type":"dialogue","name":"惶恐的卡车司机","text":"伊雷妮，是、是我。","id":525,"figure":"https://media.prts.wiki/3/3c/Avg_avg_npc_1547_1-10$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#6$1","focus":"r","id":526},{"type":"dialogue","name":"伊雷妮","text":"索默尔，你就在营地？","id":527,"figure":"https://media.prts.wiki/6/64/Avg_avg_npc_1542_1-6$1.png"},{"type":"dialogue","name":"伊雷妮","text":"你没有听见我和彼得罗一直在找你吗，怎么不出来......","id":528,"figure":"https://media.prts.wiki/6/64/Avg_avg_npc_1542_1-6$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1547_1#11$1","focus":"l","id":529},{"type":"dialogue","name":"索默尔","text":"我、我......","id":530,"figure":"https://media.prts.wiki/a/ac/Avg_avg_npc_1547_1-11$1.png"},{"type":"dialog","id":531},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#5$1","posfrom":"0,0","posto":"-50,0","afrom":"1","ato":"1","duration":"0.6","id":532},{"type":"delay","time":"1","id":533},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#5$1","focus":"r","id":534},{"type":"dialogue","name":"伊雷妮","text":"你的衣服怎么破了，脸上这是——擦伤？","id":535,"figure":"https://media.prts.wiki/a/ae/Avg_avg_npc_1542_1-5$1.png"},{"type":"dialogue","name":"伊雷妮","text":"索默尔，发生了什么？","id":536,"figure":"https://media.prts.wiki/a/ae/Avg_avg_npc_1542_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1547_1#10$1","focus":"l","id":537},{"type":"dialogue","name":"索默尔","text":"......","id":538,"figure":"https://media.prts.wiki/3/3c/Avg_avg_npc_1547_1-10$1.png"},{"type":"dialogue","name":"索默尔","text":"昨天晚上......","id":539,"figure":"https://media.prts.wiki/3/3c/Avg_avg_npc_1547_1-10$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1542_1#5$1","focus":"r","id":540},{"type":"dialogue","name":"伊雷妮","text":"你不要告诉我，昨天晚上撞了莱昂图索先生的那辆载具......","id":541,"figure":"https://media.prts.wiki/a/ae/Avg_avg_npc_1542_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1547_1#12$1","focus":"l","id":542},{"type":"dialogue","name":"索默尔","text":"......是、是我开的。","id":543,"figure":"https://media.prts.wiki/8/80/Avg_avg_npc_1547_1-12$1.png"},{"type":"dialog","id":544},{"type":"stopsound","channel":"r","fadetime":"2","id":545},{"type":"stopsound","channel":"s","fadetime":"2","id":546},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":547},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":548},{"type":"stopmusic","fadetime":"2","id":549},{"type":"charslot","id":550},{"type":"background","id":551},{"type":"image","id":552}],"characters":["码头工人","家族成员","伊雷妮","卡车司机A","卡车司机B","拉维妮娅","警察","私人医生","莱昂图索","啰嗦的护理师","安东尼奥","？？？","甘比诺","卡车司机","惶恐的卡车司机","索默尔"]}