","key":"$d_avg_drkcludsthdr","text":"","id":448},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","afrom":"0.3","rfrom":"1","gfrom":"1","bfrom":"1","fadetime":"0.5","id":449},{"type":"delay","time":"1","id":450},{"type":"playsound","key":"$d_avg_dullthunderclap","text":"","id":451},{"type":"charslot","slot":"m","name":"char_144_red_7#1","duration":"0.5","id":452},{"type":"delay","time":"1","id":453},{"type":"playmusic","intro":"$loneliness_intro","key":"https://static.prts.wiki/music/music/static/m_avg/m_avg_loneliness_loop.mp3","volume":"0.6","id":454,"musicid":7},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","afrom":"0.5","rfrom":"1","gfrom":"1","bfrom":"1","fadetime":"0.3","id":455},{"type":"dialogue","name":"红","text":"你......你还要跟着红多久？","id":456,"figure":"https://media.prts.wiki/2/29/Avg_char_144_red_1.png"},{"type":"charslot","slot":"m","name":"char_1502_crowns","id":457},{"type":"dialogue","name":"柳德米拉","text":"我说过......直到我杀了你，或者你杀了我。","id":458,"figure":"https://media.prts.wiki/3/3f/Avg_char_1502_crowns.png"},{"type":"charslot","slot":"m","name":"char_144_red_7#1","id":459},{"type":"dialogue","name":"红","text":"你试了很多次，你杀不了红。","id":460,"figure":"https://media.prts.wiki/2/29/Avg_char_144_red_1.png"},{"type":"dialogue","name":"红","text":"而且你现在很累......","id":461,"figure":"https://media.prts.wiki/2/29/Avg_char_144_red_1.png"},{"type":"charslot","slot":"m","name":"char_1502_crowns","id":462},{"type":"dialogue","name":"柳德米拉","text":"那你就，杀了我。","id":463,"figure":"https://media.prts.wiki/3/3f/Avg_char_1502_crowns.png"},{"type":"dialog","id":464},{"type":"charslot","slot":"m","action":"shake","power":"10","times":"50","duration":"0.5","id":465},{"type":"delay","time":"0.8","id":466},{"type":"playsound","key":"$bodyfalldown1","text":"","id":467},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"0,-80","duration":"0.8","id":468},{"type":"charslot","duration":"0.8","id":469},{"type":"delay","time":"0.1","id":470},{"type":"camerashake","duration":"0.3","xstrength"