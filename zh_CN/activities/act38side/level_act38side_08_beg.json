{"storyMeta":{"storyReviewType":"NONE","storyId":"act38side_level_act38side_08_beg","storyGroup":"act38side","storySort":17,"storyDependence":"act38side_level_act38side_07_end","storyCanShow":1,"storyCode":"PV-8","storyName":"无私铁棘","storyPic":null,"storyInfo":"拉普兰德将伊雷妮案的卷宗送到拉维妮娅手中。拉维妮娅意识到了卡车工会与家族的联系，为了稳定局势，她率先向两大家族发难。","storyCanEnter":1,"storyTxt":"activities/act38side/level_act38side_08_beg","avgTag":"行动前","unLockType":"BY_START_TIME","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act38side_08","minState":"PLAYED","maxState":"COMPLETE"}],"prev":15,"next":17,"characters":["拉维妮娅","拉普兰德","德克萨斯","伊雷妮","阿尔贝托","安东尼奥","柳德米拉","家族成员","警察","家族成员A","家族成员B","德米特里","家族成员A&B"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":1},{"type":"stopmusic","id":2},{"type":"dialog","id":3},{"type":"background","image":"https://media.prts.wiki/2/27/Avg_bg_bg_vipward.png","screenadapt":"coverall","id":4},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":5},{"type":"delay","time":"2","id":6},{"type":"playmusic","intro":"$sjoyasorrow_intro","key":"https://static.prts.wiki/music/music/act9d0d0/m_avg_sjoyasorrow_loop.mp3","volume":"0.6","id":7,"musicid":0},{"type":"animtext","id":8,"name":"group_location_stamp","style":"avg_only_medium","pos":"-400,-200","block":"false","text":"<p=2>1100年11月8日    2:17 P.M.</>"},{"type":"delay","time":"3","id":9},{"type":"animtextclean","id":10},{"type":"delay","time":"1","id":11},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#1$1","duration":"0.5","focus":"n","id":12},{"type":"delay","time":"1","id":13},{"type":"playsound","key":"$dooropenquite","id":14},{"type":"delay","time":"1","id":15},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#1$1","id":16},{"type":"dialogue","name":"拉维妮娅","text":"德克萨斯，你回来了。","id":17,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"dialog","id":18},{"type":"charslot","id":19},{"type":"charslot","slot":"l","name":"avg_1028_texas2_1#1$1","duration":"1","id":20},{"type":"delay","time":"1.5","id":21},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#9$1","posfrom":"-200,0","posto":"0,0","duration":"0.8","id":22},{"type":"delay","time":"1","id":23},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#9$1","focus":"r","id":24},{"type":"multiline","name":"拉普兰德","text":"还有我……","id":25},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#3$1","focus":"r","id":26},{"type":"multiline","name":"拉普兰德","text":"怎么，不欢迎？","id":27},{"type":"dialog","id":28},{"type":"charslot","id":29},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#5$1","id":30},{"type":"dialogue","name":"拉维妮娅","text":"……拉普兰德？","id":31,"figure":"https://media.prts.wiki/1/19/Avg_avg_4065_judge_1-5$1.png"},{"type":"dialog","id":32},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":33},{"type":"charslot","id":34},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#3$1","id":35},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":36},{"type":"charslot","slot":"l","name":"avg_4065_judge_1#7$1","posfrom":"-150,0","posto":"0,0","duration":"1","id":37},{"type":"delay","time":"1.6","id":38},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#3$1","focus":"r","id":39},{"type":"dialogue","name":"拉普兰德","text":"别这么如临大敌，要是惊扰到病人可怎么办呢？","id":40,"figure":"https://media.prts.wiki/1/14/Avg_avg_npc_1564_1-3$1.png"},{"type":"dialogue","name":"拉普兰德","text":"德克萨斯，快告诉法官小姐，我真的只是过来送文件的。","id":41,"figure":"https://media.prts.wiki/1/14/Avg_avg_npc_1564_1-3$1.png"},{"type":"dialog","id":42},{"type":"charslot","id":43},{"type":"charslot","slot":"m","name":"avg_1028_texas2_1#1$1","id":44},{"type":"dialogue","name":"德克萨斯","text":"（点头）","id":45,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"dialog","id":46},{"type":"charslot","id":47},{"type":"charslot","slot":"l","name":"avg_4065_judge_1#7$1","focus":"r","id":48},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#9$1","focus":"r","id":49},{"type":"dialogue","name":"拉普兰德","text":"接着，大法官小姐。","id":50,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_1564_1-9$1.png"},{"type":"dialogue","name":"拉普兰德","text":"刚刚在门口碰见个小法官来给你送卷宗。市长大人的病房不能有太多人打扰，我和德克萨斯就顺便给你带了进来。","id":51,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_1564_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_4065_judge_1#5$1","focus":"l","id":52},{"type":"dialogue","name":"拉维妮娅","text":"……","id":53,"figure":"https://media.prts.wiki/1/19/Avg_avg_4065_judge_1-5$1.png"},{"type":"dialog","id":54},{"type":"playsound","key":"$d_avg_paper1","id":55},{"type":"delay","time":"1.5","id":56},{"type":"charslot","slot":"l","name":"avg_4065_judge_1#4$1","focus":"l","id":57},{"type":"dialogue","name":"拉维妮娅","text":"新沃尔西尼港失火，紧急庭审程序——被告伊雷妮？","id":58,"figure":"https://media.prts.wiki/2/2b/Avg_avg_4065_judge_1-4$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#9$1","focus":"r","id":59},{"type":"dialogue","name":"拉普兰德","text":"……","id":60,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_1564_1-9$1.png"},{"type":"dialogue","name":"拉普兰德","text":"那个司机小姐是你的朋友吧？别紧张，往后翻，直接看审判结果，她当场就被无罪释放了。","id":61,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_1564_1-9$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#3$1","focus":"r","id":62},{"type":"dialogue","name":"拉普兰德","text":"我和德克萨斯碰巧去听了那场庭审，很精彩，威尼斯家族——","id":63,"figure":"https://media.prts.wiki/1/14/Avg_avg_npc_1564_1-3$1.png"},{"type":"dialogue","name":"拉普兰德","text":"哈哈，抱歉抱歉，是威尼斯载具公司和萨卢佐酒业的老板同时为她作证，还在庭审结束后争着抢着送她回家……","id":64,"figure":"https://media.prts.wiki/1/14/Avg_avg_npc_1564_1-3$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1564_1#9$1","focus":"r","id":65},{"type":"dialogue","name":"拉普兰德","text":"啧啧，司机小姐的人缘可真好！","id":66,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_1564_1-9$1.png"},{"type":"dialogue","name":"拉普兰德","text":"就是她走出法院的样子，让我想起了家族成员们进法院逛一圈出来的成人礼。","id":67,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_1564_1-9$1.png"},{"type":"dialog","id":68},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":69},{"type":"charslot","id":70},{"type":"delay","time":"1","id":71},{"type":"background","image":"https://media.prts.wiki/b/bb/Avg_bg_56_g5_courtsquare_d.png","screenadapt":"coverall","id":72},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":73},{"type":"delay","time":"1","id":74},{"type":"animtext","id":75,"name":"group_location_stamp","style":"avg_only_medium","pos":"-400,-200","block":"false","text":"<p=2>1100年11月8日    11:35 A.M.</>"},{"type":"delay","time":"3","id":76},{"type":"animtextclean","id":77},{"type":"delay","time":"1","id":78},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":79},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#2$1","duration":"1","id":80},{"type":"delay","time":"1.5","id":81},{"type":"dialogue","name":"伊雷妮","text":"……","id":82,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","id":83},{"type":"text","text":"签字确认，领走判决书，离开法院。流程并不麻烦，但伊雷妮还是觉得有些头晕。阳光很刺眼，晃得她低下了头——","id":84},{"type":"text","text":"偌大的法院广场，两辆车停在她的必经之路上，它们的引擎盖上各自缀着特制的车标——在叙拉古随处可见的图案。","id":85},{"type":"text","text":"就算她不认得萨卢佐的酒标和威尼斯的家徽，她也不会不认得车前那两个刚刚还在法庭上为自己辩护的人。","id":86},{"type":"text","text":"伊雷妮知道，他们在等她——萨卢佐家族与威尼斯家族在等她。","id":87},{"type":"dialog","id":88},{"type":"charslot","slot":"m","name":"avg_npc_686_1#9$1","duration":"0.5","id":89},{"type":"delay","time":"1","id":90},{"type":"dialogue","name":"阿尔贝托","text":"恭喜你，伊雷妮小姐。","id":91,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_686_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#2$1","id":92},{"type":"dialogue","name":"伊雷妮","text":"……没什么好恭喜的。","id":93,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"dialogue","name":"伊雷妮","text":"阿尔贝托先生，虽然昨天那场火是个意外，但我担心的事情，确实也因此被稀里糊涂地解决了。","id":94,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"dialogue","name":"伊雷妮","text":"我以为，已经辛苦您白跑了一趟，就更不应该继续给您添麻烦了。","id":95,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"dialogue","name":"伊雷妮","text":"可您今天过来，就等于告诉所有人——","id":96,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_686_1#9$1","id":97},{"type":"dialogue","name":"阿尔贝托","text":"萨卢佐当然要帮卡车工会。","id":98,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_686_1-9$1.png"},{"type":"dialogue","name":"阿尔贝托","text":"从目前的状况来看，有些交易确实已经不再作数，但你我都清楚，在叙拉古，搭建一段友谊有多么难能可贵。","id":99,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_686_1-9$1.png"},{"type":"dialogue","name":"阿尔贝托","text":"约定依然存在，伊雷妮小姐。","id":100,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_686_1-9$1.png"},{"type":"dialog","id":101},{"type":"charslot","id":102},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#1$1","duration":"0.5","id":103},{"type":"delay","time":"0.8","id":104},{"type":"dialogue","name":"安东尼奥","text":"咳——阿尔贝托叔叔，我应该没有打扰你吧？","id":105,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1544_1-1$1.png"},{"type":"dialogue","name":"安东尼奥","text":"伊雷妮小姐是为我们运的轮胎，现在货在她手里出了事，我还得找她谈谈该怎么赔偿。","id":106,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1544_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#2$1","id":107},{"type":"dialogue","name":"伊雷妮","text":"安东尼奥先生……","id":108,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#1$1","id":109},{"type":"dialogue","name":"安东尼奥","text":"别紧张，虽然我们今天才正式认识，但已经相当有默契了。","id":110,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1544_1-1$1.png"},{"type":"dialogue","name":"安东尼奥","text":"你在法庭上什么都没有说，这很好。","id":111,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1544_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#2$1","id":112},{"type":"dialogue","name":"伊雷妮","text":"……","id":113,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#1$1","id":114},{"type":"dialogue","name":"安东尼奥","text":"关于卡车工会，以及许多事情，我想我们已经有很多东西可以交流。","id":115,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1544_1-1$1.png"},{"type":"dialogue","name":"安东尼奥","text":"上车吧，我送你回营地。","id":116,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1544_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_686_1#7$1","id":117},{"type":"dialogue","name":"阿尔贝托","text":"小威尼斯——","id":118,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_686_1-7$1.png"},{"type":"dialog","id":119},{"type":"charslot","id":120},{"type":"stopmusic","fadetime":"2","id":121},{"type":"playsound","key":"$d_avg_carhorn","id":122},{"type":"playsound","key":"$d_avg_truckengine","loop":"true","channel":"1","volume":"0","id":123},{"type":"soundvolume","volume":"0.6","channel":"1","fadetime":"1","id":124},{"type":"delay","time":"1.5","id":125},{"type":"stopsound","channel":"1","fadetime":"2","id":126},{"type":"text","text":"嘹亮的鸣笛声打断了三人的对话，一辆卡车从两辆私家车之间穿过，稳稳地停在了伊雷妮面前。","id":127},{"type":"charslot","slot":"m","name":"avg_npc_686_1#1$1","id":128},{"type":"dialogue","name":"阿尔贝托","text":"……","id":129,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1544_1#4$1","id":130},{"type":"dialogue","name":"安东尼奥","text":"……","id":131,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_1544_1-4$1.png"},{"type":"charslot","id":132},{"type":"playsound","key":"$d_avg_cardoorc","id":133},{"type":"text","text":"车门打开，伊雷妮看到了下车的柳德米拉。","id":134},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#5$1","id":135},{"type":"dialogue","name":"伊雷妮","text":"柳德米拉！","id":136,"figure":"https://media.prts.wiki/a/ae/Avg_avg_npc_1542_1-5$1.png"},{"type":"playmusic","intro":"$storyendjp_intro","key":"https://static.prts.wiki/music/music/act5d0/m_avg_storyendjp_loop.mp3","volume":"0.6","id":137,"musicid":1},{"type":"dialog","id":138},{"type":"charslot","id":139},{"type":"charslot","slot":"m","name":"avg_1502_crosly_1#6$1","duration":"1","id":140},{"type":"delay","time":"1","id":141},{"type":"dialogue","name":"柳德米拉","text":"……","id":142,"figure":"https://media.prts.wiki/c/c0/Avg_avg_1502_crosly_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#7$1","id":143},{"type":"dialogue","name":"伊雷妮","text":"……你怎么了？","id":144,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1542_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_1502_crosly_1#1$1","id":145},{"type":"dialogue","name":"柳德米拉","text":"走吧，我来接你回家。营地里还有很多事情等着你拿主意呢。","id":146,"figure":"https://media.prts.wiki/2/26/Avg_avg_1502_crosly_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1542_1#2$1","id":147},{"type":"dialogue","name":"伊雷妮","text":"好，我们走。","id":148,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"dialog","id":149},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1.5","block":"true","id":150},{"type":"charslot","id":151},{"type":"playsound","key":"$d_avg_cardoorc","id":152},{"type":"curtain","direction":"0","fillfrom":"0.1","fillto":"0.1","fadetime":"0.1","id":153},{"type":"curtain","direction":"4","fillfrom":"0.1","fillto":"0.1","fadetime":"0.1","id":154},{"type":"charslot","slot":"left","name":"avg_1502_crosly_1#1$1","id":155},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#2$1","id":156},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1.5","block":"true","id":157},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#2$1","focus":"r","id":158},{"type":"dialogue","name":"伊雷妮","text":"回去之后，我们得赶紧想办法送索默尔暂时离开，现在城里对他来说不安全。","id":159,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_1542_1-2$1.png"},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#6$1","focus":"r","id":160},{"type":"dialogue","name":"伊雷妮","text":"……柳德米拉，你有心事？","id":161,"figure":"https://media.prts.wiki/6/64/Avg_avg_npc_1542_1-6$1.png"},{"type":"charslot","slot":"right","focus":"n","id":162},{"type":"text","text":"柳德米拉没有说话，只是将怀中的那枚打火机交给了伊雷妮。","id":163},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#5$1","focus":"r","id":164},{"type":"dialogue","name":"伊雷妮","text":"欸……这不是索默尔的？！","id":165,"figure":"https://media.prts.wiki/a/ae/Avg_avg_npc_1542_1-5$1.png"},{"type":"charslot","slot":"left","name":"avg_1502_crosly_1#6$1","focus":"l","id":166},{"type":"dialogue","name":"柳德米拉","text":"他做了他能做的所有。","id":167,"figure":"https://media.prts.wiki/c/c0/Avg_avg_1502_crosly_1-6$1.png"},{"type":"charslot","slot":"left","name":"avg_1502_crosly_1#7$1","focus":"l","id":168},{"type":"dialogue","name":"柳德米拉","text":"我早该明白，家族绝对不会允许任何可能对他们造成威胁的人存在。","id":169,"figure":"https://media.prts.wiki/9/91/Avg_avg_1502_crosly_1-7$1.png"},{"type":"dialog","id":170},{"type":"charslot","id":171},{"type":"playsound","key":"$d_avg_driveincar","volume":"0","loop":"true","channel":"car","id":172},{"type":"soundvolume","volume":"0.5","channel":"car","fadetime":"2","id":173},{"type":"camerashake","duration":"5","xstrength":"3","ystrength":"2","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":174},{"type":"playsound","key":"$sportscarstart","id":175},{"type":"delay","time":"1","id":176},{"type":"text","text":"透过后视镜，伊雷妮再次对上了小威尼斯与阿尔贝托的眼睛。","id":177},{"type":"text","text":"她突然明白这两人为什么信心满满地站出来替自己作证，又为什么同时在广场等自己。","id":178},{"type":"text","text":"小威尼斯说得没错，她的沉默，以及他们的发声，意味着三方在法庭上达成了默契。","id":179},{"type":"dialog","id":180},{"type":"charslot","slot":"left","name":"avg_1502_crosly_1#7$1","focus":"r","id":181},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#6$1","focus":"r","id":182},{"type":"dialogue","name":"伊雷妮","text":"……索默尔在哪？","id":183,"figure":"https://media.prts.wiki/6/64/Avg_avg_npc_1542_1-6$1.png"},{"type":"charslot","slot":"left","name":"avg_1502_crosly_1#6$1","focus":"l","id":184},{"type":"dialogue","name":"柳德米拉","text":"……","id":185,"figure":"https://media.prts.wiki/c/c0/Avg_avg_1502_crosly_1-6$1.png"},{"type":"dialogue","name":"柳德米拉","text":"……对不起，我找不到……","id":186,"figure":"https://media.prts.wiki/c/c0/Avg_avg_1502_crosly_1-6$1.png"},{"type":"charslot","slot":"right","focus":"n","id":187},{"type":"text","text":"伊雷妮握紧了手中的打火机。","id":188},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#8$1","focus":"r","id":189},{"type":"dialogue","name":"伊雷妮","text":"所以事情的发展的确超出了所有人的预料，他们不得不下场保住我。","id":190,"figure":"https://media.prts.wiki/8/8f/Avg_avg_npc_1542_1-8$1.png"},{"type":"dialogue","name":"伊雷妮","text":"但代价……","id":191,"figure":"https://media.prts.wiki/8/8f/Avg_avg_npc_1542_1-8$1.png"},{"type":"charslot","slot":"left","name":"avg_1502_crosly_1#7$1","focus":"l","id":192},{"type":"dialogue","name":"柳德米拉","text":"他们想让市政厅和法院的人看到，咱们已经和家族绑在了一条船上。","id":193,"figure":"https://media.prts.wiki/9/91/Avg_avg_1502_crosly_1-7$1.png"},{"type":"dialogue","name":"柳德米拉","text":"刚刚那两个家伙对你的态度……简直就像在争抢地盘。","id":194,"figure":"https://media.prts.wiki/9/91/Avg_avg_1502_crosly_1-7$1.png"},{"type":"charslot","slot":"m","focus":"n","id":195},{"type":"text","text":"这场庭审不是事情的结束，它只是开始。","id":196},{"type":"text","text":"未来漫长的时间里，家族将成为卡车互助会的附骨之疽，她不得不和那些人纠缠，继续保持这种默契，可耻的默契。","id":197},{"type":"text","text":"卡车已经离法院广场越来越远，她看着手中的打火机，突然没那么恐惧了。","id":198},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#8$1","focus":"r","id":199},{"type":"dialogue","name":"伊雷妮","text":"这件事没完，阿尔贝托，安东尼奥……","id":200,"figure":"https://media.prts.wiki/8/8f/Avg_avg_npc_1542_1-8$1.png"},{"type":"dialogue","name":"伊雷妮","text":"我和索默尔刚搬来新沃尔西尼的时候，真的相信我们已经远离了家族。","id":201,"figure":"https://media.prts.wiki/8/8f/Avg_avg_npc_1542_1-8$1.png"},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#3$1","focus":"r","id":202},{"type":"dialogue","name":"伊雷妮","text":"……呵，真可笑啊。","id":203,"figure":"https://media.prts.wiki/f/f9/Avg_avg_npc_1542_1-3$1.png"},{"type":"charslot","slot":"right","name":"avg_npc_1542_1#9$1","focus":"r","id":204},{"type":"dialogue","name":"伊雷妮","text":"索默尔，对不起，我不会再相信他们中的任何人了。","id":205,"figure":"https://media.prts.wiki/b/b6/Avg_avg_npc_1542_1-9$1.png"},{"type":"stopmusic","fadetime":"2","id":206},{"type":"dialog","id":207},{"type":"stopsound","channel":"car","fadetime":"2","id":208},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":209},{"type":"charslot","id":210},{"type":"curtain","id":211},{"type":"delay","time":"1","id":212},{"type":"background","image":"https://media.prts.wiki/2/27/Avg_bg_bg_vipward.png","screenadapt":"coverall","id":213},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":214},{"type":"delay","time":"1","id":215},{"type":"playmusic","intro":"$ponder_intro","key":"https://static.prts.wiki/music/music/act15d0d0/m_avg_ponder_loop.mp3","volume":"0.6","id":216,"musicid":2},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#1$1","duration":"0.5","id":217},{"type":"delay","time":"1","id":218},{"type":"dialogue","name":"拉维妮娅","text":"……","id":219,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1564_1#3$1","id":220},{"type":"dialogue","name":"拉普兰德","text":"多有趣的场面，像是拍电影。萨卢佐的员工，威尼斯的员工，还有卡车司机，围在那位司机小姐身边的人，占了小半个广场……","id":221,"figure":"https://media.prts.wiki/1/14/Avg_avg_npc_1564_1-3$1.png"},{"type":"dialogue","name":"拉普兰德","text":"我第一次进法院，说是成年礼，出来的时候都没有那么多人迎接。","id":222,"figure":"https://media.prts.wiki/1/14/Avg_avg_npc_1564_1-3$1.png"},{"type":"dialogue","name":"拉普兰德","text":"德克萨斯就更惨了，哈哈，来叙拉古做客，不小心沾上了官司，当时只有我等她。","id":223,"figure":"https://media.prts.wiki/1/14/Avg_avg_npc_1564_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_1028_texas2_1#1$1","id":224},{"type":"dialogue","name":"德克萨斯","text":"……不要再提你那无聊的恶作剧了，拉普兰德。","id":225,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#1$1","id":226},{"type":"dialogue","name":"拉维妮娅","text":"拉普兰德小姐，感谢你专程过来提醒。如果没什么别的事，还请离开吧。","id":227,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1564_1#9$1","id":228},{"type":"dialogue","name":"拉普兰德","text":"不客气，都是我应该做的。","id":229,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_1564_1-9$1.png"},{"type":"dialogue","name":"拉普兰德","text":"明天可就是狂欢节了，法官小姐，你们还有的忙呢。","id":230,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_1564_1-9$1.png"},{"type":"dialog","id":231},{"type":"charslot","duration":"1","id":232},{"type":"dialog","id":233},{"type":"playsound","key":"$doorclosequite","id":234},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":235},{"type":"charslot","id":236},{"type":"delay","time":"1","id":237},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":238},{"type":"delay","time":"1","id":239},{"type":"charslot","slot":"left","name":"avg_4065_judge_1#1$1","duration":"1","id":240},{"type":"charslot","slot":"right","name":"avg_1028_texas2_1#1$1","duration":"1","id":241},{"type":"delay","time":"2","id":242},{"type":"charslot","slot":"right","name":"avg_1028_texas2_1#1$1","focus":"r","id":243},{"type":"dialogue","name":"德克萨斯","text":"从昨天中午开始，我一直跟着拉普兰德。","id":244,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"dialogue","name":"德克萨斯","text":"我们赶到港口的时候，那场火已经烧得差不多了，和她没有直接的关系。","id":245,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"charslot","slot":"right","name":"avg_1028_texas2_1#8$1","focus":"r","id":246},{"type":"dialogue","name":"德克萨斯","text":"接下来的整个晚上，她真的都在走街串巷地跑出租。今天又去了法院，再然后来到了医院……","id":247,"figure":"https://media.prts.wiki/5/5d/Avg_avg_1028_texas2_1-8$1.png"},{"type":"charslot","slot":"right","name":"avg_1028_texas2_1#1$1","focus":"r","id":248},{"type":"dialogue","name":"德克萨斯","text":"我暂时还不清楚她到底要做什么。","id":249,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"charslot","slot":"left","name":"avg_4065_judge_1#8$1","focus":"l","id":250},{"type":"dialogue","name":"拉维妮娅","text":"——","id":251,"figure":"https://media.prts.wiki/8/84/Avg_avg_4065_judge_1-8$1.png"},{"type":"charslot","slot":"right","name":"avg_1028_texas2_1#5$1","focus":"r","id":252},{"type":"dialogue","name":"德克萨斯","text":"拉维妮娅，你还在看这份卷宗？","id":253,"figure":"https://media.prts.wiki/6/6f/Avg_avg_1028_texas2_1-5$1.png"},{"type":"charslot","slot":"left","name":"avg_4065_judge_1#5$1","focus":"l","id":254},{"type":"dialogue","name":"拉维妮娅","text":"单从卷宗内容来看，这场审判没有任何问题。但这种感觉太过熟悉……","id":255,"figure":"https://media.prts.wiki/1/19/Avg_avg_4065_judge_1-5$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"整场庭审程序完整、证据详实，但除了帮助某个人脱罪，它实际上没有查明任何真相，也没有解决任何问题。","id":256,"figure":"https://media.prts.wiki/1/19/Avg_avg_4065_judge_1-5$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"在沃尔西尼，在叙拉古的其他地方，绝大多数的案子都只能以这样的一份卷宗收尾。","id":257,"figure":"https://media.prts.wiki/1/19/Avg_avg_4065_judge_1-5$1.png"},{"type":"charslot","slot":"left","name":"avg_4065_judge_1#2$1","focus":"l","id":258},{"type":"dialogue","name":"拉维妮娅","text":"而我一度认为，这样的审判已经不会存在于新沃尔西尼。","id":259,"figure":"https://media.prts.wiki/e/ee/Avg_avg_4065_judge_1-2$1.png"},{"type":"charslot","slot":"right","name":"avg_1028_texas2_1#5$1","focus":"r","id":260},{"type":"dialogue","name":"德克萨斯","text":"拉维妮娅……","id":261,"figure":"https://media.prts.wiki/6/6f/Avg_avg_1028_texas2_1-5$1.png"},{"type":"charslot","slot":"left","name":"avg_4065_judge_1#1$1","focus":"l","id":262},{"type":"dialogue","name":"拉维妮娅","text":"不用安慰我，德克萨斯。","id":263,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"我更在意的是，这些人从什么时候开始居然会在意一个家族之外的普通人无辜或者有罪？","id":264,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"更何况在此之前，整个威尼斯家族在新沃尔西尼的表现几乎没有任何可以指摘的地方，小威尼斯却在此时出了这个头。","id":265,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"从德米特里到英格丽——这两天，我可能一直都追错了方向。","id":266,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"但可以肯定的是，在这场庭审之前——或者就是这场庭审，让他们站在了一起。","id":267,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"莱昂遭遇的那场车祸，肇事逃逸的车辆，还有港口的火灾，这些事情明显存在更深的联系……","id":268,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"萨卢佐、威尼斯，还有卡车工会，这三方势力到底在共同隐藏什么？","id":269,"figure":"https://media.prts.wiki/f/f2/Avg_avg_4065_judge_1-1$1.png"},{"type":"charslot","duration":"0.5","id":270},{"type":"playsound","key":"$d_avg_paper2","id":271},{"type":"text","text":"拉维妮娅合上了卷宗，她的手抚过封面上法院的标志和《新都市管理法案》的字样。","id":272},{"type":"text","text":"片刻后，她抬起了头。","id":273},{"type":"text","text":"德克萨斯看着眼前的朋友，如果说她刚刚还有些低落和迷惑，那么现在，她已肉眼可见地重新振作了起来。","id":274},{"type":"dialog","id":275},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#7$1","duration":"0.5","id":276},{"type":"delay","time":"1","id":277},{"type":"dialogue","name":"拉维妮娅","text":"明天就是狂欢节了，莱昂到现在还重伤未醒……我已经没有多少时间去查明他们接下来会有怎样的图谋。","id":278,"figure":"https://media.prts.wiki/d/d0/Avg_avg_4065_judge_1-7$1.png"},{"type":"dialogue","name":"拉维妮娅","text":"不能让局势恶化，更不能坐以待毙。","id":279,"figure":"https://media.prts.wiki/d/d0/Avg_avg_4065_judge_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_1028_texas2_1#3$1","id":280},{"type":"dialogue","name":"德克萨斯","text":"……你的意思是？","id":281,"figure":"https://media.prts.wiki/8/84/Avg_avg_1028_texas2_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_4065_judge_1#15$1","id":282},{"type":"dialogue","name":"拉维妮娅","text":"这些人依然觉得《新都市管理法案》是可以利用的东西，那么我会告诉他们，在新沃尔西尼，它确实是秩序的基底。","id":283,"figure":"https://media.prts.wiki/1/1c/Avg_avg_4065_judge_1-15$1.png"},{"type":"stopmusic","fadetime":"2","id":284},{"type":"dialog","id":285},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":286},{"type":"charslot","id":287},{"type":"delay","time":"1","id":288},{"type":"background","image":"https://media.prts.wiki/1/15/Avg_bg_56_g12_saluzzowinery.png","screenadapt":"coverall","id":289},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":290},{"type":"delay","time":"1","id":291},{"type":"playmusic","intro":"$darkalley_intro","key":"https://static.prts.wiki/music/music/act5d0/m_avg_longmendarkalley_loop.mp3","volume":"0.6","id":292,"musicid":3},{"type":"animtext","id":293,"name":"group_location_stamp","style":"avg_only_medium","pos":"-400,-200","block":"false","text":"<p=2>1100年11月8日    4:45 P.M.</>"},{"type":"delay","time":"3","id":294},{"type":"animtextclean","id":295},{"type":"delay","time":"1","id":296},{"type":"playsound","key":"$d_gen_walk_n","volume":"0.5","id":297},{"type":"delay","time":"1.5","id":298},{"type":"dialogue","name":"家族成员","text":"等等，你不能进去！","id":299},{"type":"dialog","id":300},{"type":"playsound","key":"$d_gen_doorclose","volume":"0.7","id":301},{"type":"camerashake","duration":"0.3","xstrength":"20","ystrength":"20","vibrato":"30","randomness":"90","fadeout":"true","block":"true","id":302},{"type":"delay","time":"0.5","id":303},{"type":"charslot","slot":"m","name":"avg_1028_texas2_1#1$1","duration":"0.5","id":304},{"type":"delay","time":"1.5","id":305},{"type":"charslot","slot":"m","name":"avg_npc_686_1#5$1","id":306},{"type":"dialogue","name":"阿尔贝托","text":"德克萨斯？","id":307,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_686_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_686_1#10$1","id":308},{"type":"dialogue","name":"阿尔贝托","text":"无缘无故闯进我的酒庄，这可不像是你会做的事情。","id":309,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_686_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_1028_texas2_1#1$1","id":310},{"type":"dialogue","name":"德克萨斯","text":"我当然不能这么做。","id":311,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"dialog","id":312},{"type":"charslot","id":313},{"type":"playsound","key":"$d_gen_soldiersrun","volume":"0.7","id":314},{"type":"delay","time":"0.5","id":315},{"type":"charslot","slot":"m","name":"avg_npc_1553_1#1$2","duration":"0.5","id":316},{"type":"delay","time":"1.5","id":317},{"type":"dialogue","name":"警察","text":"我说过我们会来找你的，阿尔贝托·萨卢佐先生。","id":318,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_686_1#1$1","id":319},{"type":"dialogue","name":"阿尔贝托","text":"……","id":320,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"playsound","key":"$d_avg_paper1","id":321},{"type":"charslot","slot":"m","name":"avg_npc_1553_1#1$2","id":322},{"type":"dialogue","name":"警察","text":"这是近两个月来萨卢佐酒业提交的所有资质审批文件。","id":323,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"dialogue","name":"警察","text":"同一批员工，短短两个月间，在你们的注册资料里连续变换了好几次身份，先是安保人员，再是酿酒师等专业技术人员……","id":324,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"dialogue","name":"警察","text":"我们合理怀疑，萨卢佐酒业涉嫌以非法手段规避正常的背景审查流程。","id":325,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"dialogue","name":"警察","text":"请跟我们回去接受调查。","id":326,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1553_1$2.png"},{"type":"dialog","id":327},{"type":"charslot","id":328},{"type":"charslot","slot":"left","name":"avg_npc_1554_1#1$1","duration":"0.5","id":329},{"type":"delay","time":"0.5","id":330},{"type":"charslot","slot":"right","name":"avg_npc_1554_1#1$1","duration":"0.5","id":331},{"type":"delay","time":"1","id":332},{"type":"charslot","slot":"left","focus":"l","id":333},{"type":"dialogue","name":"家族成员A","text":"变来变去，不是因为一直按照市政厅的要求在改吗？","id":334,"figure":"https://media.prts.wiki/b/bb/Avg_avg_npc_1554_1$1.png"},{"type":"dialogue","name":"家族成员A","text":"你们突然把这些旧的资料又翻出来，到底想干什么？","id":335,"figure":"https://media.prts.wiki/b/bb/Avg_avg_npc_1554_1$1.png"},{"type":"charslot","slot":"r","focus":"r","id":336},{"type":"dialogue","name":"家族成员B","text":"别跟他们说那么多，这帮警察明显就是故意针对萨卢佐家！*叙拉古粗口*，我们还交了那么多的认证金！","id":337,"figure":"https://media.prts.wiki/b/bb/Avg_avg_npc_1554_1$1.png"},{"type":"dialogue","name":"家族成员B","text":"总之，不能让他们在萨卢佐的地盘上把老爷带走——","id":338,"figure":"https://media.prts.wiki/b/bb/Avg_avg_npc_1554_1$1.png"},{"type":"dialog","id":339},{"type":"charslot","id":340},{"type":"playsound","key":"$d_gen_walk_n","volume":"0.7","id":341},{"type":"charslot","slot":"m","name":"avg_npc_690_1#7$1","duration":"1","id":342},{"type":"delay","time":"1.5","id":343},{"type":"dialogue","name":"德米特里","text":"住手。不要妨碍警察办案。","id":344,"figure":"https://media.prts.wiki/e/e9/Avg_avg_npc_690_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_690_1#9$1","id":345},{"type":"dialogue","name":"德米特里","text":"如果他们只是怀疑萨卢佐酒业用非法手段规避背景审查，要解释起来并不难……只是需要时间。","id":346,"figure":"https://media.prts.wiki/d/db/Avg_avg_npc_690_1-9$1.png"},{"type":"dialog","id":347},{"type":"charslot","id":348},{"type":"charslot","slot":"left","name":"avg_npc_1554_1#1$1","id":349},{"type":"charslot","slot":"right","name":"avg_npc_1554_1#1$1","id":350},{"type":"dialogue","name":"家族成员A&B","text":"……","id":351,"figure":"https://media.prts.wiki/b/bb/Avg_avg_npc_1554_1$1.png"},{"type":"dialog","id":352},{"type":"charslot","id":353},{"type":"charslot","slot":"m","name":"avg_npc_686_1#1$1","id":354},{"type":"dialogue","name":"阿尔贝托","text":"听他的。","id":355,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"dialog","id":356},{"type":"charslot","id":357},{"type":"charslot","slot":"left","name":"avg_npc_1554_1#1$1","id":358},{"type":"charslot","slot":"right","name":"avg_npc_1554_1#1$1","id":359},{"type":"dialogue","name":"家族成员A&B","text":"是，老爷。","id":360,"figure":"https://media.prts.wiki/b/bb/Avg_avg_npc_1554_1$1.png"},{"type":"dialog","id":361},{"type":"charslot","id":362},{"type":"charslot","slot":"m","name":"avg_npc_686_1#1$1","id":363},{"type":"dialogue","name":"阿尔贝托","text":"是那个法官的主意，对吧？","id":364,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_1028_texas2_1#1$1","id":365},{"type":"dialogue","name":"德克萨斯","text":"什么？","id":366,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_686_1#1$1","id":367},{"type":"dialogue","name":"阿尔贝托","text":"她当然不会认为凭借这样不痛不痒的罪名就能拿我怎么样，但起码接下来这几天，可以将我困在监狱里。","id":368,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"dialogue","name":"阿尔贝托","text":"我想，她应该已经去了小威尼斯或者伊雷妮那儿，不然来酒庄的不会是你。","id":369,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_1028_texas2_1#1$1","id":370},{"type":"dialogue","name":"德克萨斯","text":"我只是正好有空。","id":371,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_686_1#9$1","id":372},{"type":"dialogue","name":"阿尔贝托","text":"仅凭她掌握的信息，能在这么短的时间做出这么雷厉风行的决策，够果决。","id":373,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_686_1-9$1.png"},{"type":"dialogue","name":"阿尔贝托","text":"我还记得去年她冲到我府邸找贝纳尔多时的软弱样子——真是判若两人。","id":374,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_686_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_1028_texas2_1#1$1","id":375},{"type":"dialogue","name":"德克萨斯","text":"这些你跟我说没有用。你要是清清白白，就没什么好怕的。","id":376,"figure":"https://media.prts.wiki/c/c5/Avg_avg_1028_texas2_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_686_1#1$1","id":377},{"type":"dialogue","name":"阿尔贝托","text":"当然，我跟你们走。我会尽量配合你们的调查。","id":378,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"dialogue","name":"阿尔贝托","text":"我今天在法庭上就说过，这是新沃尔西尼市民应尽的义务。","id":379,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"dialogue","name":"阿尔贝托","text":"更何况，整个萨卢佐酒业并不会因为我的离开而停止运转。","id":380,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"dialogue","name":"阿尔贝托","text":"德米特里，你这段时间，应该已经熟悉我们在新沃尔西尼的业务了吧？","id":381,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_686_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_690_1#1$1","id":382},{"type":"dialogue","name":"德米特里","text":"当然，阿尔贝托先生。","id":383,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_690_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_686_1#9$1","id":384},{"type":"dialogue","name":"阿尔贝托","text":"那暂时交给你了，萨卢佐酒业的经理。","id":385,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_686_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_690_1#1$1","id":386},{"type":"dialogue","name":"德米特里","text":"当然。","id":387,"figure":"https://media.prts.wiki/9/96/Avg_avg_npc_690_1-1$1.png"},{"type":"dialog","id":388},{"type":"delay","time":"1","id":389},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":390},{"type":"stopmusic","fadetime":"2","id":391},{"type":"image","id":392},{"type":"charslot","id":393}],"characters":["拉维妮娅","拉普兰德","德克萨斯","伊雷妮","阿尔贝托","安东尼奥","柳德米拉","家族成员","警察","家族成员A","家族成员B","德米特里","家族成员A&B"]}