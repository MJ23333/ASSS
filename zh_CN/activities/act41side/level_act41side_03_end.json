{"storyMeta":{"storyReviewType":"NONE","storyId":"act41side_level_act41side_03_end","storyGroup":"act41side","storySort":7,"storyDependence":"act41side_level_act41side_03_beg","storyCanShow":1,"storyCode":"EA-3","storyName":"惶惑与冲动","storyPic":null,"storyInfo":"即便粮车返回城内，乱象的蔓延也无法被阻止。在拉芙希妮和涅梅丝找来之前，得知了真相的库林在悲怒中做出将雕像拖上广场毁去的决定。","storyCanEnter":1,"storyTxt":"activities/act41side/level_act41side_03_end","avgTag":"行动后","unLockType":"STAGE_CLEAR","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act41side_03","minState":"PASS","maxState":"COMPLETE"}],"prev":5,"next":7,"characters":["提奥","阴沉的居民","车夫的声音","遥远的争吵声","担忧的居民","库林","布莉吉","？？？","巨龙","拉芙希妮","涅梅丝"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":1},{"type":"stopmusic","id":2},{"type":"dialog","id":3},{"type":"background","image":"https://media.prts.wiki/2/24/Avg_bg_59_g3_dragonsquare_d.png","screenadapt":"coverall","block":"true","id":4},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":5},{"type":"delay","time":"1","id":6},{"type":"playmusic","intro":"$nervous_intro","key":"https://static.prts.wiki/music/music/act9d0d0/m_avg_nervous_loop.mp3","volume":"0.6","id":7,"musicid":0},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":8},{"type":"delay","time":"1","id":9},{"type":"playsound","key":"$d_avg_runstop","volume":"1","id":10},{"type":"charslot","slot":"m","name":"avg_npc_240","posfrom":"100,0","posto":"0,0","duration":"0.7","isblock":"false","id":11},{"type":"delay","time":"1","id":12},{"type":"playsound","key":"$d_avg_walkfast","volume":"1","id":13},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"-150,0","afrom":"1","ato":"0","duration":"1","isblock":"false","id":14},{"type":"delay","time":"1.5","id":15},{"type":"charslot","id":16},{"type":"playsound","key":"$d_avg_punchsp3","volume":"0.8","id":17},{"type":"camerashake","duration":"1","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":18},{"type":"delay","time":"0.6","id":19},{"type":"playsound","key":"$d_avg_runstop","volume":"1","id":20},{"type":"charslot","slot":"m","name":"avg_npc_240","duration":"0.5","id":21},{"type":"dialogue","name":"提奥","text":"哎哟！","id":22,"figure":"https://media.prts.wiki/3/32/Avg_avg_npc_240.png"},{"type":"dialog","id":23},{"type":"charslot","id":24},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","duration":"0.7","id":25},{"type":"delay","time":"1","id":26},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":27},{"type":"dialogue","name":"阴沉的居民","text":"是谁——提奥？你不看路的吗？","id":28,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_240","focus":"m","id":29},{"type":"dialogue","name":"提奥","text":"抱、抱歉！罗里先生，我想去拉格兰街碰碰运气，看能不能买到点土豆——","id":30,"figure":"https://media.prts.wiki/3/32/Avg_avg_npc_240.png"},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":31},{"type":"camerashake","duration":"0.5","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":32},{"type":"dialogue","name":"阴沉的居民","text":"滚开！","id":33,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_240","focus":"m","id":34},{"type":"dialogue","name":"提奥","text":"抱歉......","id":35,"figure":"https://media.prts.wiki/3/32/Avg_avg_npc_240.png"},{"type":"dialog","id":36},{"type":"charslot","id":37},{"type":"playsound","key":"$d_avg_pcknmgrwl","volume":"1","id":38},{"type":"delay","time":"1","id":39},{"type":"dialogue","name":"车夫的声音","text":"小心！驮兽受惊了！快躲开！","id":40},{"type":"dialog","id":41},{"type":"charslot","slot":"m","name":"avg_npc_240","focus":"m","id":42},{"type":"delay","time":"0.2","id":43},{"type":"playsound","key":"$d_avg_pcknmrn","volume":"0.6","id":44},{"type":"playsound","key":"$d_avg_carriage_loop","volume":"1","loop":"true","channel":"ca","id":45},{"type":"stopsound","channel":"ca","fadetime":"4","id":46},{"type":"camerashake","duration":"3.5","xstrength":"40","ystrength":"40","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":47},{"type":"delay","time":"2","id":48},{"type":"playsound","key":"$d_avg_doorbreak","volume":"0.8","id":49},{"type":"playsound","key":"$bodyfalldown1","volume":"1","delay":"0.3","id":50},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":51},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":52},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":53},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":54},{"type":"charslot","duration":"0.5","id":55},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0.7","block":"true","id":56},{"type":"delay","time":"1.5","id":57},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":58},{"type":"dialogue","name":"阴沉的居民","text":"赶车的，你疯了吗，你差点撞死我！给我停下！","id":59,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"dialog","id":60},{"type":"charslot","id":61},{"type":"playsound","key":"$d_avg_pcknmrn","channel":"step1","loop":"false","volume":"0.4","id":62},{"type":"playsound","key":"$d_avg_carriagegoaway","channel":"step2","loop":"false","volume":"1","delay":"0.2","id":63},{"type":"stopsound","channel":"step1","fadetime":"4","id":64},{"type":"stopsound","channel":"step2","fadetime":"4","id":65},{"type":"delay","time":"2.5","id":66},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":67},{"type":"dialogue","name":"阴沉的居民","text":"居然就这么跑了？！","id":68,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"dialog","id":69},{"type":"charslot","id":70},{"type":"dialogue","name":"提奥","text":"罗里先生，我......","id":71},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":72},{"type":"dialogue","name":"阴沉的居民","text":"哈，哈哈，真是恶有恶报，被撞的居然是你？","id":73,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"dialogue","name":"阴沉的居民","text":"走，小子，这下你哪也去不了了，跟我去见深池的人，我要把你这个叛徒交给他们，这样我就有土豆可以——","id":74,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"dialogue","name":"阴沉的居民","text":"不对，不能走大路！万一这个间谍被其他人抢走......","id":75,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"dialog","id":76},{"type":"charslot","id":77},{"type":"playsound","key":"$d_avg_clothmovement","volume":"0.7","id":78},{"type":"camerashake","duration":"1","xstrength":"25","ystrength":"25","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":79},{"type":"delay","time":"1","id":80},{"type":"text","text":"男人一把拎起男孩的领子，不顾男孩痛苦的呻吟，拖着他走向平日无人经过的小巷深处。","id":81},{"type":"dialog","id":82},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":83},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":84},{"type":"charslot","id":85},{"type":"background","image":"https://media.prts.wiki/2/25/Avg_bg_59_g1_citystreets_d.png","screenadapt":"coverall","block":"true","id":86},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":87},{"type":"delay","time":"1","id":88},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":89},{"type":"delay","time":"0.5","id":90},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":91},{"type":"dialogue","name":"阴沉的居民","text":"也真的是邪门，为什么还是走不出去？难道我记错路了？","id":92,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"n","id":93},{"type":"dialogue","name":"遥远的争吵声","text":"别抢！把土豆还我！你自己去粮店买，你看那里还有剩下的......","id":94},{"type":"dialogue","name":"遥远的争吵声","text":"还给我！！","id":95},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":96},{"type":"dialogue","name":"阴沉的居民","text":"还有剩下的？！","id":97,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"dialog","id":98},{"type":"charslot","id":99},{"type":"text","text":"男人看向声音传来的方向，又看了看一条胳膊攥在自己手里，几乎已经没了人样的男孩。","id":100},{"type":"charslot","slot":"m","name":"avg_npc_1686_1#1$1","focus":"m","id":101},{"type":"dialogue","name":"阴沉的居民","text":"快死了......快死了还能从他嘴里撬出来情报吗？深池的老爷们还能愿意给我口吃的吗？","id":102,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"dialogue","name":"阴沉的居民","text":"......叛徒，算你运气好。","id":103,"figure":"https://media.prts.wiki/3/38/Avg_avg_npc_1686_1-1$1.png"},{"type":"dialog","id":104},{"type":"stopmusic","fadetime":"1.5","id":105},{"type":"playsound","key":"$d_avg_clothmovementsp","volume":"1","id":106},{"type":"camerashake","duration":"0.7","xstrength":"25","ystrength":"25","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":107},{"type":"delay","time":"1","id":108},{"type":"playsound","key":"$rungeneral","volume":"0.9","id":109},{"type":"charslot","duration":"1.5","id":110},{"type":"delay","time":"2.5","id":111},{"type":"text","text":"男人甩开孩子那反而抓紧了自己袖口的手，快步跑向声音传来的方向。","id":112},{"type":"dialog","id":113},{"type":"charslot","id":114},{"type":"dialogue","name":"提奥","text":"好痛......我的腿......","id":115},{"type":"dialog","id":116},{"type":"playsound","key":"$d_avg_clothtrailground","volume":"1","id":117},{"type":"delay","time":"1.5","id":118},{"type":"dialogue","name":"提奥","text":"不行，站不起来......","id":119},{"type":"dialog","id":120},{"type":"charslot","slot":"m","name":"avg_npc_1696_1#1$1","duration":"1","id":121},{"type":"delay","time":"2","id":122},{"type":"dialog","id":123},{"type":"charslot","id":124},{"type":"playmusic","intro":"$drift_intro","key":"https://static.prts.wiki/music/music/act9d0d0/m_avg_drift_loop.mp3","volume":"0.6","id":125,"musicid":1},{"type":"dialogue","name":"提奥","text":"艾玛阿姨......","id":126},{"type":"charslot","slot":"m","name":"avg_npc_1696_1#1$1","focus":"m","id":127},{"type":"dialogue","name":"担忧的居民","text":"......谁叫我？谁？！","id":128,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialogue","name":"担忧的居民","text":"我已经照你说的做了，我已经做了！别再来缠着我了——","id":129,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialog","id":130},{"type":"charslot","id":131},{"type":"dialogue","name":"提奥","text":"艾玛......阿姨！","id":132},{"type":"charslot","slot":"m","name":"avg_npc_1696_1#1$1","focus":"m","id":133},{"type":"dialogue","name":"担忧的居民","text":"提奥？你怎么了？","id":134,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialog","id":135},{"type":"charslot","id":136},{"type":"dialogue","name":"提奥","text":"我被驮兽车给撞了，然后又被人丢到了这里。","id":137},{"type":"dialogue","name":"提奥","text":"我不是维多利亚人的间谍，艾玛阿姨。求你救救我，带我去找库林先生，好吗？","id":138},{"type":"charslot","slot":"m","name":"avg_npc_1696_1#1$1","focus":"m","id":139},{"type":"dialogue","name":"担忧的居民","text":"维多利亚人......间谍？","id":140,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialogue","name":"担忧的居民","text":"原来这么快啊......","id":141,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialog","id":142},{"type":"charslot","id":143},{"type":"dialogue","name":"提奥","text":"艾玛阿姨，我好痛，真的好痛。","id":144},{"type":"dialogue","name":"提奥","text":"我知道维多利亚人害了大家，大家都不喜欢我，没人愿意听我说话，更没人愿意碰我。","id":145},{"type":"dialogue","name":"提奥","text":"可是能不能......至少把库林先生叫过来，我好痛，而且好冷......","id":146},{"type":"dialogue","name":"提奥","text":"艾玛阿姨，等我长大了，我会去找维多利亚人报仇的，我会去替尼亚尔叔叔......报仇的。","id":147},{"type":"charslot","slot":"m","name":"avg_npc_1696_1#1$1","focus":"m","id":148},{"type":"dialogue","name":"担忧的居民","text":"（深呼吸）","id":149,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialogue","name":"担忧的居民","text":"提奥，如果死的只有尼亚尔，也许我会帮你。","id":150,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialog","id":151},{"type":"charslot","id":152},{"type":"dialogue","name":"提奥","text":"艾玛......阿姨？","id":153},{"type":"charslot","slot":"m","name":"avg_npc_1696_1#1$1","focus":"m","id":154},{"type":"dialogue","name":"担忧的居民","text":"你只知道尼亚尔死在战争里，可还有更多人，他们没上战场，也死掉了。","id":155,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialogue","name":"担忧的居民","text":"因为你们维多利亚人封锁了商路，直到现在还在封锁，所有人都在挨饿，包括我，包括......","id":156,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialogue","name":"担忧的居民","text":"尼亚尔留给我的......我肚子里的孩子。","id":157,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialogue","name":"担忧的居民","text":"他也饿死了，被你们维多利亚人活活饿死了。","id":158,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialogue","name":"担忧的居民","text":"所以，找其他人去帮你叫库林吧。他们不像我，他们都是好人......","id":159,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialogue","name":"担忧的居民","text":"......很好很好的好人。","id":160,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1696_1-1$1.png"},{"type":"dialog","id":161},{"type":"musicvolume","volume":"0.2","fadetime":"1.5","id":162},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":163},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":164},{"type":"charslot","id":165},{"type":"background","image":"https://media.prts.wiki/0/09/Avg_bg_bg_oldwarehouse_d.png","screenadapt":"coverall","block":"true","id":166},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":167},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#2$1","focus":"m","id":168},{"type":"delay","time":"2","id":169},{"type":"playsound","key":"$d_avg_woodcracle","volume":"0.8","loop":"true","channel":"a","id":170},{"type":"musicvolume","volume":"0.6","fadetime":"2","id":171},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":172},{"type":"delay","time":"0.5","id":173},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#2$1","focus":"m","id":174},{"type":"dialogue","name":"库林","text":"艾玛，竟然是艾玛......","id":175,"figure":"https://media.prts.wiki/b/b4/Avg_avg_npc_1697_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#7$1","focus":"m","id":176},{"type":"dialogue","name":"库林","text":"为什么她会变成这样？","id":177,"figure":"https://media.prts.wiki/2/2f/Avg_avg_npc_1697_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#6$1","focus":"m","id":178},{"type":"dialogue","name":"布莉吉","text":"库林，我不是给她辩解，但那天经过那里的人，肯定不止她一个。","id":179,"figure":"https://media.prts.wiki/e/e4/Avg_avg_4177_brigid_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":180},{"type":"dialogue","name":"库林","text":"是啊，不止她一个......","id":181,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#11$1","focus":"m","id":182},{"type":"dialogue","name":"布莉吉","text":"......我是不是说错话了？","id":183,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4177_brigid_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":184},{"type":"dialogue","name":"库林","text":"不，你没说错。","id":185,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialogue","name":"库林","text":"你之前还想带提奥离开，是吗？你看见什么了？","id":186,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#11$1","focus":"m","id":187},{"type":"dialogue","name":"布莉吉","text":"别人欺负他。不是小孩子之间的打打闹闹，是大人。","id":188,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4177_brigid_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#2$1","focus":"m","id":189},{"type":"dialogue","name":"库林","text":"我在第一次看见提奥被欺负的时候就冲了上去，我以为这样的事情......不会再发生。","id":190,"figure":"https://media.prts.wiki/b/b4/Avg_avg_npc_1697_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#6$1","focus":"m","id":191},{"type":"dialogue","name":"布莉吉","text":"实际上......发生过很多次。","id":192,"figure":"https://media.prts.wiki/e/e4/Avg_avg_4177_brigid_1-6$1.png"},{"type":"dialogue","name":"布莉吉","text":"之前我只是一直有种很不好的预感，我觉得提奥不属于这座城市，纳斯尔纱可能容不下他，谁知道......","id":193,"figure":"https://media.prts.wiki/e/e4/Avg_avg_4177_brigid_1-6$1.png"},{"type":"dialogue","name":"布莉吉","text":"......","id":194,"figure":"https://media.prts.wiki/e/e4/Avg_avg_4177_brigid_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":195},{"type":"dialogue","name":"库林","text":"我知道了。你走吧。","id":196,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#11$1","focus":"m","id":197},{"type":"dialogue","name":"布莉吉","text":"库林？","id":198,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4177_brigid_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":199},{"type":"dialogue","name":"库林","text":"我说我知道了。","id":200,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#11$1","focus":"m","id":201},{"type":"dialogue","name":"布莉吉","text":"你......","id":202,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4177_brigid_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#4$1","focus":"m","id":203},{"type":"dialogue","name":"库林","text":"我说我知道了！走！现在就走！让我——","id":204,"figure":"https://media.prts.wiki/2/29/Avg_avg_npc_1697_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#7$1","focus":"m","id":205},{"type":"dialogue","name":"库林","text":"......一个人待着，好吗？","id":206,"figure":"https://media.prts.wiki/2/2f/Avg_avg_npc_1697_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#6$1","focus":"m","id":207},{"type":"dialogue","name":"布莉吉","text":"......抱歉。","id":208,"figure":"https://media.prts.wiki/e/e4/Avg_avg_4177_brigid_1-6$1.png"},{"type":"dialog","id":209},{"type":"stopmusic","fadetime":"2","id":210},{"type":"playsound","key":"$d_avg_walk_stage","volume":"1","loop":"false","channel":"bw","id":211},{"type":"stopsound","fadetime":"2","channel":"bw","id":212},{"type":"charslot","duration":"0.7","id":213},{"type":"delay","time":"2","id":214},{"type":"text","text":"铁匠怔怔地站着，四周静谧，只剩下火焰的噼啪声。","id":215},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#7$1","focus":"m","id":216},{"type":"dialogue","name":"库林","text":"提奥，我......","id":217,"figure":"https://media.prts.wiki/2/2f/Avg_avg_npc_1697_1-7$1.png"},{"type":"dialog","id":218},{"type":"charslot","id":219},{"type":"text","text":"他错过的事情太多，无法理解的事也太多，已经无力去厘清其中的因果与关窍。","id":220},{"type":"text","text":"他只意识到一件事，自己什么都没做到。","id":221},{"type":"dialog","id":222},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#7$1","focus":"m","id":223},{"type":"dialogue","name":"库林","text":"我算什么英雄？！","id":224,"figure":"https://media.prts.wiki/2/2f/Avg_avg_npc_1697_1-7$1.png"},{"type":"dialog","id":225},{"type":"charslot","id":226},{"type":"stopsound","channel":"a","fadetime":"1.5","id":227},{"type":"delay","time":"2","id":228},{"type":"dialogue","name":"？？？","text":"是啊，你算什么英雄？","id":229},{"type":"text","text":"铁匠环顾四周，工坊内空无一人，唯有巨龙的雕塑正用空空如也的眼眶斜睨着他，宛如质疑。","id":230},{"type":"dialog","id":231},{"type":"playmusic","intro":"$loneliness_intro","key":"https://static.prts.wiki/music/music/static/m_avg/m_avg_loneliness_loop.mp3","volume":"0.6","id":232,"musicid":2},{"type":"delay","time":"1","id":233},{"type":"dialogue","name":"巨龙","text":"你算什么英雄？","id":234},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#11$1","focus":"m","id":235},{"type":"dialogue","name":"库林","text":"我算......什么英雄？","id":236,"figure":"https://media.prts.wiki/7/79/Avg_avg_npc_1697_1-11$1.png"},{"type":"dialog","id":237},{"type":"charslot","id":238},{"type":"dialogue","name":"巨龙","text":"英雄会放任一个每天面对无数敌意的孩子，在时不时对他口吐恶言的人群中东游西逛？","id":239},{"type":"dialogue","name":"巨龙","text":"英雄会让粮食在自己鼻子底下运出城，直到城内无粮可吃，还只能向邻居分发几枚可怜的土豆？","id":240},{"type":"dialogue","name":"巨龙","text":"英雄会在城内乱作一团的时候窝在家里埋头打铁，就为了把自己的名字刻在雕像的基座上，满足那点可怜的虚荣心？","id":241},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#5$1","focus":"m","id":242},{"type":"dialogue","name":"库林","text":"什么？！","id":243,"figure":"https://media.prts.wiki/a/a8/Avg_avg_npc_1697_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#11$1","focus":"m","id":244},{"type":"dialogue","name":"库林","text":"我......我绝不是为了什么虚荣，我是为了......为了能用英雄的名号，去......","id":245,"figure":"https://media.prts.wiki/7/79/Avg_avg_npc_1697_1-11$1.png"},{"type":"dialog","id":246},{"type":"charslot","id":247},{"type":"dialogue","name":"巨龙","text":"去像你当时对涅梅丝说的那样，“为那些在战争中失去了一切的同胞谋幸福”？","id":248},{"type":"dialogue","name":"巨龙","text":"就像现在？","id":249},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#11$1","focus":"m","id":250},{"type":"dialogue","name":"库林","text":"......就像......现在？","id":251,"figure":"https://media.prts.wiki/7/79/Avg_avg_npc_1697_1-11$1.png"},{"type":"dialog","id":252},{"type":"charslot","id":253},{"type":"dialogue","name":"巨龙","text":"你要保护的弱小已经不在人世。","id":254},{"type":"dialogue","name":"巨龙","text":"你要伸张的正义，已经没入黑暗。","id":255},{"type":"dialogue","name":"巨龙","text":"你要为之谋福利的同胞......艾玛，罗里，他们真的还是你的同胞吗？","id":256},{"type":"dialogue","name":"巨龙","text":"他们难道不是活在过去的死人吗？","id":257},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#5$1","focus":"m","id":258},{"type":"dialogue","name":"库林","text":"活在过去的......死人？！","id":259,"figure":"https://media.prts.wiki/a/a8/Avg_avg_npc_1697_1-5$1.png"},{"type":"dialog","id":260},{"type":"charslot","id":261},{"type":"dialogue","name":"巨龙","text":"他们甚至不像你，你那颗虚荣的心还梦想着未来，而他们？他们不过是一群活在过去的行尸走肉罢了。","id":262},{"type":"dialogue","name":"巨龙","text":"你的同胞是个拿着从火里抢出来的古董刀四处比划的可怜人吗？","id":263},{"type":"dialogue","name":"巨龙","text":"或者，为了一个流产的胎儿，就对一个无辜的孩子见死不救的走私犯？","id":264},{"type":"dialogue","name":"巨龙","text":"又或者，面对变故，已经只能理解仇恨这一种逻辑的“城里人”？","id":265},{"type":"dialogue","name":"巨龙","text":"现在就抓个人来，问问他以后的打算，猜猜你能听见什么？","id":266},{"type":"dialog","id":267},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":268},{"type":"delay","time":"1","id":269},{"type":"playsound","key":"$d_avg_speardrop","volume":"1","id":270},{"type":"camerashake","duration":"0.7","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":271},{"type":"delay","time":"1","id":272},{"type":"text","text":"铁匠从不离手的大锤当啷一声落在地上。","id":273},{"type":"text","text":"他死死盯住巨龙的头颅。","id":274},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":275},{"type":"dialogue","name":"库林","text":"不，不......","id":276,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialogue","name":"库林","text":"真正把人们困在过去的......难道不是你吗？","id":277,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialogue","name":"库林","text":"我收集同胞们生活用的碗盆，点燃同胞们取暖照明用的燃料......就只为了哺育你这......","id":278,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialogue","name":"库林","text":"怪物。","id":279,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":280},{"type":"multiline","name":"库林","text":"粮食我不知道，但金属、燃料......","id":281},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#7$1","focus":"m","id":282},{"type":"multiline","name":"库林","text":"对，是我，我亲手把锅，把碗，把人们的生活喂到你的嘴里，喂你长到如此巨大......","id":283},{"type":"dialogue","name":"库林","text":"连我自己的生活也被你吞吃下去，紧接着，就是提奥的生命......","id":284,"figure":"https://media.prts.wiki/2/2f/Avg_avg_npc_1697_1-7$1.png"},{"type":"multiline","name":"库林","text":"提奥，提奥......","id":285},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":286},{"type":"multiline","name":"库林","text":"对，是我养大了这个怪物，这怪物又把你的命吞掉！","id":287},{"type":"dialogue","name":"库林","text":"现在，它又要在夏末节那天站上广场，张开双翼，它说整座城的居民都会被它变成只能活在过去的死人......","id":288,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialog","id":289},{"type":"charslot","id":290},{"type":"dialogue","name":"巨龙","text":"......","id":291},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":292},{"type":"dialogue","name":"库林","text":"怪物，你说得对。我的确不是英雄。","id":293,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialogue","name":"库林","text":"我只是个可怜的、虚荣的骗子。过去我骗其他人，现在，我骗的是自己。","id":294,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialogue","name":"库林","text":"但人们需要我。","id":295,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialog","id":296},{"type":"charslot","id":297},{"type":"dialogue","name":"巨龙","text":"需要你？","id":298},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":299},{"type":"dialogue","name":"库林","text":"他们需要一个英雄，去叫醒他们，告诉他们，战争已经结束了，现在重要的是明天，是未来，是即将开始的生活。","id":300,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialog","id":301},{"type":"charslot","id":302},{"type":"dialogue","name":"巨龙","text":"就凭你？","id":303},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#2$1","focus":"m","id":304},{"type":"dialogue","name":"库林","text":"就凭我。","id":305,"figure":"https://media.prts.wiki/b/b4/Avg_avg_npc_1697_1-2$1.png"},{"type":"dialog","id":306},{"type":"charslot","duration":"0.7","id":307},{"type":"delay","time":"1","id":308},{"type":"text","text":"铁匠决绝地自炉膛边离开。他拿了一条最粗大、最结实的铁索，又拖着铁索，回到巨龙那仍然斜睨着他的头颅下边。","id":309},{"type":"dialog","id":310},{"type":"playsound","key":"$d_avg_ironchaindrop","volume":"1","id":311},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":312},{"type":"dialogue","name":"库林","text":"跟我走。","id":313,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialog","id":314},{"type":"charslot","id":315},{"type":"dialogue","name":"巨龙","text":"去哪里？","id":316},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":317},{"type":"dialogue","name":"库林","text":"广场。","id":318,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialog","id":319},{"type":"charslot","id":320},{"type":"dialogue","name":"巨龙","text":"今天并不是夏末节。","id":321},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":322},{"type":"dialogue","name":"库林","text":"我不能再等，再等下去，你那些不祥的预言只会成真。","id":323,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#2$1","focus":"m","id":324},{"type":"dialogue","name":"库林","text":"跟我走......","id":325,"figure":"https://media.prts.wiki/b/b4/Avg_avg_npc_1697_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1697_1#8$1","focus":"m","id":326},{"type":"dialogue","name":"库林","text":"然后，我会将你拆掉......","id":327,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialogue","name":"库林","text":"我会让你把生活还给所有人。","id":328,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1697_1-8$1.png"},{"type":"dialog","id":329},{"type":"charslot","id":330},{"type":"text","text":"巨龙纹丝不动，但铁匠分明看到，那头颅向着他低了低，既像轻蔑，又像邀请。","id":331},{"type":"dialog","id":332},{"type":"stopmusic","fadetime":"2","id":333},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":334},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":335},{"type":"charslot","id":336},{"type":"background","image":"https://media.prts.wiki/f/f8/Avg_bg_59_g10_indoor.png","screenadapt":"coverall","block":"true","id":337},{"type":"delay","time":"1","id":338},{"type":"playmusic","intro":"$loading_intro","key":"https://static.prts.wiki/music/music/beta1_180603/m_sys_loading_loop.mp3","volume":"0.6","id":339,"musicid":3},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":340},{"type":"delay","time":"0.5","id":341},{"type":"playsound","key":"$doorknockquite","volume":"1","id":342},{"type":"delay","time":"1","id":343},{"type":"playsound","key":"$dooropenquite","volume":"1","id":344},{"type":"delay","time":"1","id":345},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#6$1","duration":"0.7","id":346},{"type":"delay","time":"1","id":347},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#6$1","focus":"m","id":348},{"type":"dialogue","name":"布莉吉","text":"苇草、涅梅丝，我回来了。库林的状态很不好，你们也许该去看看他。","id":349,"figure":"https://media.prts.wiki/e/e4/Avg_avg_4177_brigid_1-6$1.png"},{"type":"dialogue","name":"布莉吉","text":"你们那边的情况呢？城里人怎么样了？","id":350,"figure":"https://media.prts.wiki/e/e4/Avg_avg_4177_brigid_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1694_1#1$1","focus":"m","id":351},{"type":"dialogue","name":"拉芙希妮","text":"人们仍然在抓间谍......维多利亚间谍。","id":352,"figure":"https://media.prts.wiki/d/d9/Avg_avg_npc_1694_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#4$1","focus":"m","id":353},{"type":"dialogue","name":"布莉吉","text":"他们疯了！说到底，塔拉人，维多利亚人，不都是人吗？战争已经结束了，我们难道还要这样继续你死我活下去？","id":354,"figure":"https://media.prts.wiki/3/3b/Avg_avg_4177_brigid_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#7$1","focus":"m","id":355},{"type":"dialogue","name":"布莉吉","text":"涅梅丝，去解释给人们听，让他们吃不上饭的深池已经被红龙惩治了，粮食也——","id":356,"figure":"https://media.prts.wiki/6/64/Avg_avg_4177_brigid_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1692_1#7$1","focus":"m","id":357},{"type":"dialogue","name":"涅梅丝","text":"布莉吉，别再说深池这个词，一次也别说。这是领袖的命令。","id":358,"figure":"https://media.prts.wiki/3/3a/Avg_avg_npc_1692_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1692_1#6$1","focus":"m","id":359},{"type":"dialogue","name":"涅梅丝","text":"而且......说到底，粮食的事，我也只是在庆功会上听见他们窃窃私语罢了，没有证明，没有审判。","id":360,"figure":"https://media.prts.wiki/3/33/Avg_avg_npc_1692_1-6$1.png"},{"type":"dialogue","name":"涅梅丝","text":"甚至连粮食到底是怎么回来的，我都一无所知。","id":361,"figure":"https://media.prts.wiki/3/33/Avg_avg_npc_1692_1-6$1.png"},{"type":"dialogue","name":"涅梅丝","text":"更别说深——那些人不在了的消息，现在根本就没传到人们的耳朵里......我到底该怎么解释？","id":362,"figure":"https://media.prts.wiki/3/33/Avg_avg_npc_1692_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#6$1","focus":"m","id":363},{"type":"dialogue","name":"布莉吉","text":"......","id":364,"figure":"https://media.prts.wiki/e/e4/Avg_avg_4177_brigid_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1694_1#1$1","focus":"m","id":365},{"type":"dialogue","name":"拉芙希妮","text":"如果道理讲不通，就只能硬来了。","id":366,"figure":"https://media.prts.wiki/d/d9/Avg_avg_npc_1694_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1692_1#10$1","focus":"m","id":367},{"type":"dialogue","name":"涅梅丝","text":"您是说？","id":368,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1692_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1694_1#1$1","focus":"m","id":369},{"type":"dialogue","name":"拉芙希妮","text":"我回到这里，原本抱着再也不做影子的打算。","id":370,"figure":"https://media.prts.wiki/d/d9/Avg_avg_npc_1694_1-1$1.png"},{"type":"dialogue","name":"拉芙希妮","text":"但到了现在这个地步，如果真正的领袖始终不愿露面承担责任，我就必须出面，至少暂时安抚混乱的人心。","id":371,"figure":"https://media.prts.wiki/d/d9/Avg_avg_npc_1694_1-1$1.png"},{"type":"dialogue","name":"拉芙希妮","text":"对了，那位库林先生呢？他毕竟是公认的英雄，如果他能帮我们一把，事情会顺利很多的。","id":372,"figure":"https://media.prts.wiki/d/d9/Avg_avg_npc_1694_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1692_1#8$1","focus":"m","id":373},{"type":"dialogue","name":"涅梅丝","text":"他应该就在自己的工坊。我带路。","id":374,"figure":"https://media.prts.wiki/d/d9/Avg_avg_npc_1692_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1692_1#7$1","focus":"m","id":375},{"type":"dialogue","name":"涅梅丝","text":"布莉吉，你趁现在赶紧出城。","id":376,"figure":"https://media.prts.wiki/3/3a/Avg_avg_npc_1692_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#11$1","focus":"m","id":377},{"type":"dialogue","name":"布莉吉","text":"为什么？","id":378,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4177_brigid_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1692_1#6$1","focus":"m","id":379},{"type":"dialogue","name":"涅梅丝","text":"你......如果我们和库林都没法成功，你和人群之间......","id":380,"figure":"https://media.prts.wiki/3/33/Avg_avg_npc_1692_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#10$1","focus":"m","id":381},{"type":"dialogue","name":"布莉吉","text":"我懂了，因为城里的人不喜欢我，我可能会碍事，对吧？","id":382,"figure":"https://media.prts.wiki/f/f3/Avg_avg_4177_brigid_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1692_1#6$1","focus":"m","id":383},{"type":"dialogue","name":"涅梅丝","text":"抱歉，布莉吉，我没有说你碍事的意思——","id":384,"figure":"https://media.prts.wiki/3/33/Avg_avg_npc_1692_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#10$1","focus":"m","id":385},{"type":"dialogue","name":"布莉吉","text":"但你说得对，我就是会碍事啊。","id":386,"figure":"https://media.prts.wiki/f/f3/Avg_avg_4177_brigid_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_4177_brigid_1#9$1","focus":"m","id":387},{"type":"dialogue","name":"布莉吉","text":"别担心，我现在就走，去黑林碰碰运气。也许它现在就愿意放行了呢。","id":388,"figure":"https://media.prts.wiki/6/6f/Avg_avg_4177_brigid_1-9$1.png"},{"type":"dialog","id":389},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":390},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":391},{"type":"charslot","id":392},{"type":"background","image":"https://media.prts.wiki/2/25/Avg_bg_59_g1_citystreets_d.png","screenadapt":"coverall","block":"true","id":393},{"type":"delay","time":"1","id":394},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":395},{"type":"delay","time":"1","id":396},{"type":"playsound","key":"$rungeneral","volume":"0.9","id":397},{"type":"dialogue","name":"涅梅丝","text":"库林！","id":398},{"type":"dialogue","name":"涅梅丝","text":"库林......","id":399},{"type":"dialogue","name":"拉芙希妮","text":"他不在吗？","id":400},{"type":"dialogue","name":"涅梅丝","text":"他......","id":401},{"type":"dialog","id":402},{"type":"playsound","key":"$d_avg_runstop","volume":"1","id":403},{"type":"charslot","slot":"m","name":"avg_npc_1694_1#6$1","duration":"0.5","id":404},{"type":"delay","time":"0.7","id":405},{"type":"charslot","slot":"m","name":"avg_npc_1694_1#6$1","focus":"m","id":406},{"type":"dialogue","name":"拉芙希妮","text":"这？！","id":407,"figure":"https://media.prts.wiki/8/80/Avg_avg_npc_1694_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1692_1#5$1","focus":"m","id":408},{"type":"dialogue","name":"涅梅丝","text":"......","id":409,"figure":"https://media.prts.wiki/9/9f/Avg_avg_npc_1692_1-5$1.png"},{"type":"dialog","id":410},{"type":"charslot","id":411},{"type":"text","text":"两人瞠目结舌。","id":412},{"type":"text","text":"工坊的门......","id":413},{"type":"text","text":"不，工坊正对着她们的那面墙，已经不在了。","id":414},{"type":"text","text":"那面本该在雕像完工时才拆掉的墙此时已经化作一堆瓦砾，而那些瓦砾掩盖不住的，是一道通向广场方向的拖痕。","id":415},{"type":"text","text":"一道宽如道路的，长长的拖痕。","id":416},{"type":"dialog","id":417},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":418},{"type":"stopmusic","fadetime":"2","id":419},{"type":"charslot","id":420},{"type":"image","id":421}],"characters":["提奥","阴沉的居民","车夫的声音","遥远的争吵声","担忧的居民","库林","布莉吉","？？？","巨龙","拉芙希妮","涅梅丝"]}