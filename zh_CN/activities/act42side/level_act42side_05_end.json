{"storyMeta":{"storyReviewType":"NONE","storyId":"act42side_level_act42side_05_end","storyGroup":"act42side","storySort":12,"storyDependence":"act42side_level_act42side_05_beg","storyCanShow":1,"storyCode":"MT-5","storyName":"共融","storyPic":null,"storyInfo":"牧首邀请安多恩参与育婴圣堂未来更宏大的计划。能天使因试图阻碍降生仪式被逮捕，所有非萨科塔都被铳骑以各种理由带走。","storyCanEnter":1,"storyTxt":"activities/act42side/level_act42side_05_end","avgTag":"行动后","unLockType":"BY_START_TIME","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act42side_05","minState":"PASS","maxState":"COMPLETE"}],"prev":10,"next":12,"characters":["木攀兽","牧首","帕特里奇昂","安多恩","能天使","蕾缪安","菲亚梅塔","莫斯提马","薇尔丽芙","梵里妮","潘格尼尼","铳骑","紧张的修女","席德佳"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":1},{"type":"stopmusic","id":2},{"type":"dialog","id":3},{"type":"background","image":"https://media.prts.wiki/6/65/Avg_bg_61_g2_baptismlobby.png","screenadapt":"coverall","id":4},{"type":"delay","time":"1","id":5},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_calm_loop.mp3","volume":"0.6","id":6,"musicid":0},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":7},{"type":"delay","time":"1","id":8},{"type":"playsound","key":"$d_avg_comfortbell","volume":"1","id":9},{"type":"charslot","slot":"m","name":"avg_npc_1790_1#1$1","duration":"1.5","id":10},{"type":"delay","time":"2.5","id":11},{"type":"dialogue","name":"木攀兽","text":"......","id":12,"figure":"https://media.prts.wiki/6/6F/Avg_avg_npc_1790_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":13},{"type":"dialogue","name":"牧首","text":"这个响动......别紧张，孩子。","id":14,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialog","id":15},{"type":"charslot","id":16},{"type":"playsound","key":"$rungeneral","volume":"0.4","id":17},{"type":"charslot","slot":"m","name":"avg_4194_rmixer_1#1$1","duration":"1.5","id":18},{"type":"delay","time":"2","id":19},{"type":"dialogue","name":"帕特里奇昂","text":"牧首。","id":20,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#16$2","focus":"m","id":21},{"type":"dialogue","name":"安多恩","text":"......","id":22,"figure":"https://media.prts.wiki/3/32/Avg_avg_npc_1800_1-16$2.png"},{"type":"charslot","slot":"m","name":"avg_4194_rmixer_1#1$1","focus":"m","id":23},{"type":"dialogue","name":"帕特里奇昂","text":"保育员先生，你也在。真是辛苦了，感谢你在这段时间的付出。","id":24,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#16$2","focus":"m","id":25},{"type":"dialogue","name":"安多恩","text":"只是尽我所能。","id":26,"figure":"https://media.prts.wiki/3/32/Avg_avg_npc_1800_1-16$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":27},{"type":"dialogue","name":"牧首","text":"这个小家伙还很脆弱。安多恩，带他回他母亲身边去吧。","id":28,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"我随后便去找你们。","id":29,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialog","id":30},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#16$2","focus":"m","id":31},{"type":"delay","time":"1","id":32},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":33},{"type":"charslot","duration":"1.5","id":34},{"type":"delay","time":"2","id":35},{"type":"charslot","slot":"m","name":"avg_4194_rmixer_1#1$1","focus":"m","id":36},{"type":"dialogue","name":"帕特里奇昂","text":"牧首，您看起来有些虚弱......需要我护送您回去吗？","id":37,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":38},{"type":"dialogue","name":"牧首","text":"无妨，只是刚刚的心跳声仍在我的体内回响。","id":39,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"不止那位母亲，帕特里奇昂，我听到了不计其数的心跳在共鸣，几乎要震塌这座圣堂。","id":40,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"不论出身，不论种族，人们已经开始连结......但也有人已经拒绝了我们所展示的未来。","id":41,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"降生仪式可以到此为止了，不必让同胞们在此逗留，准备下一步的工作吧。","id":42,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_4194_rmixer_1#1$1","focus":"m","id":43},{"type":"dialogue","name":"帕特里奇昂","text":"我明白了。还请您去休息，这边剩下的事情交给我就好。","id":44,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"dialog","id":45},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":46},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":47},{"type":"charslot","id":48},{"type":"background","image":"https://media.prts.wiki/6/65/Avg_bg_61_g2_baptismlobby.png","screenadapt":"coverall","id":49},{"type":"delay","time":"2","id":50},{"type":"playsound","key":"$d_avg_crwddiscuss_outside","volume":"0.4","loop":"true","channel":"bse","id":51},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":52},{"type":"delay","time":"2","id":53},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":54},{"type":"charslot","slot":"m","name":"avg_4194_rmixer_1#1$1","duration":"1.5","id":55},{"type":"delay","time":"2","id":56},{"type":"soundvolume","channel":"bse","volume":"0","fadetime":"1","id":57},{"type":"delay","time":"2","id":58},{"type":"dialogue","name":"帕特里奇昂","text":"再次感谢各位来到育婴圣堂。","id":59,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"dialogue","name":"帕特里奇昂","text":"不论诸位是否理解，又怎样看待先前牧首在峰会上提出的主张，这只木攀兽的降生与启圣，无疑都给予了我们更明晰的启示。","id":60,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"dialogue","name":"帕特里奇昂","text":"关于如何跨越“国家”“种族”的隔阂，关于如何从根本上消弭仇恨、缔造和平......关于如何共同应对悬于头顶的灾异。","id":61,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"dialogue","name":"帕特里奇昂","text":"以降生仪式为起点，第二届万国峰会将正式进入下一阶段——","id":62,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"dialogue","name":"帕特里奇昂","text":"拉特兰将向所有萨科塔之外的种族分享光环！","id":63,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"dialogue","name":"帕特里奇昂","text":"“愿主将属灵的恩典赐予每一人。”","id":64,"figure":"https://media.prts.wiki/A/A9/Avg_avg_4194_rmixer_1$1.png"},{"type":"dialog","id":65},{"type":"stopmusic","fadetime":"2","id":66},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":67},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":68},{"type":"charslot","id":69},{"type":"background","image":"https://media.prts.wiki/7/71/Avg_bg_61_g1_nurserytemplesquare.png","screenadapt":"coverall","id":70},{"type":"delay","time":"2","id":71},{"type":"playmusic","intro":"$m_dia_street_intro","key":"https://static.prts.wiki/music/music/beta3_181101/m_dia_street_loop.mp3","volume":"0.6","id":72,"musicid":1},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":73},{"type":"delay","time":"2","id":74},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":75},{"type":"charslot","slot":"l","name":"avg_300_phenxi_1#1$1","duration":"1.5","id":76},{"type":"charslot","slot":"r","name":"avg_213_mostma_1#1$1","duration":"1.5","id":77},{"type":"delay","time":"2","id":78},{"type":"charslot","slot":"r","name":"avg_213_mostma_1#1$1","focus":"none","id":79},{"type":"dialogue","name":"能天使","text":"菲亚梅塔，莫斯提马，这边这边！","id":80},{"type":"dialog","id":81},{"type":"charslot","id":82},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#3$1","duration":"1.5","id":83},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#8$2","duration":"1.5","id":84},{"type":"delay","time":"2","id":85},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#8$2","focus":"r","id":86},{"type":"dialogue","name":"蕾缪安","text":"......","id":87,"figure":"https://media.prts.wiki/4/4B/Avg_avg_npc_1811_1-8$2.png"},{"type":"dialog","id":88},{"type":"charslot","id":89},{"type":"charslot","slot":"l","name":"avg_300_phenxi_1#3$1","focus":"l","id":90},{"type":"charslot","slot":"r","name":"avg_213_mostma_1#1$1","focus":"l","id":91},{"type":"dialogue","name":"菲亚梅塔","text":"蕾缪乐？","id":92,"figure":"https://media.prts.wiki/F/F3/Avg_avg_300_phenxi_1-3$1.png"},{"type":"dialogue","name":"菲亚梅塔","text":"你什么时候回来的？怎么也不跟我们说一声。","id":93,"figure":"https://media.prts.wiki/F/F3/Avg_avg_300_phenxi_1-3$1.png"},{"type":"charslot","slot":"l","name":"avg_300_phenxi_1#9$1","focus":"l","id":94},{"type":"dialogue","name":"菲亚梅塔","text":"这身新衣服不错嘛，这副新手铐也......","id":95,"figure":"https://media.prts.wiki/2/23/Avg_avg_300_phenxi_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#5$1","focus":"l","id":96},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#8$2","focus":"l","id":97},{"type":"dialogue","name":"能天使","text":"本来想过段时间给你们一个惊喜的，这不是......嘿嘿。","id":98,"figure":"https://media.prts.wiki/F/F9/Avg_avg_1041_angel2_1-5$1.png"},{"type":"dialogue","name":"能天使","text":"（试图挠头）","id":99,"figure":"https://media.prts.wiki/F/F9/Avg_avg_1041_angel2_1-5$1.png"},{"type":"dialog","id":100},{"type":"charslot","id":101},{"type":"charslot","slot":"l","name":"avg_300_phenxi_1#9$1","focus":"r","id":102},{"type":"charslot","slot":"r","name":"avg_213_mostma_1#12$1","focus":"r","id":103},{"type":"dialogue","name":"菲亚梅塔","text":"蕾缪安，怎么回事？","id":104,"figure":"https://media.prts.wiki/D/DC/Avg_avg_213_mostma_1-12$1.png"},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#5$1","focus":"r","id":105},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#11$2","focus":"r","id":106},{"type":"dialogue","name":"蕾缪安","text":"......一两句话说不清楚。","id":107,"figure":"https://media.prts.wiki/1/1B/Avg_avg_npc_1811_1-11$2.png"},{"type":"charslot","slot":"l","name":"avg_300_phenxi_1#9$1","focus":"r","id":108},{"type":"charslot","slot":"r","name":"avg_213_mostma_1#7$1","focus":"r","id":109},{"type":"dialogue","name":"莫斯提马","text":"要不，我帮你争取两分钟逃跑？","id":110,"figure":"https://media.prts.wiki/9/97/Avg_avg_213_mostma_1-7$1.png"},{"type":"dialog","id":111},{"type":"charslot","id":112},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#9$1","focus":"l","id":113},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#11$2","focus":"l","id":114},{"type":"delay","time":"2","id":115},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#3$1","focus":"l","id":116},{"type":"multiline","name":"能天使","text":"也行——","id":117},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#9$1","focus":"l","id":118},{"type":"multiline","name":"能天使","end":"true","text":"还是别给我老姐添乱了，下次吧！","id":119},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#1$2","focus":"r","id":120},{"type":"dialogue","name":"蕾缪安","text":"......","id":121,"figure":"https://media.prts.wiki/E/EA/Avg_avg_npc_1811_1-1$2.png"},{"type":"dialog","id":122},{"type":"charslot","id":123},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":124},{"type":"charslot","slot":"m","name":"avg_npc_1780_1#1$1","duration":"1.5","id":125},{"type":"delay","time":"2","id":126},{"type":"dialogue","name":"薇尔丽芙","text":"抱歉，我是不是打扰你们几位好友团聚了？","id":127,"figure":"https://media.prts.wiki/F/F9/Avg_avg_npc_1780_1-1$1.png"},{"type":"dialog","id":128},{"type":"charslot","id":129},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#1$1","focus":"all","id":130},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#8$2","focus":"all","id":131},{"type":"delay","time":"2","id":132},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#8$2","focus":"r","id":133},{"type":"dialogue","name":"蕾缪安","text":"前辈。","id":134,"figure":"https://media.prts.wiki/4/4B/Avg_avg_npc_1811_1-8$2.png"},{"type":"dialog","id":135},{"type":"charslot","id":136},{"type":"charslot","slot":"m","name":"avg_npc_1780_1#1$1","focus":"m","id":137},{"type":"dialogue","name":"薇尔丽芙","text":"蕾缪安枢机，你自己一个人就能够将嫌犯带回第七厅吗？","id":138,"figure":"https://media.prts.wiki/F/F9/Avg_avg_npc_1780_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1780_1#3$1","focus":"m","id":139},{"type":"dialogue","name":"薇尔丽芙","text":"还是说，需要支援......？毕竟试图破坏育婴圣堂，干涉万国峰会，可是干系重大！","id":140,"figure":"https://media.prts.wiki/0/00/Avg_avg_npc_1780_1-3$1.png"},{"type":"dialog","id":141},{"type":"charslot","id":142},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#1$1","focus":"r","id":143},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#2$2","focus":"r","id":144},{"type":"dialogue","name":"蕾缪安","text":"不放心的话，前辈你可以和我一起，或者让铳骑监督。","id":145,"figure":"https://media.prts.wiki/F/FB/Avg_avg_npc_1811_1-2$2.png"},{"type":"dialog","id":146},{"type":"charslot","id":147},{"type":"charslot","slot":"m","name":"avg_npc_1780_1#3$1","focus":"m","id":148},{"type":"dialogue","name":"薇尔丽芙","text":"别这么说话嘛。毕竟根据阿摩斯辅佐官的证词，你确实之前就在其他案发现场发现了蕾缪乐的踪迹......","id":149,"figure":"https://media.prts.wiki/0/00/Avg_avg_npc_1780_1-3$1.png"},{"type":"dialog","id":150},{"type":"charslot","id":151},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#1$1","focus":"r","id":152},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#5$2","focus":"r","id":153},{"type":"dialogue","name":"蕾缪安","text":"你是想说，我试图包庇自己的妹妹？","id":154,"figure":"https://media.prts.wiki/7/77/Avg_avg_npc_1811_1-5$2.png"},{"type":"dialog","id":155},{"type":"charslot","id":156},{"type":"charslot","slot":"m","name":"avg_npc_1780_1#8$1","focus":"m","id":157},{"type":"dialogue","name":"薇尔丽芙","text":"那倒是没有，毕竟都是间接证据，不足以说明你采取了什么行动。","id":158,"figure":"https://media.prts.wiki/2/2D/Avg_avg_npc_1780_1-8$1.png"},{"type":"dialogue","name":"薇尔丽芙","text":"还记得我们之前在圣堂内的谈话吗？","id":159,"figure":"https://media.prts.wiki/2/2D/Avg_avg_npc_1780_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1780_1#9$1","focus":"m","id":160},{"type":"dialogue","name":"薇尔丽芙","text":"我很欣赏你的能力和办事手段，“噤声的蕾缪安”，不过我也清楚你那些美好的品质一般在什么时候最能得到体现......","id":161,"figure":"https://media.prts.wiki/C/CC/Avg_avg_npc_1780_1-9$1.png"},{"type":"dialogue","name":"薇尔丽芙","text":"更何况这次牵涉到的是你的妹妹，我们有所怀疑也是在所难免，请你理解。","id":162,"figure":"https://media.prts.wiki/C/CC/Avg_avg_npc_1780_1-9$1.png"},{"type":"dialog","id":163},{"type":"charslot","id":164},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#1$1","focus":"r","id":165},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#2$2","focus":"r","id":166},{"type":"dialogue","name":"蕾缪安","text":"那你们大可放心。放小乐背着一身罪名乱跑，并不能真正帮到她。","id":167,"figure":"https://media.prts.wiki/F/FB/Avg_avg_npc_1811_1-2$2.png"},{"type":"dialog","id":168},{"type":"charslot","id":169},{"type":"charslot","slot":"m","name":"avg_npc_1780_1#8$1","focus":"m","id":170},{"type":"dialogue","name":"薇尔丽芙","text":"嗯嗯，只要蕾缪乐能够配合，我相信这里面的误会一定能解开的。","id":171,"figure":"https://media.prts.wiki/2/2D/Avg_avg_npc_1780_1-8$1.png"},{"type":"dialog","id":172},{"type":"charslot","id":173},{"type":"charslot","slot":"l","name":"avg_1041_angel2_1#1$1","focus":"all","id":174},{"type":"charslot","slot":"r","name":"avg_npc_1811_1#8$2","focus":"all","id":175},{"type":"delay","time":"0.5","id":176},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":177},{"type":"charslot","slot":"l","afrom":"1","ato":"0","duration":"1","id":178},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"-200,0","duration":"1.5","id":179},{"type":"charslot","slot":"r","afrom":"1","ato":"0","duration":"1","id":180},{"type":"charslot","slot":"r","posfrom":"0,0","posto":"-200,0","duration":"1.5","id":181},{"type":"delay","time":"2.5","id":182},{"type":"charslot","id":183},{"type":"charslot","slot":"l","name":"avg_300_phenxi_1#1$1","focus":"all","id":184},{"type":"charslot","slot":"r","name":"avg_213_mostma_1#10$1","focus":"all","id":185},{"type":"delay","time":"0.5","id":186},{"type":"charslot","slot":"r","posfrom":"0,0","posto":"-100,0","duration":"1.5","id":187},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"-100,0","duration":"1.5","id":188},{"type":"delay","time":"1.5","id":189},{"type":"charslot","slot":"r","name":"avg_213_mostma_1#10$1","focus":"none","id":190},{"type":"dialogue","name":"薇尔丽芙","text":"稍微等等，“微光守夜人”，还有......万国信使莫斯提马。","id":191},{"type":"dialog","id":192},{"type":"charslot","slot":"r","posfrom":"-100,0","posto":"0,0","duration":"1.5","id":193},{"type":"charslot","slot":"l","posfrom":"-100,0","posto":"0,0","duration":"1.5","id":194},{"type":"delay","time":"1.5","id":195},{"type":"charslot","slot":"l","name":"avg_300_phenxi_1#1$1","focus":"r","id":196},{"type":"charslot","slot":"r","name":"avg_213_mostma_1#1$1","focus":"r","id":197},{"type":"dialogue","name":"莫斯提马","text":"......","id":198,"figure":"https://media.prts.wiki/7/78/Avg_avg_213_mostma_1-1$1.png"},{"type":"charslot","slot":"l","name":"avg_300_phenxi_1#1$1","focus":"l","id":199},{"type":"dialogue","name":"菲亚梅塔","text":"怎么了？","id":200,"figure":"https://media.prts.wiki/2/21/Avg_avg_300_phenxi_1-1$1.png"},{"type":"dialog","id":201},{"type":"charslot","id":202},{"type":"charslot","slot":"m","name":"avg_npc_1780_1#1$1","focus":"m","id":203},{"type":"dialogue","name":"薇尔丽芙","text":"两位请暂时留在育婴圣堂，教皇厅有些任务需要交给两位。","id":204,"figure":"https://media.prts.wiki/F/F9/Avg_avg_npc_1780_1-1$1.png"},{"type":"dialog","id":205},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":206},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":207},{"type":"charslot","id":208},{"type":"background","image":"https://media.prts.wiki/7/71/Avg_bg_61_g1_nurserytemplesquare.png","screenadapt":"coverall","id":209},{"type":"delay","time":"2","id":210},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":211},{"type":"delay","time":"2","id":212},{"type":"charslot","slot":"m","name":"avg_npc_1779_1#4$2","afrom":"0","ato":"1","duration":"1","id":213},{"type":"charslot","slot":"m","posfrom":"-200,0","posto":"0,0","duration":"1.5","id":214},{"type":"delay","time":"2","id":215},{"type":"dialogue","name":"梵里妮","text":"小乐姐......被带走了？","id":216},{"type":"dialogue","name":"梵里妮","text":"呜，好不容易说服老师让我出来，还是没来得及......","id":217},{"type":"dialogue","name":"梵里妮","text":"这，怎么办，梵妮，你还能做些什么？","id":218},{"type":"dialog","id":219},{"type":"stopmusic","fadetime":"2","id":220},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":221},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":222},{"type":"charslot","id":223},{"type":"background","image":"https://media.prts.wiki/4/43/Avg_bg_61_g4_nurseryindoor.png","screenadapt":"coverall","id":224},{"type":"delay","time":"2","id":225},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_calm_loop.mp3","volume":"0.6","id":226,"musicid":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":227},{"type":"delay","time":"2","id":228},{"type":"playsound","key":"$doorknockquite","volume":"1","id":229},{"type":"delay","time":"2","id":230},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":231},{"type":"dialogue","name":"牧首","text":"不必叩门，安多恩。我没有任何事需要回避你。","id":232,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialog","id":233},{"type":"charslot","id":234},{"type":"playsound","key":"$dooropenquite","volume":"1","id":235},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","duration":"1.5","id":236},{"type":"delay","time":"2","id":237},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":238},{"type":"dialogue","name":"牧首","text":"孩子的母亲？","id":239,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":240},{"type":"dialogue","name":"安多恩","text":"已经入睡了。","id":241,"figure":"https://media.prts.wiki/C/CF/Avg_avg_npc_1800_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#11$1","focus":"m","id":242},{"type":"dialogue","name":"安多恩","text":"我把这孩子带了过来。他羽毛还没长齐，但惊人地有活力。我猜，您或许会想再摸摸他。","id":243,"figure":"https://media.prts.wiki/8/8E/Avg_avg_npc_1800_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":244},{"type":"dialogue","name":"牧首","text":"谢谢。这于我也是一种慰藉。","id":245,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":246},{"type":"dialogue","name":"安多恩","text":"这里......","id":247,"figure":"https://media.prts.wiki/C/CF/Avg_avg_npc_1800_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":248},{"type":"dialogue","name":"牧首","text":"还记得吗？你我来到拉特兰后，为了安置这孩子的母亲，临时建了这间屋子，后来它成了整座圣堂的第一间育婴室。","id":249,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":250},{"type":"dialogue","name":"安多恩","text":"当然。我和您一起铺好了这简陋却温暖的床铺，挂好了安抚铃，让她得以安睡。","id":251,"figure":"https://media.prts.wiki/C/CF/Avg_avg_npc_1800_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":252},{"type":"dialogue","name":"牧首","text":"虽然这个房间早已不再使用，但我时常会重回这里，哪怕只是简单地祷告。","id":253,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"......这里是你我的起点。","id":254,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1790_1#1$1","focus":"m","id":255},{"type":"dialogue","name":"木攀兽","text":"（惬意地舒展身体）","id":256,"figure":"https://media.prts.wiki/6/6F/Avg_avg_npc_1790_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":257},{"type":"dialogue","name":"牧首","text":"我能感受到，他也喜欢这里。","id":258,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"说起来，这孩子的光环真闪亮啊。你抱他进来的时候，我就感受到了。","id":259,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":260},{"type":"dialogue","name":"安多恩","text":"这是您一直以来坚信的奇迹，牧首。","id":261,"figure":"https://media.prts.wiki/C/CF/Avg_avg_npc_1800_1-1$1.png"},{"type":"dialogue","name":"安多恩","text":"只是，我仍不明白，您是如何在最初见到他的母亲时，就看到了奇迹的预兆？","id":262,"figure":"https://media.prts.wiki/C/CF/Avg_avg_npc_1800_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":263},{"type":"dialogue","name":"牧首","text":"不，安多恩，我那时没有看到任何预兆，我只看到你的内心在挣扎。","id":264,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"她那时已油尽灯枯，需要的并非救治，而是安葬。但你仍想救她，你不希望这念头在常识的冲刷下消散。","id":265,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"我坚信的，是你精心保护的那一个念头，可以缔造生命的奇迹。","id":266,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"生命是伟大的，“常识”这种标尺从来都无法用来测量它的进程。","id":267,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#3$1","focus":"m","id":268},{"type":"dialogue","name":"安多恩","text":"任何人都会有救她的念头，牧首。","id":269,"figure":"https://media.prts.wiki/9/9D/Avg_avg_npc_1800_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":270},{"type":"dialogue","name":"牧首","text":"所以任何人都可以缔造奇迹。或许就是因为人们不愿相信信仰的力量，奇迹才会被称作奇迹。","id":271,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"安多恩，你难道不曾想过，是光环赋予了萨科塔信仰，还是信仰为萨科塔带来了光环？","id":272,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"我们的律法、共感和铳武，以及我们依托这些建立起的乐园......","id":273,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"它们的开端，难道真如常识所示，只是一种毫无来由的恩赐？","id":274,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#3$1","focus":"m","id":275},{"type":"dialogue","name":"安多恩","text":"......我不知道，牧首。","id":276,"figure":"https://media.prts.wiki/9/9D/Avg_avg_npc_1800_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":277},{"type":"dialogue","name":"牧首","text":"过去有其开端，未来亦然。","id":278,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"育婴圣堂......这座高耸入云的巨构，并非于一日之内落成。它的开端也只是这样一间平平无奇的育婴室。","id":279,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":280},{"type":"dialogue","name":"安多恩","text":"我们的育婴室......","id":281,"figure":"https://media.prts.wiki/C/CF/Avg_avg_npc_1800_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":282},{"type":"dialogue","name":"牧首","text":"你我最初可曾手握宏伟圣堂的蓝图？不，我们只是想要一个安全而舒适的房间，用来安置那位母亲......","id":283,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"但它依然一发不可收拾地演化成了现在的样子。","id":284,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"那么，一个所有人都得救的未来，当然可以发端于你我的信仰。","id":285,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":286},{"type":"dialogue","name":"安多恩","text":"牧首......我追随您，是因为我为了那样一个未来苦寻已久，而您恰巧知晓道路。","id":287,"figure":"https://media.prts.wiki/C/CF/Avg_avg_npc_1800_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#2$1","focus":"m","id":288},{"type":"dialogue","name":"安多恩","text":"但我不曾想过，也无法理解，为何您会认为那道路的开端在于我。","id":289,"figure":"https://media.prts.wiki/0/0C/Avg_avg_npc_1800_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#3$1","focus":"m","id":290},{"type":"dialogue","name":"安多恩","text":"我终究只能做些微不足道的小事。","id":291,"figure":"https://media.prts.wiki/9/9D/Avg_avg_npc_1800_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1777_1#1$1","focus":"m","id":292},{"type":"dialogue","name":"牧首","text":"微不足道的小事，惊天动地的壮举，不过一线之隔，一念之差。你苦寻多年才跋涉至此，不应为了这种无谓的区别而止步。","id":293,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialogue","name":"牧首","text":"接下来，除了照顾好这对母子，我需要你打起精神，去做更多的事情......比如，下一场降生仪式。","id":294,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1777_1$1.png"},{"type":"dialog","id":295},{"type":"stopmusic","fadetime":"2","id":296},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":297},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":298},{"type":"charslot","id":299},{"type":"background","image":"https://media.prts.wiki/E/E2/Avg_bg_61_g12_firearmsworkshop.png","screenadapt":"coverall","id":300},{"type":"delay","time":"2","id":301},{"type":"playmusic","intro":"$mist_intro","key":"https://static.prts.wiki/music/music/beta1_180603/m_dia_mist_loop.mp3","volume":"0.6","id":302,"musicid":3},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":303},{"type":"delay","time":"2","id":304},{"type":"playsound","key":"$dooropenquite","volume":"1","id":305},{"type":"delay","time":"2","id":306},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":307},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","duration":"1.5","id":308},{"type":"delay","time":"2.5","id":309},{"type":"charslot","slot":"m","name":"avg_npc_1781_1#2$1","focus":"m","id":310},{"type":"dialogue","name":"潘格尼尼","text":"你们来得要比通知里早啊。","id":311,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1781_1-2$1.png"},{"type":"dialogue","name":"潘格尼尼","text":"该收拾的都已经收拾完了，你们直接把封条贴了吧，完事我好回去睡觉。","id":312,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1781_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":313},{"type":"dialogue","name":"铳骑","text":"......","id":314,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1781_1#2$1","focus":"m","id":315},{"type":"dialogue","name":"潘格尼尼","text":"帕特里奇昂？","id":316,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1781_1-2$1.png"},{"type":"dialog","id":317},{"type":"playsound","key":"$d_avg_clothmovement","volume":"1","id":318},{"type":"charslot","slot":"m","name":"avg_npc_1781_1#3$1","focus":"m","id":319},{"type":"delay","time":"1","id":320},{"type":"dialogue","name":"潘格尼尼","text":"啧，差点骂错人了。","id":321,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"dialogue","name":"潘格尼尼","text":"不是说最后的接收步骤是公证所负责吗，怎么来的是铳骑？","id":322,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":323},{"type":"dialogue","name":"铳骑","text":"前提是，一切正常，你没有做什么手脚。","id":324,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1781_1#3$1","focus":"m","id":325},{"type":"dialogue","name":"潘格尼尼","text":"什么意思？","id":326,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":327},{"type":"dialogue","name":"铳骑","text":"我刚刚查验了工坊内的材料间，以及所有的操作设备，有明显的近期使用过的迹象。","id":328,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"dialogue","name":"铳骑","text":"我想，阿摩斯枢机辅佐官上次来的时候应该声明过——","id":329,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"dialogue","name":"铳骑","text":"签署关停文件后，铳械工坊一应业务即告终止，私下进行任何守护铳或者爆破物相关的制作活动将被视为违背条律。","id":330,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1781_1#3$1","focus":"m","id":331},{"type":"dialogue","name":"潘格尼尼","text":"......","id":332,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"dialogue","name":"潘格尼尼","text":"我盘下这间小作坊也有几十年了，说关就关，我舍不得......","id":333,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"dialogue","name":"潘格尼尼","text":"最后这点时间，没忍住让这些老伙计再动了动，听听响声，流流眼泪，有什么问题吗？","id":334,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":335},{"type":"dialogue","name":"铳骑","text":"类似的说辞，您已经说过一遍了。","id":336,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"dialogue","name":"铳骑","text":"您的学徒，梵里妮小姐，您在育婴圣堂门口带走了她——她人呢？","id":337,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1781_1#3$1","focus":"m","id":338},{"type":"dialogue","name":"潘格尼尼","text":"可能又溜回去看降生仪式了吧。","id":339,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"dialogue","name":"潘格尼尼","text":"她不是个小孩子了，我的眼神又不好，怎么看得住！","id":340,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":341},{"type":"dialogue","name":"铳骑","text":"既然如此，潘格尼尼先生，让我们换个地方说吧。","id":342,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1781_1#3$1","focus":"m","id":343},{"type":"dialogue","name":"潘格尼尼","text":"如果我不愿意呢？","id":344,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":345},{"type":"dialogue","name":"铳骑","text":"如非必要，我不应对您采取任何强制性的手段。","id":346,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1781_1#3$1","focus":"m","id":347},{"type":"dialogue","name":"潘格尼尼","text":"是帕特里奇昂那家伙让你来的，对吧？","id":348,"figure":"https://media.prts.wiki/F/FE/Avg_avg_npc_1781_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":349},{"type":"dialogue","name":"铳骑","text":"......请吧。","id":350,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"dialog","id":351},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":352},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":353},{"type":"charslot","id":354},{"type":"background","image":"https://media.prts.wiki/F/F4/Avg_bg_26_g6_laterano_chapelin.png","screenadapt":"coverall","id":355},{"type":"delay","time":"2","id":356},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":357},{"type":"delay","time":"2","id":358},{"type":"charslot","slot":"m","name":"avg_npc_370_1#1$1","focus":"m","id":359},{"type":"dialogue","name":"紧张的修女","text":"铳骑阁下，您问席德佳？","id":360,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":361},{"type":"dialogue","name":"铳骑","text":"她不在修道院里吗？","id":362,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_370_1#1$1","focus":"m","id":363},{"type":"dialogue","name":"紧张的修女","text":"在、她在的......但她刚好出了点意外，还在休息。","id":364,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":365},{"type":"dialogue","name":"铳骑","text":"嗯？","id":366,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_370_1#1$1","focus":"m","id":367},{"type":"dialogue","name":"紧张的修女","text":"唔，这要从哪儿说起呢......","id":368,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"dialogue","name":"紧张的修女","text":"昨天，突然有一辆告解车停在了修道院门口，席德佳修女就躺在车厢里......不、不省人事。","id":369,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"dialogue","name":"紧张的修女","text":"告解车被自定义了终点，现场也没有其他人在，我们不清楚她到底遭遇了什么。","id":370,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"dialogue","name":"紧张的修女","text":"铳骑阁下，或许可以等她醒来，我们再让她去找您。","id":371,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":372},{"type":"dialogue","name":"铳骑","text":"事态紧急，带我去见她。","id":373,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_370_1#1$1","focus":"m","id":374},{"type":"dialogue","name":"紧张的修女","text":"这......","id":375,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"dialog","id":376},{"type":"charslot","id":377},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":378},{"type":"charslot","slot":"m","name":"avg_npc_1784_1#3$1","duration":"1.5","id":379},{"type":"delay","time":"2.5","id":380},{"type":"dialogue","name":"席德佳","text":"咳咳......请不要为难格兰修女。","id":381,"figure":"https://media.prts.wiki/8/83/Avg_avg_npc_1784_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_370_1#1$1","focus":"m","id":382},{"type":"dialogue","name":"紧张的修女","text":"席德佳，你醒了，感觉还好吗？桌上的......","id":383,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1784_1#1$1","focus":"m","id":384},{"type":"dialogue","name":"席德佳","text":"放心放心，只是有点晕而已。","id":385,"figure":"https://media.prts.wiki/3/3C/Avg_avg_npc_1784_1-1$1.png"},{"type":"dialogue","name":"席德佳","text":"桌上的热粥我已经喝了，咳就是因为刚刚烫到了。","id":386,"figure":"https://media.prts.wiki/3/3C/Avg_avg_npc_1784_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1784_1#11$1","focus":"m","id":387},{"type":"dialogue","name":"席德佳","text":"铳骑阁下，您是为阿尔图罗小姐的事情来的吧？","id":388,"figure":"https://media.prts.wiki/4/49/Avg_avg_npc_1784_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":389},{"type":"dialogue","name":"铳骑","text":"......","id":390,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1784_1#15$1","focus":"m","id":391},{"type":"dialogue","name":"席德佳","text":"您听我说，阿尔图罗小姐她确实擅自离开了兰登修道院......","id":392,"figure":"https://media.prts.wiki/A/A1/Avg_avg_npc_1784_1-15$1.png"},{"type":"dialogue","name":"席德佳","text":"但我已经在发现后的第一时间出去追了，请相信我，我已经找到她了！但......发生了一些意想不到的事情......","id":393,"figure":"https://media.prts.wiki/A/A1/Avg_avg_npc_1784_1-15$1.png"},{"type":"dialogue","name":"席德佳","text":"请再给兰登修道院一点时间，不，请再给我一点时间。","id":394,"figure":"https://media.prts.wiki/A/A1/Avg_avg_npc_1784_1-15$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":395},{"type":"dialogue","name":"铳骑","text":"席德佳修女，你介意跟我们走一趟吗？","id":396,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1784_1#15$1","focus":"m","id":397},{"type":"dialogue","name":"席德佳","text":"......好，我跟您去。","id":398,"figure":"https://media.prts.wiki/A/A1/Avg_avg_npc_1784_1-15$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":399},{"type":"dialogue","name":"铳骑","text":"对了，这位修女，你也一起吧。","id":400,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_370_1#1$1","focus":"m","id":401},{"type":"dialogue","name":"紧张的修女","text":"我？","id":402,"figure":"https://media.prts.wiki/A/A7/Avg_avg_npc_370_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1784_1#15$1","focus":"m","id":403},{"type":"dialogue","name":"席德佳","text":"格兰修女和这件事情没有关系。","id":404,"figure":"https://media.prts.wiki/A/A1/Avg_avg_npc_1784_1-15$1.png"},{"type":"dialogue","name":"席德佳","text":"阿尔图罗小姐的监管事宜一直是我在负责，是我的失职......","id":405,"figure":"https://media.prts.wiki/A/A1/Avg_avg_npc_1784_1-15$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_358_1#1$1","focus":"m","id":406},{"type":"dialogue","name":"铳骑","text":"别紧张，席德佳修女。","id":407,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"dialogue","name":"铳骑","text":"兰登修道院发生了这么重大的事情，教皇厅需要知晓全部的细节，尽可能多地收集线索。","id":408,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"dialogue","name":"铳骑","text":"现在，请跟我们走吧。","id":409,"figure":"https://media.prts.wiki/9/9C/Avg_avg_npc_358_1$1.png"},{"type":"dialog","id":410},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":411},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":412},{"type":"stopmusic","fadetime":"2","id":413},{"type":"image","id":414},{"type":"charslot","id":415}],"characters":["木攀兽","牧首","帕特里奇昂","安多恩","能天使","蕾缪安","菲亚梅塔","莫斯提马","薇尔丽芙","梵里妮","潘格尼尼","铳骑","紧张的修女","席德佳"]}