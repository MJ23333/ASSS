{"storyMeta":{"storyReviewType":"NONE","storyId":"act42side_level_act42side_07_end","storyGroup":"act42side","storySort":16,"storyDependence":"act42side_level_act42side_07_beg","storyCanShow":1,"storyCode":"MT-7","storyName":"丧礼","storyPic":null,"storyInfo":"安多恩一直照料的木攀兽母亲去世，但他的悲伤很快就被抹去，他意识到牧首承诺给他的未来是多么恐怖。费德里科与离群萨科塔们展开对峙，并最终允许他们作为助力入城。","storyCanEnter":1,"storyTxt":"activities/act42side/level_act42side_07_end","avgTag":"行动后","unLockType":"BY_START_TIME","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act42side_07","minState":"PASS","maxState":"COMPLETE"}],"prev":14,"next":16,"characters":["蕾缪安","阿摩斯","？？？","木攀兽","安多恩","保育员","堕天使A","奥罗拉","堕天使B","堕天使们","玻利瓦尔小孩","努艾达","费德里科","离群萨科塔A","离群萨科塔B","阿尔图罗"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":1},{"type":"stopmusic","id":2},{"type":"dialog","id":3},{"type":"background","image":"https://media.prts.wiki/9/93/Avg_bg_26_g8_laterano_dwelling.png","screenadapt":"coverall","block":"true","id":4},{"type":"delay","time":"1","id":5},{"type":"playmusic","intro":"$darkness02_intro","key":"https://static.prts.wiki/music/music/beta1_180603/m_dia_darkness02_loop.mp3","volume":"0.6","id":6,"musicid":0},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":7},{"type":"delay","time":"0.5","id":8},{"type":"playsound","key":"$doorknockquite","volume":"1","id":9},{"type":"delay","time":"1","id":10},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#1$1","focus":"m","id":11},{"type":"dialogue","name":"蕾缪安","text":"请进。","id":12,"figure":"https://media.prts.wiki/1/1d/Avg_avg_npc_1811_1-1$1.png"},{"type":"dialog","id":13},{"type":"charslot","id":14},{"type":"delay","time":"0.5","id":15},{"type":"playsound","key":"$d_avg_walk_stage","volume":"1","loop":"false","channel":"aw","id":16},{"type":"stopsound","fadetime":"2","channel":"aw","id":17},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#1$1","duration":"1","id":18},{"type":"delay","time":"1.5","id":19},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#1$1","focus":"m","id":20},{"type":"dialogue","name":"阿摩斯","text":"蕾缪安枢机……","id":21,"figure":"https://media.prts.wiki/a/a2/Avg_avg_npc_1783_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#1$1","focus":"m","id":22},{"type":"dialogue","name":"蕾缪安","text":"得改口了哦。","id":23,"figure":"https://media.prts.wiki/1/1d/Avg_avg_npc_1811_1-1$1.png"},{"type":"dialogue","name":"蕾缪安","text":"我已经被禁足，原则上教皇厅应该不允许任何人前来探视才对啊。","id":24,"figure":"https://media.prts.wiki/1/1d/Avg_avg_npc_1811_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#1$1","focus":"m","id":25},{"type":"dialogue","name":"阿摩斯","text":"报备过了。","id":26,"figure":"https://media.prts.wiki/a/a2/Avg_avg_npc_1783_1-1$1.png"},{"type":"dialogue","name":"阿摩斯","text":"我刚刚接任，在事务交接上难免有一些仓促，来请教前任枢机，再正常不过。","id":27,"figure":"https://media.prts.wiki/a/a2/Avg_avg_npc_1783_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#10$1","focus":"m","id":28},{"type":"dialogue","name":"蕾缪安","text":"哈哈，你适应得很快嘛，阿摩斯枢机。","id":29,"figure":"https://media.prts.wiki/f/f9/Avg_avg_npc_1811_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#1$1","focus":"m","id":30},{"type":"dialogue","name":"蕾缪安","text":"我记得你之前可是说，自己是个没什么追求的人。","id":31,"figure":"https://media.prts.wiki/1/1d/Avg_avg_npc_1811_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#1$1","focus":"m","id":32},{"type":"dialogue","name":"阿摩斯","text":"蕾缪安枢……小姐，我不是来趁机炫耀什么的，我们之间本来也不是什么勾心斗角的上下级关系吧。","id":33,"figure":"https://media.prts.wiki/a/a2/Avg_avg_npc_1783_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#1$1","focus":"m","id":34},{"type":"dialogue","name":"蕾缪安","text":"抱歉。","id":35,"figure":"https://media.prts.wiki/1/1d/Avg_avg_npc_1811_1-1$1.png"},{"type":"dialogue","name":"蕾缪安","text":"但如果你是来问蕾缪乐的行踪，我已经在前几轮询问中说过很多次——确实无可奉告。","id":36,"figure":"https://media.prts.wiki/1/1d/Avg_avg_npc_1811_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#2$1","focus":"m","id":37},{"type":"dialogue","name":"阿摩斯","text":"不，我想问您另外一个问题。","id":38,"figure":"https://media.prts.wiki/d/d6/Avg_avg_npc_1783_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#10$1","focus":"m","id":39},{"type":"dialogue","name":"阿摩斯","text":"蕾缪安小姐，您愿意牺牲自己的事业，只是为了保护妹妹，还是，您真的相信她说的……","id":40,"figure":"https://media.prts.wiki/a/af/Avg_avg_npc_1783_1-10$1.png"},{"type":"dialogue","name":"阿摩斯","text":"从降生仪式，到万国峰会……拉特兰最近发生的所有事都很不对劲。我们像是，患上了某种疾病。","id":41,"figure":"https://media.prts.wiki/a/af/Avg_avg_npc_1783_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#6$1","focus":"m","id":42},{"type":"dialogue","name":"蕾缪安","text":"……","id":43,"figure":"https://media.prts.wiki/0/0c/Avg_avg_npc_1811_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#14$1","focus":"m","id":44},{"type":"dialogue","name":"蕾缪安","text":"对我来说，这是一码事。","id":45,"figure":"https://media.prts.wiki/e/ed/Avg_avg_npc_1811_1-14$1.png"},{"type":"dialog","id":46},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#10$1","focus":"m","id":47},{"type":"delay","time":"1","id":48},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#2$1","focus":"m","id":49},{"type":"dialogue","name":"阿摩斯","text":"我、我想请您看一样东西。","id":50,"figure":"https://media.prts.wiki/d/d6/Avg_avg_npc_1783_1-2$1.png"},{"type":"dialog","id":51},{"type":"charslot","id":52},{"type":"playsound","key":"$d_avg_devicebeep","volume":"1","id":53},{"type":"delay","time":"1","id":54},{"type":"text","text":"阿摩斯点开了自己的终端，递给蕾缪安。","id":55},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#11$1","focus":"m","id":56},{"type":"dialogue","name":"蕾缪安","text":"这是？","id":57,"figure":"https://media.prts.wiki/0/0e/Avg_avg_npc_1811_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#1$1","focus":"m","id":58},{"type":"dialogue","name":"阿摩斯","text":"万国信使的申请函。我希望能够成为万国信使，负责玻利瓦尔一带的政府沟通任务。","id":59,"figure":"https://media.prts.wiki/a/a2/Avg_avg_npc_1783_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#11$1","focus":"m","id":60},{"type":"dialogue","name":"蕾缪安","text":"你想离开拉特兰？为什么？","id":61,"figure":"https://media.prts.wiki/0/0e/Avg_avg_npc_1811_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#5$1","focus":"m","id":62},{"type":"dialogue","name":"阿摩斯","text":"我和我妻子……","id":63,"figure":"https://media.prts.wiki/d/d2/Avg_avg_npc_1783_1-5$1.png"},{"type":"dialogue","name":"阿摩斯","text":"当年我们大吵了一架，不欢而散。等我再回到家，她已经去出任务了，前往卡兹戴尔附近的荒野，处理萨卡兹侵扰商队的事情。","id":64,"figure":"https://media.prts.wiki/d/d2/Avg_avg_npc_1783_1-5$1.png"},{"type":"dialogue","name":"阿摩斯","text":"她一直是这样的脾气，听不进去别人的话。那时候是冬天，我估摸着她春天才能回来，我还来得及做点什么……","id":65,"figure":"https://media.prts.wiki/d/d2/Avg_avg_npc_1783_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#2$1","focus":"m","id":66},{"type":"dialogue","name":"阿摩斯","text":"后来的事情，我也告诉过您，堕天啊驱逐啊什么的。","id":67,"figure":"https://media.prts.wiki/d/d6/Avg_avg_npc_1783_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#5$1","focus":"m","id":68},{"type":"dialogue","name":"阿摩斯","text":"第七厅专司情报、国安和外交，工作上有一些便利，我花了很长的时间，终于打听到了她的下落。于是我就想着……","id":69,"figure":"https://media.prts.wiki/d/d2/Avg_avg_npc_1783_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#11$1","focus":"m","id":70},{"type":"dialogue","name":"蕾缪安","text":"我能理解。","id":71,"figure":"https://media.prts.wiki/0/0e/Avg_avg_npc_1811_1-11$1.png"},{"type":"dialogue","name":"蕾缪安","text":"可是，你刚刚说的怪事是指？","id":72,"figure":"https://media.prts.wiki/0/0e/Avg_avg_npc_1811_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#7$1","focus":"m","id":73},{"type":"dialogue","name":"阿摩斯","text":"我知道万国信使的选拔标准有多严格，凭我的能力，实在是……所以这份申请，一直躺在我的邮箱里。直到……","id":74,"figure":"https://media.prts.wiki/5/5b/Avg_avg_npc_1783_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#11$1","focus":"m","id":75},{"type":"dialogue","name":"蕾缪安","text":"你接任第七厅枢机后，批准了自己的那份申请？","id":76,"figure":"https://media.prts.wiki/0/0e/Avg_avg_npc_1811_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#10$1","focus":"m","id":77},{"type":"dialogue","name":"阿摩斯","text":"是、是。","id":78,"figure":"https://media.prts.wiki/a/af/Avg_avg_npc_1783_1-10$1.png"},{"type":"dialogue","name":"阿摩斯","text":"通知我接任枢机一职的时候，帕特里奇昂阁下说我从来都只是缺乏一个契机……","id":79,"figure":"https://media.prts.wiki/a/af/Avg_avg_npc_1783_1-10$1.png"},{"type":"dialogue","name":"阿摩斯","text":"虽然他肯定另有所指，但我这没出息的脑子，第一时间想到的就是这件事。","id":80,"figure":"https://media.prts.wiki/a/af/Avg_avg_npc_1783_1-10$1.png"},{"type":"dialogue","name":"阿摩斯","text":"可是，我点过批准之后，这份申请就……消失了。没有收到任何申请被驳回的消息，没有任何记录可查。","id":81,"figure":"https://media.prts.wiki/a/af/Avg_avg_npc_1783_1-10$1.png"},{"type":"dialogue","name":"阿摩斯","text":"它就那么消失在了我的终端里，像是、像是从来没有存在过。","id":82,"figure":"https://media.prts.wiki/a/af/Avg_avg_npc_1783_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#3$1","focus":"m","id":83},{"type":"dialogue","name":"蕾缪安","text":"——！","id":84,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1811_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#1$1","focus":"m","id":85},{"type":"dialogue","name":"阿摩斯","text":"流程上，那份申请不论我批准与否都不会被通过，我不可能被允许立刻辞去枢机职务，成为万国信使。","id":86,"figure":"https://media.prts.wiki/a/a2/Avg_avg_npc_1783_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#8$1","focus":"m","id":87},{"type":"dialogue","name":"阿摩斯","text":"更何况所有万国信使都已经被召回拉特兰，哪怕真的当上了，我也没机会去见奥罗拉。","id":88,"figure":"https://media.prts.wiki/f/ff/Avg_avg_npc_1783_1-8$1.png"},{"type":"dialogue","name":"阿摩斯","text":"批准那份申请对我来说，连弥补都算不上，那就只是一丝微不足道的慰藉。","id":89,"figure":"https://media.prts.wiki/f/ff/Avg_avg_npc_1783_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#7$1","focus":"m","id":90},{"type":"dialogue","name":"阿摩斯","text":"谁会想着把这微不足道的慰藉也给抹消？","id":91,"figure":"https://media.prts.wiki/5/5b/Avg_avg_npc_1783_1-7$1.png"},{"type":"dialogue","name":"阿摩斯","text":"对我来说，这足以成为一条线索……让我怀疑这个拉特兰是否真实。","id":92,"figure":"https://media.prts.wiki/5/5b/Avg_avg_npc_1783_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#1$1","focus":"m","id":93},{"type":"dialogue","name":"阿摩斯","text":"或许……您妹妹想做的事情，是正确的。","id":94,"figure":"https://media.prts.wiki/a/a2/Avg_avg_npc_1783_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#8$1","focus":"m","id":95},{"type":"dialogue","name":"蕾缪安","text":"阿摩斯枢机，你有向其他人提起这件事吗？","id":96,"figure":"https://media.prts.wiki/c/cc/Avg_avg_npc_1811_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#4$1","focus":"m","id":97},{"type":"dialogue","name":"阿摩斯","text":"没、没有。整整一个晚上，我都没法合眼……想来想去，也只有您可以分享了。","id":98,"figure":"https://media.prts.wiki/b/bf/Avg_avg_npc_1783_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#6$1","focus":"m","id":99},{"type":"dialogue","name":"蕾缪安","text":"阿摩斯枢机，我在想，这是否是什么新的审讯手段。","id":100,"figure":"https://media.prts.wiki/0/0c/Avg_avg_npc_1811_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#8$1","focus":"m","id":101},{"type":"dialogue","name":"阿摩斯","text":"您可以相信我，蕾缪安小姐。","id":102,"figure":"https://media.prts.wiki/f/ff/Avg_avg_npc_1783_1-8$1.png"},{"type":"dialogue","name":"阿摩斯","text":"我们都有自己真正在意的东西……也都不多。","id":103,"figure":"https://media.prts.wiki/f/ff/Avg_avg_npc_1783_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1811_1#1$1","focus":"m","id":104},{"type":"dialogue","name":"蕾缪安","text":"很有意思的发言，阿摩斯先生。","id":105,"figure":"https://media.prts.wiki/1/1d/Avg_avg_npc_1811_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1783_1#1$1","focus":"m","id":106},{"type":"dialogue","name":"阿摩斯","text":"哦对了，今天，育婴圣堂会举行一场更为盛大的降生仪式。","id":107,"figure":"https://media.prts.wiki/a/a2/Avg_avg_npc_1783_1-1$1.png"},{"type":"dialog","id":108},{"type":"stopmusic","fadetime":"2","id":109},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":110},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":111},{"type":"charslot","id":112},{"type":"background","image":"https://media.prts.wiki/4/43/Avg_bg_61_g4_nurseryindoor.png","screenadapt":"coverall","block":"true","id":113},{"type":"backgroundtween","xFrom":"100","yFrom":"0","xTo":"-100","yTo":"0","xScaleFrom":"1.3","yScaleFrom":"1.3","xScaleTo":"1.3","yScaleTo":"1.3","duration":"35","block":"false","id":114},{"type":"curtain","direction":"0","fillfrom":"0.01","fillto":"0.15","grad":"true","fadetime":"0.1","id":115},{"type":"curtain","direction":"4","fillfrom":"0.01","fillto":"0.15","grad":"true","fadetime":"0.1","id":116},{"type":"delay","time":"1","id":117},{"type":"playmusic","intro":"$loneliness_intro","key":"https://static.prts.wiki/music/music/static/m_avg/m_avg_loneliness_loop.mp3","volume":"0.6","id":118,"musicid":1},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":119},{"type":"delay","time":"0.5","id":120},{"type":"text","text":"“每个人终其一生，都在为死亡这件事做准备。”","id":121},{"type":"text","text":"哪怕在潮石镇那样被饥荒和瘟疫冲刷得一无所有的地方，也会有年迈的老人在闭眼前一刻，舔舔干裂的嘴唇，悠悠说出类似的话。","id":122},{"type":"text","text":"这是一句老生常谈，只不过对有些人来说是饮恨的总结，而对另一些人来说是不怀遗憾的感喟。但它们的前提是一样的——","id":123},{"type":"text","text":"死亡，是生命的终点。","id":124},{"type":"dialog","id":125},{"type":"curtain","fadetime":"1","id":126},{"type":"delay","time":"2","id":127},{"type":"background","image":"https://media.prts.wiki/4/43/Avg_bg_61_g4_nurseryindoor.png","screenadapt":"coverall","fadetime":"1.5","block":"true","id":128},{"type":"delay","time":"1","id":129},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#2$1","duration":"1","id":130},{"type":"delay","time":"2","id":131},{"type":"dialog","id":132},{"type":"charslot","id":133},{"type":"dialogue","name":"？？？","text":"——","id":134},{"type":"dialog","id":135},{"type":"charslot","slot":"m","name":"avg_npc_1790_1#1$1","duration":"0.5","id":136},{"type":"delay","time":"0.7","id":137},{"type":"charslot","slot":"m","name":"avg_npc_1790_1#1$1","focus":"m","id":138},{"type":"dialogue","name":"木攀兽","text":"（疑惑地拱头）","id":139,"figure":"https://media.prts.wiki/6/6f/Avg_avg_npc_1790_1$1.png"},{"type":"dialogue","name":"木攀兽","text":"（紧张地扇翅）","id":140,"figure":"https://media.prts.wiki/6/6f/Avg_avg_npc_1790_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#2$1","focus":"m","id":141},{"type":"dialogue","name":"安多恩","text":"是的，孩子，你的母亲已经不会再回应我们了。","id":142,"figure":"https://media.prts.wiki/0/0c/Avg_avg_npc_1800_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#3$1","focus":"m","id":143},{"type":"dialogue","name":"安多恩","text":"……她已经死去。","id":144,"figure":"https://media.prts.wiki/9/9d/Avg_avg_npc_1800_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1790_1#1$1","focus":"m","id":145},{"type":"playsound","key":"$d_avg_birdlingchirp_1","volume":"1","id":146},{"type":"dialogue","name":"木攀兽","text":"（低低地嘤鸣）","id":147,"figure":"https://media.prts.wiki/6/6f/Avg_avg_npc_1790_1$1.png"},{"type":"dialog","id":148},{"type":"charslot","id":149},{"type":"text","text":"母兽已经没有了鼻息，安多恩缓缓合上了她的眼睛。","id":150},{"type":"text","text":"幼崽靠了过来，他颤抖着，连毛色都变得暗淡。安多恩将他抱上自己的膝头，对上他的眼睛。","id":151},{"type":"text","text":"幼崽的声音含混不清，安多恩也不懂兽的语言，但他清晰地感受到悲伤。悲伤像是平静河面下奔涌的水流——幼崽的，自己的。","id":152},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#2$1","focus":"m","id":153},{"type":"dialogue","name":"安多恩","text":"死亡总是伴随着新生，你的母亲只是在自知生命无可挽回后，选择将生的希望留给你。","id":154,"figure":"https://media.prts.wiki/0/0c/Avg_avg_npc_1800_1-2$1.png"},{"type":"dialogue","name":"安多恩","text":"她用尽了所有力气，她最终做到了这件事情。","id":155,"figure":"https://media.prts.wiki/0/0c/Avg_avg_npc_1800_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#3$1","focus":"m","id":156},{"type":"dialogue","name":"安多恩","text":"这是你的第一课。","id":157,"figure":"https://media.prts.wiki/9/9d/Avg_avg_npc_1800_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1790_1#1$1","focus":"m","id":158},{"type":"playsound","key":"$d_avg_birdlingchirp_1","volume":"1","id":159},{"type":"dialogue","name":"木攀兽","text":"（低低地嘤鸣）","id":160,"figure":"https://media.prts.wiki/6/6f/Avg_avg_npc_1790_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":161},{"type":"dialogue","name":"安多恩","text":"潮石镇、那个有钟楼的小镇、荒野上的修道院，还有如今……我经历过许多类似的时刻，如今我再次经历，体悟越发深刻。","id":162,"figure":"https://media.prts.wiki/c/cf/Avg_avg_npc_1800_1-1$1.png"},{"type":"dialog","id":163},{"type":"charslot","id":164},{"type":"text","text":"万物都会在它既定的旅程中走向终结，所以意义的延续才显得难能可贵。","id":165},{"type":"text","text":"死亡，是一场告别。","id":166},{"type":"text","text":"是死者对生者的赠礼，是生者拯救自己的起点。","id":167},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#11$1","focus":"m","id":168},{"type":"dialogue","name":"安多恩","text":"孩子，别恐惧。","id":169,"figure":"https://media.prts.wiki/8/8e/Avg_avg_npc_1800_1-11$1.png"},{"type":"dialogue","name":"安多恩","text":"你应该悲哀，你应该铭记……我与你一起。","id":170,"figure":"https://media.prts.wiki/8/8e/Avg_avg_npc_1800_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1790_1#1$1","focus":"m","id":171},{"type":"dialogue","name":"木攀兽","text":"……","id":172,"figure":"https://media.prts.wiki/6/6f/Avg_avg_npc_1790_1$1.png"},{"type":"dialog","id":173},{"type":"charslot","id":174},{"type":"playsound","key":"$doorknockquite","volume":"1","id":175},{"type":"delay","time":"1","id":176},{"type":"dialogue","name":"保育员","text":"安多恩前辈，她的葬礼由您主持，我就不进去了。","id":177},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":178},{"type":"dialogue","name":"安多恩","text":"牧首呢？","id":179,"figure":"https://media.prts.wiki/c/cf/Avg_avg_npc_1800_1-1$1.png"},{"type":"dialog","id":180},{"type":"charslot","id":181},{"type":"dialogue","name":"保育员","text":"牧首恐怕暂时无法过来，她在准备接下来的降生仪式，为圣堂内的所有非萨科塔赋予光环……她让我跟您说声抱歉。","id":182},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#3$1","focus":"m","id":183},{"type":"dialogue","name":"安多恩","text":"……无妨。","id":184,"figure":"https://media.prts.wiki/9/9d/Avg_avg_npc_1800_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":185},{"type":"dialogue","name":"安多恩","text":"人们习惯了隆重地迎接新生，而葬礼总是简单的。告诉牧首，我会稍微晚一点再恢复工作。","id":186,"figure":"https://media.prts.wiki/c/cf/Avg_avg_npc_1800_1-1$1.png"},{"type":"dialog","id":187},{"type":"charslot","id":188},{"type":"dialogue","name":"保育员","text":"您还好吗？","id":189},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#2$1","focus":"m","id":190},{"type":"dialogue","name":"安多恩","text":"母亲的离世太过突然，这孩子还太小，很难抵御那样强烈的悲伤，我需要陪在他身边。","id":191,"figure":"https://media.prts.wiki/0/0c/Avg_avg_npc_1800_1-2$1.png"},{"type":"dialog","id":192},{"type":"charslot","id":193},{"type":"dialogue","name":"保育员","text":"不，安多恩前辈，牧首担心的是您。","id":194},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#1$1","focus":"m","id":195},{"type":"dialogue","name":"安多恩","text":"嗯？","id":196,"figure":"https://media.prts.wiki/c/cf/Avg_avg_npc_1800_1-1$1.png"},{"type":"dialog","id":197},{"type":"charslot","id":198},{"type":"dialogue","name":"保育员","text":"牧首说，您和她一起陪伴了这位母亲良久，您内心的苦痛不言而喻。","id":199},{"type":"dialogue","name":"保育员","text":"您是一个善思的人，每一段旅程都会给您启发，但在那之前，也会让您困顿。","id":200},{"type":"dialogue","name":"保育员","text":"至于这个孩子……他是奇迹，他有能力走出阴霾。","id":201},{"type":"dialogue","name":"保育员","text":"牧首让我转告您，未来，拉特兰每一个新生的生命，都不会被外在的灾厄和内里的悲伤所击倒。","id":202},{"type":"dialogue","name":"保育员","text":"他们生而平等，也将勇敢而强大……拉特兰会帮助他们做到。","id":203},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#3$1","focus":"m","id":204},{"type":"dialogue","name":"安多恩","text":"……","id":205,"figure":"https://media.prts.wiki/9/9d/Avg_avg_npc_1800_1-3$1.png"},{"type":"dialog","id":206},{"type":"stopmusic","fadetime":"2","id":207},{"type":"charslot","slot":"l","name":"avg_npc_1790_1#1$1","posfrom":"100,0","posto":"100,0","afrom":"0","ato":"1","duration":"0.7","id":208},{"type":"delay","time":"1","id":209},{"type":"charslot","slot":"l","action":"jump","power":"5","times":"3","duration":"0.7","id":210},{"type":"delay","time":"1.5","id":211},{"type":"dialog","id":212},{"type":"charslot","id":213},{"type":"text","text":"安多恩感到木攀兽幼崽在轻拱自己的手臂。他想抚摸小兽，但小兽奋力地张开翅膀，推开了他的手。","id":214},{"type":"playsound","key":"$d_avg_wing","volume":"1","id":215},{"type":"playsound","key":"$d_avg_comfortbell","volume":"1","delay":"0.5","id":216},{"type":"text","text":"小兽盘旋着飞起，落在房间中央的安抚铃上，与安抚铃一同发出悦耳的声响。","id":217},{"type":"text","text":"安多恩不解地望向幼崽，哪怕头顶光环行走了几十年，他依然在刹那间被小兽无比明亮的光环晃到了眼。","id":218},{"type":"charslot","slot":"m","name":"avg_npc_1790_1#1$1","focus":"m","id":219},{"type":"dialogue","name":"木攀兽","text":"（用力地扇翅）","id":220,"figure":"https://media.prts.wiki/6/6f/Avg_avg_npc_1790_1$1.png"},{"type":"playsound","key":"$d_avg_birdlingchirp_2","volume":"1","id":221},{"type":"dialogue","name":"木攀兽","text":"（高高地嘤鸣）","id":222,"figure":"https://media.prts.wiki/6/6f/Avg_avg_npc_1790_1$1.png"},{"type":"dialog","id":223},{"type":"charslot","id":224},{"type":"playmusic","intro":"$newhope01_intro","key":"https://static.prts.wiki/music/music/beta3_181101/m_dia_newhope01_loop.mp3","volume":"0.6","id":225,"musicid":2},{"type":"text","text":"他与小兽朝夕相处，这些动作意味着什么，他再清楚不过。","id":226},{"type":"text","text":"那是小兽在邀他一同玩耍。","id":227},{"type":"text","text":"从来不会拒绝孩子们的保育员呆立原地。","id":228},{"type":"text","text":"他想借助共感传达自己的悲伤，想以最委婉的方式拒绝这难以理解的邀请。","id":229},{"type":"text","text":"但最终，他只是走上前去，牵住木攀兽的爪，与小兽一同、与安抚铃一同，在空旷的房间正中跳起了圆舞的步伐。","id":230},{"type":"text","text":"木攀兽兴奋地鸣叫着，尖锐的啼鸣久久不能散去；他的羽毛在灯光下熠熠生辉，在旋转中展露出全部的光泽。","id":231},{"type":"text","text":"他们的步伐越来越快，安多恩只能勉强撇过头去，望向母兽的遗体，试图确认自己的情绪。他猛地意识到——","id":232},{"type":"text","text":"自己早已不再悲伤。","id":233},{"type":"text","text":"他与那小兽一样快乐，他与那小兽一样美丽，他与那小兽一样，满怀希望地向未来献上高歌与舞蹈。","id":234},{"type":"text","text":"他们飞旋的步伐在地面上、在空气中画出一个又一个美丽的圆环。","id":235},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#9$1","focus":"m","id":236},{"type":"dialogue","name":"安多恩","text":"这……这就是……","id":237,"figure":"https://media.prts.wiki/7/72/Avg_avg_npc_1800_1-9$1.png"},{"type":"dialogue","name":"安多恩","text":"萨科塔？","id":238,"figure":"https://media.prts.wiki/7/72/Avg_avg_npc_1800_1-9$1.png"},{"type":"dialogue","name":"安多恩","text":"只有免于苦痛的本能……","id":239,"figure":"https://media.prts.wiki/7/72/Avg_avg_npc_1800_1-9$1.png"},{"type":"dialogue","name":"安多恩","text":"却没有悲伤与哀悼的资格？","id":240,"figure":"https://media.prts.wiki/7/72/Avg_avg_npc_1800_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1800_1#5$1","focus":"m","id":241},{"type":"camerashake","duration":"0.5","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":242},{"type":"dialogue","name":"安多恩","text":"难道这就是萨科塔，这就是生命的奇迹？！","id":243,"figure":"https://media.prts.wiki/7/76/Avg_avg_npc_1800_1-5$1.png"},{"type":"dialog","id":244},{"type":"charslot","id":245},{"type":"text","text":"没有人回答他歇斯底里的诘问。他的牧首正在启圣大堂，为人们赋上一顶又一顶美丽的光环。","id":246},{"type":"text","text":"唯独他自己，突兀地停下了脚步，没来由地想起了一场葬礼，一场本不应存在于他记忆中的葬礼。","id":247},{"type":"dialog","id":248},{"type":"bg","duration":"2","from":"0","to":"1","block":"true","id":249},{"type":"delay","time":"0.5","id":250},{"type":"cameraeffect","effect":"Grayscale","fadetime":"1.5","keep":"true","initamount":"0","amount":"0.8","block":"true","id":251},{"type":"background","image":"https://media.prts.wiki/9/94/Avg_bg_26_g5_laterano_chapelout.png","screenadapt":"coverall","fadetime":"1.5","block":"true","id":252},{"type":"delay","time":"0.5","id":253},{"type":"bg","duration":"1.5","from":"1","to":"0","block":"true","id":254},{"type":"delay","time":"2","id":255},{"type":"text","text":"鸢尾花田，小小的孩子，一些残忍却真诚的倾诉与祷告，钟声。","id":256},{"type":"dialog","id":257},{"type":"stopmusic","fadetime":"2","id":258},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":259},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":260},{"type":"charslot","id":261},{"type":"background","image":"https://media.prts.wiki/1/1c/Avg_bg_31_g4_mini12_village.png","screenadapt":"coverall","block":"true","id":262},{"type":"cameraeffect","effect":"Grayscale","keep":"true","amount":"0","block":"true","id":263},{"type":"delay","time":"1","id":264},{"type":"playsound","key":"$d_avg_crwddiscuss_outside","volume":"0","loop":"true","channel":"crwd1","id":265},{"type":"soundvolume","volume":"0.3","channel":"crwd1","fadetime":"2","id":266},{"type":"playmusic","intro":"$darkness01_intro","key":"https://static.prts.wiki/music/music/beta1_180603/m_dia_darkness01_loop.mp3","volume":"0.6","id":267,"musicid":3},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":268},{"type":"delay","time":"0.5","id":269},{"type":"charslot","slot":"m","name":"avg_npc_1805_1#2$1","focus":"m","id":270},{"type":"dialogue","name":"堕天使A","text":"还、还是没有回应吗？","id":271,"figure":"https://media.prts.wiki/5/53/Avg_avg_npc_1805_1-2$1.png"},{"type":"dialogue","name":"堕天使A","text":"喂，奥罗拉？","id":272,"figure":"https://media.prts.wiki/5/53/Avg_avg_npc_1805_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":273},{"type":"dialogue","name":"奥罗拉","text":"不信就过来自己听。","id":274,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialog","id":275},{"type":"charslot","slot":"m","name":"avg_npc_1805_1#2$1","focus":"m","id":276},{"type":"delay","time":"0.2","id":277},{"type":"playsound","key":"$d_avg_recorderglitch","volume":"1","id":278},{"type":"delay","time":"1.5","id":279},{"type":"charslot","slot":"m","name":"avg_npc_1805_1#1$1","focus":"m","id":280},{"type":"dialogue","name":"堕天使A","text":"耳朵要聋了……里面各种杂音，什么也听不清呀！","id":281,"figure":"https://media.prts.wiki/0/04/Avg_avg_npc_1805_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1806_1#1$1","focus":"m","id":282},{"type":"dialogue","name":"堕天使B","text":"奥罗拉，这到底是怎么回事？","id":283,"figure":"https://media.prts.wiki/6/65/Avg_avg_npc_1806_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":284},{"type":"dialogue","name":"奥罗拉","text":"你在质问我？","id":285,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1806_1#2$1","focus":"m","id":286},{"type":"dialogue","name":"堕天使B","text":"你毕竟是铳骑，起码曾经是，你自然要比我们更懂这些东西。","id":287,"figure":"https://media.prts.wiki/3/39/Avg_avg_npc_1806_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":288},{"type":"dialogue","name":"奥罗拉","text":"你也说了，“曾经”。","id":289,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialogue","name":"奥罗拉","text":"这些杂音够吵了，你们要是再吵，我有的是办法让你们闭嘴。","id":290,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialog","id":291},{"type":"charslot","id":292},{"type":"charslot","slot":"l","name":"avg_npc_1805_1#1$1","focus":"all","id":293},{"type":"charslot","slot":"r","name":"avg_npc_1806_1#1$1","focus":"all","id":294},{"type":"dialogue","name":"堕天使们","text":"……","id":295},{"type":"dialog","id":296},{"type":"charslot","id":297},{"type":"charslot","slot":"m","name":"avg_npc_240","focus":"m","id":298},{"type":"dialogue","name":"玻利瓦尔小孩","text":"修女……","id":299,"figure":"https://media.prts.wiki/3/32/Avg_avg_npc_240.png"},{"type":"charslot","slot":"m","name":"avg_4187_graceb_1#3$1","focus":"m","id":300},{"type":"dialogue","name":"努艾达","text":"别害怕，雨果。","id":301,"figure":"https://media.prts.wiki/6/69/Avg_avg_4187_graceb_1-3$1.png"},{"type":"dialog","id":302},{"type":"playsound","key":"$d_gen_walk_n","volume":"0.6","id":303},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"-100,0","duration":"1.5","id":304},{"type":"charslot","duration":"1","id":305},{"type":"delay","time":"2","id":306},{"type":"charslot","slot":"l","name":"avg_npc_1782_1#12$1","focus":"all","id":307},{"type":"delay","time":"0.2","id":308},{"type":"charslot","slot":"r","name":"avg_4187_graceb_1#3$1","posfrom":"70,0","posto":"0,0","duration":"1","id":309},{"type":"delay","time":"1.5","id":310},{"type":"charslot","slot":"r","name":"avg_4187_graceb_1#3$1","focus":"r","id":311},{"type":"dialogue","name":"努艾达","text":"（奥罗拉，孩子们在看着，别这样。）","id":312,"figure":"https://media.prts.wiki/6/69/Avg_avg_4187_graceb_1-3$1.png"},{"type":"dialogue","name":"努艾达","text":"（这些萨科塔都是突遭变故，从其他国家不远万里赶回来的。他们头上还顶着破碎的光环，满心恐慌却得不到安抚……）","id":313,"figure":"https://media.prts.wiki/6/69/Avg_avg_4187_graceb_1-3$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1782_1#12$1","focus":"l","id":314},{"type":"dialogue","name":"奥罗拉","text":"……","id":315,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialogue","name":"奥罗拉","text":"拉特兰的城际网络系统向来稳定，城外各个聚落的通讯装置会由专人定期维护。","id":316,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialogue","name":"奥罗拉","text":"这一根紧急通讯桩离拉特兰城只有三公里，按理说是最不该出问题的。但我已经通过特殊频道呼叫了十几次了，都没有回应。","id":317,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialogue","name":"奥罗拉","text":"呵，难道拉特兰真完蛋了？","id":318,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"charslot","slot":"r","name":"avg_4187_graceb_1#3$1","focus":"r","id":319},{"type":"dialogue","name":"努艾达","text":"奥罗拉，辛苦再试几次吧。","id":320,"figure":"https://media.prts.wiki/6/69/Avg_avg_4187_graceb_1-3$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1782_1#12$1","focus":"l","id":321},{"type":"dialogue","name":"奥罗拉","text":"努艾达，你看起来比他们还要紧张。","id":322,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"charslot","slot":"r","name":"avg_4187_graceb_1#16$1","focus":"r","id":323},{"type":"dialogue","name":"努艾达","text":"是吗？","id":324,"figure":"https://media.prts.wiki/9/9c/Avg_avg_4187_graceb_1-16$1.png"},{"type":"dialog","id":325},{"type":"charslot","id":326},{"type":"text","text":"努艾达没有回答。几个孩子跑了过来，攥住她的裙摆，随着她的目光一起看向前方。","id":327},{"type":"text","text":"从这个小镇，已经能窥见拉特兰城的外围，洁白的城墙与流云同色，像是误入凡尘的圣灵居所，本不该存世的奇迹。","id":328},{"type":"text","text":"而远行者此刻与它相隔咫尺，他们风尘仆仆，疲惫不堪，已经破碎的光环和光翼在荒野里显得越发黯淡。","id":329},{"type":"text","text":"朝圣者终抵终途，可苦旅真的能就此结束吗？","id":330},{"type":"charslot","slot":"r","name":"avg_4187_graceb_1#6$1","focus":"r","id":331},{"type":"charslot","slot":"l","name":"avg_npc_1782_1#12$1","focus":"r","id":332},{"type":"dialogue","name":"努艾达","text":"那就是，拉特兰……","id":333,"figure":"https://media.prts.wiki/0/05/Avg_avg_4187_graceb_1-6$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1782_1#12$1","focus":"l","id":334},{"type":"dialogue","name":"奥罗拉","text":"行了，看样子城里的人是火烧眉毛，连自己都顾不过来了。收拾东西，我们直接进城。","id":335,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialog","id":336},{"type":"charslot","id":337},{"type":"charslot","slot":"m","name":"avg_npc_1805_1#1$1","focus":"m","id":338},{"type":"dialogue","name":"堕天使A","text":"也是，总不能一直这样干等着。不管了，走！","id":339,"figure":"https://media.prts.wiki/0/04/Avg_avg_npc_1805_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1806_1#2$1","focus":"m","id":340},{"type":"dialogue","name":"堕天使B","text":"可是，没有得到教皇厅的允许，擅自进城的话……","id":341,"figure":"https://media.prts.wiki/3/39/Avg_avg_npc_1806_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":342},{"type":"dialogue","name":"奥罗拉","text":"我们这些堕天的罪人决定回拉特兰，难道得到教皇厅的允许了？","id":343,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialogue","name":"奥罗拉","text":"别告诉我你回来是想着给拉特兰报恩的，那样的话我可以先把你解决了。","id":344,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"stopmusic","fadetime":"2","id":345},{"type":"dialog","id":346},{"type":"charslot","duration":"0.3","id":347},{"type":"delay","time":"0.5","id":348},{"type":"stopsound","channel":"crwd1","fadetime":"2","id":349},{"type":"playsound","key":"$d_avg_walk_stage","volume":"1","loop":"false","channel":"nw","id":350},{"type":"stopsound","fadetime":"2","channel":"nw","id":351},{"type":"delay","time":"1.5","id":352},{"type":"dialogue","name":"？？？","text":"停下脚步，到此为止。","id":353},{"type":"dialog","id":354},{"type":"playmusic","intro":"$m_sys_act16side_intro","key":"https://static.prts.wiki/music/music/act16side/m_sys_act16side_loop.mp3","volume":"0.6","id":355,"musicid":4},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#1$1","duration":"1","id":356},{"type":"delay","time":"1.5","id":357},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#1$1","focus":"m","id":358},{"type":"dialogue","name":"费德里科","text":"你们不得进入拉特兰。","id":359,"figure":"https://media.prts.wiki/e/e9/Avg_avg_1032_excu2_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":360},{"type":"dialogue","name":"奥罗拉","text":"嗬，竟然是一位公证所的执行者。","id":361,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#1$1","focus":"m","id":362},{"type":"dialogue","name":"费德里科","text":"你是奥罗拉？","id":363,"figure":"https://media.prts.wiki/e/e9/Avg_avg_1032_excu2_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":364},{"type":"dialogue","name":"奥罗拉","text":"你认识我？","id":365,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#1$1","focus":"m","id":366},{"type":"dialogue","name":"费德里科","text":"收到你的通讯后，我在公证所查阅了你的资料。","id":367,"figure":"https://media.prts.wiki/e/e9/Avg_avg_1032_excu2_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#10$1","focus":"m","id":368},{"type":"dialogue","name":"费德里科","text":"奥罗拉，前公民编号LC0073458，前铳骑第三小队队长，于1090年冬率队前往北部荒野护送拉特兰商队，并与萨卡兹佣兵爆发冲突。","id":369,"figure":"https://media.prts.wiki/b/bc/Avg_avg_1032_excu2_1-10$1.png"},{"type":"dialogue","name":"费德里科","text":"你成功完成了任务。但在返程途中，移动修道院遭遇了小型天灾，被押解的萨卡兹佣兵趁机暴动，被你当场格杀。","id":370,"figure":"https://media.prts.wiki/b/bc/Avg_avg_1032_excu2_1-10$1.png"},{"type":"dialogue","name":"费德里科","text":"随后，当同行的铳骑试图如实记述任务报告时，为了掩盖因自己的过激手段招致的罪责，你竟然举铳威胁对方。","id":371,"figure":"https://media.prts.wiki/b/bc/Avg_avg_1032_excu2_1-10$1.png"},{"type":"dialogue","name":"费德里科","text":"混乱中你杀害了同僚，也因此被剥夺公民身份，被永久驱逐出拉特兰。","id":372,"figure":"https://media.prts.wiki/b/bc/Avg_avg_1032_excu2_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":373},{"type":"dialogue","name":"奥罗拉","text":"……","id":374,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":375},{"type":"dialogue","name":"奥罗拉","text":"怎么，执行者先生，你面无表情地说完这一大通，就是想告诉我，拉特兰从来没有忘记我的罪？","id":376,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialogue","name":"奥罗拉","text":"看看你面前的这几百人。他们有一些是像我一样遭到驱逐的堕天使，有一些是出于种种原因脱离圣城的离群者……","id":377,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialogue","name":"奥罗拉","text":"甚至还有一群人，从来没有见过圣城，他们在玻利瓦尔那样的烂地方，信奉着拉特兰的教义……","id":378,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialogue","name":"奥罗拉","text":"你没看见这些人的光环吗？这是堕天还是病？他们跋山涉水来到这里，求一个解，求个说法，求个心安。","id":379,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":380},{"type":"camerashake","duration":"0.5","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":381},{"type":"dialogue","name":"奥罗拉","text":"而拉特兰，却只是派出一个执行者将我们挡在城外？！","id":382,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"dialog","id":383},{"type":"charslot","id":384},{"type":"playsound","key":"$d_avg_crowdrun","volume":"0.6","id":385},{"type":"delay","time":"2","id":386},{"type":"playsound","key":"$d_avg_gunequip","volume":"0.7","id":387},{"type":"playsound","key":"$d_avg_gunload","volume":"0.9","delay":"0.2","id":388},{"type":"playsound","key":"$shotgunreload","volume":"1","delay":"0.4","id":389},{"type":"playsound","key":"$d_avg_revolverchange","volume":"0.6","delay":"0.3","id":390},{"type":"playsound","key":"$d_avg_gunequip","channel":"1","volume":"0.3","id":391},{"type":"playsound","key":"$d_avg_gunequip","channel":"2","volume":"0.5","id":392},{"type":"image","image":"https://media.prts.wiki/7/7a/Avg_61_i10.png","screenadapt":"coverall","xScale":"1.15","yScale":"1.15","fadetime":"1.5","id":393},{"type":"imagetween","xScaleTo":"1","yScaleTo":"1","duration":"30","block":"false","id":394},{"type":"delay","time":"2.5","id":395},{"type":"text","text":"越来越多的离群萨科塔围了上来，他们将费德里科堵在中间，向着他举起手中的武器。","id":396},{"type":"dialogue","name":"离群萨科塔A","text":"我们只是离开拉特兰久了些，只是忘了怎么和其他萨科塔一样生活……现在就要被拒之门外？","id":397},{"type":"dialogue","name":"离群萨科塔B","text":"律法责罚罪孽，可你告诉我，我老老实实在莱塔尼亚过了二十年日子，我犯了什么罪？","id":398},{"type":"dialogue","name":"堕天使A","text":"如果律法如此残酷，应该受罚的就不是我们，而是你——你和你的同僚，律法的牙兽！","id":399},{"type":"dialogue","name":"堕天使B","text":"执行者，我当初堕天就是因为你们惩罚不了该惩罚的人！现在看来，你们的本事从来都没用对过地方！","id":400},{"type":"dialogue","name":"费德里科","text":"……","id":401},{"type":"dialog","id":402},{"type":"delay","time":"1","id":403},{"type":"text","text":"费德里科沉默地看着眼前的人群。","id":404},{"type":"text","text":"路灯不合时宜地亮着，给人们的脸平添一抹怪异的色彩。恐慌、焦躁、愤怒、疑惑、惊惧……种种表情让他们的五官变得扭曲。","id":405},{"type":"text","text":"他们握住武器的手在颤抖，骚乱一触即发。","id":406},{"type":"text","text":"但费德里科有能力控制眼下的局面。凭自己的反应速度，他有把握尽快解决对方的头领，强行镇压剩下的人。","id":407},{"type":"text","text":"一直以来，他都是这么做的，而且效果显著。","id":408},{"type":"text","text":"费德里科是一位优秀的公证所执行者，这是他成为执行者的第八年，工作早已得心应手。","id":409},{"type":"text","text":"同时，这也是他被加上圣徒名号的第三个年头，除了一朵已经被焚毁的花，几个偶然相识的人，没有谁能给他启发或指点。","id":410},{"type":"dialog","id":411},{"type":"delay","time":"1","id":412},{"type":"dialogue","name":"费德里科","text":"……","id":413},{"type":"text","text":"他看着眼前紧张的人群，缓缓将手从腰间移开，示意自己的手与守护铳保持了足够的距离。","id":414},{"type":"dialogue","name":"费德里科","text":"我来，并不是为了重申拉特兰曾对各位下达的判决。","id":415},{"type":"dialogue","name":"费德里科","text":"我来，并不代表公证所、教皇厅，以及拉特兰的任何官方立场。","id":416},{"type":"dialogue","name":"费德里科","text":"各位不得进入拉特兰城，是因为城中发生了一些远超常识的异变，你们的到来，或许会让局势更加混乱。","id":417},{"type":"dialogue","name":"费德里科","text":"我需要一些时间，我会尽量向你们解释清楚。","id":418},{"type":"dialog","id":419},{"type":"image","fadetime":"1.5","block":"true","id":420},{"type":"delay","time":"1","id":421},{"type":"charslot","slot":"m","name":"avg_npc_1782_1#12$1","focus":"m","id":422},{"type":"dialogue","name":"奥罗拉","text":"……","id":423,"figure":"https://media.prts.wiki/1/11/Avg_avg_npc_1782_1-12$1.png"},{"type":"charslot","slot":"m","name":"avg_4187_graceb_1#16$1","focus":"m","id":424},{"type":"dialogue","name":"努艾达","text":"……","id":425,"figure":"https://media.prts.wiki/9/9c/Avg_avg_4187_graceb_1-16$1.png"},{"type":"dialog","id":426},{"type":"charslot","id":427},{"type":"charslot","slot":"l","name":"avg_npc_1805_1#1$1","focus":"all","id":428},{"type":"charslot","slot":"r","name":"avg_npc_1806_1#1$1","focus":"all","id":429},{"type":"dialogue","name":"堕天使们","text":"……","id":430},{"type":"dialog","id":431},{"type":"charslot","id":432},{"type":"playsound","key":"$d_avg_cellodoubth","volume":"1","id":433},{"type":"delay","time":"1","id":434},{"type":"charslot","slot":"m","name":"avg_245_cello_1#11$1","duration":"1","id":435},{"type":"delay","time":"2","id":436},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#9$1","focus":"m","id":437},{"type":"dialogue","name":"费德里科","text":"阿尔图罗？你不应该离开圣城。","id":438,"figure":"https://media.prts.wiki/d/d3/Avg_avg_1032_excu2_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_245_cello_1#11$1","focus":"m","id":439},{"type":"dialogue","name":"阿尔图罗","text":"放心吧，我已经见到了博士……我来找你，自然也是博士的意思。","id":440,"figure":"https://media.prts.wiki/0/03/Avg_avg_245_cello_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_245_cello_1#2$1","focus":"m","id":441},{"type":"dialogue","name":"阿尔图罗","text":"博士的发现确证了你我的猜想。拉特兰全城陷入了某种群体性的幻梦，但此刻，梦境中的异变正在与现实叠加……","id":442,"figure":"https://media.prts.wiki/7/73/Avg_avg_245_cello_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_245_cello_1#4$1","focus":"m","id":443},{"type":"dialogue","name":"阿尔图罗","text":"灾异正在吞噬整座城市。","id":444,"figure":"https://media.prts.wiki/0/0f/Avg_avg_245_cello_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#4$1","focus":"m","id":445},{"type":"dialogue","name":"费德里科","text":"……类似巫王的帕维永崩解后，荒域对崔林特尔梅的侵袭？","id":446,"figure":"https://media.prts.wiki/0/0e/Avg_avg_1032_excu2_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_245_cello_1#11$1","focus":"m","id":447},{"type":"dialogue","name":"阿尔图罗","text":"大概吧，我也并不能完全理解。但毫无疑问的是，几百万拉特兰人正深陷在虚幻与现实的拉扯中，我们需要新的助力。","id":448,"figure":"https://media.prts.wiki/0/03/Avg_avg_245_cello_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#10$1","focus":"m","id":449},{"type":"dialogue","name":"费德里科","text":"……这些背律者和离群者。","id":450,"figure":"https://media.prts.wiki/b/bc/Avg_avg_1032_excu2_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_245_cello_1#11$1","focus":"m","id":451},{"type":"dialogue","name":"阿尔图罗","text":"恰巧出现的不和谐音，往往能成为演奏中有趣的变奏。","id":452,"figure":"https://media.prts.wiki/0/03/Avg_avg_245_cello_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_1032_excu2_1#1$1","focus":"m","id":453},{"type":"dialogue","name":"费德里科","text":"我同意博士的判断。","id":454,"figure":"https://media.prts.wiki/e/e9/Avg_avg_1032_excu2_1-1$1.png"},{"type":"dialogue","name":"费德里科","text":"但如果灾异覆盖的范围是整座拉特兰城，他们极有可能会在入城的同时进入幻梦。","id":455,"figure":"https://media.prts.wiki/e/e9/Avg_avg_1032_excu2_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_245_cello_1#11$1","focus":"m","id":456},{"type":"dialogue","name":"阿尔图罗","text":"所以我才来找你，顺便带来了我的琴。","id":457,"figure":"https://media.prts.wiki/0/03/Avg_avg_245_cello_1-11$1.png"},{"type":"dialog","id":458},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":459},{"type":"stopmusic","fadetime":"2","id":460},{"type":"charslot","id":461},{"type":"image","id":462}],"characters":["蕾缪安","阿摩斯","？？？","木攀兽","安多恩","保育员","堕天使A","奥罗拉","堕天使B","堕天使们","玻利瓦尔小孩","努艾达","费德里科","离群萨科塔A","离群萨科塔B","阿尔图罗"]}