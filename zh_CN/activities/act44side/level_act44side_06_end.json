{"storyMeta":{"storyReviewType":"NONE","storyId":"act44side_level_act44side_06_end","storyGroup":"act44side","storySort":14,"storyDependence":"act44side_level_act44side_06_beg","storyCanShow":1,"storyCode":"AT-6","storyName":"漩涡","storyPic":null,"storyInfo":"在寄身金石电视台，却对三船的所作所为深恶痛绝的更纱的帮助下，萌萌香和吉星与星熊取得了联络。而森内也了结了他多年来寻找某位神明的心愿，尽管了结心愿的方式出乎他的意料。","storyCanEnter":1,"storyTxt":"activities/act44side/level_act44side_06_end","avgTag":"行动后","unLockType":"BY_START_TIME","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act44side_06","minState":"PASS","maxState":"COMPLETE"}],"prev":12,"next":14,"characters":["萌萌香","懈怠的黑道","？？？","更纱","森内","久违的神明","好事的神明","星熊","电视里的声音"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"stopmusic","id":1},{"type":"dialog","id":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":3},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":4},{"type":"charslot","id":5},{"type":"background","image":"https://media.prts.wiki/3/3d/Avg_bg_bg_towerinside.png","screenadapt":"coverall","id":6},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_formal_loop.mp3","volume":"0.6","id":7,"musicid":0},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":8},{"type":"playsound","key":"$transmission","volume":"1","id":9},{"type":"delay","time":"1","id":10},{"type":"charslot","slot":"m","name":"avg_npc_1918_1#8$1","duration":"0.5","isblock":"true","id":11},{"type":"dialogue","name":"萌萌香","text":"星熊！星熊！！能听见我说话吗？","id":12,"figure":"https://media.prts.wiki/6/6a/Avg_avg_npc_1918_1-8$1.png"},{"type":"dialogue","name":"萌萌香","text":"能听见我——","id":13,"figure":"https://media.prts.wiki/6/6a/Avg_avg_npc_1918_1-8$1.png"},{"type":"dialog","id":14},{"type":"charslot","id":15},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":16},{"type":"charslot","slot":"m","name":"avg_npc_1906_1#1$1","posfrom":"200,0","posto":"0,0","duration":"1.5","id":17},{"type":"delay","time":"0.5","id":18},{"type":"dialogue","name":"懈怠的黑道","text":"号什么丧呢！","id":19,"figure":"https://media.prts.wiki/0/0b/Avg_avg_npc_1906_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1918_1#14$1","id":20},{"type":"dialogue","name":"萌萌香","text":"星——","id":21,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_1918_1-14$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1906_1#1$1","id":22},{"type":"dialogue","name":"懈怠的黑道","text":"你就叫吧，看看星熊那傻瓜什么时候来自投罗网！","id":23,"figure":"https://media.prts.wiki/0/0b/Avg_avg_npc_1906_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1918_1#13$1","id":24},{"type":"dialogue","name":"萌萌香","text":"......金兵卫到底想拿我怎么样？","id":25,"figure":"https://media.prts.wiki/c/cb/Avg_avg_npc_1918_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1906_1#1$1","id":26},{"type":"dialogue","name":"懈怠的黑道","text":"金兵卫？那是谁？","id":27,"figure":"https://media.prts.wiki/0/0b/Avg_avg_npc_1906_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1918_1#12$1","id":28},{"type":"dialogue","name":"萌萌香","text":"......我说三船。","id":29,"figure":"https://media.prts.wiki/6/63/Avg_avg_npc_1918_1-12$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1906_1#1$1","id":30},{"type":"dialogue","name":"懈怠的黑道","text":"我怎么知道？不过，毕竟你多少也算个偶像，说不定会长拿你还有什么别的用处，也说不定他就打算做掉你拉倒。","id":31,"figure":"https://media.prts.wiki/0/0b/Avg_avg_npc_1906_1$1.png"},{"type":"dialogue","name":"懈怠的黑道","text":"你也是的，白长了这么一张漂亮脸蛋，怎么就不知道跟他服个软？","id":32,"figure":"https://media.prts.wiki/0/0b/Avg_avg_npc_1906_1$1.png"},{"type":"dialog","id":33},{"type":"playsound","key":"$d_gen_transmissionget","volume":"1","id":34},{"type":"delay","time":"1.5","id":35},{"type":"dialogue","name":"懈怠的黑道","text":"*东国粗口*，明知道我被临时拉来当看守，又是哪个混球给我发信息寻开心——","id":36,"figure":"https://media.prts.wiki/0/0b/Avg_avg_npc_1906_1$1.png"},{"type":"dialogue","name":"懈怠的黑道","text":"啥？又搞来一个倒霉蛋跟我换班？","id":37,"figure":"https://media.prts.wiki/0/0b/Avg_avg_npc_1906_1$1.png"},{"type":"camerashake","duration":"0.3","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":38},{"type":"dialogue","name":"懈怠的黑道","text":"呀——嚯！","id":39,"figure":"https://media.prts.wiki/0/0b/Avg_avg_npc_1906_1$1.png"},{"type":"dialog","id":40},{"type":"playsound","key":"$rungeneral","volume":"1","loop":"true","channel":"r","id":41},{"type":"stopsound","channel":"r","fadetime":"1","id":42},{"type":"charslot","slot":"m","name":"avg_npc_1906_1#1$1","posfrom":"0,0","posto":"200,0","afrom":"1","ato":"0","duration":"0.5","isblock":"true","id":43},{"type":"delay","time":"1","id":44},{"type":"charslot","id":45},{"type":"charslot","slot":"m","name":"avg_npc_1918_1#7$1","id":46},{"type":"dialogue","name":"萌萌香","text":"......走远了。","id":47,"figure":"https://media.prts.wiki/d/d2/Avg_avg_npc_1918_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1918_1#6$1","id":48},{"type":"dialogue","name":"萌萌香","text":"刚刚到底是怎么回事？为什么能听见人的声音，甚至......好像还和星熊说上了话？","id":49,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1918_1-6$1.png"},{"type":"dialogue","name":"萌萌香","text":"难道出幻觉了？","id":50,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1918_1-6$1.png"},{"type":"charslot","slot":"m","focus":"n","id":51},{"type":"dialogue","name":"？？？","text":"在——你——的——背——后——","id":52},{"type":"charslot","id":53},{"type":"camerashake","duration":"0.3","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":54},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#10$1","posfrom":"200,0","posto":"0,0","afrom":"1","ato":"1","duration":"0.5","id":55},{"type":"dialogue","name":"萌萌香","text":"呀！！","id":56,"figure":"https://media.prts.wiki/a/a1/Avg_avg_npc_1918_1-10$1.png"},{"type":"dialog","id":57},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":58},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#10$1","posfrom":"200,0","posto":"0,0","duration":"1.5","isblock":"true","id":59},{"type":"delay","time":"0.5","id":60},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#10$1","focus":"r","id":61},{"type":"dialogue","name":"？？？","text":"噗！","id":62,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_1900_1-10$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#9$1","focus":"r","id":63},{"type":"dialogue","name":"？？？","text":"原来你节目里那些反应真不是演的啊。之前吉星告诉我的时候我还不信呢。","id":64,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#10$1","focus":"l","id":65},{"type":"dialogue","name":"萌萌香","text":"你认识吉星？吉星她怎么样了？","id":66,"figure":"https://media.prts.wiki/a/a1/Avg_avg_npc_1918_1-10$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#9$1","focus":"r","id":67},{"type":"dialogue","name":"？？？","text":"她和你差不多，也被关了起来。暂时应该不会吃什么苦头。","id":68,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#3$1","focus":"l","id":69},{"type":"dialogue","name":"萌萌香","text":"你、你到底是......","id":70,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1918_1-3$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#9$1","focus":"r","id":71},{"type":"dialogue","name":"？？？","text":"叫我更纱吧，算是你的粉丝，名义上也算是三船的雇员。不过，我的真实身份其实是隐藏的忍客！","id":72,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#7$1","focus":"l","id":73},{"type":"dialogue","name":"萌萌香","text":"忍客？忍者？","id":74,"figure":"https://media.prts.wiki/d/d2/Avg_avg_npc_1918_1-7$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#4$1","focus":"r","id":75},{"type":"dialogue","name":"更纱","text":"别瞎说，忍者不过是拿钱办事的杀人犯，忍客可是城际网络的漫游者！","id":76,"figure":"https://media.prts.wiki/b/b6/Avg_avg_npc_1900_1-4$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#3$1","focus":"l","id":77},{"type":"dialogue","name":"萌萌香","text":"可我记得忍客一开始不也是财阀养来攻击竞争对手的忍者，只是精通城际网络相关的技术吗？","id":78,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1918_1-3$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#3$1","focus":"r","id":79},{"type":"dialogue","name":"更纱","text":"啧，那就流浪忍客，流浪忍客好吧！","id":80,"figure":"https://media.prts.wiki/e/ef/Avg_avg_npc_1900_1-3$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#7$1","focus":"l","id":81},{"type":"dialogue","name":"萌萌香","text":"可我还是不知道你从哪来，也不知道你为什么会帮我——","id":82,"figure":"https://media.prts.wiki/d/d2/Avg_avg_npc_1918_1-7$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#9$1","focus":"r","id":83},{"type":"dialogue","name":"更纱","text":"你在家看到的那段录像，就是三船和澪商量怎么让你感染矿石病的那段，那是我放出来提醒你的！这样够不够让你相信我？","id":84,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#11$1","focus":"l","id":85},{"type":"dialogue","name":"萌萌香","text":"就是你大半夜把我吓得睡不着觉？！","id":86,"figure":"https://media.prts.wiki/5/5a/Avg_avg_npc_1918_1-11$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#4$1","focus":"r","id":87},{"type":"dialogue","name":"更纱","text":"这这这，毕竟那也是我头一次处理御机——不是，金石台的信号系统，稍微出了点错，不是故意的，真的不是故意的！","id":88,"figure":"https://media.prts.wiki/b/b6/Avg_avg_npc_1900_1-4$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#1$1","focus":"l","id":89},{"type":"dialogue","name":"萌萌香","text":"嗯......嗯。不管怎么说，如果不是你，我可能已经......","id":90,"figure":"https://media.prts.wiki/7/73/Avg_avg_npc_1918_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#11$1","focus":"r","id":91},{"type":"dialogue","name":"更纱","text":"说实话，我一开始只是听说金石台是御机首屈一指的大电视台，就来随便递份简历养活自己罢了。","id":92,"figure":"https://media.prts.wiki/a/a7/Avg_avg_npc_1900_1-11$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#5$1","focus":"r","id":93},{"type":"dialogue","name":"更纱","text":"但越是在这儿待着，越觉得他们其实有点不像话，只有你这个当家花旦还挺可爱的......结果他们居然连你也不放过！","id":94,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1900_1-5$1.png"},{"type":"dialogue","name":"更纱","text":"尤其是那个三船，他要是个更像样点的家伙，我倒也不是不知道拿钱办事的道理。","id":95,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1900_1-5$1.png"},{"type":"dialogue","name":"更纱","text":"可这家伙......帮这种人做事，还不如让我跳海自尽呢。","id":96,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1900_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#23$1","focus":"l","id":97},{"type":"dialogue","name":"萌萌香","text":"......哈哈。","id":98,"figure":"https://media.prts.wiki/a/a9/Avg_avg_npc_1918_1-23$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#1$1","focus":"r","id":99},{"type":"dialogue","name":"更纱","text":"刚才我从三船的监控网里定位到了星熊的位置，就稍微帮你们连上了一会儿。","id":100,"figure":"https://media.prts.wiki/1/1c/Avg_avg_npc_1900_1-1$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#3$1","focus":"l","id":101},{"type":"dialogue","name":"萌萌香","text":"欸？这也能连上？上次直播的时候，电视台的技术总监连事先设置好的连接都鼓捣了大半天......","id":102,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1918_1-3$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#9$1","focus":"r","id":103},{"type":"dialogue","name":"更纱","text":"那他水平也不怎么样嘛。","id":104,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"dialogue","name":"更纱","text":"总而言之，现在你听我的指示，一会儿我再让你和星熊联络一次，让她在外面接应。","id":105,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#10$1","focus":"r","id":106},{"type":"dialogue","name":"更纱","text":"我们一会儿带上吉星一起走，听我的，保证那些笨蛋黑道连你们的影子都摸不到。","id":107,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_1900_1-10$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#7$1","focus":"l","id":108},{"type":"dialogue","name":"萌萌香","text":"......不，我不能走。","id":109,"figure":"https://media.prts.wiki/d/d2/Avg_avg_npc_1918_1-7$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#5$1","focus":"r","id":110},{"type":"dialogue","name":"更纱","text":"你在说什么蠢话？不走，就在这儿等着三船拿你开刀？","id":111,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1900_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#1$1","focus":"l","id":112},{"type":"dialogue","name":"萌萌香","text":"我走了之后......又能去哪儿呢？","id":113,"figure":"https://media.prts.wiki/7/73/Avg_avg_npc_1918_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#5$1","focus":"r","id":114},{"type":"dialogue","name":"更纱","text":"南院的地盘这么大，你想去哪就去哪啊。","id":115,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1900_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#6$1","focus":"l","id":116},{"type":"dialogue","name":"萌萌香","text":"去改名换姓，当一个永远不知道什么时候会被人追上的逃亡者？我不干。","id":117,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1918_1-6$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#3$1","focus":"l","id":118},{"type":"dialogue","name":"萌萌香","text":"羽生萌萌香这个名字不是我自己选的，但事到如今，才告诉我，要我把这个名字从自己身上剥下去......","id":119,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1918_1-3$1.png"},{"type":"dialogue","name":"萌萌香","text":"那我和死了又有什么区别？","id":120,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1918_1-3$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#5$1","focus":"r","id":121},{"type":"dialogue","name":"更纱","text":"你认真的？我听你这话，怎么听怎么都像是准备赴死哦？你不怕死？","id":122,"figure":"https://media.prts.wiki/2/21/Avg_avg_npc_1900_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#3$1","focus":"l","id":123},{"type":"dialogue","name":"萌萌香","text":"我不知道，我只知道自己已经没有别的活法了。","id":124,"figure":"https://media.prts.wiki/a/a0/Avg_avg_npc_1918_1-3$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#9$1","focus":"r","id":125},{"type":"dialogue","name":"更纱","text":"行，不愧是我喜欢的明星。你刚刚那段话还挺酷的，感觉像是电影里的台词。","id":126,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"dialogue","name":"更纱","text":"那你打算怎么把这个明星当下去？金兵卫不让你当怎么办？","id":127,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#11$1","focus":"l","id":128},{"type":"dialogue","name":"萌萌香","text":"......事到如今，谁还拦在我前面，我就要让那家伙知道，就算是我，被逼到墙角......也是会咬人的。","id":129,"figure":"https://media.prts.wiki/5/5a/Avg_avg_npc_1918_1-11$1.png"},{"type":"dialogue","name":"萌萌香","text":"金兵卫不是捏造了那么多怪谈吗？我要告诉全御机的人，他们被骗了，被一个叫金兵卫的人渣彻头彻尾地骗了。","id":130,"figure":"https://media.prts.wiki/5/5a/Avg_avg_npc_1918_1-11$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#9$1","focus":"r","id":131},{"type":"dialogue","name":"更纱","text":"有点意思。","id":132,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#13$1","focus":"l","id":133},{"type":"dialogue","name":"萌萌香","text":"更纱，你能帮我连接整个御机的电视吗？我要向他们所有人告发金兵卫。","id":134,"figure":"https://media.prts.wiki/c/cb/Avg_avg_npc_1918_1-13$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#1$1","focus":"r","id":135},{"type":"dialogue","name":"更纱","text":"一台一台黑过去，那得弄到什么时候？","id":136,"figure":"https://media.prts.wiki/1/1c/Avg_avg_npc_1900_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#9$1","focus":"r","id":137},{"type":"dialogue","name":"更纱","text":"不过反正他们今天也要搞个什么继位仪式，原本就要向全城直播，我们只要搭个顺风车就好啦。","id":138,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"dialogue","name":"更纱","text":"之前听见有人说你带着断刀什么的，还在你身上吗？在直播的时候能派上用场的。","id":139,"figure":"https://media.prts.wiki/d/d4/Avg_avg_npc_1900_1-9$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_1918_1#13$1","focus":"l","id":140},{"type":"dialogue","name":"萌萌香","text":"我和吉星被金兵卫抓住之后，他手下的第一件事就是把断刀从我身上搜出来......","id":141,"figure":"https://media.prts.wiki/c/cb/Avg_avg_npc_1918_1-13$1.png"},{"type":"dialogue","name":"萌萌香","text":"即便这样，即便没了物证，我也要说。一定要说。","id":142,"figure":"https://media.prts.wiki/c/cb/Avg_avg_npc_1918_1-13$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1900_1#10$1","focus":"r","id":143},{"type":"dialogue","name":"更纱","text":"好！","id":144,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_1900_1-10$1.png"},{"type":"dialogue","name":"更纱","text":"等着我，我去把那个叫吉星的小姑娘也弄过来，再加上电视那边的青鬼，到时候我们一起商量，该怎么好好给三船一个教训！","id":145,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_1900_1-10$1.png"},{"type":"dialog","id":146},{"type":"stopmusic","fadetime":"2","id":147},{"type":"stopsound","channel":"o","fadetime":"2","id":148},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":149},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":150},{"type":"charslot","id":151},{"type":"interlude","channel":"3","clear":"true","id":152},{"type":"background","image":"https://media.prts.wiki/2/24/Avg_bg_64_g13_rooftop.png","screenadapt":"coverall","id":153},{"type":"playsound","key":"$d_avg_snowstormflp","volume":"0","loop":"true","channel":"sn","id":154},{"type":"soundvolume","volume":"1","channel":"sn","fadetime":"2","id":155},{"type":"delay","time":"1","id":156},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":157},{"type":"delay","time":"1","id":158},{"type":"dialogue","name":"森内","text":"你在哪里？","id":159},{"type":"dialogue","name":"森内","text":"你到底在......哪里......","id":160},{"type":"dialog","id":161},{"type":"playsound","key":"$d_avg_clothmovement","volume":"1","id":162},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#2$1","posfrom":"0,-20","posto":"0,0","duration":"1.5","isblock":"true","id":163},{"type":"delay","time":"0.5","id":164},{"type":"dialogue","name":"森内","text":"啧，我怎么睡着了......","id":165,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"dialogue","name":"森内","text":"......","id":166,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#11$1","id":167},{"type":"dialogue","name":"森内","text":"等等，难道神明大人已经？！","id":168,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"charslot","slot":"m","focus":"n","id":169},{"type":"dialogue","name":"？？？","text":"吾辈还没那么性急。","id":170},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#8$1","id":171},{"type":"dialogue","name":"森内","text":"您？！","id":172,"figure":"https://media.prts.wiki/2/28/Avg_avg_4199_makiri_1-8$1.png"},{"type":"dialog","id":173},{"type":"charslot","id":174},{"type":"stopsound","channel":"sn","fadetime":"2","id":175},{"type":"playmusic","key":"https://static.prts.wiki/music/music/act28side/m_avg_saferoom_loop.mp3","volume":"0.6","id":176,"musicid":1},{"type":"text","text":"森内腾的一声坐正。","id":177},{"type":"text","text":"他想回头去看身后的神明，却又不敢，生怕那里其实什么都没有，一切不过是梦中之梦。","id":178},{"type":"text","text":"而他身后开口说话的神明对这样的反应，似乎也颇为满意。","id":179},{"type":"dialog","id":180},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","duration":"1.5","id":181},{"type":"delay","time":"2.5","id":182},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#2$1","id":183},{"type":"dialogue","name":"森内","text":"神明大人......","id":184,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"dialogue","name":"森内","text":"好久......不见。","id":185,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":186},{"type":"dialogue","name":"久违的神明","text":"......","id":187,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#1$1","id":188},{"type":"dialogue","name":"森内","text":"您终于愿意见我了。","id":189,"figure":"https://media.prts.wiki/8/84/Avg_avg_4199_makiri_1-1$1.png"},{"type":"dialogue","name":"森内","text":"当年您让我们家有了钱，不用再过紧巴巴的苦日子，我很感激。","id":190,"figure":"https://media.prts.wiki/8/84/Avg_avg_4199_makiri_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":191},{"type":"dialogue","name":"久违的神明","text":"你花了这么多年寻找吾辈，就是为了道谢？","id":192,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#9$1","id":193},{"type":"dialogue","name":"森内","text":"我当然想向您道谢，可我也一直想问您一件事。","id":194,"figure":"https://media.prts.wiki/4/41/Avg_avg_4199_makiri_1-9$1.png"},{"type":"dialogue","name":"森内","text":"您当年......究竟为什么要离我们而去，为什么我们一家人幸福的生活，最后连一片残渣也没有剩下？","id":195,"figure":"https://media.prts.wiki/4/41/Avg_avg_4199_makiri_1-9$1.png"},{"type":"dialogue","name":"森内","text":"是因为我们做了什么触犯您的事？还是说，命运的力量，就连您也无力阻挡，所以才......干脆对我避而不见？","id":196,"figure":"https://media.prts.wiki/4/41/Avg_avg_4199_makiri_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":197},{"type":"dialogue","name":"久违的神明","text":"......和吾辈有什么关系？","id":198,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#9$1","id":199},{"type":"dialogue","name":"森内","text":"是啊，我也觉得，不该是这样的......","id":200,"figure":"https://media.prts.wiki/4/41/Avg_avg_4199_makiri_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":201},{"type":"dialogue","name":"久违的神明","text":"吾辈是说，你追着吾辈，难道只是为了一个理由？","id":202,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"难道你不是为了能再度把幸福抓在手里，这才无论如何都要跟吾辈见一面的吗？","id":203,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#9$1","id":204},{"type":"dialogue","name":"森内","text":"......","id":205,"figure":"https://media.prts.wiki/4/41/Avg_avg_4199_makiri_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":206},{"type":"dialogue","name":"久违的神明","text":"虽然已经重复到烦了，但你当时还年幼，现在多半已经忘干净了，所以吾辈就耐着性子再说一次。","id":207,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"吾辈从来不会赠予人什么东西。","id":208,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"你就当吾辈喜欢一件事好了。只要这件事发生，吾辈就有可能出现在人的身边。","id":209,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#11$1","id":210},{"type":"dialogue","name":"森内","text":"一件......事？是说“幸福”吗？","id":211,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":212},{"type":"dialogue","name":"久违的神明","text":"当然。","id":213,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"吾辈既不是因为生你的气，也不是因为愧对于你，不过是因为幸福离你而去，这才不见你罢了。","id":214,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"不过，吾辈现在终于有了见你的理由。","id":215,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"此时此刻的你，只要选对了路，就能获得幸福，远超你想象的莫大的幸福。","id":216,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","id":217},{"type":"text","text":"神明的声音一如过去，可森内不知道，是不是自己失去了那份独属于孩子的纯真，这朝思暮想的声音，竟听出了一丝毛骨悚然的意味。","id":218},{"type":"text","text":"是因为听过太多谎言了吗？","id":219},{"type":"text","text":"是的，因为自己听过了太多谎言，就不由自主地将所有美好的承诺都当成了欺骗。","id":220},{"type":"text","text":"但现在不一样。","id":221},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#11$1","id":222},{"type":"dialogue","name":"森内","text":"您......请讲。","id":223,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":224},{"type":"dialogue","name":"久违的神明","text":"你现在正处在一场风暴的中心。","id":225,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"一个叫星熊的鬼，一条叫金兵卫的蛇，还有一条可怜的金鱼，再加上你这头只相信自己鼻子的狼，这些人的命运搅成一团。","id":226,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"哦，还有个可怜的老头，已经被害死了。","id":227,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#8$1","id":228},{"type":"dialogue","name":"森内","text":"铁斋先生？！","id":229,"figure":"https://media.prts.wiki/2/28/Avg_avg_4199_makiri_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":230},{"type":"dialogue","name":"久违的神明","text":"而他一死，你一直心心念念的幸福，终于有了一个能被你抓在手中的机会。","id":231,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#11$1","id":232},{"type":"dialogue","name":"森内","text":"他的死......我的......幸福？您这是什么意思？","id":233,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"dialogue","name":"森内","text":"而且......为什么？铁斋为什么会死？谁杀了他？","id":234,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":235},{"type":"dialogue","name":"久违的神明","text":"这很难猜吗？","id":236,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"你更该问自己的是，这重要吗？","id":237,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"你现在站在一个无数人梦寐以求的位置上，森内彻。你手头有一单大生意。选对了路，你就能得到一切。","id":238,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#8$1","id":239},{"type":"dialogue","name":"森内","text":"您让我......站金兵卫那一边？","id":240,"figure":"https://media.prts.wiki/2/28/Avg_avg_4199_makiri_1-8$1.png"},{"type":"dialogue","name":"森内","text":"金兵卫是个骗子。他不可能放过我。","id":241,"figure":"https://media.prts.wiki/2/28/Avg_avg_4199_makiri_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":242},{"type":"dialogue","name":"久违的神明","text":"所以这才是一单大生意。","id":243,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#11$1","id":244},{"type":"dialogue","name":"森内","text":"......","id":245,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":246},{"type":"dialogue","name":"久违的神明","text":"金兵卫当然是个骗子，但他需要你。更确切地说，金石会需要你。","id":247,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"金石会和金石集团的剥离已经到了最后一步，如果不是出了天大的变故，没有人能拦得住。","id":248,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"一切看似都在金兵卫的计算之内，但事情到了现在，他很快就要力不从心了。","id":249,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"作为一个在锻冶町和仁田街摸爬滚打这么长时间，还活得下来的人，你的器量并不比金兵卫差多少。","id":250,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","id":251},{"type":"text","text":"森内愣住了。","id":252},{"type":"text","text":"他设想过无数种与这位神明再会的场景，却唯独没想过会像今天这样，听祂平静地说出如此......","id":253},{"type":"text","text":"......恐怖的话。","id":254},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#11$1","id":255},{"type":"dialogue","name":"森内","text":"您让我......夺取金兵卫的位置？这就是您所说的幸福？","id":256,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":257},{"type":"dialogue","name":"久违的神明","text":"是啊。","id":258,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#4$1","id":259},{"type":"dialogue","name":"森内","text":"可您是否想过，假如我真的夺走了那个位置，却没能力驾驭......","id":260,"figure":"https://media.prts.wiki/0/00/Avg_avg_4199_makiri_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":261},{"type":"dialogue","name":"久违的神明","text":"但你会得到钱。很多很多的钱。","id":262,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#9$1","id":263},{"type":"dialogue","name":"森内","text":"钱......？","id":264,"figure":"https://media.prts.wiki/4/41/Avg_avg_4199_makiri_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":265},{"type":"dialogue","name":"久违的神明","text":"无论有没有能力，你都会得到钱，一笔也许不如金兵卫捞到的多，但对现在的你而言......难以想象的钱。","id":266,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"钱，不就是幸福吗？","id":267,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"年幼的你，和你的家人，不正是得到了钱吗？","id":268,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"这座御机，这整个国家，不也是得到了钱，才得到了源源不断的幸福吗？","id":269,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"而当钱离你而去的时候，幸福又在哪里呢？","id":270,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#9$1","id":271},{"type":"dialogue","name":"森内","text":"......","id":272,"figure":"https://media.prts.wiki/4/41/Avg_avg_4199_makiri_1-9$1.png"},{"type":"dialogue","name":"森内","text":"这就是......您给我的教诲？","id":273,"figure":"https://media.prts.wiki/4/41/Avg_avg_4199_makiri_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":274},{"type":"dialogue","name":"久违的神明","text":"这不是教诲，只不过是最浅显不过的道理。","id":275,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"dialogue","name":"久违的神明","text":"金兵卫懂，议员懂，生活在御机的几乎所有人都懂。而你......你年幼的时候，不也懂这件事吗？","id":276,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","id":277},{"type":"text","text":"森内只觉得浑身发冷，仿佛夕阳正在它自己放射出的金色光芒中慢慢窒息。","id":278},{"type":"text","text":"那真的是自己年幼时偶遇的神明吗？","id":279},{"type":"text","text":"还是说，这只是一个怪诞的噩梦......不，是有什么东西正在蒙骗自己，好让自己彻底死了寻找神明的心？","id":280},{"type":"text","text":"但，祂的自称，祂说话的方式，甚至祂常说的那句“和吾辈有什么关系”......自己从来没能忘掉过。","id":281},{"type":"text","text":"但为什么，为什么记忆中的祂就连那句冰冷的撇清都像是某种对自己温暖的鼓励，可现在......","id":282},{"type":"text","text":"森内张开嘴，不住地喘息着，却仍觉得自己无法在这冰冷的噩梦中喘上哪怕一口气。","id":283},{"type":"text","text":"于是，他把手伸进口袋，拿出了那串钥匙。","id":284},{"type":"dialog","id":285},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":286},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":287},{"type":"charslot","id":288},{"type":"background","id":289},{"type":"image","image":"https://media.prts.wiki/9/96/Avg_64_i04.png","screenadapt":"coverall","xScale":"1.7","yScale":"1.7","id":290},{"type":"imagetween","yFrom":"250","yTo":"230","duration":"10","block":"false","id":291},{"type":"delay","time":"1","id":292},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":293},{"type":"playsound","key":"$d_avg_slbell","volume":"1","id":294},{"type":"delay","time":"1","id":295},{"type":"text","text":"款式老旧的钥匙上布满了划痕，而钥匙圈上挂着一枚小小的招财猫。","id":296},{"type":"text","text":"它已经陪伴他许多年。","id":297},{"type":"dialog","id":298},{"type":"image","image":"https://media.prts.wiki/9/96/Avg_64_i04.png","screenadapt":"coverall","xScale":"1.05","yScale":"1.05","fadetime":"3","id":299},{"type":"imagetween","xScaleFrom":"1.15","yScaleFrom":"1.15","xScaleTo":"1","yScaleTo":"1","duration":"40","block":"false","id":300},{"type":"delay","time":"1","id":301},{"type":"dialogue","name":"森内","text":"财富就是幸福，是吗？","id":302},{"type":"dialogue","name":"久违的神明","text":"......","id":303},{"type":"dialogue","name":"森内","text":"也许是这样没错。也许我下意识里一直都是这么相信的。","id":304},{"type":"dialogue","name":"森内","text":"可您是否想过，在一切的一切之前，我其实......只把您当成一个朋友，一个有点孤僻的孩子唯一的朋友。","id":305},{"type":"dialogue","name":"森内","text":"在我看来，这个朋友的确给我带来了幸福，我很感激，可我根本无法报答这份幸福。无论我做什么，您都无意接受。","id":306},{"type":"dialogue","name":"森内","text":"所以，当我有段时间没去找您，而您消失不见的时候，我想，那一定是因为，我不仅没有报答，甚至还怠慢了您。","id":307},{"type":"dialogue","name":"森内","text":"我以为，我放弃了唯一的朋友，所以我才落得这样一个下场。我罪有应得。","id":308},{"type":"dialogue","name":"森内","text":"您敢相信吗，之前三船对我威逼利诱的时候，我差点也做了差不多的事。","id":309},{"type":"dialogue","name":"久违的神明","text":"那个鬼？","id":310},{"type":"dialogue","name":"森内","text":"嗯。她来救我的时候，我的五脏六腑都因为愧疚搅成一团，可我仍是什么都没能说出口。","id":311},{"type":"dialogue","name":"森内","text":"但您刚刚告诉我，我完全搞颠倒了，不是您给我带来了幸福，而是幸福来了，您才来到了我身旁，对吗？","id":312},{"type":"dialogue","name":"久违的神明","text":"对。","id":313},{"type":"dialogue","name":"森内","text":"我明白了。您是神明......您只是神明，对吗？","id":314},{"type":"dialogue","name":"森内","text":"抱歉，把神明当朋友，简直狂妄之极，而妄图抓到神明的尾巴，更是痴心妄想。","id":315},{"type":"dialogue","name":"森内","text":"感谢您愿意来见我，愿意告诉我，我这么长时间的人生，完完全全地走到了一条错路上。一条彻头彻尾的错路。","id":316},{"type":"dialogue","name":"森内","text":"一个情报贩子......怎么可能有货真价实的朋友？","id":317},{"type":"dialog","id":318},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":319},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":320},{"type":"charslot","id":321},{"type":"image","id":322},{"type":"gridbg","imagegroup":"47_g15_eveningglow_L1/47_g15_eveningglow_R1/47_g15_eveningglow_L2/47_g15_eveningglow_R2","solidwidth":"1280/1280/1280/1280","solidheight":"720/720/720/720","x":"-640","fadetime":"1","id":323},{"type":"largebgtween","duration":"60","yFrom":"720","yTo":"360","block":"false","id":324},{"type":"delay","time":"1","id":325},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":326},{"type":"delay","time":"1","id":327},{"type":"text","text":"森内举起那串钥匙，把招财猫挂件从钥匙圈上取下来。","id":328},{"type":"text","text":"他端详着那枚挂件，仿佛这样就在和他背后的神明说话。","id":329},{"type":"dialogue","name":"森内","text":"但我还是想要朋友。真正的朋友。","id":330},{"type":"dialogue","name":"森内","text":"我这样说，您能明白吗？您......会生气吗？","id":331},{"type":"dialogue","name":"久违的神明","text":"......","id":332},{"type":"dialogue","name":"森内","text":"如果您没有生气，我甚至还想......不揣冒昧地......和您打一个赌。","id":333},{"type":"text","text":"森内把手伸到前面，伸到没有水泥楼板阻挡的半空之中。","id":334},{"type":"dialogue","name":"森内","text":"如果我照您说的做......","id":335},{"type":"dialogue","name":"森内","text":"这一辈子，我永远也不可能再获得真正的朋友......","id":336},{"type":"dialogue","name":"森内","text":"真正的幸福。","id":337},{"type":"text","text":"他咬着嘴唇，松开颤抖的手。","id":338},{"type":"dialog","id":339},{"type":"playsound","key":"$d_avg_snowstormflp","volume":"0","loop":"true","channel":"sn","id":340},{"type":"soundvolume","volume":"1","channel":"sn","fadetime":"2","id":341},{"type":"playsound","key":"$d_avg_slbell","volume":"1","id":342},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":343},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":344},{"type":"charslot","id":345},{"type":"largebg","id":346},{"type":"text","text":"那枚挂坠就像再普通不过的杂物一样，笔直地向下落去，很快就被橘黄色的夕阳下黑色的街巷吞噬。","id":347},{"type":"dialog","id":348},{"type":"stopmusic","fadetime":"2","id":349},{"type":"background","image":"https://media.prts.wiki/2/24/Avg_bg_64_g13_rooftop.png","screenadapt":"coverall","id":350},{"type":"delay","time":"1","id":351},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":352},{"type":"delay","time":"1","id":353},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#2$1","id":354},{"type":"dialogue","name":"森内","text":"......再见了。","id":355,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1903_1#1$1","bstart":"0.4","bend":"1","id":356},{"type":"dialogue","name":"久违的神明","text":"你要去哪里？","id":357,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1903_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#5$1","id":358},{"type":"dialogue","name":"森内","text":"去找星熊。如果真像你所说，连铁斋都遇害了，我无论如何得去帮星熊一把。","id":359,"figure":"https://media.prts.wiki/9/93/Avg_avg_4199_makiri_1-5$1.png"},{"type":"dialog","id":360},{"type":"charslot","id":361},{"type":"playsound","key":"$d_avg_hastybell","volume":"1","id":362},{"type":"charslot","slot":"m","name":"avg_npc_1904_1#1$2","posfrom":"-200,0","posto":"0,0","duration":"1.5","isblock":"true","id":363},{"type":"delay","time":"0.5","id":364},{"type":"dialogue","name":"好事的神明","text":"她在仁田街的后巷里呢，有间小小神社的那一条。","id":365,"figure":"https://media.prts.wiki/9/9a/Avg_avg_npc_1904_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#8$1","id":366},{"type":"dialogue","name":"森内","text":"欸......欸？","id":367,"figure":"https://media.prts.wiki/2/28/Avg_avg_4199_makiri_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1904_1#1$2","id":368},{"type":"dialogue","name":"好事的神明","text":"欸什么欸，是我！","id":369,"figure":"https://media.prts.wiki/9/9a/Avg_avg_npc_1904_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#8$1","id":370},{"type":"dialogue","name":"森内","text":"招财猫大人，祂——","id":371,"figure":"https://media.prts.wiki/2/28/Avg_avg_4199_makiri_1-8$1.png"},{"type":"charslot","id":372},{"type":"text","text":"森内下意识地回过头去，那里空空如也，仿佛从一开始，就什么都不曾存在过，除了傍晚橘黄色的空气。","id":373},{"type":"text","text":"等他把头转回前方的时候，那位好事的神明正漂浮在他面前的空中。","id":374},{"type":"charslot","slot":"m","name":"avg_npc_1904_1#1$2","id":375},{"type":"dialogue","name":"好事的神明","text":"你拒绝了祂，祂就走了，很奇怪吗？","id":376,"figure":"https://media.prts.wiki/9/9a/Avg_avg_npc_1904_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#11$1","id":377},{"type":"dialogue","name":"森内","text":"那您......又为什么要帮我？","id":378,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1904_1#1$2","id":379},{"type":"dialogue","name":"好事的神明","text":"我才没想帮你。是我们神社的人气王，他说总是吃你的竹轮不好意思，让我有空帮你一把。","id":380,"figure":"https://media.prts.wiki/9/9a/Avg_avg_npc_1904_1$2.png"},{"type":"dialogue","name":"好事的神明","text":"真是的，想帮忙倒是自己来帮啊！","id":381,"figure":"https://media.prts.wiki/9/9a/Avg_avg_npc_1904_1$2.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#2$1","id":382},{"type":"dialogue","name":"森内","text":"......","id":383,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_4199_makiri_1#1$1","id":384},{"type":"dialogue","name":"森内","text":"多谢您来相助，也替我多谢那位......呃......“人气王”？","id":385,"figure":"https://media.prts.wiki/8/84/Avg_avg_4199_makiri_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1904_1#1$2","id":386},{"type":"dialogue","name":"好事的神明","text":"别以为我会帮你打什么架，我就是给你指个路罢了。","id":387,"figure":"https://media.prts.wiki/9/9a/Avg_avg_npc_1904_1$2.png"},{"type":"dialogue","name":"好事的神明","text":"说到底，我们两个可都被三船那混小子狠狠摆了一道啊。","id":388,"figure":"https://media.prts.wiki/9/9a/Avg_avg_npc_1904_1$2.png"},{"type":"dialog","id":389},{"type":"stopsound","channel":"sn","fadetime":"2","id":390},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":391},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":392},{"type":"charslot","id":393},{"type":"background","image":"https://media.prts.wiki/2/2d/Avg_bg_64_g3_jindaalley.png","screenadapt":"coverall","id":394},{"type":"charslot","slot":"r","name":"avg_1044_hsgma2_1#2$1","id":395},{"type":"playmusic","intro":"$darkness01_intro","key":"https://static.prts.wiki/music/music/beta1_180603/m_dia_darkness01_loop.mp3","volume":"0.6","id":396,"musicid":2},{"type":"delay","time":"1","id":397},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":398},{"type":"delay","time":"1","id":399},{"type":"playsound","key":"$d_avg_leathershoes_fts","volume":"0.6","id":400},{"type":"charslot","slot":"l","name":"avg_4199_makiri_1#2$1","duration":"1.5","id":401},{"type":"delay","time":"2","id":402},{"type":"charslot","slot":"l","name":"avg_4199_makiri_1#2$1","focus":"n","id":403},{"type":"charslot","slot":"r","name":"avg_1044_hsgma2_1#2$1","focus":"r","id":404},{"type":"dialogue","name":"星熊","text":"森内老板？","id":405,"figure":"https://media.prts.wiki/2/27/Avg_avg_1044_hsgma2_1-2$1.png"},{"type":"charslot","slot":"l","name":"avg_4199_makiri_1#2$1","focus":"l","id":406},{"type":"dialogue","name":"森内","text":"......","id":407,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"charslot","slot":"r","name":"avg_1044_hsgma2_1#2$1","focus":"r","id":408},{"type":"dialogue","name":"星熊","text":"你来帮我，还是阻止我？","id":409,"figure":"https://media.prts.wiki/2/27/Avg_avg_1044_hsgma2_1-2$1.png"},{"type":"charslot","slot":"l","name":"avg_4199_makiri_1#2$1","focus":"l","id":410},{"type":"dialogue","name":"森内","text":"帮你。","id":411,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"charslot","slot":"r","name":"avg_1044_hsgma2_1#2$1","focus":"r","id":412},{"type":"dialogue","name":"星熊","text":"有余力来帮我，难道你真的找到神明大人了？","id":413,"figure":"https://media.prts.wiki/2/27/Avg_avg_1044_hsgma2_1-2$1.png"},{"type":"charslot","slot":"l","name":"avg_4199_makiri_1#3$1","focus":"l","id":414},{"type":"dialogue","name":"森内","text":"祂很好，比我好得多。但我找到了祂，祂从此就和我再无关系。","id":415,"figure":"https://media.prts.wiki/e/e8/Avg_avg_4199_makiri_1-3$1.png"},{"type":"charslot","slot":"l","name":"avg_4199_makiri_1#2$1","focus":"l","id":416},{"type":"dialogue","name":"森内","text":"萌萌香呢？她没在你身边？","id":417,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"charslot","slot":"r","name":"avg_1044_hsgma2_1#5$1","focus":"r","id":418},{"type":"dialogue","name":"星熊","text":"我正要去救她——","id":419,"figure":"https://media.prts.wiki/7/7a/Avg_avg_1044_hsgma2_1-5$1.png"},{"type":"dialog","id":420},{"type":"charslot","slot":"m","focus":"n","id":421},{"type":"playsound","key":"$d_avg_oldtvelectricity","volume":"0","loop":"true","channel":"o","id":422},{"type":"soundvolume","volume":"1","channel":"o","fadetime":"1","id":423},{"type":"delay","time":"1","id":424},{"type":"dialogue","name":"电视里的声音","text":"森内？是森内吗？","id":425},{"type":"charslot","slot":"l","name":"avg_4199_makiri_1#11$1","focus":"l","id":426},{"type":"dialogue","name":"森内","text":"电视？","id":427,"figure":"https://media.prts.wiki/9/9b/Avg_avg_4199_makiri_1-11$1.png"},{"type":"charslot","slot":"m","focus":"n","id":428},{"type":"dialogue","name":"电视里的声音","text":"是森内老板！萌萌香跟我说了，你做的关东煮全东国不分南北第一好吃。等这件事结了，你可务必让我吃上两口！","id":429},{"type":"charslot","slot":"l","name":"avg_4199_makiri_1#2$1","focus":"l","id":430},{"type":"dialogue","name":"森内","text":"您是哪位？","id":431,"figure":"https://media.prts.wiki/2/24/Avg_avg_4199_makiri_1-2$1.png"},{"type":"charslot","slot":"m","focus":"n","id":432},{"type":"dialogue","name":"电视里的声音","text":"叫我更纱就行。不过现在可不是相互做自我介绍的时候了！","id":433},{"type":"dialogue","name":"电视里的声音","text":"来，萌萌香、吉星，离麦克风近一点！现在是开作战会议的时候了！","id":434},{"type":"dialogue","name":"电视里的声音","text":"为了你们今天的事情能顺利成功，我准备给整个御机一个这~么大的惊喜！","id":435},{"type":"dialog","id":436},{"type":"stopsound","channel":"o","fadetime":"2","id":437},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":438},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":439},{"type":"interlude","channel":"4","clear":"true","id":440},{"type":"stopmusic","fadetime":"2","id":441},{"type":"charslot","id":442},{"type":"background","id":443},{"type":"image","id":444}],"characters":["萌萌香","懈怠的黑道","？？？","更纱","森内","久违的神明","好事的神明","星熊","电视里的声音"]}