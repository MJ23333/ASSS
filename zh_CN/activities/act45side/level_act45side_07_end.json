{"storyMeta":{"storyReviewType":"NONE","storyId":"act45side_level_act45side_07_end","storyGroup":"act45side","storySort":15,"storyDependence":"act45side_level_act45side_07_beg","storyCanShow":1,"storyCode":"SS-7","storyName":"永恒绚烂的藏品","storyPic":null,"storyInfo":"祥子正视了自己的梦境，也产生了犹豫。“母亲”看出了祥子的挣扎，开导并鼓励她离开梦境、寻求真实，祥子和“母亲”做了最后的道别。","storyCanEnter":1,"storyTxt":"activities/act45side/level_act45side_07_end","avgTag":"行动后","unLockType":"STAGE_CLEAR","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act45side_07","minState":"PASS","maxState":"COMPLETE"}],"prev":13,"next":15,"characters":["丰川祥子","母亲","红豆","？？？","爱丽丝","贝娜","“母亲”","“父亲”","母亲&父亲"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":1},{"type":"stopmusic","id":2},{"type":"dialog","id":3},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":4},{"type":"delay","time":"1","id":5},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_comedy_loop.mp3","volume":"0.6","id":6,"musicid":0},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":7},{"type":"delay","time":"0.5","id":8},{"type":"playsound","key":"$d_avg_carcrash_wreck","volume":"0.6","id":9},{"type":"camerashake","duration":"1.5","xstrength":"25","ystrength":"25","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":10},{"type":"delay","time":"2","id":11},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#6$2","focus":"m","id":12},{"type":"dialogue","name":"丰川祥子","text":"妈妈，稍等我一下好吗？","id":13,"figure":"https://media.prts.wiki/0/0B/Avg_avg_4182_oblvns_1-6$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_1941_1#5$1","focus":"m","id":14},{"type":"dialogue","name":"母亲","text":"嗯，去吧。","id":15,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"dialog","id":16},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","text":"","id":17},{"type":"charslot","id":18},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":19},{"type":"delay","time":"0.7","id":20},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1.5","block":"true","id":21},{"type":"delay","time":"1","id":22},{"type":"playsound","key":"$d_avg_runstop","volume":"1","id":23},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#14$2","duration":"0.7","id":24},{"type":"delay","time":"1","id":25},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#14$2","focus":"m","id":26},{"type":"dialogue","name":"丰川祥子","text":"你们还好吗？！","id":27,"figure":"https://media.prts.wiki/D/D9/Avg_avg_4182_oblvns_1-14$2.png"},{"type":"dialog","id":28},{"type":"charslot","id":29},{"type":"delay","time":"0.2","id":30},{"type":"playsound","key":"$d_avg_clothtrailground","volume":"1","id":31},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#5$1","duration":"1","id":32},{"type":"delay","time":"1.5","id":33},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#5$1","focus":"m","id":34},{"type":"dialogue","name":"红豆","text":"唔......还好还好，就是屁股有点痛......","id":35,"figure":"https://media.prts.wiki/C/C1/Avg_avg_290_vigna_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#14$2","focus":"m","id":36},{"type":"dialogue","name":"丰川祥子","text":"刚刚不是还见到了爱丽丝小姐......","id":37,"figure":"https://media.prts.wiki/D/D9/Avg_avg_4182_oblvns_1-14$2.png"},{"type":"dialog","id":38},{"type":"charslot","id":39},{"type":"dialogue","name":"？？？","text":"唔......唔......唔......！","id":40},{"type":"text","text":"麦草垛的深处传来一阵熟悉的声音。","id":41},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#4$1","focus":"m","id":42},{"type":"dialogue","name":"红豆","text":"呃......快把爱丽丝挖出来！","id":43,"figure":"https://media.prts.wiki/7/7E/Avg_avg_290_vigna_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#14$2","focus":"m","id":44},{"type":"dialogue","name":"丰川祥子","text":"好、好的！","id":45,"figure":"https://media.prts.wiki/D/D9/Avg_avg_4182_oblvns_1-14$2.png"},{"type":"dialog","id":46},{"type":"charslot","id":47},{"type":"playsound","key":"$d_avg_hidehaystack","volume":"1","id":48},{"type":"camerashake","duration":"1.5","xstrength":"12","ystrength":"15","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":49},{"type":"delay","time":"2","id":50},{"type":"charslot","slot":"m","name":"avg_338_iris_1#5$1","duration":"0.7","id":51},{"type":"delay","time":"1","id":52},{"type":"charslot","slot":"m","name":"avg_338_iris_1#5$1","focus":"m","id":53},{"type":"dialogue","name":"爱丽丝","text":"（大口喘气）差......差点就要闷死了！","id":54,"figure":"https://media.prts.wiki/D/DB/Avg_avg_338_iris_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#6$2","focus":"m","id":55},{"type":"dialogue","name":"丰川祥子","text":"你们不是还要收集孩子们的愿望吗？为什么会出现在这？","id":56,"figure":"https://media.prts.wiki/0/0B/Avg_avg_4182_oblvns_1-6$2.png"},{"type":"charslot","slot":"m","name":"avg_369_bena_1#10$1","focus":"m","id":57},{"type":"dialogue","name":"贝娜","text":"嘿嘿，工作比想象中顺利得多。这边的孩子们意外地乖巧，所以就提前结束啦。","id":58,"figure":"https://media.prts.wiki/8/81/Avg_avg_369_bena_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#5$1","focus":"m","id":59},{"type":"dialogue","name":"红豆","text":"我本来是想体验体验在乡间开车的感觉，没想到半路出了毛病......","id":60,"figure":"https://media.prts.wiki/C/C1/Avg_avg_290_vigna_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_369_bena_1#11$1","focus":"m","id":61},{"type":"dialogue","name":"贝娜","text":"我也修理过这种载具，我们赶紧一起把它修好吧。","id":62,"figure":"https://media.prts.wiki/B/BE/Avg_avg_369_bena_1-11$1.png"},{"type":"dialog","id":63},{"type":"charslot","duration":"1","id":64},{"type":"delay","time":"1.5","id":65},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#5$1","focus":"m","id":66},{"type":"delay","time":"0.3","id":67},{"type":"charslot","duration":"1","id":68},{"type":"delay","time":"2","id":69},{"type":"charslot","slot":"m","name":"avg_338_iris_1#5$1","focus":"m","id":70},{"type":"dialogue","name":"爱丽丝","text":"唉，也不知道今天是幸运还是倒霉......","id":71,"figure":"https://media.prts.wiki/D/DB/Avg_avg_338_iris_1-5$1.png"},{"type":"dialogue","name":"爱丽丝","text":"本来我还有些担心哪里会出状况。","id":72,"figure":"https://media.prts.wiki/D/DB/Avg_avg_338_iris_1-5$1.png"},{"type":"dialogue","name":"爱丽丝","text":"没想到今天的工作出奇地顺利，更没想到的是，会在这种小事上出现意外。","id":73,"figure":"https://media.prts.wiki/D/DB/Avg_avg_338_iris_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#9$1","focus":"m","id":74},{"type":"dialogue","name":"爱丽丝","text":"但愿能尽快修好吧......这样今晚就能返程了。","id":75,"figure":"https://media.prts.wiki/0/0D/Avg_avg_338_iris_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#6$2","focus":"m","id":76},{"type":"dialogue","name":"丰川祥子","text":"今晚返程......？","id":77,"figure":"https://media.prts.wiki/0/0B/Avg_avg_4182_oblvns_1-6$2.png"},{"type":"stopmusic","fadetime":"2","id":78},{"type":"dialog","id":79},{"type":"charslot","id":80},{"type":"text","text":"祥子转身看向身后。","id":81},{"type":"dialog","id":82},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","text":"","id":83},{"type":"charslot","id":84},{"type":"playmusic","key":"https://static.prts.wiki/music/music/act28side/m_avg_wasteland_loop.mp3","volume":"0.6","id":85,"musicid":1},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":86},{"type":"charslot","slot":"m","name":"avg_npc_1941_1#5$1","focus":"m","id":87},{"type":"delay","time":"0.5","id":88},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1","block":"true","id":89},{"type":"delay","time":"0.5","id":90},{"type":"text","text":"就在不远处，母亲正微笑地看着她和她的伙伴们。","id":91},{"type":"text","text":"她发觉了女儿回眸的视线，于是轻轻地点了点头。","id":92},{"type":"dialog","id":93},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","text":"","id":94},{"type":"charslot","id":95},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":96},{"type":"delay","time":"0.5","id":97},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1","block":"true","id":98},{"type":"delay","time":"0.5","id":99},{"type":"charslot","slot":"m","name":"avg_338_iris_1#10$1","focus":"m","id":100},{"type":"dialogue","name":"爱丽丝","text":"那是......你的母亲？","id":101,"figure":"https://media.prts.wiki/F/FC/Avg_avg_338_iris_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#10$2","focus":"m","id":102},{"type":"dialogue","name":"丰川祥子","text":"......嗯。","id":103,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#2$1","focus":"m","id":104},{"type":"dialogue","name":"爱丽丝","text":"你们长得真像，尤其是眼睛和嘴巴，给人一种既温柔又坚定的感觉。","id":105,"figure":"https://media.prts.wiki/7/7D/Avg_avg_338_iris_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#10$2","focus":"m","id":106},{"type":"dialogue","name":"丰川祥子","text":"......可是我并不坚定。","id":107,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#1$1","focus":"m","id":108},{"type":"dialogue","name":"爱丽丝","text":"为什么这么说？","id":109,"figure":"https://media.prts.wiki/D/D6/Avg_avg_338_iris_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#10$2","focus":"m","id":110},{"type":"dialogue","name":"丰川祥子","text":"因为，我......","id":111,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#12$2","focus":"m","id":112},{"type":"dialogue","name":"丰川祥子","text":"爱丽丝小姐，你是仙女对吧？","id":113,"figure":"https://media.prts.wiki/F/F2/Avg_avg_4182_oblvns_1-12$2.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#1$1","focus":"m","id":114},{"type":"dialogue","name":"爱丽丝","text":"嗯......怎么了？","id":115,"figure":"https://media.prts.wiki/D/D6/Avg_avg_338_iris_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#12$2","focus":"m","id":116},{"type":"dialogue","name":"丰川祥子","text":"仙女会倾听人的愿望，然后将愿望在梦中化为短暂的“现实”......对吧？","id":117,"figure":"https://media.prts.wiki/F/F2/Avg_avg_4182_oblvns_1-12$2.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#3$1","focus":"m","id":118},{"type":"dialogue","name":"爱丽丝","text":"......是的。","id":119,"figure":"https://media.prts.wiki/9/90/Avg_avg_338_iris_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#14$2","focus":"m","id":120},{"type":"dialogue","name":"丰川祥子","text":"可是如果，真的有人在梦境中无法自拔，那又该怎么办？","id":121,"figure":"https://media.prts.wiki/D/D9/Avg_avg_4182_oblvns_1-14$2.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#10$1","focus":"m","id":122},{"type":"dialogue","name":"爱丽丝","text":"真正的仙女，是不会允许这样的事情发生的。","id":123,"figure":"https://media.prts.wiki/F/FC/Avg_avg_338_iris_1-10$1.png"},{"type":"dialogue","name":"爱丽丝","text":"待在梦里的时间过长，最后只会让人分辨不清现实和梦境。","id":124,"figure":"https://media.prts.wiki/F/FC/Avg_avg_338_iris_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#14$2","focus":"m","id":125},{"type":"dialogue","name":"丰川祥子","text":"如果她一直不苏醒呢？","id":126,"figure":"https://media.prts.wiki/D/D9/Avg_avg_4182_oblvns_1-14$2.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#10$1","focus":"m","id":127},{"type":"dialogue","name":"爱丽丝","text":"祥子，最严重的结果从来不是无法苏醒，而是将梦中的一切当作理所应当后，却在某一刻醒来，发现经历的一切全是泡影。","id":128,"figure":"https://media.prts.wiki/F/FC/Avg_avg_338_iris_1-10$1.png"},{"type":"dialogue","name":"爱丽丝","text":"在梦中度过了无比幸福的一生后，却发现自己又回到了现实，一切又回到了原点。","id":129,"figure":"https://media.prts.wiki/F/FC/Avg_avg_338_iris_1-10$1.png"},{"type":"dialogue","name":"爱丽丝","text":"年幼的躯体，苍老的灵魂。梦中的一切都无法抓住，从此只能孑然一身地行于世间。","id":130,"figure":"https://media.prts.wiki/F/FC/Avg_avg_338_iris_1-10$1.png"},{"type":"dialogue","name":"爱丽丝","text":"这样的梦，真的是好的吗？","id":131,"figure":"https://media.prts.wiki/F/FC/Avg_avg_338_iris_1-10$1.png"},{"type":"dialogue","name":"爱丽丝","text":"本该失败的事，就不应靠梦境去逃避；本该错过的人，就应该好好地说声再见。","id":132,"figure":"https://media.prts.wiki/F/FC/Avg_avg_338_iris_1-10$1.png"},{"type":"dialog","id":133},{"type":"charslot","id":134},{"type":"text","text":"祥子再次转身看向身后。","id":135},{"type":"dialog","id":136},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","text":"","id":137},{"type":"charslot","id":138},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":139},{"type":"charslot","slot":"m","name":"avg_npc_1941_1#5$1","focus":"m","id":140},{"type":"delay","time":"0.5","id":141},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1","block":"true","id":142},{"type":"delay","time":"2","id":143},{"type":"dialog","id":144},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","text":"","id":145},{"type":"charslot","id":146},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":147},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#10$2","focus":"m","id":148},{"type":"delay","time":"0.5","id":149},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1","block":"true","id":150},{"type":"delay","time":"1","id":151},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#10$2","focus":"m","id":152},{"type":"dialogue","name":"丰川祥子","text":"......","id":153,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#1$1","focus":"m","id":154},{"type":"dialogue","name":"爱丽丝","text":"我好像说得有些多了......是不是耽误你们母女相聚了？","id":155,"figure":"https://media.prts.wiki/D/D6/Avg_avg_338_iris_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#6$2","focus":"m","id":156},{"type":"dialogue","name":"丰川祥子","text":"......没有的事！","id":157,"figure":"https://media.prts.wiki/0/0B/Avg_avg_4182_oblvns_1-6$2.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#5$1","focus":"m","id":158},{"type":"dialogue","name":"爱丽丝","text":"抱歉，曾经有一个对我而言很重要的人，也问过我同样的问题。","id":159,"figure":"https://media.prts.wiki/D/DB/Avg_avg_338_iris_1-5$1.png"},{"type":"dialog","id":160},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":161},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.7","block":"true","id":162},{"type":"musicvolume","volume":"0.3","fadetime":"1","id":163},{"type":"charslot","id":164},{"type":"background","image":"https://media.prts.wiki/C/C1/Avg_bg_65_g2_dreamcastlehall.png","screenadapt":"coverall","block":"true","id":165},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":166},{"type":"charslot","slot":"m","name":"avg_npc_1942_1#22$1","focus":"m","id":167},{"type":"delay","time":"1","id":168},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.7","block":"true","id":169},{"type":"delay","time":"2","id":170},{"type":"charslot","duration":"0.7","id":171},{"type":"delay","time":"1","id":172},{"type":"dialogue","name":"爱丽丝","text":"那时的我没有给出坚决的答案，最后酿成了无可挽回的错。","id":173},{"type":"dialogue","name":"爱丽丝","text":"所以我才会这么在意这件事情......","id":174},{"type":"dialog","id":175},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":176},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.7","block":"true","id":177},{"type":"charslot","id":178},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":179},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":180},{"type":"delay","time":"1","id":181},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.7","block":"true","id":182},{"type":"musicvolume","volume":"0.6","fadetime":"1","id":183},{"type":"delay","time":"1.5","id":184},{"type":"dialogue","name":"贝娜","text":"喂——","id":185},{"type":"dialog","id":186},{"type":"playsound","key":"$sportscarstart","volume":"0.4","id":187},{"type":"delay","time":"2","id":188},{"type":"dialogue","name":"贝娜","text":"载具终于修好啦——","id":189},{"type":"dialogue","name":"贝娜","text":"红豆，你别碰了！千万别碰！","id":190},{"type":"dialog","id":191},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#6$1","duration":"0.7","id":192},{"type":"delay","time":"1","id":193},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#6$1","focus":"m","id":194},{"type":"dialogue","name":"红豆","text":"唔......","id":195,"figure":"https://media.prts.wiki/0/07/Avg_avg_290_vigna_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#1$1","focus":"m","id":196},{"type":"dialogue","name":"红豆","text":"你们快些上去吧——","id":197,"figure":"https://media.prts.wiki/8/8C/Avg_avg_290_vigna_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_338_iris_1#2$1","focus":"m","id":198},{"type":"dialogue","name":"爱丽丝","text":"祥子小姐，你会跟我们一起回去吗？","id":199,"figure":"https://media.prts.wiki/7/7D/Avg_avg_338_iris_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#10$2","focus":"m","id":200},{"type":"dialogue","name":"丰川祥子","text":"我......","id":201,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"dialog","id":202},{"type":"charslot","id":203},{"type":"text","text":"祥子又一次看向了身后的“母亲”。","id":204},{"type":"dialog","id":205},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","text":"","id":206},{"type":"charslot","id":207},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":208},{"type":"charslot","slot":"m","name":"avg_npc_1941_1#5$1","focus":"m","id":209},{"type":"delay","time":"0.5","id":210},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1","block":"true","id":211},{"type":"delay","time":"1","id":212},{"type":"text","text":"“母亲”依然在那里站着，似乎在等待着什么。","id":213},{"type":"text","text":"在等待她的许诺？还是她的宣判？","id":214},{"type":"text","text":"她只是一直站在那，对自己的女儿报以最温柔的微笑。","id":215},{"type":"dialog","id":216},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","text":"","id":217},{"type":"charslot","id":218},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_31_g3_mini12_farmland.png","screenadapt":"coverall","block":"true","id":219},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#10$2","focus":"m","id":220},{"type":"delay","time":"0.5","id":221},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1","block":"true","id":222},{"type":"delay","time":"0.5","id":223},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#10$2","focus":"m","id":224},{"type":"dialogue","name":"丰川祥子","text":"我......","id":225,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#9$1","focus":"m","id":226},{"type":"dialogue","name":"红豆","text":"......","id":227,"figure":"https://media.prts.wiki/6/6C/Avg_avg_290_vigna_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_290_vigna_1#8$1","focus":"m","id":228},{"type":"dialogue","name":"红豆","text":"没关系的，祥子。你就在家里多待一段时间吧，你最近这么累，也该休休假了。我会和人事部那边打好招呼的。","id":229,"figure":"https://media.prts.wiki/D/D5/Avg_avg_290_vigna_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#1$2","focus":"m","id":230},{"type":"dialogue","name":"丰川祥子","text":"好的......谢谢。","id":231,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"dialog","id":232},{"type":"stopmusic","fadetime":"2","id":233},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":234},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":235},{"type":"charslot","id":236},{"type":"background","image":"https://media.prts.wiki/5/5B/Avg_bg_65_g6_sakikopianoroom.png","screenadapt":"coverall","block":"true","id":237},{"type":"delay","time":"1","id":238},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_calm_loop.mp3","volume":"0.6","id":239,"musicid":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":240},{"type":"delay","time":"0.5","id":241},{"type":"playsound","key":"$d_avg_piano_heavy","id":242},{"type":"playsound","key":"$d_avg_piano_heavy","channel":"a","delay":"1","id":243},{"type":"playsound","key":"$d_avg_piano_heavy","channel":"b","delay":"1.5","id":244},{"type":"delay","time":"2","id":245},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#12$2","duration":"0.7","id":246},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","duration":"0.7","id":247},{"type":"delay","time":"1","id":248},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#12$2","focus":"l","id":249},{"type":"dialogue","name":"丰川祥子","text":"我再试试——","id":250,"figure":"https://media.prts.wiki/F/F2/Avg_avg_4182_oblvns_1-12$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","focus":"r","id":251},{"type":"dialogue","name":"“母亲”","text":"祥子，就先到这里吧。","id":252,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"dialogue","name":"“母亲”","text":"你已经很累了吧，我们来沏点红茶，再慢慢——","id":253,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#10$2","focus":"l","id":254},{"type":"dialogue","name":"丰川祥子","text":"只是因为太紧张了——","id":255,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#6$1","focus":"r","id":256},{"type":"dialogue","name":"“母亲”","text":"不如我们来聊聊天吧。","id":257,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1941_1-6$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#1$2","focus":"l","id":258},{"type":"dialogue","name":"丰川祥子","text":"......","id":259,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","focus":"r","id":260},{"type":"dialogue","name":"“母亲”","text":"刚才那些人，是祥子的朋友吗？","id":261,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#1$2","focus":"l","id":262},{"type":"dialogue","name":"丰川祥子","text":"嗯，大家都是罗德岛的同事，也都是很好的朋友。","id":263,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#7$1","focus":"r","id":264},{"type":"dialogue","name":"“母亲”","text":"罗德岛......","id":265,"figure":"https://media.prts.wiki/6/66/Avg_avg_npc_1941_1-7$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#1$2","focus":"l","id":266},{"type":"dialogue","name":"丰川祥子","text":"嗯，是一家医药公司，有一艘巨大的陆行舰。","id":267,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"dialog","id":268},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":269},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":270},{"type":"charslot","id":271},{"type":"background","image":"https://media.prts.wiki/C/CF/Avg_bg_bg_0_rhodes3.png","screenadapt":"coverall","block":"true","id":272},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":273},{"type":"delay","time":"0.5","id":274},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":275},{"type":"delay","time":"0.5","id":276},{"type":"dialogue","name":"丰川祥子","text":"我们在舰船上工作和生活，去往这个世界的任何地方。","id":277},{"type":"dialog","id":278},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":279},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.7","block":"true","id":280},{"type":"charslot","id":281},{"type":"background","image":"https://media.prts.wiki/5/5B/Avg_bg_65_g6_sakikopianoroom.png","screenadapt":"coverall","block":"true","id":282},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":283},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#1$2","id":284},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#7$1","id":285},{"type":"delay","time":"0.5","id":286},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":287},{"type":"delay","time":"1","id":288},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#7$1","focus":"r","id":289},{"type":"dialogue","name":"“母亲”","text":"......世界？","id":290,"figure":"https://media.prts.wiki/6/66/Avg_avg_npc_1941_1-7$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#1$2","focus":"l","id":291},{"type":"dialogue","name":"丰川祥子","text":"......泰拉。","id":292,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","focus":"r","id":293},{"type":"dialogue","name":"“母亲”","text":"真是有意思的说法呢~","id":294,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#1$2","focus":"l","id":295},{"type":"dialogue","name":"丰川祥子","text":"......","id":296,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","focus":"r","id":297},{"type":"dialogue","name":"“母亲”","text":"罗德岛上，有能供人练琴的琴房吗？","id":298,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#1$2","focus":"l","id":299},{"type":"dialogue","name":"丰川祥子","text":"有，巡航期间没有那么多娱乐活动，很多干员都会玩些乐器来打发时间。","id":300,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"dialogue","name":"丰川祥子","text":"我有时也会在宿舍里用便携电子琴弹两首曲子。红豆还会组建自己的乐队——","id":301,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","focus":"r","id":302},{"type":"dialogue","name":"“母亲”","text":"那祥子有组建自己的乐队吗？","id":303,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#6$2","focus":"l","id":304},{"type":"dialogue","name":"丰川祥子","text":"......","id":305,"figure":"https://media.prts.wiki/0/0B/Avg_avg_4182_oblvns_1-6$2.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#10$2","focus":"l","id":306},{"type":"dialogue","name":"丰川祥子","text":"有。","id":307,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","focus":"r","id":308},{"type":"dialogue","name":"“母亲”","text":"是和红豆小姐一起？","id":309,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#10$2","focus":"l","id":310},{"type":"dialogue","name":"丰川祥子","text":"不是的，是和其他人......","id":311,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","focus":"r","id":312},{"type":"dialogue","name":"“母亲”","text":"妈妈有点好奇，和祥子一起组乐队的人会是什么样的呢？","id":313,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#10$2","focus":"l","id":314},{"type":"dialogue","name":"丰川祥子","text":"......","id":315,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"dialog","id":316},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":317},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":318},{"type":"charslot","id":319},{"type":"image","image":"https://media.prts.wiki/B/B3/Avg_65_i01_1.png","screenadapt":"coverall","xScale":"1.5","yScale":"1.5","fadetime":"0","x":"310","y":"-90","id":320},{"type":"delay","time":"1","id":321},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":322},{"type":"delay","time":"1","id":323},{"type":"dialogue","name":"丰川祥子","text":"有一个虽然总和我意见不合，但是很有上进心的努力派鼓手，我们比起朋友，更像是战友。","id":324},{"type":"dialogue","name":"丰川祥子","text":"有一个技术高超的贝斯手，总是认真地为大家做好日程管理之类的幕后工作，作为工作伙伴十分值得信任。","id":325},{"type":"dialogue","name":"丰川祥子","text":"有一个擅长作词的吉他手兼主唱，她明明还有自己的偶像工作要做，但即使忙碌，也一直支持着我。","id":326},{"type":"dialogue","name":"丰川祥子","text":"还有一位吉他手，我们从小就是很好的朋友，在......在我离开家一个人时，总会陪着我......","id":327},{"type":"dialogue","name":"“母亲”","text":"听起来，你们是一个亲密无间的团体。","id":328},{"type":"dialogue","name":"丰川祥子","text":"不，实际上我们总是吵架，甚至乐队还解散过。","id":329},{"type":"dialogue","name":"“母亲”","text":"那你们现在有和好如初吗？","id":330},{"type":"dialogue","name":"丰川祥子","text":"......","id":331},{"type":"dialogue","name":"丰川祥子","text":"我和她们走散了。","id":332},{"type":"dialogue","name":"丰川祥子","text":"她们在很远很远的地方，我没法去到的地方。","id":333},{"type":"dialogue","name":"“母亲”","text":"有多远？从维多利亚到乌萨斯？还是更远？","id":334},{"type":"dialog","id":335},{"type":"background","image":"https://media.prts.wiki/5/5B/Avg_bg_65_g6_sakikopianoroom.png","screenadapt":"coverall","fadetime":"0","block":"true","id":336},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#10$2","id":337},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","id":338},{"type":"delay","time":"0.5","id":339},{"type":"dialog","id":340},{"type":"image","fadetime":"1.5","block":"true","id":341},{"type":"delay","time":"2","id":342},{"type":"stopmusic","fadetime":"2","id":343},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#10$2","focus":"l","id":344},{"type":"dialogue","name":"丰川祥子","text":"我......","id":345,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#7$1","focus":"r","id":346},{"type":"dialogue","name":"“母亲”","text":"为什么犹豫了？","id":347,"figure":"https://media.prts.wiki/6/66/Avg_avg_npc_1941_1-7$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#10$2","focus":"l","id":348},{"type":"dialogue","name":"丰川祥子","text":"因为......因为......","id":349,"figure":"https://media.prts.wiki/3/33/Avg_avg_4182_oblvns_1-10$2.png"},{"type":"dialog","id":350},{"type":"delay","time":"1","id":351},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#7$2","focus":"l","id":352},{"type":"dialogue","name":"丰川祥子","text":"......我害怕我去找她们的话，就要离开你们。","id":353,"figure":"https://media.prts.wiki/9/93/Avg_avg_4182_oblvns_1-7$2.png"},{"type":"dialogue","name":"丰川祥子","text":"我害怕再也见不到你——","id":354,"figure":"https://media.prts.wiki/9/93/Avg_avg_4182_oblvns_1-7$2.png"},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","focus":"r","id":355},{"type":"dialogue","name":"“母亲”","text":"傻孩子，我一直都在呀。","id":356,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#8$2","focus":"l","id":357},{"type":"playmusic","intro":"$distressed_intro","key":"https://static.prts.wiki/music/music/act9d0d0/m_avg_distressed_loop.mp3","volume":"0.6","id":358,"musicid":3},{"type":"dialogue","name":"丰川祥子","text":"可是，你不是离开我了吗？！","id":359,"figure":"https://media.prts.wiki/9/98/Avg_avg_4182_oblvns_1-8$2.png"},{"type":"dialog","id":360},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":361},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":362},{"type":"charslot","id":363},{"type":"background","image":"https://media.prts.wiki/B/BB/Avg_bg_bg_ltroom.png","screenadapt":"coverall","block":"true","id":364},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":365},{"type":"bg","duration":"0.1","from":"0","to":"1","block":"true","id":366},{"type":"delay","time":"1","id":367},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":368},{"type":"delay","time":"1","id":369},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":370},{"type":"blocker","a":"0.4","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":371},{"type":"subtitle","text":"“妈......麻麻......”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":372},{"type":"subtitle","text":"“亲爱的，祥子她......她在叫我啊......”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":373},{"type":"subtitle","text":"“麻麻......麻麻......”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":374},{"type":"subtitle","text":"“祥子，祥子！也叫叫我！”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":375},{"type":"subtitle","text":"“爸......麻麻......”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":376},{"type":"subtitle","text":"“啊啊啊啊啊啊——”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":377},{"type":"subtitle","id":378},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":379},{"type":"delay","time":"1","id":380},{"type":"dialog","id":381},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":382},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":383},{"type":"charslot","id":384},{"type":"background","image":"https://media.prts.wiki/5/5B/Avg_bg_65_g6_sakikopianoroom.png","screenadapt":"coverall","block":"true","id":385},{"type":"delay","time":"1","id":386},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":387},{"type":"delay","time":"1","id":388},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":389},{"type":"blocker","a":"0.4","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":390},{"type":"subtitle","text":"“嗯，先按这个键，再按这个键......”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":391},{"type":"subtitle","text":"“啊！这样就能弹出跟妈妈弹得一样的音了！”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":392},{"type":"subtitle","text":"“嗯嗯！祥子真厉害！”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":393},{"type":"subtitle","text":"“祥子想一直跟妈妈学弹琴！想多陪陪妈妈！”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":394},{"type":"subtitle","text":"“......嗯。我们要一直在一起。”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":395},{"type":"subtitle","id":396},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":397},{"type":"delay","time":"1","id":398},{"type":"dialog","id":399},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":400},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":401},{"type":"charslot","id":402},{"type":"background","image":"https://media.prts.wiki/E/E1/Avg_bg_33_g5_srcpark.png","screenadapt":"coverall","block":"true","id":403},{"type":"delay","time":"1","id":404},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":405},{"type":"delay","time":"1","id":406},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":407},{"type":"blocker","a":"0.4","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":408},{"type":"subtitle","text":"“瑞穗走得太早了......”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":409},{"type":"subtitle","text":"“不过得了这种病，她坚持得算久的了。”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":410},{"type":"subtitle","text":"......","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":411},{"type":"subtitle","text":"“妈妈......”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":412},{"type":"subtitle","text":"“祥子，爸爸会努力让你幸福的。”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":413},{"type":"subtitle","id":414},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":415},{"type":"delay","time":"1","id":416},{"type":"dialog","id":417},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":418},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":419},{"type":"charslot","id":420},{"type":"background","image":"https://media.prts.wiki/8/8F/Avg_bg_64_g2_jindastreet_n.png","screenadapt":"coverall","block":"true","id":421},{"type":"delay","time":"1","id":422},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":423},{"type":"delay","time":"1","id":424},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":425},{"type":"blocker","a":"0.4","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":426},{"type":"subtitle","text":"“父亲......为什么要酗酒？”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":427},{"type":"subtitle","text":"“祥子......爸爸会努力的......”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":428},{"type":"subtitle","id":429},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":430},{"type":"delay","time":"1","id":431},{"type":"dialog","id":432},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":433},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":434},{"type":"charslot","id":435},{"type":"background","image":"https://media.prts.wiki/F/F8/Avg_bg_bg_indoor_u.png","screenadapt":"coverall","block":"true","id":436},{"type":"delay","time":"1","id":437},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":438},{"type":"delay","time":"1","id":439},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":440},{"type":"blocker","a":"0.4","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":441},{"type":"subtitle","text":"“我已经......没法努力了。”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":442},{"type":"subtitle","id":443},{"type":"sticker","id":444,"multi":"true","text":"“爸爸，看到现在的你，妈妈一定会伤心的！”","x":"300","y":"300","alignment":"center","size":"24","delay":"0.04","width":"700","block":"true"},{"type":"sticker","id":445,"multi":"true","text":"\\n\\n“妈妈不是说过吗......”","block":"true"},{"type":"sticker","id":446},{"type":"subtitle","text":"“烦死了！”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":447},{"type":"subtitle","id":448},{"type":"playsound","key":"$bottlebroken","volume":"1","id":449},{"type":"delay","time":"1","id":450},{"type":"subtitle","text":"“祥子，求求你......不要再管我了。”","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":451},{"type":"subtitle","id":452},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":453},{"type":"delay","time":"1","id":454},{"type":"dialog","id":455},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":456},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":457},{"type":"charslot","id":458},{"type":"background","image":"https://media.prts.wiki/8/8A/Avg_bg_bg_black.png","screenadapt":"coverall","block":"true","id":459},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":460},{"type":"delay","time":"1","id":461},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":462},{"type":"subtitle","text":"妈妈，我知道的，我一直都知道的。","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":463},{"type":"subtitle","text":"我不应该待在这里，这里不是我的世界。","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":464},{"type":"subtitle","text":"美好的梦境不可能一直延续，终有一天，我还是会离开你。","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":465},{"type":"subtitle","text":"可是、可是——","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":466},{"type":"subtitle","text":"我多么希望，这个离别的时刻能晚些到来......","x":"300","y":"370","alignment":"center","size":"24","delay":"0.04","width":"700","id":467},{"type":"subtitle","id":468},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":469},{"type":"dialog","id":470},{"type":"stopmusic","fadetime":"2","id":471},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":472},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":473},{"type":"charslot","id":474},{"type":"background","image":"https://media.prts.wiki/5/5B/Avg_bg_65_g6_sakikopianoroom.png","screenadapt":"coverall","block":"true","id":475},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#8$2","focus":"m","id":476},{"type":"bg","duration":"0.1","from":"1","to":"0","block":"true","id":477},{"type":"delay","time":"1","id":478},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":479},{"type":"delay","time":"1","id":480},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#8$2","afrom":"1","ato":"0","duration":"0.7","id":481},{"type":"delay","time":"1","id":482},{"type":"playsound","key":"$d_avg_magicchange","volume":"1","id":483},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#8$1","duration":"1","id":484},{"type":"delay","time":"2.5","id":485},{"type":"dialog","id":486},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":487},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":488},{"type":"charslot","id":489},{"type":"image","image":"https://media.prts.wiki/3/3C/Avg_65_i10_1.png","screenadapt":"coverall","block":"true","id":490},{"type":"delay","time":"2","id":491},{"type":"playmusic","intro":"$storyendjp_intro","key":"https://static.prts.wiki/music/music/act5d0/m_avg_storyendjp_loop.mp3","volume":"0.6","id":492,"musicid":4},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"4","block":"true","id":493},{"type":"delay","time":"2","id":494},{"type":"text","text":"温暖的体温，真切的呼吸。","id":495},{"type":"text","text":"妈妈温柔地注视着祥子。","id":496},{"type":"dialogue","name":"“母亲”","text":"对不起，祥子......妈妈对你撒谎了。","id":497},{"type":"dialogue","name":"丰川祥子","text":"欸......？","id":498},{"type":"dialogue","name":"“母亲”","text":"你早就知道，我不是你真正的妈妈了吧？","id":499},{"type":"dialogue","name":"“母亲”","text":"对不起，妈妈一直在小心地维护着这个小小的谎言。","id":500},{"type":"dialogue","name":"“母亲”","text":"其实我根本没有参加过你的高中入学典礼。在你问我以前，我记忆中的你还是一个初中生。","id":501},{"type":"dialogue","name":"“母亲”","text":"而我也不知为何，最近我眼里的祥子，即使在开心地笑着，身边依然萦绕着一层阴云......","id":502},{"type":"dialogue","name":"“母亲”","text":"祥子，从什么时候开始，会有这样的表情了？","id":503},{"type":"dialogue","name":"“母亲”","text":"在我不知道的这段时间里，你到底经历了什么痛苦呢？","id":504},{"type":"dialogue","name":"丰川祥子","text":"我......我......","id":505},{"type":"dialogue","name":"“母亲”","text":"对不起，关于这些，妈妈都一无所知。我唯一知晓的是，在你最痛苦的时候，我却没能陪伴在你的身边。","id":506},{"type":"dialogue","name":"“母亲”","text":"祥子，能见到你，妈妈真的、真的很开心。","id":507},{"type":"dialogue","name":"“母亲”","text":"妈妈真的、真的很想看着你长大。","id":508},{"type":"dialogue","name":"“母亲”","text":"我也很想站在台下，亲眼看看你的演出。","id":509},{"type":"dialogue","name":"“母亲”","text":"你新认识的那些朋友......我也很想见见她们。","id":510},{"type":"dialogue","name":"“母亲”","text":"妈妈很贪心，想知道关于你的一切，想一直陪伴在你的身边。","id":511},{"type":"dialogue","name":"“母亲”","text":"但正因为我是你的妈妈，正因为我深爱着你......","id":512},{"type":"dialogue","name":"“母亲”","text":"所以才想让你离开这里，去寻找你自己真正的生活。","id":513},{"type":"dialogue","name":"“母亲”","text":"祥子，离开吧。","id":514},{"type":"dialogue","name":"“母亲”","text":"回到你的“世界”去。","id":515},{"type":"dialogue","name":"丰川祥子","text":"妈妈......！","id":516},{"type":"dialog","id":517},{"type":"playsound","key":"$d_avg_cloakmovement","volume":"1","id":518},{"type":"image","image":"https://media.prts.wiki/0/0F/Avg_65_i10_2.png","screenadapt":"coverall","fadetime":"1.5","block":"true","id":519},{"type":"delay","time":"2","id":520},{"type":"text","text":"奔涌的情感终于止不住地决堤，祥子将头埋入母亲的怀中，嚎啕大哭。","id":521},{"type":"text","text":"而母亲只是轻拍女儿的背，喃喃地安抚，就像她以前经常做的那样。","id":522},{"type":"dialog","id":523},{"type":"delay","time":"1.5","id":524},{"type":"stopmusic","fadetime":"2","id":525},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":526},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":527},{"type":"charslot","id":528},{"type":"image","id":529},{"type":"background","image":"https://media.prts.wiki/B/B6/Avg_bg_65_g5_sakikodininghall.png","screenadapt":"coverall","block":"true","id":530},{"type":"delay","time":"2","id":531},{"type":"playmusic","intro":"$warm_intro","key":"https://static.prts.wiki/music/music/act9d0d0/m_avg_warm_loop.mp3","volume":"0.6","id":532,"musicid":5},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":533},{"type":"delay","time":"0.5","id":534},{"type":"playsound","key":"$d_avg_woodenstairfts","volume":"1","loop":"true","channel":"w","id":535},{"type":"stopsound","channel":"w","fadetime":"2","id":536},{"type":"charslot","slot":"l","name":"avg_4182_oblvns_1#1$2","duration":"1","id":537},{"type":"charslot","slot":"r","name":"avg_npc_1941_1#5$1","duration":"1","id":538},{"type":"delay","time":"2","id":539},{"type":"dialog","id":540},{"type":"charslot","id":541},{"type":"charslot","slot":"m","name":"avg_npc_1940_1#7$1","focus":"m","id":542},{"type":"dialogue","name":"“父亲”","text":"欸？祥子，你又要出门吗？","id":543,"figure":"https://media.prts.wiki/4/4D/Avg_avg_npc_1940_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1941_1#5$1","focus":"m","id":544},{"type":"dialogue","name":"“母亲”","text":"祥子接下来有重要的事要做。","id":545,"figure":"https://media.prts.wiki/8/89/Avg_avg_npc_1941_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1940_1#3$1","focus":"m","id":546},{"type":"dialogue","name":"“父亲”","text":"这才回家多久，不能再多留一会吗......","id":547,"figure":"https://media.prts.wiki/E/E7/Avg_avg_npc_1940_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1941_1#6$1","focus":"m","id":548},{"type":"dialogue","name":"“母亲”","text":"......亲爱的。","id":549,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1941_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1940_1#5$1","focus":"m","id":550},{"type":"dialogue","name":"“父亲”","text":"我明白了！","id":551,"figure":"https://media.prts.wiki/0/06/Avg_avg_npc_1940_1-5$1.png"},{"type":"dialog","id":552},{"type":"charslot","duration":"0.5","id":553},{"type":"delay","time":"0.7","id":554},{"type":"charslot","slot":"l","name":"avg_npc_1941_1#5$1","focus":"all","id":555},{"type":"delay","time":"0.2","id":556},{"type":"charslot","slot":"r","name":"avg_npc_1940_1#5$1","posfrom":"100,0","posto":"0,0","duration":"1","isblock":"true","id":557},{"type":"delay","time":"1","id":558},{"type":"charslot","slot":"r","name":"avg_npc_1940_1#5$1","focus":"r","id":559},{"type":"dialogue","name":"“父亲”","text":"祥子，我已经和你妈妈统一战线了！","id":560,"figure":"https://media.prts.wiki/0/06/Avg_avg_npc_1940_1-5$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_1940_1#3$1","focus":"r","id":561},{"type":"dialogue","name":"“父亲”","text":"（哭腔）就是......就是......你在外面一定要记得好好吃饭哦！","id":562,"figure":"https://media.prts.wiki/E/E7/Avg_avg_npc_1940_1-3$1.png"},{"type":"dialog","id":563},{"type":"charslot","id":564},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#11$2","focus":"m","id":565},{"type":"dialogue","name":"丰川祥子","text":"嗯，我知道啦。","id":566,"figure":"https://media.prts.wiki/4/4C/Avg_avg_4182_oblvns_1-11$2.png"},{"type":"charslot","slot":"m","name":"avg_4182_oblvns_1#1$2","focus":"m","id":567},{"type":"dialogue","name":"丰川祥子","text":"那......我就出门了。","id":568,"figure":"https://media.prts.wiki/0/03/Avg_avg_4182_oblvns_1-1$2.png"},{"type":"dialog","id":569},{"type":"charslot","id":570},{"type":"charslot","slot":"l","name":"avg_npc_1941_1#5$1","focus":"all","id":571},{"type":"charslot","slot":"r","name":"avg_npc_1940_1#5$1","focus":"all","id":572},{"type":"dialogue","name":"母亲&父亲","text":"嗯！","id":573},{"type":"charslot","slot":"l","name":"avg_npc_1941_1#6$1","focus":"all","id":574},{"type":"charslot","slot":"r","name":"avg_npc_1940_1#6$1","focus":"all","id":575},{"type":"dialogue","name":"母亲&父亲","text":"祥子，一路顺风——","id":576},{"type":"dialog","id":577},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":578},{"type":"stopmusic","fadetime":"2","id":579},{"type":"charslot","id":580},{"type":"image","id":581}],"characters":["丰川祥子","母亲","红豆","？？？","爱丽丝","贝娜","“母亲”","“父亲”","母亲&父亲"]}