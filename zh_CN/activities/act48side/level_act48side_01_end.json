{"storyMeta":{"storyReviewType":"NONE","storyId":"act48side_level_act48side_01_end","storyGroup":"act48side","storySort":3,"storyDependence":"act48side_level_act48side_01_beg","storyCanShow":1,"storyCode":"ME-1","storyName":"工作与时日","storyPic":null,"storyInfo":"在缇缇的提议下，工地上争吵的双方解决了纠纷。一切顺利，但原本应该帮大家统筹与调解的帕拉斯人在哪里？","storyCanEnter":1,"storyTxt":"activities/act48side/level_act48side_01_end","avgTag":"行动后","unLockType":"BY_START_TIME","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act48side_01","minState":"PASS","maxState":"COMPLETE"}],"prev":1,"next":3,"characters":["果农代表","工匠代表","缇缇","米奥","清醒的工匠","工匠代表&果农代表","赞索斯","卡珊卓拉","工匠","帕拉斯"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","duration":"0","block":"true","id":1},{"type":"stopmusic","id":2},{"type":"dialog","id":3},{"type":"delay","time":"1","id":4},{"type":"background","image":"https://media.prts.wiki/6/68/Avg_bg_69_g7_firsttemple.png","screenadapt":"coverall","id":5},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","duration":"1","block":"true","id":6},{"type":"playmusic","intro":"$farce_intro","key":"https://static.prts.wiki/music/music/a001/m_dia_farce_loop.mp3","volume":"0.6","id":7,"musicid":0},{"type":"playsound","key":"$d_avg_crwddiscuss_inside","channel":"1","loop":"true","volume":"0.7","id":8},{"type":"delay","time":"2","id":9},{"type":"camerashake","duration":"0.5","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":10},{"type":"dialogue","name":"果农代表","text":"搬不搬！","id":11},{"type":"dialogue","name":"工匠代表","text":"不搬！","id":12},{"type":"dialogue","name":"工匠代表","text":"搬不搬！","id":13},{"type":"camerashake","duration":"0.5","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":14},{"type":"dialogue","name":"果农代表","text":"不！搬！","id":15},{"type":"dialog","id":16},{"type":"playsound","key":"$d_gen_walk_n","id":17},{"type":"charslot","slot":"l","name":"avg_npc_1482_1#1$1","duration":"1","id":18},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#3$2","duration":"1","id":19},{"type":"delay","time":"2","id":20},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#3$2","focus":"r","id":21},{"type":"dialogue","name":"缇缇","text":"好、好有气势的辩论！不愧是传承英雄血脉的米诺斯人！","id":22,"figure":"https://media.prts.wiki/6/61/Avg_avg_4056_titi_1-3$2.png"},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#5$2","focus":"r","id":23},{"type":"dialogue","name":"缇缇","text":"呃……就是没什么实质内容。","id":24,"figure":"https://media.prts.wiki/f/f9/Avg_avg_4056_titi_1-5$2.png"},{"type":"charslot","slot":"l","name":"avg_npc_1482_1#1$1","focus":"l","id":25},{"type":"dialogue","name":"米奥","text":"两边都在扯着嗓子大喊，根本不知道他们在吵什么。","id":26,"figure":"https://media.prts.wiki/d/d5/Avg_avg_npc_1482_1-1$1.png"},{"type":"dialog","id":27},{"type":"charslot","id":28},{"type":"charslot","slot":"m","name":"avg_npc_2074_1#1$1","focus":"m","id":29},{"type":"dialogue","name":"清醒的工匠","text":"在雅赛努斯航线修改一事上，果农跟我们神殿的工人积怨已久，都在气头上。","id":30,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"dialogue","name":"清醒的工匠","text":"唉，真是惭愧，怎么能让随便拉来的游客来解决我们自己人的纠纷，他们吵的连我都听不明白……","id":31,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"dialog","id":32},{"type":"charslot","id":33},{"type":"charslot","slot":"l","name":"avg_npc_1482_1#1$1","focus":"r","id":34},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#5$2","focus":"r","id":35},{"type":"delay","time":"1.5","id":36},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#3$2","focus":"r","id":37},{"type":"effect","name":"$e_emoji_proud","layer":"1","x":"250","y":"150","id":38},{"type":"delay","time":"1","id":39},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#8$2","focus":"r","id":40},{"type":"dialogue","name":"缇缇","text":"如果只是要听明白，哼哼……","id":41,"figure":"https://media.prts.wiki/a/ab/Avg_avg_4056_titi_1-8$2.png"},{"type":"charslot","slot":"l","name":"avg_npc_1482_1#1$1","focus":"l","id":42},{"type":"dialogue","name":"米奥","text":"缇缇，别给自己找麻烦。","id":43,"figure":"https://media.prts.wiki/d/d5/Avg_avg_npc_1482_1-1$1.png"},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#8$2","focus":"r","id":44},{"type":"dialogue","name":"缇缇","text":"“随便拉来的游客”刚好想到了一个办法。","id":45,"figure":"https://media.prts.wiki/a/ab/Avg_avg_4056_titi_1-8$2.png"},{"type":"dialog","id":46},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":47},{"type":"charslot","slot":"r","posfrom":"0,0","posto":"200,0","afrom":"1","ato":"0","duration":"1.5","id":48},{"type":"delay","time":"2.5","id":49},{"type":"dialog","id":50},{"type":"charslot","id":51},{"type":"charslot","slot":"m","name":"avg_npc_2074_1#1$1","focus":"m","id":52},{"type":"dialogue","name":"清醒的工匠","text":"哎！小姑娘别往吵架的人堆里跑啊，当心被他们伤着！","id":53,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"dialog","id":54},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"2","block":"true","id":55},{"type":"charslot","id":56},{"type":"playsound","key":"$d_avg_smashtable","volume":"1","channel":"2","id":57},{"type":"delay","time":"0.5","id":58},{"type":"playsound","key":"$d_avg_bowl_smash","volume":"1","channel":"4","id":59},{"type":"image","image":"https://media.prts.wiki/f/f6/Avg_69_i03.png","id":60},{"type":"imagetween","xScaleFrom":"1","yScaleFrom":"1","xScaleTo":"0.8","yScaleTo":"0.8","duration":"45","block":"false","id":61},{"type":"delay","time":"1.5","id":62},{"type":"playsound","key":"$d_avg_cnstrctnck","volume":"1","id":63},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"2","block":"true","id":64},{"type":"text","text":"神殿的工匠代表和庇护果农的义务兵各执一词、面红耳赤，丝毫没注意到一对黑色的尖耳朵从石桌下探了出来。","id":65},{"type":"text","text":"小个子菲林女孩一跃而出，笑眯眯地拉过两人的手，把他们的手交握在一起。","id":66},{"type":"text","text":"事件核心的双方代表一时没反应过来，被她扯得失去重心，双双趴在石桌上，齐齐看向这个开朗的外乡人。","id":67},{"type":"dialogue","name":"工匠代表","text":"这是谁带来的小女孩，跑到神殿来过家家吗！","id":68},{"type":"dialogue","name":"果农代表","text":"哈，你的无理取闹连外邦人都看不下去了，真丢雅赛努斯人的脸。","id":69},{"type":"dialogue","name":"工匠代表","text":"别趁机火上浇油！","id":70},{"type":"dialogue","name":"工匠代表","text":"喂，这是我们米诺斯人的事，不需要一个啥都不懂的外国小姑娘教我们怎么和好。","id":71},{"type":"dialogue","name":"缇缇","text":"谁说要让你们和好了？","id":72},{"type":"dialogue","name":"工匠代表&果农代表","text":"啊？","id":73},{"type":"dialogue","name":"缇缇","text":"不直面问题，是没办法解决问题的。就算现在重修旧好，又能维持多久呢？","id":74},{"type":"dialogue","name":"缇缇","text":"再说了，入乡随俗。米诺斯盛传激昂的英雄史诗和动人的故事，它们记载了无数前人的智慧，哪需要我教各位怎么解决问题？","id":75},{"type":"dialogue","name":"缇缇","text":"相传米诺斯最善战的英雄海格斯武艺高超，令所有外敌闻风丧胆。","id":76},{"type":"dialogue","name":"缇缇","text":"但面对米诺斯同乡，哪怕对方再冒犯，他也不会直接出手，而是以扳手腕的方式点到为止。","id":77},{"type":"dialogue","name":"工匠代表","text":"效仿英雄用力气定输赢？不错，省了那些口舌之辩！","id":78},{"type":"dialogue","name":"缇缇","text":"我还没说完。","id":79},{"type":"dialogue","name":"缇缇","text":"又相传，有一位沉默的英雄，他年轻时热情而大胆，曾是被鲜花簇拥的飞扬少年。","id":80},{"type":"dialogue","name":"缇缇","text":"但命运让他知晓了一个不应让任何人知道的秘密，从此他缄口不言，沉默了三十年。","id":81},{"type":"dialogue","name":"工匠代表","text":"等等，大力神海格斯的传说耳熟能详，但“沉默的英雄”？少诓我们！","id":82},{"type":"dialogue","name":"缇缇","text":"啊，这是小时候父亲给我讲的米诺斯故事，确实不是什么有名的典故，太适合用来举例所以说顺嘴了——","id":83},{"type":"dialogue","name":"缇缇","text":"咳，总之！我建议效仿米诺斯先贤，以扳手腕定输赢。","id":84},{"type":"dialogue","name":"缇缇","text":"不过要加一个小小的条件——不管怨气有多大，只有赢得对局的人才能说话。","id":85},{"type":"dialogue","name":"工匠代表","text":"呵，从来没听过这种规矩。","id":86},{"type":"dialogue","name":"缇缇","text":"你是不善言辞，还是四肢无力？","id":87},{"type":"dialogue","name":"工匠代表","text":"废话少说，比就比。","id":88},{"type":"dialogue","name":"缇缇","text":"嘿嘿，那第一届第一神殿扳手腕大赛——","id":89},{"type":"dialogue","name":"缇缇","text":"正式开始！","id":90},{"type":"dialog","id":91},{"type":"stopsound","channel":"1","fadetime":"2","id":92},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"2","block":"true","id":93},{"type":"charslot","id":94},{"type":"image","id":95},{"type":"background","image":"https://media.prts.wiki/6/68/Avg_bg_69_g7_firsttemple.png","screenadapt":"coverall","id":96},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"2","block":"true","id":97},{"type":"playsound","key":"$d_avg_bowl_smash","volume":"1","channel":"1","id":98},{"type":"camerashake","duration":"0.5","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"true","id":99},{"type":"playsound","key":"$d_avg_masses_cheer","volume":"1","channel":"4","id":100},{"type":"camerashake","duration":"2","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"true","id":101},{"type":"charslot","slot":"m","name":"avg_npc_1482_1#1$1","focus":"m","id":102},{"type":"dialogue","name":"米奥","text":"嚯，没想到那个义务兵看着瘦弱，技巧却很娴熟，趁大块头卸力的瞬间使劲，漂亮！","id":103,"figure":"https://media.prts.wiki/d/d5/Avg_avg_npc_1482_1-1$1.png"},{"type":"dialog","id":104},{"type":"charslot","id":105},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"l","id":106},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"l","id":107},{"type":"dialogue","name":"工匠代表","text":"你——","id":108,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"r","id":109},{"type":"dialogue","name":"果农代表","text":"憋着，输家不准说话！","id":110,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialogue","name":"果农代表","text":"石料堵在渡口，新采的苹果一筐都运不出去，而且种植区完全被山峰的阴影遮挡，未熟透的苹果根本照不到太阳，这样下去就要歉收了！","id":111,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialogue","name":"果农代表","text":"一比零，再来。","id":112,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialog","id":113},{"type":"charslot","id":114},{"type":"playsound","key":"$d_avg_smashtable","volume":"1","channel":"2","id":115},{"type":"camerashake","duration":"0.5","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"true","id":116},{"type":"playsound","key":"$d_avg_masses_cheer","volume":"1","channel":"4","id":117},{"type":"camerashake","duration":"2","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"true","id":118},{"type":"charslot","slot":"m","name":"avg_npc_1482_1#1$1","focus":"m","id":119},{"type":"dialogue","name":"米奥","text":"哇，这身肌肉果然不是白长的，看来背大理石对人类来说是不错的运动啊。","id":120,"figure":"https://media.prts.wiki/d/d5/Avg_avg_npc_1482_1-1$1.png"},{"type":"dialog","id":121},{"type":"charslot","id":122},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"l","id":123},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"l","id":124},{"type":"dialogue","name":"工匠代表","text":"苹果得先搬走我们才能运石料吧？而且我们重建第一神殿是受到了米诺斯众英雄的感召，要是耽误了事情，你担得起责吗！","id":125,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"dialogue","name":"工匠代表","text":"一比一，再来！","id":126,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"dialog","id":127},{"type":"charslot","id":128},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#1$2","focus":"m","id":129},{"type":"dialogue","name":"缇缇","text":"苹果采收和运送石料……原来是这样。","id":130,"figure":"https://media.prts.wiki/0/08/Avg_avg_4056_titi_1-1$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_1482_1#2$1","focus":"m","id":131},{"type":"dialogue","name":"米奥","text":"好看好看，米诺斯人真是有趣。不过再比几轮下去，双方选手没了力气，观赏性可就差了……","id":132,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_1482_1-2$1.png"},{"type":"dialog","id":133},{"type":"playsound","key":"$d_avg_masses_cheer","volume":"1","channel":"4","id":134},{"type":"camerashake","duration":"2","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"true","id":135},{"type":"charslot","slot":"m","name":"avg_npc_1482_1#1$1","focus":"m","id":136},{"type":"dialogue","name":"米奥","text":"欸，他们怎么停下来了？","id":137,"figure":"https://media.prts.wiki/d/d5/Avg_avg_npc_1482_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#1$2","focus":"m","id":138},{"type":"dialogue","name":"缇缇","text":"他们意识到了，扳手腕原本就不是为了决出胜负，而是为了让他们有机会听对方说话。","id":139,"figure":"https://media.prts.wiki/0/08/Avg_avg_4056_titi_1-1$2.png"},{"type":"dialogue","name":"缇缇","text":"被愤怒冲昏头脑的时候，耳朵也会失灵，即使是简单的事情也会变得复杂，更别提要解决长久的积怨。","id":140,"figure":"https://media.prts.wiki/0/08/Avg_avg_4056_titi_1-1$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_1482_1#1$1","focus":"m","id":141},{"type":"dialogue","name":"米奥","text":"倒是没看出来，你的心思还挺细……","id":142,"figure":"https://media.prts.wiki/d/d5/Avg_avg_npc_1482_1-1$1.png"},{"type":"dialogue","name":"米奥","text":"但解决完了情绪，你又该怎么解决真正的问题呢？","id":143,"figure":"https://media.prts.wiki/d/d5/Avg_avg_npc_1482_1-1$1.png"},{"type":"dialog","id":144},{"type":"charslot","id":145},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"l","id":146},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"l","id":147},{"type":"dialogue","name":"工匠代表","text":"呼……呼……","id":148,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"r","id":149},{"type":"dialogue","name":"果农代表","text":"呼……呼……","id":150,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialog","id":151},{"type":"charslot","id":152},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#4$2","focus":"m","id":153},{"type":"dialogue","name":"缇缇","text":"看来是个平手呀。","id":154,"figure":"https://media.prts.wiki/b/b0/Avg_avg_4056_titi_1-4$2.png"},{"type":"dialog","id":155},{"type":"charslot","id":156},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"l","id":157},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"l","id":158},{"type":"dialogue","name":"工匠代表","text":"外国小姑娘……","id":159,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"dialog","id":160},{"type":"charslot","id":161},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#9$2","focus":"m","id":162},{"type":"dialogue","name":"缇缇","text":"叫我缇缇吧。","id":163,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"dialog","id":164},{"type":"charslot","id":165},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"l","id":166},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"l","id":167},{"type":"dialogue","name":"工匠代表","text":"唉，缇缇，我们也不想耽搁果农的工作。","id":168,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"dialogue","name":"工匠代表","text":"参与重建的人虽多，但大家都只在自己喜欢的时间和区域采石，进度堪忧。昨天我一个人从山上背了十五吨大理石料，依旧不够。","id":169,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"r","id":170},{"type":"dialogue","name":"果农代表","text":"道理我们都懂，但苹果可不会善解人意。","id":171,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialog","id":172},{"type":"charslot","id":173},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#1$2","focus":"m","id":174},{"type":"dialogue","name":"缇缇","text":"唔，既要增加采石效率，又要让苹果能获得足够日晒……既然如此，为什么不采取折中的法子？","id":175,"figure":"https://media.prts.wiki/0/08/Avg_avg_4056_titi_1-1$2.png"},{"type":"dialog","id":176},{"type":"charslot","id":177},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"r","id":178},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"r","id":179},{"type":"dialogue","name":"果农代表","text":"怎么说？","id":180,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialog","id":181},{"type":"charslot","id":182},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#9$2","focus":"m","id":183},{"type":"dialogue","name":"缇缇","text":"把挡住种植区日光的那座山峰挖空，不就好了嘛。","id":184,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"dialog","id":185},{"type":"charslot","id":186},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"l","id":187},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"l","id":188},{"type":"dialogue","name":"工匠代表","text":"……","id":189,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"r","id":190},{"type":"dialogue","name":"果农代表","text":"……","id":191,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"l","id":192},{"type":"dialogue","name":"工匠代表","text":"哈哈哈！好一个“折中”，这可是我听过最异想天开的解决方法了！","id":193,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"dialogue","name":"工匠代表","text":"不过有点意思。","id":194,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"dialog","id":195},{"type":"charslot","id":196},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#9$2","focus":"m","id":197},{"type":"dialogue","name":"缇缇","text":"算是一点个人的兴趣爱好，我来雅赛努斯的路上，顺便研究了一下城区规划和自然环境。","id":198,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"dialogue","name":"缇缇","text":"现在遮挡种植区日晒的山峰并非主峰，且顶端土质松软，底下则是大片的大理石岩层，会是不错的采石场。","id":199,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"dialog","id":200},{"type":"charslot","id":201},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"r","id":202},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"r","id":203},{"type":"dialogue","name":"果农代表","text":"你的意思是夷平山峰，这样就算不改航线，种植区也能晒到太阳？这可能吗……","id":204,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialog","id":205},{"type":"charslot","id":206},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#9$2","focus":"m","id":207},{"type":"dialogue","name":"缇缇","text":"所以，果农们也要加入采石的队伍。","id":208,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#10$2","focus":"m","id":209},{"type":"dialogue","name":"缇缇","text":"补充人员是增加采石效率的最快方法，另外还要集合分散在各处山峰的工匠们一起采石。","id":210,"figure":"https://media.prts.wiki/5/56/Avg_avg_4056_titi_1-10$2.png"},{"type":"dialogue","name":"缇缇","text":"要是工匠先生一个人一天就能背十五吨大理石料……","id":211,"figure":"https://media.prts.wiki/5/56/Avg_avg_4056_titi_1-10$2.png"},{"type":"dialog","id":212},{"type":"charslot","id":213},{"type":"charslot","slot":"l","name":"avg_npc_2087_1#1$1","focus":"l","id":214},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"l","id":215},{"type":"dialogue","name":"工匠代表","text":"夷平山峰并非不可能。","id":216,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"charslot","slot":"r","name":"avg_npc_2086_1#1$1","focus":"r","id":217},{"type":"dialogue","name":"果农代表","text":"重建神殿本就是雅赛努斯人集体通过的提议，如果还能顺便解决日晒的问题，皆大欢喜。","id":218,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialogue","name":"果农代表","text":"我这就去跟果农们商量！","id":219,"figure":"https://media.prts.wiki/0/09/Avg_avg_npc_2086_1$1.png"},{"type":"dialog","id":220},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":221},{"type":"charslot","slot":"r","posfrom":"0,0","posto":"200,0","afrom":"1","ato":"0","duration":"1.5","id":222},{"type":"delay","time":"2.5","id":223},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"200,0","duration":"1.5","id":224},{"type":"delay","time":"2.5","id":225},{"type":"charslot","id":226},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#6$2","focus":"m","id":227},{"type":"dialogue","name":"缇缇","text":"太好啦，问题解决！","id":228,"figure":"https://media.prts.wiki/c/c1/Avg_avg_4056_titi_1-6$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_2087_1#1$1","focus":"m","id":229},{"type":"dialogue","name":"工匠代表","text":"多谢你，缇缇。","id":230,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#9$2","focus":"m","id":231},{"type":"dialogue","name":"缇缇","text":"太客气了。","id":232,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"dialogue","name":"缇缇","text":"虽然神殿还未修建完成，但你们的手艺真是巧夺天工……我越来越好奇第一神殿的负责人是什么样的了！","id":233,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_2087_1#1$1","focus":"m","id":234},{"type":"dialogue","name":"工匠代表","text":"呃，说到这个，现在倒还有一个问题没有解决。","id":235,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#4$2","focus":"m","id":236},{"type":"dialogue","name":"缇缇","text":"什么？","id":237,"figure":"https://media.prts.wiki/b/b0/Avg_avg_4056_titi_1-4$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_2087_1#1$1","focus":"m","id":238},{"type":"dialogue","name":"工匠代表","text":"你想见的那位重建神殿的第一倡议人，帕拉斯小姐，昨晚就失踪了。","id":239,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_2087_1$1.png"},{"type":"dialog","id":240},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#3$2","focus":"m","id":241},{"type":"delay","time":"0.5","id":242},{"type":"effect","name":"$e_emoji_question","layer":"1","x":"-40","y":"180","id":243},{"type":"effect","name":"$e_emoji_question","layer":"2","x":"20","y":"200","id":244},{"type":"effect","name":"$e_emoji_question","layer":"3","x":"70","y":"180","id":245},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#3$2","focus":"m","id":246},{"type":"delay","time":"3","id":247},{"type":"stopmusic","fadetime":"2","id":248},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":249},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":250},{"type":"charslot","id":251},{"type":"image","id":252},{"type":"background","image":"https://media.prts.wiki/8/8d/Avg_bg_31_g1_luo_park.png","screenadapt":"coverall","block":"true","id":253},{"type":"delay","time":"2","id":254},{"type":"playmusic","intro":"$loneliness_intro","key":"https://static.prts.wiki/music/music/static/m_avg/m_avg_loneliness_loop.mp3","volume":"0.6","id":255,"musicid":1},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":256},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#15$1","duration":"1","id":257},{"type":"delay","time":"2","id":258},{"type":"dialogue","name":"赞索斯","text":"“……从前的欢愉属于我们两个，永恒的宁静却独归于你。”","id":259,"figure":"https://media.prts.wiki/c/cc/Avg_avg_4166_varkis_1-15$1.png"},{"type":"dialogue","name":"赞索斯","text":"“赫里亚山间的清风，阿涅斯平原上的溪流，你澄澈的双眼已无法映出这些美景；”","id":260,"figure":"https://media.prts.wiki/c/cc/Avg_avg_4166_varkis_1-15$1.png"},{"type":"dialogue","name":"赞索斯","text":"“夜晚的安眠与白日的闲暇，也再进不了我的内心……”","id":261,"figure":"https://media.prts.wiki/c/cc/Avg_avg_4166_varkis_1-15$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":262},{"type":"dialogue","name":"赞索斯","text":"一别七年了，伊萨科斯吾友。","id":263,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"dialog","id":264},{"type":"charslot","duration":"1","id":265},{"type":"delay","time":"2","id":266},{"type":"text","text":"高大的战士将手中的仙客来花束放在洁白的墓碑前。","id":267},{"type":"text","text":"他的动作轻柔，几片白色的花瓣却依然掉落在地。","id":268},{"type":"dialog","id":269},{"type":"playsound","key":"$d_gen_walk_n","id":270},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#1$1","duration":"1","id":271},{"type":"delay","time":"2","id":272},{"type":"dialogue","name":"卡珊卓拉","text":"……","id":273,"figure":"https://media.prts.wiki/7/7a/Avg_avg_npc_2068_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":274},{"type":"dialogue","name":"赞索斯","text":"你来晚了。","id":275,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#3$1","focus":"m","id":276},{"type":"dialogue","name":"卡珊卓拉","text":"附近的驮兽牧场景色宜人，我只是路过。","id":277,"figure":"https://media.prts.wiki/c/c7/Avg_avg_npc_2068_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#15$1","focus":"m","id":278},{"type":"dialogue","name":"赞索斯","text":"随你用什么借口，你知道自己放不下。","id":279,"figure":"https://media.prts.wiki/c/cc/Avg_avg_4166_varkis_1-15$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":280},{"type":"dialogue","name":"赞索斯","text":"我也是。","id":281,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#1$1","focus":"m","id":282},{"type":"dialogue","name":"卡珊卓拉","text":"……","id":283,"figure":"https://media.prts.wiki/7/7a/Avg_avg_npc_2068_1-1$1.png"},{"type":"dialogue","name":"卡珊卓拉","text":"在雅赛努斯生活了五年，你从不光顾恩底弥翁神殿。","id":284,"figure":"https://media.prts.wiki/7/7a/Avg_avg_npc_2068_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#4$1","focus":"m","id":285},{"type":"dialogue","name":"卡珊卓拉","text":"你带着伊萨科斯的血衣来拜访我，那是你第一次踏进神殿，也是最后一次。","id":286,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_2068_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":287},{"type":"dialogue","name":"赞索斯","text":"我不需要英雄的指引。","id":288,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#1$1","focus":"m","id":289},{"type":"dialogue","name":"卡珊卓拉","text":"但你还在做同一个梦，不是吗……你责怪自己送伊萨科斯渡了那条河，然后他就那么死在了战场上。","id":290,"figure":"https://media.prts.wiki/7/7a/Avg_avg_npc_2068_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#3$1","focus":"m","id":291},{"type":"dialogue","name":"赞索斯","text":"那条河的上游被萨尔贡人兴建的水坝拦截，它现在只会在我的梦中迸流。","id":292,"figure":"https://media.prts.wiki/b/bc/Avg_avg_4166_varkis_1-3$1.png"},{"type":"dialogue","name":"赞索斯","text":"它为我的家乡送来了赫里亚山巅融化的雪水，也送来了他……","id":293,"figure":"https://media.prts.wiki/b/bc/Avg_avg_4166_varkis_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#6$1","focus":"m","id":294},{"type":"dialogue","name":"卡珊卓拉","text":"伊萨科斯是我为数不多可以交心的友人，他从不忌惮我的身份和“天赋”。","id":295,"figure":"https://media.prts.wiki/a/ac/Avg_avg_npc_2068_1-6$1.png"},{"type":"dialogue","name":"卡珊卓拉","text":"他的家族饱受战火余热的燎烧，他的父亲颓唐了一辈子，他却不愿那样。九年前领受神谕的时候，他的眼睛泛着雀跃的光……","id":296,"figure":"https://media.prts.wiki/a/ac/Avg_avg_npc_2068_1-6$1.png"},{"type":"dialogue","name":"卡珊卓拉","text":"无论结局如何，他认识了你，另一位可以依靠、情同兄弟的友人。赞索斯先生，他可曾入梦，告诉你无需再为他挂怀？","id":297,"figure":"https://media.prts.wiki/a/ac/Avg_avg_npc_2068_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":298},{"type":"dialogue","name":"赞索斯","text":"……","id":299,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#15$1","focus":"m","id":300},{"type":"dialogue","name":"赞索斯","text":"解读梦境是你的生活，悼亡和铭记是我的。我会以自己的方式平息怒火。","id":301,"figure":"https://media.prts.wiki/c/cc/Avg_avg_4166_varkis_1-15$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#6$1","focus":"m","id":302},{"type":"dialogue","name":"卡珊卓拉","text":"可赞索斯先生，战争已经结束了。萨尔贡已经与我们签订了互不侵扰的协议，这次萨尔贡使节来访也是一种表态。","id":303,"figure":"https://media.prts.wiki/a/ac/Avg_avg_npc_2068_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":304},{"type":"dialogue","name":"赞索斯","text":"呵，我当然清楚，里底娅甚至还装模作样地“敲打”了我。","id":305,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"dialogue","name":"赞索斯","text":"雅赛努斯历史上第一个全民公投选出的理事官，她不用再受议事厅和祭司们牵制，全权负责外交和部分公共事务管理……","id":306,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"dialogue","name":"赞索斯","text":"她也没少给你添麻烦吧？","id":307,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#1$1","focus":"m","id":308},{"type":"dialogue","name":"卡珊卓拉","text":"恩底弥翁神殿暂未受到牵连，但一些边缘的神职人员和他们所属神殿的职能正在被淡化。而且……","id":309,"figure":"https://media.prts.wiki/7/7a/Avg_avg_npc_2068_1-1$1.png"},{"type":"dialogue","name":"卡珊卓拉","text":"克瑞斯拉第一神殿即将落成，理应安排一场由祭司主导的戏剧仪式，呼唤英雄克瑞斯拉进入神殿，庇佑米诺斯。","id":310,"figure":"https://media.prts.wiki/7/7a/Avg_avg_npc_2068_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#4$1","focus":"m","id":311},{"type":"dialogue","name":"卡珊卓拉","text":"现在，组织民众出演戏剧的工作由理事官办公室代行。","id":312,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_2068_1-4$1.png"},{"type":"dialogue","name":"卡珊卓拉","text":"但前几天，我与里底娅理事官商议此事时，她虽答应，却在剧目选择上闪烁其词……","id":313,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_2068_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":314},{"type":"dialogue","name":"赞索斯","text":"呵，在她眼里，无论是祭司还是那些传统仪式，都是为米诺斯旅游业添砖加瓦的摆设。","id":315,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"dialogue","name":"赞索斯","text":"你对戏剧仪式必须选用古典正剧的坚持，只会被她视作议事厅的祭司在向她示威。","id":316,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#4$1","focus":"m","id":317},{"type":"dialogue","name":"卡珊卓拉","text":"我知道行政改革或许对如今的米诺斯而言不可避免，但……","id":318,"figure":"https://media.prts.wiki/7/7b/Avg_avg_npc_2068_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":319},{"type":"dialogue","name":"赞索斯","text":"总有些东西不会变，也不能变。","id":320,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"dialogue","name":"赞索斯","text":"里底娅在行政权方面的小心思与我无关，但若是来访的萨尔贡人包藏祸心，我不会坐视不理。","id":321,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#6$1","focus":"m","id":322},{"type":"dialogue","name":"卡珊卓拉","text":"……","id":323,"figure":"https://media.prts.wiki/a/ac/Avg_avg_npc_2068_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#13$1","focus":"m","id":324},{"type":"dialogue","name":"赞索斯","text":"卡珊卓拉小姐，我本就是一名与“英雄”无缘的感染者，现在也不再需要神谕的指引，可我仍旧会做梦。","id":325,"figure":"https://media.prts.wiki/7/7c/Avg_avg_4166_varkis_1-13$1.png"},{"type":"dialogue","name":"赞索斯","text":"如果我告诉你，我跟九年前的伊萨科斯一样，梦到了一条染血的河流……","id":326,"figure":"https://media.prts.wiki/7/7c/Avg_avg_4166_varkis_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":327},{"type":"dialogue","name":"赞索斯","text":"这次，你会给出什么样的解读呢？","id":328,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#8$1","focus":"m","id":329},{"type":"dialogue","name":"卡珊卓拉","text":"赞索斯先生！","id":330,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_2068_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_4166_varkis_1#1$1","focus":"m","id":331},{"type":"dialogue","name":"赞索斯","text":"渡口还有工作，我的徒弟在等我，失陪了。","id":332,"figure":"https://media.prts.wiki/9/98/Avg_avg_4166_varkis_1-1$1.png"},{"type":"dialog","id":333},{"type":"playsound","key":"$d_gen_walk_n","id":334},{"type":"charslot","duration":"1","id":335},{"type":"delay","time":"2","id":336},{"type":"charslot","slot":"m","name":"avg_npc_2068_1#6$1","focus":"m","id":337},{"type":"dialogue","name":"卡珊卓拉","text":"……","id":338,"figure":"https://media.prts.wiki/a/ac/Avg_avg_npc_2068_1-6$1.png"},{"type":"dialog","id":339},{"type":"stopmusic","fadetime":"2","id":340},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":341},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":342},{"type":"charslot","id":343},{"type":"image","id":344},{"type":"background","image":"https://media.prts.wiki/5/56/Avg_bg_69_g1_rivercrossing.png","screenadapt":"coverall","block":"true","id":345},{"type":"delay","time":"2","id":346},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_normal_loop.mp3","volume":"0.6","id":347,"musicid":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":348},{"type":"playsound","key":"$d_gen_walk_n","id":349},{"type":"charslot","slot":"l","name":"avg_npc_2074_1#1$1","duration":"1","id":350},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#1$2","duration":"1","id":351},{"type":"delay","time":"2","id":352},{"type":"charslot","slot":"l","name":"avg_npc_2074_1#1$1","focus":"l","id":353},{"type":"dialogue","name":"工匠","text":"缇缇，你真是热心。不但帮我们解决了跟果农的矛盾，现在还愿意陪我们一起找帕拉斯小姐。","id":354,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#9$2","focus":"r","id":355},{"type":"dialogue","name":"缇缇","text":"小事小事。再说了，我也想快点见到那位重建神殿的倡议人。","id":356,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"dialogue","name":"缇缇","text":"最后一次见到帕拉斯小姐的地方，是渡口？","id":357,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"charslot","slot":"l","name":"avg_npc_2074_1#1$1","focus":"l","id":358},{"type":"dialogue","name":"工匠","text":"没错。","id":359,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"dialogue","name":"工匠","text":"昨天晚上，帕拉斯小姐还坐在码头，一边喝酒，一边对着远处的荷谟伊山喃喃自语。","id":360,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"dialogue","name":"工匠","text":"自重建神殿以来，她为我们解决了很多问题。虽然她并不在雅赛努斯的神殿供职，很多台前工作是恩底弥翁神殿的卡珊卓拉小姐负责……","id":361,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"dialogue","name":"工匠","text":"但分工、采购，甚至打点关系，都是她独自一人在我们尚未注意到的时候悄悄完成的。","id":362,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#4$2","focus":"r","id":363},{"type":"dialogue","name":"缇缇","text":"原来如此，这样一位稳重的负责人突然失踪，倒确实让人担心……","id":364,"figure":"https://media.prts.wiki/b/b0/Avg_avg_4056_titi_1-4$2.png"},{"type":"charslot","slot":"l","name":"avg_npc_2074_1#1$1","focus":"l","id":365},{"type":"dialogue","name":"工匠","text":"哈哈……这个嘛，倒不是头一回了。","id":366,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#9$2","focus":"r","id":367},{"type":"dialogue","name":"缇缇","text":"对了，差点忘了问最重要的事，这位帕拉斯小姐到底长什么样子？","id":368,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"charslot","slot":"l","name":"avg_npc_2074_1#1$1","focus":"l","id":369},{"type":"dialogue","name":"工匠","text":"她是一位小个子的丰蹄女性，总是一副睡不醒的样子，头顶上还有一朵小花。","id":370,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#1$2","focus":"r","id":371},{"type":"dialogue","name":"缇缇","text":"小花……唔，是不是只有两片叶子，花瓣红得连褶皱都看不到的那种？","id":372,"figure":"https://media.prts.wiki/0/08/Avg_avg_4056_titi_1-1$2.png"},{"type":"charslot","slot":"l","name":"avg_npc_2074_1#1$1","focus":"l","id":373},{"type":"dialogue","name":"工匠","text":"对对对，你怎么知道？","id":374,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#5$2","focus":"r","id":375},{"type":"dialogue","name":"缇缇","text":"你说的花，是不是长那个样子的呀？","id":376,"figure":"https://media.prts.wiki/f/f9/Avg_avg_4056_titi_1-5$2.png"},{"type":"dialog","id":377},{"type":"charslot","id":378},{"type":"text","text":"工匠随缇缇指的方向看去，一朵小红花正插在不远处的苹果堆中，左摇右摆。","id":379},{"type":"dialog","id":380},{"type":"charslot","slot":"l","name":"avg_npc_2074_1#1$1","focus":"l","id":381},{"type":"charslot","slot":"r","name":"avg_4056_titi_1#5$2","focus":"l","id":382},{"type":"dialogue","name":"工匠","text":"还真是……不过，这不是果农们运苹果的箱子吗，怎么还开花了？","id":383,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"dialog","id":384},{"type":"camerashake","duration":"0.5","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"true","id":385},{"type":"charslot","slot":"l","name":"avg_npc_2074_1#1$1","focus":"l","id":386},{"type":"dialogue","name":"工匠","text":"不对，里面有什么东西！快躲开，缇缇！","id":387,"figure":"https://media.prts.wiki/c/ce/Avg_avg_npc_2074_1$1.png"},{"type":"dialog","id":388},{"type":"playsound","key":"$d_avg_woodenbox_apple_overturn","id":389},{"type":"camerashake","duration":"2","xstrength":"10","ystrength":"10","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":390},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":391},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"2","block":"true","id":392},{"type":"charslot","id":393},{"type":"image","id":394},{"type":"image","image":"https://media.prts.wiki/2/2b/Avg_69_i13.png","id":395},{"type":"imagetween","xFrom":"60","xTo":"0","yFrom":"-90","yTo":"0","duration":"25","xScaleFrom":"1.05","yScaleFrom":"1.05","xScaleTo":"0.8","yScaleTo":"0.8","block":"false","id":396},{"type":"delay","time":"2","id":397},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":398},{"type":"delay","time":"3.5","id":399},{"type":"text","text":"木箱仿佛拥有意识一般突然“苏醒”，熟透了的苹果倾泻而出，铺满了码头，滚落到清澈的特尔斐运河里。","id":400},{"type":"text","text":"懒散的丰蹄从果实堆成的寝床中滑了出来，被刺眼的天光照得直皱眉头，下意识地揉了揉眼睛。","id":401},{"type":"dialogue","name":"工匠","text":"帕、帕拉斯小姐？","id":402},{"type":"dialogue","name":"工匠","text":"喂！快来人，不用借船了，我们找到帕拉斯小姐了！","id":403},{"type":"dialogue","name":"缇缇","text":"这就是那位稳重的负责人、提出重建神殿的倡议者、极得民心的英雄人物——帕拉斯小姐？","id":404},{"type":"dialogue","name":"缇缇","text":"跟我想象的完全不一样欸……","id":405},{"type":"text","text":"缇缇好奇地凑近倒在地上的女孩。","id":406},{"type":"text","text":"她想从对方的双角上找出历战的缺口和磨损；探究她的武器究竟是何种构造，是否能支撑独特的源石技艺……","id":407},{"type":"text","text":"甚至想触碰她头顶神秘的小花，判断那是否是众英雄的赐福。","id":408},{"type":"text","text":"但缇缇没有感知到任何属于英雄的特殊之处，只是闻到了一阵又一阵苹果的甜香。","id":409},{"type":"text","text":"翻倒在地上的人似乎被缇缇吵醒，喃喃出声，缇缇侧耳去听。","id":410},{"type":"dialogue","name":"帕拉斯","text":"山……荷谟伊山……","id":411},{"type":"dialogue","name":"帕拉斯","text":"西侧的山峰……挪平……不挡日光……","id":412},{"type":"dialogue","name":"帕拉斯","text":"……得告诉果农和工人……还差什么……","id":413},{"type":"dialogue","name":"帕拉斯","text":"对……苹果酒……本来就该一起喝……","id":414},{"type":"dialogue","name":"缇缇","text":"夷平山峰解决日晒的问题？原来她跟我想到了一样的解决方法……甚至在梦里还想着重建神殿的事情？","id":415},{"type":"dialogue","name":"缇缇","text":"噗……谁说英雄只能是身强力壮的将领呢？我怎么忘了，这里不是萨尔贡，而是米诺斯呀。","id":416},{"type":"dialog","id":417},{"type":"delay","time":"2","id":418},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":419},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"2","block":"true","id":420},{"type":"charslot","id":421},{"type":"image","id":422},{"type":"background","image":"https://media.prts.wiki/5/56/Avg_bg_69_g1_rivercrossing.png","screenadapt":"coverall","block":"true","id":423},{"type":"delay","time":"2","id":424},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":425},{"type":"playsound","key":"$d_avg_clothmovement","id":426},{"type":"charslot","slot":"m","name":"avgnew_482_pallas_1#21$1","posfrom":"0,-50","posto":"0,0","afrom":"0","ato":"1","duration":"2.5","id":427},{"type":"delay","time":"3.5","id":428},{"type":"dialogue","name":"帕拉斯","text":"唔，谁……？","id":429,"figure":"https://media.prts.wiki/5/5d/Avg_avgnew_482_pallas_1-21$1.png"},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#9$2","focus":"m","id":430},{"type":"dialogue","name":"缇缇","text":"终于见面啦，提出重建克瑞斯拉第一神殿的倡议人，帕拉斯小姐。","id":431,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"dialogue","name":"缇缇","text":"我是萨尔贡使节团大使，梅捷缇克缇-娜苏图-玛夏耶尔。","id":432,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"charslot","slot":"m","name":"avgnew_482_pallas_1#21$1","focus":"m","id":433},{"type":"dialogue","name":"帕拉斯","text":"梅……","id":434,"figure":"https://media.prts.wiki/5/5d/Avg_avgnew_482_pallas_1-21$1.png"},{"type":"dialog","id":435},{"type":"effect","name":"$e_emoji_matter","layer":"1","x":"60","y":"180","id":436},{"type":"delay","time":"2","id":437},{"type":"charslot","slot":"m","name":"avg_4056_titi_1#9$2","focus":"m","id":438},{"type":"dialogue","name":"缇缇","text":"朋友们都叫我缇缇，这样称呼我就好啦。","id":439,"figure":"https://media.prts.wiki/b/b6/Avg_avg_4056_titi_1-9$2.png"},{"type":"dialog","id":440},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":441},{"type":"stopmusic","fadetime":"2","id":442},{"type":"charslot","id":443},{"type":"image","id":444}],"characters":["果农代表","工匠代表","缇缇","米奥","清醒的工匠","工匠代表&果农代表","赞索斯","卡珊卓拉","工匠","帕拉斯"]}