{"storyMeta":{"storyReviewType":"NONE","storyId":"act49side_level_act49side_09_beg","storyGroup":"act49side","storySort":18,"storyDependence":"act49side_level_act49side_08_end","storyCanShow":1,"storyCode":"TA-9","storyName":"气合","storyPic":null,"storyInfo":"字伥肆虐，守军苦战。太尉力谏真龙，却无法改变君王亲启“不反”、以身终局的决意。禁城中，陈与魏彦吾刀刃相见。","storyCanEnter":1,"storyTxt":"activities/act49side/level_act49side_09_beg","avgTag":"行动前","unLockType":"BY_START_TIME","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"act49side_09","minState":"PLAYED","maxState":"COMPLETE"}],"prev":16,"next":18,"characters":["筋疲力竭的守军","惶恐不安的守军","禁军","太尉","真龙","魏彦吾","陈","陈晖洁"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"stopmusic","id":1},{"type":"dialog","id":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":3},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":4},{"type":"charslot","id":5},{"type":"curtain","direction":"0","fillfrom":"0.1","fillto":"0.1","fadetime":"0.1","id":6},{"type":"curtain","direction":"4","fillfrom":"0.1","fillto":"0.1","fadetime":"0.1","id":7},{"type":"background","screenadapt":"coverall","id":8},{"type":"bg","id":9,"from":"0","to":"0.8","duration":"0.1","block":"false"},{"type":"playmusic","intro":"$m_bat_ymmons_intro","key":"https://static.prts.wiki/music/music/act23side/m_bat_ymmons_loop.mp3","volume":"0.6","id":10,"musicid":0},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":11},{"type":"delay","time":"1","id":12},{"type":"charslot","slot":"l","name":"avg_npc_1637_1#1$1","isblock":"true","id":13},{"type":"charslot","slot":"R","name":"avg_npc_2135_1#1$1","action":"jump","posto":"-200,0","power":"0","times":"1","duration":"0.5","id":14},{"type":"camerashake","duration":"0.5","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":15},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":16},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":17},{"type":"playsound","key":"$sheildimpact","volume":"1","text":"","id":18},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.05","block":"true","id":19},{"type":"charslot","slot":"R","action":"jump","posto":"50,0","power":"5","times":"1","duration":"1","id":20},{"type":"delay","time":"0.5","id":21},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"60,0","duration":"0.1","isblock":"true","id":22},{"type":"playsound","key":"$d_avg_attack_heavy","volume":"1","text":"","id":23},{"type":"charslot","slot":"r","action":"shake","afrom":"1","ato":"1","power":"3","times":"30","duration":"0.3","isblock":"true","id":24},{"type":"charslot","slot":"l","posfrom":"60,0","posto":"0,0","duration":"1.2","isblock":"false","id":25},{"type":"playsound","key":"$d_avg_fog_blowaway","volume":"0.8","id":26},{"type":"effect","name":"$e_vanish","layer":"1","x":"120","id":27},{"type":"charslot","slot":"r","afrom":"1","ato":"0","duration":"0.8","id":28},{"type":"delay","time":"1","id":29},{"type":"charslot","id":30},{"type":"playsound","key":"$d_avg_magic_5","volume":"1","text":"","id":31},{"type":"blocker","a":"0.8","r":"1","g":"1","b":"1","fadetime":"0.3","block":"true","id":32},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.1","block":"true","id":33},{"type":"charslot","slot":"r","name":"avg_npc_2135_1#1$1","posfrom":"150,-50","posto":"150,0","duration":"1","isblock":"false","id":34},{"type":"delay","time":"0.3","id":35},{"type":"charslot","slot":"l","name":"avg_npc_2135_1#1$1","posfrom":"-150,-50","posto":"-150,0","duration":"1","isblock":"false","id":36},{"type":"delay","time":"0.3","id":37},{"type":"charslot","slot":"m","name":"avg_npc_2135_1#1$1","posfrom":"0,-50","posto":"0,0","duration":"1.2","isblock":"true","id":38},{"type":"delay","time":"1","id":39},{"type":"charslot","id":40},{"type":"charslot","slot":"r","name":"avg_npc_1637_1#1$1","focus":"l","id":41},{"type":"charslot","slot":"l","name":"avg_npc_1637_1#1$1","focus":"l","isblock":"true","id":42},{"type":"dialogue","name":"筋疲力竭的守军","text":"没完没了......","id":43,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"charslot","slot":"r","focus":"r","id":44},{"type":"dialogue","name":"惶恐不安的守军","text":"小心！","id":45,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"dialog","id":46},{"type":"charslot","id":47},{"type":"charslot","slot":"r","name":"avg_npc_1637_1#1$1","posfrom":"150,0","posto":"150,0","id":48},{"type":"charslot","slot":"l","name":"avg_npc_2135_1#1$1","posfrom":"-100,0","posto":"200,0","duration":"0.5","isblock":"false","id":49},{"type":"delay","time":"0.3","id":50},{"type":"charslot","slot":"m","name":"avg_npc_1637_1#1$1","posfrom":"400,0","posto":"100,0","duration":"0.25","focus":"m","isblock":"true","id":51},{"type":"camerashake","duration":"0.5","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":52},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":53},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":54},{"type":"playsound","key":"$swordtsing5","volume":"1","text":"","id":55},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.05","block":"true","id":56},{"type":"charslot","slot":"l","action":"jump","posto":"-350,0","power":"5","times":"1","duration":"0.5","isblock":"true","id":57},{"type":"playsound","key":"$d_avg_fog_blowaway","volume":"0.8","id":58},{"type":"effect","name":"$e_vanish","layer":"1","x":"-350","id":59},{"type":"charslot","slot":"l","afrom":"1","ato":"0","duration":"0.8","isblock":"true","id":60},{"type":"delay","time":"0.5","id":61},{"type":"charslot","id":62},{"type":"charslot","slot":"r","name":"avg_npc_1637_1#1$1","focus":"r","id":63},{"type":"charslot","slot":"l","name":"avg_npc_1637_1#1$1","focus":"r","isblock":"true","id":64},{"type":"dialogue","name":"筋疲力竭的守军","text":"这些怪物到底是从哪里来的，到底还剩多少？！","id":65,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"charslot","slot":"l","focus":"l","isblock":"true","text":"","id":66},{"type":"dialogue","name":"惶恐不安的守军","text":"不仅没有变少，反而越来越多了。","id":67,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"dialogue","name":"惶恐不安的守军","text":"......听说昨天一夜，北三营已经折了一半人进去......","id":68,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"charslot","slot":"r","focus":"r","isblock":"true","id":69},{"type":"dialogue","name":"筋疲力竭的守军","text":"什么？！","id":70,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"charslot","slot":"l","focus":"l","isblock":"true","id":71},{"type":"dialogue","name":"惶恐不安的守军","text":"发现了吗，不知道从什么时候开始，这些凭空冒出来的怪物变得越来越真实，攻击性也越来越强......","id":72,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"charslot","slot":"r","focus":"r","isblock":"true","id":73},{"type":"dialogue","name":"筋疲力竭的守军","text":"*炎国粗口*，支援，支援到底在哪？","id":74,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"dialogue","name":"筋疲力竭的守军","text":"再这样打下去，马上就要弹尽粮绝了——","id":75,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"dialog","id":76},{"type":"delay","time":"0.3","id":77},{"type":"charslot","slot":"r","posfrom":"0,0","posto":"0,-30","duration":"0.5","isblock":"true","id":78},{"type":"charslot","slot":"r","posfrom":"0,-30","posto":"0,-150","afrom":"1","ato":"0","duration":"0.3","id":79},{"type":"playsound","key":"$bodyfalldown1","volume":"1","id":80},{"type":"delay","time":"0.8","id":81},{"type":"charslot","id":82},{"type":"curtain","direction":"0","fillfrom":"0.1","fillto":"0.01","fadetime":"1.5","block":"false","id":83},{"type":"bg","id":84,"from":"0.8","to":"0","duration":"1.5","block":"false"},{"type":"curtain","direction":"4","fillfrom":"0.1","fillto":"0.01","fadetime":"1.5","block":"true","id":85},{"type":"curtain","id":86},{"type":"delay","time":"0.8","id":87},{"type":"playsound","key":"$d_avg_fsmetal","volume":"1","id":88},{"type":"charslot","slot":"m","name":"avg_npc_1634_1#1$1","afrom":"0","ato":"0","duration":"0","id":89},{"type":"charslot","slot":"m","action":"zoom","poszoom":"0.5,0.5","scale":"0.95","duration":"0","id":90},{"type":"delay","time":"0.1","id":91},{"type":"charslot","slot":"m","action":"zoom","poszoom":"0.5,0.5","scale":"1","duration":"1.5","id":92},{"type":"charslot","slot":"m","afrom":"0","ato":"1","duration":"1.5","isblock":"true","id":93},{"type":"delay","time":"1.5","id":94},{"type":"charslot","id":95},{"type":"charslot","slot":"r","name":"avg_npc_2135_1#1$1","posfrom":"150,0","posto":"150,0","isblock":"false","id":96},{"type":"charslot","slot":"l","name":"avg_npc_2135_1#1$1","posfrom":"-150,0","posto":"-150,0","isblock":"false","id":97},{"type":"charslot","slot":"m","name":"avg_npc_2135_1#1$1","isblock":"true","id":98},{"type":"delay","time":"0.3","id":99},{"type":"playsound","key":"$e_skill_skulsrsword","id":100},{"type":"effect","name":"$e_bladeline_01_large","rox":"0","roy":"0","roz":"0","layer":"1","id":101},{"type":"delay","time":"0.2","id":102},{"type":"playsound","key":"$e_skill_skulsrsword","id":103},{"type":"effect","name":"$e_bladeline_01_large","rox":"0","roy":"0","roz":"-40","layer":"2","id":104},{"type":"playsound","key":"$d_avg_fog_blowaway","volume":"0.8","id":105},{"type":"effect","name":"$e_vanish","layer":"1","x":"-250","id":106},{"type":"playsound","key":"$d_avg_fog_blowaway","volume":"0.8","id":107},{"type":"effect","name":"$e_vanish","layer":"2","x":"0","id":108},{"type":"playsound","key":"$d_avg_fog_blowaway","volume":"0.8","id":109},{"type":"effect","name":"$e_vanish","layer":"3","x":"250","id":110},{"type":"charslot","slot":"r","afrom":"1","ato":"0","duration":"1","block":"false","id":111},{"type":"charslot","slot":"l","afrom":"1","ato":"0","duration":"1","block":"false","id":112},{"type":"charslot","slot":"m","afrom":"1","ato":"0","duration":"1","block":"true","id":113},{"type":"delay","time":"1","id":114},{"type":"charslot","id":115},{"type":"delay","time":"1","id":116},{"type":"charslot","slot":"m","name":"avg_npc_1634_1#1$1","id":117},{"type":"dialogue","name":"禁军","text":"站起来。","id":118,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"dialogue","name":"禁军","text":"守疆卫土，我辈天职，岂容有失。","id":119,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1637_1#1$1","id":120},{"type":"dialogue","name":"筋疲力竭的守军","text":"禁军？！","id":121,"figure":"https://media.prts.wiki/c/c5/Avg_avg_npc_1637_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1634_1#1$1","id":122},{"type":"dialogue","name":"禁军","text":"所有人，列阵迎敌。","id":123,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"dialog","id":124},{"type":"playsound","key":"$d_avg_drum","id":125},{"type":"delay","time":"1","id":126},{"type":"playsound","key":"$d_avg_marchturnaround","id":127},{"type":"delay","time":"1","id":128},{"type":"playsound","key":"$d_avg_drum","id":129},{"type":"dialogue","name":"禁军","text":"剿灭城中作乱孽物，死战不退。","id":130,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"stopmusic","fadetime":"2","id":131},{"type":"dialog","id":132},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":133},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":134},{"type":"charslot","id":135},{"type":"background","image":"https://media.prts.wiki/d/d3/Avg_bg_58_g5_dragonpalace.png","screenadapt":"coverall","id":136},{"type":"delay","time":"1","id":137},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":138},{"type":"delay","time":"1","id":139},{"type":"playmusic","key":"https://static.prts.wiki/music/music/act13d0d0/m_sys_midautumn20.mp3","volume":"0.6","id":140,"musicid":1},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"0,-30","duration":"1","name":"avg_npc_1239_1#1$1","isblock":"true","id":141},{"type":"dialogue","name":"太尉","text":"拜见陛下。","id":142,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1239_1-1$1.png"},{"type":"dialog","id":143},{"type":"charslot","id":144},{"type":"dialogue","name":"真龙","text":"太尉的病看来已经全好......可喜。","id":145},{"type":"dialogue","name":"真龙","text":"事到如今，你找我还有什么事？","id":146},{"type":"dialog","id":147},{"type":"charslot","slot":"m","posfrom":"0,-30","posto":"0,0","duration":"1","name":"avg_npc_1239_1#1$1","isblock":"true","id":148},{"type":"dialogue","name":"太尉","text":"陛下难道忘了，前日里，是陛下吩咐老臣，前来上早朝。","id":149,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1239_1-1$1.png"},{"type":"dialog","id":150},{"type":"charslot","id":151},{"type":"dialogue","name":"真龙","text":"太尉大人怕是睡糊涂了......早朝早已散了，太尉大人来迟了。","id":152},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","id":153},{"type":"dialogue","name":"太尉","text":"不迟，不迟......到明日才是下一个望日。","id":154,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","text":"","id":155},{"type":"dialogue","name":"太尉","text":"老臣愿陪着陛下，等陛下下达圣意。","id":156,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"dialog","id":157},{"type":"charslot","id":158},{"type":"dialogue","name":"真龙","text":"......我还是不知，太尉究竟为何如此心急。","id":159},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#7$1","text":"","id":160},{"type":"dialogue","name":"太尉","text":"老臣不知，陛下究竟还在等什么。","id":161,"figure":"https://media.prts.wiki/6/66/Avg_avg_npc_1239_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","id":162},{"type":"dialogue","name":"太尉","text":"老臣也不知......今日陛下原本打算去做什么。","id":163,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"dialog","id":164},{"type":"charslot","id":165},{"type":"dialogue","name":"真龙","text":"......与太尉无关。","id":166},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#1$1","id":167},{"type":"dialogue","name":"太尉","text":"陛下不说，老臣只能妄自揣度圣意了。","id":168,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1239_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#1$1","id":169},{"type":"dialogue","name":"太尉","text":"陛下要以万金之躯启动“不反”，解决当下岁陵里的那场危机？","id":170,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1239_1-1$1.png"},{"type":"dialog","id":171},{"type":"charslot","id":172},{"type":"dialogue","name":"真龙","text":"......","id":173},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","id":174},{"type":"dialogue","name":"太尉","text":"不知陛下是听了何人谗言......出此下策。","id":175,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"dialog","id":176},{"type":"charslot","id":177},{"type":"dialogue","name":"真龙","text":"无人进谏，我就不能自己拿主意？","id":178},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#3$1","id":179},{"type":"dialogue","name":"太尉","text":"四十年前......陛下登基那年，是我与太傅带陛下去视察“不反”。","id":180,"figure":"https://media.prts.wiki/c/c6/Avg_avg_npc_1239_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#3$1","text":"","id":181},{"type":"dialogue","name":"太尉","text":"我仍记得，从那间幽室出来后，陛下三日不朝，老臣至今也不知道，彼时的陛下，心中所想为何？","id":182,"figure":"https://media.prts.wiki/c/c6/Avg_avg_npc_1239_1-3$1.png"},{"type":"dialog","id":183},{"type":"charslot","id":184},{"type":"dialogue","name":"真龙","text":"我也记得那时......现在想来，也不怕太尉笑话，大可说与太尉听。","id":185},{"type":"dialogue","name":"真龙","text":"我当时不过在想......有这等神物，在炎国传了千年，也不曾有一位真龙开启过“不反”。","id":186},{"type":"dialogue","name":"真龙","text":"如果在我手中，大炎沦至需要使用“不反”的地步......那我便是大炎第一号无能之君。","id":187},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","text":"","id":188},{"type":"dialogue","name":"太尉","text":"斗胆问陛下......若陛下以身殉国，后事应当如何？","id":189,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"dialog","id":190},{"type":"charslot","id":191},{"type":"dialogue","name":"真龙","text":"何必担忧......可以接替我的那位，不是已经到百灶了？","id":192},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","text":"","id":193},{"type":"dialogue","name":"太尉","text":"如果炎武以废储君之身再登大宝，百官不服，炎国大乱，又当如何？","id":194,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"dialog","id":195},{"type":"charslot","id":196},{"type":"dialogue","name":"真龙","text":"......那便是卿等之过了。","id":197},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","text":"","id":198},{"type":"dialogue","name":"太尉","text":"臣唯有恳请陛下，打消这等念头。","id":199,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"dialog","id":200},{"type":"charslot","id":201},{"type":"dialogue","name":"真龙","text":"说来好笑......","id":202},{"type":"dialogue","name":"真龙","text":"太尉明知道，我绝非你仰慕的先帝那样的雄主......","id":203},{"type":"dialogue","name":"真龙","text":"太尉不去期待兄长早日成为可以助你实现抱负的真龙......","id":204},{"type":"dialogue","name":"真龙","text":"......又何苦来劝我？","id":205},{"type":"camerashake","duration":"0.3","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":206},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#5$1","id":207},{"type":"dialogue","name":"太尉","text":"......陛下！！","id":208,"figure":"https://media.prts.wiki/5/5a/Avg_avg_npc_1239_1-5$1.png"},{"type":"dialog","id":209},{"type":"charslot","id":210},{"type":"text","text":"面前的老人蓦地激动起来，颤抖的声音几乎声嘶力竭。","id":211},{"type":"text","text":"龙椅上的人几乎忘了，上一次见到眼前老者如此激动是何时的事。","id":212},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#8$1","id":213},{"type":"dialogue","name":"太尉","text":"臣岂不见......陛下四十年来日日宵衣旰食，励精图治......未曾有一日懈怠。","id":214,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1239_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#8$1","id":215},{"type":"dialogue","name":"太尉","text":"四十年来......大炎四海平定，人口极盛，国库充盈。","id":216,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1239_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#6$1","id":217},{"type":"dialogue","name":"太尉","text":"大炎千年来......可曾有如此中兴之主......可曾有如此......有为，仁君......？","id":218,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_1239_1-6$1.png"},{"type":"dialog","id":219},{"type":"charslot","id":220},{"type":"dialogue","name":"真龙","text":"......","id":221},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#6$1","id":222},{"type":"dialogue","name":"太尉","text":"可是陛下......难道要坐视大炎来之不易的盛世图景......","id":223,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_1239_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#6$1","text":"","id":224},{"type":"dialogue","name":"太尉","text":"在这个动荡之世，付诸东流吗？","id":225,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_1239_1-6$1.png"},{"type":"dialog","id":226},{"type":"charslot","id":227},{"type":"playsound","key":"$d_avg_erthshkng","volume":"1","loop":"true","channel":"e","id":228},{"type":"camerashake","duration":"4","xstrength":"10","ystrength":"10","vibrato":"90","randomness":"90","fadeout":"true","block":"false","id":229},{"type":"stopsound","channel":"e","fadetime":"6","id":230},{"type":"playsound","key":"$d_avg_rockfall","volume":"0.3","id":231},{"type":"delay","time":"2","id":232},{"type":"playsound","key":"$d_avg_fsmetal","volume":"1","id":233},{"type":"delay","time":"0.4","id":234},{"type":"charslot","slot":"m","name":"avg_npc_1634_1#1$1","posfrom":"100,0","posto":"0,0","duration":"1.2","isblock":"true","id":235},{"type":"dialogue","name":"禁军","text":"司岁台急报，岁陵有变，深层检测到强烈的能量波动。","id":236,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"dialogue","name":"禁军","text":"和一百二十年前那次相比，只强不弱。","id":237,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"dialog","id":238},{"type":"charslot","id":239},{"type":"dialogue","name":"真龙","text":"军民受灾情况如何？","id":240},{"type":"charslot","slot":"m","posfrom":"0,-30","posto":"0,-30","name":"avg_npc_1634_1#1$1","id":241},{"type":"dialogue","name":"禁军","text":"尚属可控。百灶各外围区块在能量爆发前已经驶离，近郊非移动聚落疏散也已基本完成，受灾程度轻微。","id":242,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"dialogue","name":"禁军","text":"邙山一带受灾较重，但仍有天师坚守本位，界园镇岁的作用仍在。","id":243,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"charslot","slot":"m","posfrom":"0,-30","posto":"0,-30","name":"avg_npc_1634_1#1$1","id":244},{"type":"dialogue","name":"禁军","text":"如今城中伥怪猖獗，禁军已协同巡防营建立防线，死战不退。","id":245,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1634_1$1.png"},{"type":"dialog","id":246},{"type":"charslot","id":247},{"type":"dialogue","name":"真龙","text":"知道了......下去吧。","id":248},{"type":"dialog","id":249},{"type":"charslot","id":250},{"type":"playsound","key":"$d_avg_fsmetal","volume":"1","id":251},{"type":"charslot","slot":"m","afrom":"1","ato":"0","duration":"1","id":252},{"type":"delay","time":"1","id":253},{"type":"playsound","key":"$d_avg_clothmovementsp","volume":"0.3","id":254},{"type":"delay","time":"1","id":255},{"type":"playsound","key":"$d_avg_curtain_jade","volume":"0.3","id":256},{"type":"playsound","key":"$d_avg_emperor_fts","volume":"0.3","id":257},{"type":"text","text":"帷幕后的人从龙椅上起身，拾级而下，来到了老者身侧。","id":258},{"type":"dialog","id":259},{"type":"charslot","slot":"m","name":"avg_npc_2132_1#1$1","duration":"1","isblock":"true","text":"","id":260},{"type":"dialogue","name":"真龙","text":"......时候不早了。","id":261},{"type":"dialogue","name":"真龙","text":"太尉大人，退下吧。百灶玉门两道战线，都还等着太尉都统。","id":262},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#7$1","id":263},{"type":"dialogue","name":"太尉","text":"陛下......","id":264,"figure":"https://media.prts.wiki/6/66/Avg_avg_npc_1239_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#8$1","id":265},{"type":"dialogue","name":"太尉","text":"为大炎计......陛下难道真的不知，臣为何要力主这一战？","id":266,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1239_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#8$1","id":267},{"type":"dialogue","name":"太尉","text":"当初朝中为什么要制定二十八策，陛下是否还记得？","id":268,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1239_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#3$1","id":269},{"type":"dialogue","name":"太尉","text":"维多利亚、莱塔尼亚、卡兹戴尔......整片大地除大炎之外，四方扰攘。","id":270,"figure":"https://media.prts.wiki/c/c6/Avg_avg_npc_1239_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#2$1","id":271},{"type":"dialogue","name":"太尉","text":"眼下已经是大争之世......大炎绝不能被动应变，务必主动求变......","id":272,"figure":"https://media.prts.wiki/3/3b/Avg_avg_npc_1239_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#1$1","id":273},{"type":"dialogue","name":"太尉","text":"陛下难道不见乌萨斯的前车之鉴吗？！","id":274,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1239_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2132_1#1$1","text":"","id":275},{"type":"dialogue","name":"真龙","text":"......","id":276},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#2$1","id":277},{"type":"dialogue","name":"太尉","text":"天机阁至今未曾得出结论，究竟是什么样的力量，能让整条源石矿脉化为乌有。","id":278,"figure":"https://media.prts.wiki/3/3b/Avg_avg_npc_1239_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#2$1","id":279},{"type":"dialogue","name":"太尉","text":"倘若结晶时代真的以全部主矿脉的枯竭告终，大炎必须负起责任，做好领导整个泰拉的准备。","id":280,"figure":"https://media.prts.wiki/3/3b/Avg_avg_npc_1239_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#2$1","id":281},{"type":"dialogue","name":"太尉","text":"北征乌萨斯，西拒维多利亚，东抚御机锁川两院，南定雷姆必拓，此外还要留意哥伦比亚的发展，防备阿戈尔自海上发起的侵袭。","id":282,"figure":"https://media.prts.wiki/3/3b/Avg_avg_npc_1239_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","text":"","id":283},{"type":"dialogue","name":"太尉","text":"在此种种之前......大炎务必趁国力鼎盛时，借与岁兽这一战，一扫数十年来承平暗弱之风！","id":284,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#4$1","id":285},{"type":"dialogue","name":"太尉","text":"唯有如此......方能让大炎，在这乱世中，在下一个千年......风雨不动，屹立岿然......","id":286,"figure":"https://media.prts.wiki/7/7f/Avg_avg_npc_1239_1-4$1.png"},{"type":"dialog","id":287},{"type":"charslot","id":288},{"type":"text","text":"听罢老人的长言，真龙陷入了长久的沉默。不只是为了斟酌字句，还是为了平复心绪。","id":289},{"type":"text","text":"过去了不知多久，他终于开口。","id":290},{"type":"charslot","slot":"m","name":"avg_npc_2132_1#1$1","text":"","id":291},{"type":"dialogue","name":"真龙","text":"太尉一生为大炎南征北战，立下战功无数，也落下这一身伤病......","id":292},{"type":"dialogue","name":"真龙","text":"......我又岂有一瞬质疑过太尉对大炎的拳拳忠心？","id":293},{"type":"dialogue","name":"真龙","text":"只是方才，太尉说起乌萨斯的前车之鉴，我反而想问......","id":294},{"type":"dialogue","name":"真龙","text":"太尉可还记得......高卢的前车之鉴？","id":295},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#6$1","id":296},{"type":"dialogue","name":"太尉","text":"陛下......？","id":297,"figure":"https://media.prts.wiki/f/f3/Avg_avg_npc_1239_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2132_1#1$1","text":"","id":298},{"type":"dialogue","name":"真龙","text":"太尉方才所言，句句鞭辟入里......","id":299},{"type":"dialogue","name":"真龙","text":"大炎应当求变，也不得不变......","id":300},{"type":"dialogue","name":"真龙","text":"可我思来想去，比起与岁兽这一战可能要损失的军队将士......","id":301},{"type":"dialogue","name":"真龙","text":"大炎更不需要的，还是一个垂暮真龙......还有这个，千年来只在真龙之手的权柄......","id":302},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#7$1","id":303},{"type":"dialogue","name":"太尉","text":"......","id":304,"figure":"https://media.prts.wiki/6/66/Avg_avg_npc_1239_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2132_1#1$1","text":"","id":305},{"type":"dialogue","name":"真龙","text":"要论起大炎的将来，我竟是比太尉要乐观许多......","id":306},{"type":"dialogue","name":"真龙","text":"四十年来......大炎何曾缺过忠义之士？","id":307},{"type":"dialogue","name":"真龙","text":"有太师，有虞澄、顾筌......有太傅，也有太尉你......","id":308},{"type":"dialogue","name":"真龙","text":"文臣秉忠直言，武将悍不畏死，百姓深明大义......大炎又何来“承平暗弱之风”？","id":309},{"type":"dialogue","name":"真龙","text":"至于太尉所言的那个将来，太尉大可替我去看看......","id":310},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#8$1","id":311},{"type":"dialogue","name":"太尉","text":"陛下......您到底还是......","id":312,"figure":"https://media.prts.wiki/7/7e/Avg_avg_npc_1239_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2132_1#1$1","text":"","id":313},{"type":"dialogue","name":"真龙","text":"......那场围猎之事，由祖辈开启；岁兽遗害，纠缠大炎千年的梦魇......也应当由我而终。","id":314},{"type":"dialogue","name":"真龙","text":"如果大炎当真有非流不可的血......","id":315},{"type":"dialogue","name":"真龙","text":"那也应当......从真龙始。","id":316},{"type":"dialog","id":317},{"type":"delay","time":"0.5","id":318},{"type":"charslot","slot":"m","name":"avg_npc_2132_1#1$1","text":"","id":319},{"type":"playsound","key":"$d_avg_curtain_jade","volume":"0.5","loop":"true","channel":"ja","id":320},{"type":"playsound","key":"$d_avg_emperor_fts","volume":"0.8","loop":"true","channel":"wa","id":321},{"type":"charslot","slot":"m","action":"zoom","poszoom":"0.5,0.5","scale":"1.03","duration":"1.2","id":322},{"type":"charslot","slot":"m","afrom":"1","ato":"0","duration":"1.2","id":323},{"type":"delay","time":"2","id":324},{"type":"soundvolume","volume":"0","channel":"ja","fadetime":"2","id":325},{"type":"soundvolume","volume":"0","channel":"wa","fadetime":"2","id":326},{"type":"text","text":"片刻的沉默过后，真龙迈步走向他许久不曾踏足的宫殿之外。","id":327},{"type":"text","text":"偌大的宫殿中，只剩下老者一人。","id":328},{"type":"stopsound","channel":"ja","fadetime":"0.1","id":329},{"type":"stopsound","channel":"wa","fadetime":"0.1","id":330},{"type":"dialog","id":331},{"type":"charslot","id":332},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#1$1","id":333},{"type":"dialogue","name":"太尉","text":"......臣不能劝阻陛下，也只有尽本分之忠了。","id":334,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1239_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1239_1#1$1","id":335},{"type":"dialogue","name":"太尉","text":"通知玉门，也该动一动了。","id":336,"figure":"https://media.prts.wiki/c/c1/Avg_avg_npc_1239_1-1$1.png"},{"type":"dialog","id":337},{"type":"playsound","key":"$d_avg_oldman_walk","id":338},{"type":"charslot","duration":"2","id":339},{"type":"delay","time":"2","id":340},{"type":"text","text":"简短的命令下完，老人切断通讯，缓缓走向前方。","id":341},{"type":"text","text":"他穿过帷幕，最终停在龙椅一侧，不再有什么动作，只是闭眼站在原地，似乎在等待什么......","id":342},{"type":"text","text":"直到一阵再也按捺不住的咳嗽从喉间迸出。","id":343},{"type":"text","text":"他咳得太厉害，咳到弯下了腰，不得不用双手扶住龙椅侧边。","id":344},{"type":"stopmusic","fadetime":"2","id":345},{"type":"dialog","id":346},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":347},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":348},{"type":"charslot","id":349},{"type":"background","image":"https://media.prts.wiki/6/60/Avg_bg_58_g7_forbiddencity.png","screenadapt":"coverall","id":350},{"type":"delay","time":"1","id":351},{"type":"playsound","key":"$d_avg_slmddrprn","volume":"0","channel":"rain","loop":"true","id":352},{"type":"soundvolume","volume":"0.3","channel":"rain","fadetime":"2","id":353},{"type":"playsound","key":"$d_avg_rainlight_loop","volume":"0.5","loop":"true","channel":"ra","id":354},{"type":"avgdisplay","id":355,"style":"bgeffect","name":"$eb_raingrey","slot":"bgover","y":"-250","layer":"1"},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":356},{"type":"animtext","id":357,"name":"group_location_stamp","style":"avg_only_medium","pos":"-400,-200","block":"false","text":"<p=2>望日前一日 亥时</>"},{"type":"delay","time":"3","id":358},{"type":"animtextclean","id":359},{"type":"delay","time":"1","id":360},{"type":"playmusic","key":"https://static.prts.wiki/music/music/act16d5d0/m_sys_act16_loop.mp3","volume":"0.6","id":361,"musicid":2},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#1","focus":"m","id":362},{"type":"dialogue","name":"魏彦吾","text":"......你终究还是来了。","id":363,"figure":"https://media.prts.wiki/1/1f/Avg_char_2005_weiyw_1.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#1$1","id":364},{"type":"dialogue","name":"陈","text":"你在这里。","id":365},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#1$1","id":366},{"type":"dialogue","name":"陈","text":"但我来到这里，你似乎一点也不惊讶？","id":367},{"type":"dialog","id":368},{"type":"charslot","id":369},{"type":"text","text":"要找的人就这么出现在眼前，陈晖洁还是有些猝不及防。","id":370},{"type":"text","text":"仍是那副盛气凌人的站姿，仍是那副阴晴不定的神色，好像这里不是百灶的禁城，而是他在龙门的官邸后院。","id":371},{"type":"text","text":"身后的建筑与他暗沉的外衣融为一体，仿佛那些宫阙也只是一件华丽得略显过分的披风。","id":372},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":373},{"type":"dialogue","name":"陈","text":"......所以你至少不是被挟持的。","id":374},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#1","focus":"m","text":"","id":375},{"type":"dialogue","name":"魏彦吾","text":"我还真不知道这世上还有谁能挟持于我。","id":376,"figure":"https://media.prts.wiki/1/1f/Avg_char_2005_weiyw_1.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#1","focus":"m","id":377},{"type":"dialogue","name":"魏彦吾","text":"我所做的一切，都是我自己的选择。","id":378,"figure":"https://media.prts.wiki/1/1f/Avg_char_2005_weiyw_1.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":379},{"type":"dialogue","name":"陈","text":"我永远都讨厌你这副样子......","id":380},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":381},{"type":"dialogue","name":"陈","text":"你为什么在这里？这难道就是那位太傅叮嘱你准备的后手？","id":382},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":383},{"type":"dialogue","name":"魏彦吾","text":"太傅所言，不可尽从......事情根本不该走到他所言的那一步。","id":384,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":385},{"type":"dialogue","name":"魏彦吾","text":"我另有打算。","id":386,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#7$1","id":387},{"type":"dialogue","name":"陈","text":"但不管怎么说，你是安全的。那剩下的也就好说了。","id":388},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#2","focus":"m","id":389},{"type":"dialogue","name":"魏彦吾","text":"你准备做什么？","id":390,"figure":"https://media.prts.wiki/e/e1/Avg_char_2005_weiyw_2.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#10$1","id":391},{"type":"dialogue","name":"陈","text":"保证你的安全，让你先离开百灶，然后......","id":392},{"type":"dialog","id":393},{"type":"charslot","id":394},{"type":"effect","name":"$e_chixiao_slash01","rox":"-80","roy":"89","roz":"150","layer":"1","id":395},{"type":"playsound","key":"$d_avg_bldwhoosh","id":396},{"type":"delay","time":"0.5","id":397},{"type":"text","text":"陈轻轻挥动右手的书刀，拙朴的形状在空气中划出一道竹简似的淡黄色的残影。","id":398},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":399},{"type":"dialogue","name":"陈","text":"......去纠正一些你们兄弟犯下的错。","id":400},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#2","focus":"m","id":401},{"type":"dialogue","name":"魏彦吾","text":"看上去......你已经拿到了那件遗物。","id":402,"figure":"https://media.prts.wiki/e/e1/Avg_char_2005_weiyw_2.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#1","focus":"m","id":403},{"type":"dialogue","name":"魏彦吾","text":"我似乎也不该太意外。","id":404,"figure":"https://media.prts.wiki/1/1f/Avg_char_2005_weiyw_1.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#1$1","id":405},{"type":"dialogue","name":"陈","text":"呵，按你原本的期待，会是谁把这柄书刀送到你手里？","id":406},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#2","focus":"m","text":"","id":407},{"type":"dialogue","name":"魏彦吾","text":"已经不再重要......","id":408,"figure":"https://media.prts.wiki/e/e1/Avg_char_2005_weiyw_2.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":409},{"type":"dialogue","name":"魏彦吾","text":"你既然已经拿到了这柄书刀，那你也应当知晓它的作用......还有相关的一切。","id":410,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#4$1","id":411},{"type":"dialogue","name":"陈","text":"我倒是的确很惊讶，来到百灶城后知晓的你们每一件秘密，都真是让我......大开眼界。","id":412},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#1$1","id":413},{"type":"dialogue","name":"陈","text":"心里能藏着这么多事，我简直都有点佩服你了。","id":414},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":415},{"type":"dialogue","name":"魏彦吾","text":"如果你真的希望纠正我当年犯下的错误，那你应该跟我走。","id":416,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#1$1","id":417},{"type":"dialogue","name":"陈","text":"......跟你走。","id":418},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#10$1","id":419},{"type":"dialogue","name":"陈","text":"去哪里？","id":420},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":421},{"type":"dialogue","name":"魏彦吾","text":"去禁城地下，去那一枚最初的源石前。","id":422,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":423},{"type":"dialogue","name":"魏彦吾","text":"你带来的书刀会发挥应有的作用，大炎的危机会解除，一切都会重回正轨。","id":424,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#1","focus":"m","id":425},{"type":"dialogue","name":"魏彦吾","text":"我当然希望你直接把书刀给我，这样更快，你的麻烦也会少许多。","id":426,"figure":"https://media.prts.wiki/1/1f/Avg_char_2005_weiyw_1.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#1","focus":"m","text":"","id":427},{"type":"dialogue","name":"魏彦吾","text":"但你一定不会信我说的话，你一定要亲眼看到一切才算罢休。而我对此也并不介意。","id":428,"figure":"https://media.prts.wiki/1/1f/Avg_char_2005_weiyw_1.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":429},{"type":"dialogue","name":"陈","text":"你还是在自我感动吗？你就这样装模作样地略过了自己会送命这一环。","id":430},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":431},{"type":"dialogue","name":"魏彦吾","text":"大难当前......这是炎国可以接受的最小代价。","id":432,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":433},{"type":"dialogue","name":"魏彦吾","text":"这件案子没有受害人。你的工作到此为止，陈警司。","id":434,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":435},{"type":"dialogue","name":"陈","text":"难道你忘了？早在五年前我就已经当着你的面辞职了。","id":436},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":437},{"type":"dialogue","name":"陈","text":"可现在的你，配不上我的一声“魏长官”。","id":438},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":439},{"type":"dialogue","name":"魏彦吾","text":"......","id":440,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#10$1","id":441},{"type":"dialogue","name":"陈","text":"你在叫我看着你去死，这甚至是你的话语里最不足以让我愤怒的部分。","id":442},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":443},{"type":"dialogue","name":"陈","text":"没有谁会为你这样的自我牺牲而感动的，除了你自己。","id":444},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#1$1","id":445},{"type":"dialogue","name":"陈","text":"现在的你，还没有资格就这样一死了之。","id":446},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#3","focus":"m","id":447},{"type":"dialogue","name":"魏彦吾","text":"晖洁，这不是意气之争，事关炎国社稷苍生！","id":448,"figure":"https://media.prts.wiki/9/92/Avg_char_2005_weiyw_3.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":449},{"type":"dialogue","name":"陈","text":"我当然知道......","id":450},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#2$1","id":451},{"type":"dialogue","name":"陈","text":"可你也别自大了，炎国社稷苍生不是背在你一个人的肩上。比起自说自话地去送死，你绝对有更该做的事。","id":452},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":453},{"type":"dialogue","name":"魏彦吾","text":"......很好。","id":454,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#4","focus":"m","id":455},{"type":"dialogue","name":"魏彦吾","text":"看来你不必跟着我一起去了。","id":456,"figure":"https://media.prts.wiki/2/22/Avg_char_2005_weiyw_4.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#4","focus":"m","id":457},{"type":"dialogue","name":"魏彦吾","text":"把书刀交给我，然后返回龙门。","id":458,"figure":"https://media.prts.wiki/2/22/Avg_char_2005_weiyw_4.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":459},{"type":"dialogue","name":"陈","text":"可惜，我手里的两把刀剑，一把都不能借给你。","id":460},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#4","focus":"m","id":461},{"type":"dialogue","name":"魏彦吾","text":"情况已经很紧急了，你还要一意孤行吗，陈警司？","id":462,"figure":"https://media.prts.wiki/2/22/Avg_char_2005_weiyw_4.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","id":463},{"type":"dialogue","name":"陈","text":"一意孤行的另有其人。","id":464},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#4","focus":"m","id":465},{"type":"dialogue","name":"魏彦吾","text":"你一定要逼我出手......","id":466,"figure":"https://media.prts.wiki/2/22/Avg_char_2005_weiyw_4.png"},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#3","focus":"m","id":467},{"type":"dialogue","name":"魏彦吾","text":"好，那就出招吧。让我看看，这五年来你的剑法到底成长到了什么地步！","id":468,"figure":"https://media.prts.wiki/9/92/Avg_char_2005_weiyw_3.png"},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#11$1","text":"","id":469},{"type":"dialogue","name":"陈","text":"......求之不得。","id":470},{"type":"dialog","id":471},{"type":"charslot","id":472},{"type":"text","text":"陈晖洁握紧了剑柄。","id":473},{"type":"text","text":"从接过赤霄的那一刻起，她就知道，这一刻迟早要来。","id":474},{"type":"dialog","id":475},{"type":"playsound","key":"$d_sp_chixiaobadao","id":476},{"type":"playsound","key":"$d_avg_breezetree","id":477},{"type":"blocker","a":"0.2","r":"0.92","g":"0.4","b":"0.3","fadetime":"0.6","block":"true","id":478},{"type":"blocker","a":"0","r":"0.92","g":"0.4","b":"0.3","fadetime":"0.4","block":"true","id":479},{"type":"text","text":"她拔剑出鞘，指向横亘在魏彦吾和自己之间的，百灶萧瑟的秋风。","id":480},{"type":"dialog","id":481},{"type":"charslot","id":482},{"type":"charslot","slot":"m","name":"avg_1050_chen3_1#10$1","text":"","id":483},{"type":"dialogue","name":"陈晖洁","text":"泪锋之剑......","id":484},{"type":"charslot","slot":"m","name":"char_2005_weiyw_1#5","focus":"m","id":485},{"type":"dialogue","name":"魏彦吾","text":"......当弃即弃。","id":486,"figure":"https://media.prts.wiki/a/ae/Avg_char_2005_weiyw_5.png"},{"type":"stopsound","channel":"rain","fadetime":"2","id":487},{"type":"stopsound","channel":"ra","fadetime":"2","id":488},{"type":"dialog","id":489},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":490},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":491},{"type":"avgdisplay","id":492},{"type":"stopmusic","fadetime":"2","id":493},{"type":"charslot","id":494},{"type":"background","id":495},{"type":"image","id":496}],"characters":["筋疲力竭的守军","惶恐不安的守军","禁军","太尉","真龙","魏彦吾","陈","陈晖洁"]}