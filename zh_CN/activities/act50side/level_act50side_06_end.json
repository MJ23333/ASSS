t":"true","block":"false","id":47},{"type":"delay","time":"1","id":48},{"type":"charslot","slot":"m","name":"avg_npc_2105_1#1$1","id":49},{"type":"delay","time":"0.5","id":50},{"type":"playsound","key":"$bodyfalldown3","id":51},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"0,-100","duration":"1","afrom":"1","ato":"0","id":52},{"type":"delay","time":"1","id":53},{"type":"charslot","id":54},{"type":"charslot","slot":"m","name":"avg_npc_2106_1#1$1","focus":"m","id":55},{"type":"dialogue","name":"武士队长","text":"？！","id":56},{"type":"charslot","slot":"m","name":"avg_npc_2107_1#1$1","focus":"m","id":57},{"type":"dialogue","name":"随从武士","text":"队长！","id":58},{"type":"charslot","slot":"m","name":"avg_npc_2106_1#1$1","focus":"m","id":59},{"type":"dialogue","name":"武士队长","text":"你这蠢货怎么回来了！","id":60},{"type":"charslot","slot":"m","name":"avg_npc_2107_1#1$1","focus":"m","id":61},{"type":"dialogue","name":"随从武士","text":"我......我，我不是逃跑，我是去找帮手了！","id":62},{"type":"dialogue","name":"随从武士","text":"将军不是总说，为了活下去，做什么都不丢人！","id":63},{"type":"charslot","slot":"m","name":"avg_npc_2106_1#1$1","focus":"m","id":64},{"type":"dialogue","name":"武士队长","text":"你这蠢货！你去找帮手，不是害了别人吗！","id":65},{"type":"charslot","slot":"m","name":"avg_npc_2107_1#1$1","focus":"m","id":66},{"type":"dialogue","name":"随从武士","text":"不是的！","id":67},{"type":"charslot","id":68},{"type":"dialogue","name":"远处的声音","text":"你们几个，闪开！","id":69},{"type":"dialog","id":70},{"type":"playsound","key":"$d_avg_shipcannon","id":71},{"type":"delay","time":"1","id":72},{"type":"playsound","key":"$d_avg_explosion","id":73},{"type":"camerashake","duration":"1","xstrength":"60","ystrength":"60","vibrato":"80","randomness":"90","fadeout":"true","block":"false","id":74},{"type":"delay","time":"1.5","id":75},{"type":"charslot","slot":"m","name":"avg_npc_2106_1#1$1","focus":"m","id":76},{"type":"dialogue","name":"武士队长","text":"这是......远程炮击？！","id":77},{"type":"charslot","id":78},{"type":"dialog","id":79},{"type":"playsound","key":"$d_avg_steammachine_footstep","channel":"3","id":80},{"type":"stopsound","channel":"3","fadetime":"5.2","id":81},{"type":"charslot","slot":"m","name":"avg_npc_2103_1#1$1","afrom":"0","ato":"1","duration":"3","id":82},{"type":"delay","time":"3","id":83},{"type":"text","text":"斑弥罗坐在一台样子十分滑稽的机器上。","id":84},{"type":"text","text":"那是一台通体由竹子构成的机械，外形像是载具，简直让人怀疑它究竟是如何运转起来的。","id":85},{"type":"text","text":"但任谁都不会小看这台机器，因为，它炮管上冒着的硝烟，证明刚才那一发强力的炮击正是它的杰作。","id":86},{"type":"charslot","slot":"m","name":"avg_npc_2106_1#1$1","focus":"m","id":87},{"type":"dialogue","name":"武士队长","text":"斑弥罗大人？！","id":88},{"type":"charslot","slot":"m","name":"avg_npc_2103_1#1$1","focus":"m","id":89},{"type":"dialogue","name":"斑弥罗","text":"这就是以空爆的那把远程武器为蓝本，我本人亲自研发，并最终得出的成果！","id":90},{"type":"dialogue","name":"斑弥罗","text":"看到了吗！它一发就消灭了这么多被“诅咒”的野兽！","id":91},{"type":"dialogue","name":"斑弥罗","text":"我把它命名为“斑弥罗特制击龙枪”！","id":92},{"type":"dialog","id":93},{"type":"stopmusic","fadetime":"2","id":94},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":95},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":96},{"type":"dialog","id":97},{"type":"charslot","id":98},{"type":"background","screenadapt":"coverall","id":99},{"type":"delay","time":"2","id":100},{"type":"playmusic","intro":"$darkness01_intro","key":"https://static.prts.wiki/music/music/beta1_180603/m_dia_darkness01_loop.mp3","volume":"0.6","id":101,"musicid":1},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":102},{"type":"delay","time":"1","id":103},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":104},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#7$2","afrom":"0","ato":"1","duration":"1.5","id":105},{"type":"delay","time":"2","id":106},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#7$2","focus":"m","id":107},{"type":"dialogue","name":"空爆","text":"地下居然有这样宽阔的空间。","id":108},{"type":"dialog","id":109},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#1$2","focus":"m","id":110},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"-150,0","duration":"1.5","focus":"m","id":111},{"type":"delay","time":"1.5","id":112},{"type":"playsound","key":"$d_avg_walk_water","channel":"1","id":113},{"type":"stopsound","channel":"1","fadetime":"1","id":114},{"type":"delay","time":"1","id":115},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#7$2","focus":"m","id":116},{"type":"dialogue","name":"空爆","text":"嘶——这水好冷！","id":117},{"type":"dialog","id":118},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#1$2","focus":"m","id":119},{"type":"charslot","slot":"m","posfrom":"-150,0","posto":"150,0","duration":"1.5","focus":"m","id":120},{"type":"delay","time":"1.5","id":121},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#7$2","focus":"m","id":122},{"type":"playsound","key":"$d_avg_walk_water","channel":"2","id":123},{"type":"stopsound","channel":"2","fadetime":"1","id":124},{"type":"charslot","slot":"m","posfrom":"150,0","posto":"150,50","duration":"0.3","focus":"m","id":125},{"type":"delay","time":"0.3","id":126},{"type":"charslot","slot":"m","posfrom":"150,50","posto":"150,0","duration":"0.3","focus":"m","id":127},{"type":"delay","time":"0.3","id":128},{"type":"charslot","slot":"m","posfrom":"150,0","posto":"150,50","duration":"0.3","focus":"m","id":129},{"type":"delay","time":"0.3","id":130},{"type":"charslot","slot":"m","posfrom":"150,50","posto":"150,0","duration":"0.3","focus":"m","id":131},{"type":"delay","time":"0.3","id":132},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#7$2","focus":"m","id":133},{"type":"dialogue","name":"空爆","text":"但是这边的水居然是热的！为什么？","id":134},{"type":"charslot","id":135},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$1","focus":"m","id":136},{"type":"playsound","key":"$MHR_cat_voice1","volume":"1","id":137},{"type":"dialogue","name":"政宗","text":"泡影国周边的地形比较特殊喵。","id":138},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$7","focus":"m","id":139},{"type":"dialogue","name":"政宗","text":"雪山之下，有一条熔岩带喵，那里也是普通的熔火蜗栖息的地方，我们现在已经穿过了那一带喵。","id":140},{"type":"dialog","id":141},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#1$2","focus":"m","id":142},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"0,-40","duration":"1.5","focus":"m","id":143},{"type":"delay","time":"1.5","id":144},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#7$2","focus":"m","id":145},{"type":"dialogue","name":"空爆","text":"宝巫迦，快看，这些苔藓会发光欸！","id":146},{"type":"charslot","id":147},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#8$1","focus":"m","id":148},{"type":"dialogue","name":"宝巫迦","text":"嗯。","id":149},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#10$2","focus":"m","id":150},{"type":"dialogue","name":"梓兰","text":"空爆，你能不能别像个第一次出来露营的小朋友一样......","id":151},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#5$2","focus":"m","id":152},{"type":"multiline","name":"空爆","text":"但这很有趣啊，","id":153},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#4$2","focus":"m","id":154},{"type":"multiline","name":"空爆","text":"对吧，宝巫迦？","id":155},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#4$1","focus":"m","id":156},{"type":"dialogue","name":"宝巫迦","text":"嗯。","id":157},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#11$2","focus":"m","id":158},{"type":"dialogue","name":"梓兰","text":"宝巫迦......","id":159},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#4$1","focus":"m","id":160},{"type":"dialogue","name":"宝巫迦","text":"吾没事，放心吧。","id":161},{"type":"charslot","slot":"m","name":"avg_4215_buddyD_1#1$2","focus":"m","id":162},{"type":"dialogue","name":"义经","text":"（嗅嗅）","id":163},{"type":"dialog","id":164},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"100,0","duration":"1.5","focus":"m","id":165},{"type":"delay","time":"2","id":166},{"type":"playsound","key":"$MHR_dog_voice2","id":167},{"type":"charslot","slot":"m","name":"avg_4215_buddyD_1#1$1","focus":"m","id":168},{"type":"dialogue","name":"义经","text":"（提醒的低吼）","id":169},{"type":"charslot","id":170},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$5","focus":"m","id":171},{"type":"playsound","key":"$MHR_cat_voice1","volume":"1","id":172},{"type":"dialogue","name":"政宗","text":"......果然没错喵。","id":173},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$7","focus":"m","id":174},{"type":"dialogue","name":"政宗","text":"这里是我们曾经用来中途休息的营地，狩猎雷狼龙的过程远比想象中艰辛，前代陛下组织了数次远征喵。","id":175},{"type":"dialogue","name":"政宗","text":"每一次，我们都会使用这个营地。找到这里，说明我们的方向没有错喵。","id":176},{"type":"charslot","id":177},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#3$2","focus":"m","id":178},{"type":"dialogue","name":"梓兰","text":"......等等，这个营地，怎么看起来——","id":179},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$5","focus":"m","id":180},{"type":"dialogue","name":"政宗","text":"是的，这个营地，并不是我们搭建的，而是更加久远的古代就存在于这里了喵......","id":181},{"type":"dialogue","name":"政宗","text":"我们当时也只是借用了这里喵。","id":182},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#1$1","focus":"m","id":183},{"type":"dialogue","name":"宝巫迦","text":"......","id":184},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#4$2","focus":"m","id":185},{"type":"dialogue","name":"梓兰","text":"怎么了，宝巫迦？","id":186},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#8$1","focus":"m","id":187},{"type":"dialogue","name":"宝巫迦","text":"在泡影国的历史中，有过这样一段记载——","id":188},{"type":"charslot","id":189},{"type":"dialog","id":190},{"type":"blocker","a":"0.6","r":"0","g":"0","b":"0","fadetime":"0.7","block":"true","id":191},{"type":"sticker","id":192,"multi":"true","text":"昔御轮失律，祸触八荒，日月无光；","x":"270","y":"300","alignment":"center","size":"24","delay":"0.04","width":"750","block":"true"},{"type":"sticker","id":193,"multi":"true","text":"\\n\\n遗民弃旧壤，卜新土，以存祚至今。","block":"true"},{"type":"sticker","id":194,"duration":"0"},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.7","block":"true","id":195},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$3","focus":"m","id":196},{"type":"playsound","key":"$MHR_cat_voice1","volume":"1","id":197},{"type":"dialogue","name":"政宗","text":"前面就是前代陛下失踪的地方了喵。那里太危险了，月见夜原本想再等几年，积蓄足够的力量再进去喵。","id":198},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#8$1","focus":"m","id":199},{"type":"dialogue","name":"宝巫迦","text":"月见夜......","id":200},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#6$1","focus":"m","id":201},{"type":"dialogue","name":"宝巫迦","text":"“雷之主”，吾定要杀了你......","id":202},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$3","focus":"m","id":203},{"type":"playsound","key":"$MHR_cat_voice3","volume":"1","id":204},{"type":"dialogue","name":"政宗","text":"啊，抱歉喵！","id":205},{"type":"charslot","id":206},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#11$2","focus":"r","id":207},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#13$2","focus":"r","id":208},{"type":"dialogue","name":"空爆","text":"（低声）梓兰姐，怎么办啊！宝巫迦完全是一副听不进去任何话的样子啊！","id":209},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#15$2","focus":"r","id":210},{"type":"dialogue","name":"空爆","text":"（低声）我们陪她进来没用啊，只有月见夜才能阻止她！","id":211},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#9$2","focus":"l","id":212},{"type":"dialogue","name":"梓兰","text":"（低声）我知道。","id":213},{"type":"dialogue","name":"梓兰","text":"（低声）我们要做的就是不让她做傻事。","id":214},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#3$2","focus":"l","id":215},{"type":"dialogue","name":"梓兰","text":"（低声）至于月见夜那边......我做了安排。","id":216},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#7$2","focus":"r","id":217},{"type":"multiline","name":"空爆","text":"（低声）安排？","id":218},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#6$2","focus":"r","id":219},{"type":"multiline","name":"空爆","text":"难道说......我看到你在出发之前写了点什么，交给了一个士兵，","id":220},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#7$2","focus":"r","id":221},{"type":"multiline","name":"空爆","text":"难道......","id":222},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#8$2","focus":"l","id":223},{"type":"dialogue","name":"梓兰","text":"那是给他的信。","id":224},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#9$2","focus":"l","id":225},{"type":"dialogue","name":"梓兰","text":"我看他不爽很久了。","id":226},{"type":"dialog","id":227},{"type":"stopmusic","fadetime":"2","id":228},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":229},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":230},{"type":"charslot","id":231},{"type":"background","screenadapt":"coverall","block":"true","id":232},{"type":"bg","id":233,"from":"1","to":"1","duration":"0","block":"false"},{"type":"delay","time":"0.5","id":234},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":235},{"type":"curtain","direction":"0","fillfrom":"1","fillto":"0.4","grad":"true","fadetime":"3","id":236},{"type":"curtain","direction":"4","fillfrom":"1","fillto":"0.4","grad":"true","fadetime":"3","id":237},{"type":"delay","time":"3","id":238},{"type":"curtain","direction":"0","fillfrom":"0.4","fillto":"0","grad":"true","fadetime":"3","id":239},{"type":"curtain","direction":"4","fillfrom":"0.4","fillto":"0","grad":"true","fadetime":"3","id":240},{"type":"bg","id":241,"from":"1","to":"0","duration":"2","block":"false"},{"type":"delay","time":"3","id":242},{"type":"dialogue","name":"月见夜","text":"呃啊......","id":243},{"type":"playmusic","intro":"$warm_intro","key":"https://static.prts.wiki/music/music/act9d0d0/m_avg_warm_loop.mp3","volume":"0.6","id":244,"musicid":2},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":245},{"type":"dialogue","name":"斑弥罗","text":"醒了？","id":246},{"type":"dialog","id":247},{"type":"playsound","key":"$d_avg_clothmovement","id":248},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","posfrom":"0,-100","posto":"0,0","duration":"2","id":249},{"type":"delay","time":"2.5","id":250},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","focus":"r","id":251},{"type":"dialogue","name":"月见夜","text":"......","id":252},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":253},{"type":"dialogue","name":"斑弥罗","text":"好歹是醒了，再这么下去，看你的样子都快变“异兽”了。","id":254},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#6$1","focus":"r","id":255},{"type":"dialogue","name":"月见夜","text":"......","id":256},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":257},{"type":"dialogue","name":"斑弥罗","text":"感觉怎么样？","id":258},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#1$1","focus":"r","id":259},{"type":"dialogue","name":"月见夜","text":"计划呢？","id":260},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":261},{"type":"dialogue","name":"斑弥罗","text":"放心吧，你的计划成功了。","id":262},{"type":"dialogue","name":"斑弥罗","text":"大部分野兽都掉进了那个大坑里，嘿，我造的炸药厉害吧？","id":263},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#6$1","focus":"r","id":264},{"type":"dialogue","name":"月见夜","text":"......厉害过头了。","id":265},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#4$1","focus":"r","id":266},{"type":"dialogue","name":"月见夜","text":"陛下，还有“异兽猎人”们，他们现在......","id":267},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":268},{"type":"dialogue","name":"斑弥罗","text":"他们看到你半死不活的样子，已经出发去狩猎“雷之主”了。","id":269},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","focus":"r","id":270},{"type":"dialogue","name":"月见夜","text":"什么？！","id":271},{"type":"dialog","id":272},{"type":"charslot","slot":"r","posfrom":"0,0","posto":"-10,0","duration":"1","focus":"r","id":273},{"type":"delay","time":"1","id":274},{"type":"shake","name":"right","power":"5","times":"70","fadetime":"0.3","block":"false","id":275},{"type":"delay","time":"0.5","id":276},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":277},{"type":"dialogue","name":"斑弥罗","text":"你也不用太担心，梓兰和空爆，还有政宗、义经都一起去了。","id":278},{"type":"dialogue","name":"斑弥罗","text":"说起来梓兰这个人还真是不得了。","id":279},{"type":"dialogue","name":"斑弥罗","text":"嘴上总是说着讨厌承担责任的话，到了关键时刻，她却第一个站了出来。","id":280},{"type":"dialogue","name":"斑弥罗","text":"听当时在场的士兵说，看到你的那副样子，原本陛下已经接近崩溃了，但梓兰出面稳住了局势。","id":281},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","focus":"r","id":282},{"type":"dialogue","name":"月见夜","text":"陛下去狩猎“雷之主”......是因为我？","id":283},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":284},{"type":"dialogue","name":"斑弥罗","text":"是啊，是因为你。","id":285},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#9$1","focus":"r","id":286},{"type":"dialogue","name":"月见夜","text":"......","id":287},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#7$1","focus":"r","id":288},{"type":"dialogue","name":"月见夜","text":"我为了不让陛下独自冒险狩猎“雷之主”，苦心经营了十年......","id":289},{"type":"dialogue","name":"月见夜","text":"到头来，竟然还是我亲手将陛下送上了这条道路。","id":290},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#9$1","focus":"r","id":291},{"type":"dialogue","name":"月见夜","text":"这就是巫女的宿命吗？","id":292},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":293},{"type":"dialogue","name":"斑弥罗","text":"我还以为你听说陛下去狩猎“雷之主”了，恨不得立刻跳起来去她身边呢。","id":294},{"type":"dialogue","name":"斑弥罗","text":"你不是害怕她去冒险吗？","id":295},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#6$1","focus":"r","id":296},{"type":"dialogue","name":"月见夜","text":"......你不明白，斑弥罗。","id":297},{"type":"dialogue","name":"月见夜","text":"我害怕的，从来不是陛下做不到。","id":298},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#7$1","focus":"r","id":299},{"type":"dialogue","name":"月见夜","text":"我害怕的恰恰是陛下做得到......即使那需要代价，但是，陛下会毫不犹豫地支付那种代价。","id":300},{"type":"dialogue","name":"月见夜","text":"就像前代陛下那样，毫不犹豫地消失在了我们的眼前，再也没有回来。","id":301},{"type":"dialogue","name":"月见夜","text":"我比任何人都敬爱前代陛下，所以我知道，在她的心中......有你，有我，有这个国家的所有人，唯独没有自己。","id":302},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#9$1","focus":"r","id":303},{"type":"dialogue","name":"月见夜","text":"而宝巫迦陛下继承了这份责任感。","id":304},{"type":"dialogue","name":"月见夜","text":"我希望为陛下分担这份责任，我希望为她提供一个选择——当她想要支付代价时，有人能够替她承担这份代价。","id":305},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#7$1","focus":"r","id":306},{"type":"dialogue","name":"月见夜","text":"但现在......呵，哈哈......","id":307},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":308},{"type":"dialogue","name":"斑弥罗","text":"......没想到真和梓兰说的一样。","id":309},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","focus":"r","id":310},{"type":"dialogue","name":"月见夜","text":"什么？","id":311},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":312},{"type":"dialogue","name":"斑弥罗","text":"她托武士告诉我，你醒来肯定会很消沉，让我关照你一下。","id":313},{"type":"dialogue","name":"斑弥罗","text":"要不然我才懒得来找你。","id":314},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#4$1","focus":"r","id":315},{"type":"dialogue","name":"月见夜","text":"......哈。","id":316},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":317},{"type":"dialogue","name":"斑弥罗","text":"她写了一封信，你自己看吧。","id":318},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","focus":"r","id":319},{"type":"dialogue","name":"月见夜","text":"......什么？","id":320},{"type":"dialog","id":321},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"70,0","duration":"1.5","focus":"l","id":322},{"type":"delay","time":"1.5","id":323},{"type":"playsound","key":"$d_avg_paper1","volume":"1","id":324},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":325},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":326},{"type":"dialog","id":327},{"type":"charslot","id":328},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#8$1","posfrom":"0,0","posto":"-120,0","duration":"0","id":329},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#4$1","posfrom":"0,0","posto":"120,0","duration":"0","id":330},{"type":"largebg","imagegroup":"71_g7_undergroundriver/71_g2_impermanence_room","solidwidth":"1280/1280","solidheight":"720","x":"-640","fadetime":"0","block":"true","id":331},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":332},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#8$1","focus":"l","id":333},{"type":"dialogue","name":"梓兰","text":"你醒了之后，要是听说宝巫迦跟我们一起出发了，肯定会觉得自己这么多年的努力毫无意义，然后心灰意冷吧。","id":334},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#9$1","focus":"l","id":335},{"type":"dialogue","name":"梓兰","text":"如果我猜对了，那我有一句话要告诉你——","id":336},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#4$1","focus":"r","id":337},{"type":"dialogue","name":"月见夜","text":"梓兰小姐......","id":338},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#5$1","focus":"l","id":339},{"type":"dialogue","name":"梓兰","text":"既然要装好人，那就给我装到底，你这个胆小鬼！","id":340},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","focus":"r","id":341},{"type":"dialogue","name":"月见夜","text":"梓兰小姐？！","id":342},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#9$1","focus":"l","id":343},{"type":"dialogue","name":"梓兰","text":"我一开始还觉得你跟他不一样，现在看来，你和那家伙简直是一模一样！","id":344},{"type":"dialogue","name":"梓兰","text":"死要面子，非要在别人面前装模作样。嘴上说着想要给所有人带去笑容，等到撑不住了，又自顾自地放弃，想要逃跑。","id":345},{"type":"dialogue","name":"梓兰","text":"你觉得宝巫迦会感谢你的付出？你以为前代陛下如果还活着，会感怀你的牺牲？","id":346},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#5$1","focus":"l","id":347},{"type":"dialogue","name":"梓兰","text":"开什么玩笑？","id":348},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#9$1","focus":"l","id":349},{"type":"dialogue","name":"梓兰","text":"如果在你的心中，前代陛下和宝巫迦将一切都揽在了自己身上，那么，我问你——","id":350},{"type":"dialogue","name":"梓兰","text":"你的做法和她们有什么区别？","id":351},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#9$1","focus":"r","id":352},{"type":"dialogue","name":"月见夜","text":"......","id":353},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#8$1","focus":"l","id":354},{"type":"dialogue","name":"梓兰","text":"是，你追随前代陛下多年，你看着宝巫迦长大，你比谁都了解她们，对，但是那又怎么样呢？","id":355},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#5$1","focus":"l","id":356},{"type":"dialogue","name":"梓兰","text":"难道在你的心目中，前代陛下和宝巫迦都是不明事理的人，你月见夜才是那个识大体的人？","id":357},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#6$1","focus":"r","id":358},{"type":"dialogue","name":"月见夜","text":"可是......宝巫迦陛下也好，前代陛下也好，并没有错，一直以来，泡影国的国主，“御轮”的巫女，都是这样行事的，我无法说服她们。","id":359},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#6$1","focus":"l","id":360},{"type":"dialogue","name":"梓兰","text":"你是没有办法说服她们，还是你其实不想说服她们？","id":361},{"type":"dialogue","name":"梓兰","text":"你是真的在为她们着想，还是你的心里也和她们一样，想着只要我做出牺牲，一切都会好起来的？","id":362},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#9$1","focus":"r","id":363},{"type":"dialogue","name":"月见夜","text":"我没有。","id":364},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#6$1","focus":"r","id":365},{"type":"dialogue","name":"月见夜","text":"......不，我确实是这么想的。","id":366},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#8$1","focus":"l","id":367},{"type":"multiline","name":"梓兰","text":"我不是想要责怪你，","id":368},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#9$1","focus":"l","id":369},{"type":"multiline","name":"梓兰","text":"好吧，我确实有点生气，但你自己也该明白，你没有错，但是，你也没有对。","id":370},{"type":"dialogue","name":"梓兰","text":"宝巫迦也是这样，明明还有一个方法，而你们两个好像默认这个方法不存在一样，就那么自顾自地选择了自己的方法。","id":371},{"type":"dialogue","name":"梓兰","text":"不仅如此，你们还宣称，是对方不想选择这个方法。","id":372},{"type":"dialogue","name":"梓兰","text":"无论你们自己怎么想，但在我这个“外人”看来，事情就是这样。","id":373},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","focus":"r","id":374},{"type":"dialogue","name":"月见夜","text":"......","id":375},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#9$1","focus":"l","id":376},{"type":"dialogue","name":"梓兰","text":"我不会要求你做什么事，月见夜。我只希望你冷静下来好好想想——你究竟能为宝巫迦做些什么？","id":377},{"type":"charslot","slot":"l","name":"avg_1048_orchd2_1#8$1","focus":"l","id":378},{"type":"dialogue","name":"梓兰","text":"为她而死，可以，如果这是你深思熟虑的结果，我不会拦着你。","id":379},{"type":"dialogue","name":"梓兰","text":"但是，应该还有别的事情可以做吧？","id":380},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#4$1","focus":"r","id":381},{"type":"dialogue","name":"月见夜","text":"我——","id":382},{"type":"dialog","id":383},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":384},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":385},{"type":"dialog","id":386},{"type":"charslot","id":387},{"type":"largebg","id":388},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","id":389},{"type":"background","screenadapt":"coverall","id":390},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":391},{"type":"delay","time":"2","id":392},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"n","id":393},{"type":"dialogue","name":"月见夜","text":"......斑弥罗，能扶我一把吗？","id":394},{"type":"dialog","id":395},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"100,0","duration":"1","id":396},{"type":"delay","time":"1","id":397},{"type":"playsound","key":"$d_avg_clothmovement","id":398},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#2$1","posfrom":"0,-100","posto":"0,0","duration":"1.5","id":399},{"type":"delay","time":"2","id":400},{"type":"charslot","slot":"l","posfrom":"100,0","posto":"0,0","duration":"1","id":401},{"type":"delay","time":"1","id":402},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#9$1","focus":"r","id":403},{"type":"dialogue","name":"月见夜","text":"梓兰小姐说得对。","id":404},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#7$1","focus":"r","id":405},{"type":"dialogue","name":"月见夜","text":"明明是存在那样一个方法的，我却因为不信任陛下而选择了独自承担一切。","id":406},{"type":"dialogue","name":"月见夜","text":"在我内心深处，总是将陛下当作一个需要被保护的孩子，我自大地以为，只有我看到了陛下强大背后的脆弱，可事实并非如此。","id":407},{"type":"dialogue","name":"月见夜","text":"我太顾自己的感受了。","id":408},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","focus":"l","id":409},{"type":"dialogue","name":"斑弥罗","text":"不，你和陛下一样，你们都太不顾自己，搞得别人不得不为你们操心。","id":410},{"type":"dialog","id":411},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":412},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":413},{"type":"dialog","id":414},{"type":"charslot","id":415},{"type":"background","screenadapt":"coverall","id":416},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":417},{"type":"delay","time":"2","id":418},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":419},{"type":"charslot","slot":"m","name":"avg_npc_2101_1#1$1","focus":"m","afrom":"0","ato":"1","duration":"1.5","id":420},{"type":"delay","time":"2","id":421},{"type":"charslot","id":422},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":423},{"type":"charslot","slot":"m","name":"avg_npc_2103_1#1$1","focus":"m","afrom":"0","ato":"1","duration":"1.5","id":424},{"type":"delay","time":"2","id":425},{"type":"charslot","slot":"m","name":"avg_npc_2103_1#1$1","focus":"m","id":426},{"type":"dialogue","name":"斑弥罗","text":"这十年来，每个猎人在进入狩猎团后学到的第一课，就是自己是为了让陛下能够狩猎“雷之主”而存在的。","id":427},{"type":"dialogue","name":"斑弥罗","text":"这很残忍，因为他们将不再为了自己而磨练技艺，也不再为了自己而狩猎，我讨厌这种事，所以我从来也没有想过加入狩猎团。","id":428},{"type":"dialogue","name":"斑弥罗","text":"但是，这十年来，没有人离开狩猎团。","id":429},{"type":"dialogue","name":"斑弥罗","text":"因为，他们看得到，你，月见夜将军，是那个对自己最狠的人。如果有一天，有人要为陛下的狩猎之路献出生命，你一定是第一个。","id":430},{"type":"charslot","id":431},{"type":"text","text":"越来越多的武士在月见夜的身后聚集，月见夜当然认得他们，他们都是他手下的精锐。","id":432},{"type":"charslot","slot":"m","name":"avg_npc_2107_1#1$1","focus":"m","id":433},{"type":"dialogue","name":"随从武士","text":"请下令吧，将军。","id":434},{"type":"dialogue","name":"随从武士","text":"斑弥罗大人开发的武器成功助我们抵御了兽潮，让我们去陛下的身边吧！","id":435},{"type":"charslot","slot":"m","name":"avg_npc_2101_1#1$1","focus":"m","id":436},{"type":"dialogue","name":"月见夜","text":"我能......为陛下做些什么......","id":437},{"type":"charslot","slot":"m","name":"avg_npc_2101_1#9$1","focus":"m","id":438},{"type":"dialogue","name":"月见夜","text":"......","id":439},{"type":"dialog","id":440},{"type":"stopmusic","fadetime":"2","id":441},{"type":"playsound","key":"$flashback","volume":"0.8","id":442},{"type":"blocker","a":"0","r":"1","g":"1","b":"1","fadetime":"0","block":"true","id":443},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"1","block":"true","id":444},{"type":"charslot","id":445},{"type":"charslot","slot":"m","name":"avg_npc_2102_1#1$2","focus":"m","id":446},{"type":"background","screenadapt":"coverall","id":447},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":448},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":449},{"type":"delay","time":"2","id":450},{"type":"playsound","key":"$flashback","volume":"0.8","id":451},{"type":"blocker","a":"0","r":"1","g":"1","b":"1","fadetime":"0","block":"true","id":452},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"1","block":"true","id":453},{"type":"charslot","id":454},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":455},{"type":"charslot","slot":"m","name":"avg_npc_2101_1#9$1","focus":"m","id":456},{"type":"background","screenadapt":"coverall","id":457},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":458},{"type":"delay","time":"1","id":459},{"type":"playmusic","intro":"$loneliness_intro","key":"https://static.prts.wiki/music/music/static/m_avg/m_avg_loneliness_loop.mp3","volume":"0.6","id":460,"musicid":3},{"type":"charslot","slot":"m","name":"avg_npc_2101_1#2$1","focus":"m","id":461},{"type":"dialogue","name":"月见夜","text":"那个时候......为什么......","id":462},{"type":"charslot","slot":"m","name":"avg_npc_2101_1#9$1","focus":"m","id":463},{"type":"dialogue","name":"月见夜","text":"难道说......不，这怎么可能......","id":464},{"type":"charslot","slot":"m","name":"avg_npc_2103_1#1$1","focus":"m","id":465},{"type":"dialogue","name":"斑弥罗","text":"怎么了？","id":466},{"type":"charslot","slot":"m","name":"avg_npc_2101_1#9$1","focus":"m","id":467},{"type":"dialogue","name":"月见夜","text":"......斑弥罗。","id":468},{"type":"charslot","slot":"m","name":"avg_npc_2101_1#1$1","focus":"m","id":469},{"type":"dialogue","name":"月见夜","text":"我需要尽快赶到陛下身边......有一件事，我必须告诉陛下。","id":470},{"type":"dialog","id":471},{"type":"delay","time":"1","id":472},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":473},{"type":"bgeffect","id":474},{"type":"stopmusic","fadetime":"2","id":475},{"type":"image","id":476},{"type":"charslot","id":477}],"characters":["武士队长","随从武士","远处的声音","斑弥罗","空爆","政宗","宝巫迦","梓兰","义经","月见夜"]}