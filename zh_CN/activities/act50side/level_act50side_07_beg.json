ation":"0.7","xstrength":"60","ystrength":"60","vibrato":"60","randomness":"80","fadeout":"true","block":"false","id":431},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"0.1","block":"true","id":432},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"false","id":433},{"type":"delay","time":"0.1","id":434},{"type":"playsound","key":"$MHR_normalpunch_voice","volume":"1","id":435},{"type":"delay","time":"0.01","id":436},{"type":"playsound","key":"$MHR_normalpunch_echo","volume":"1","id":437},{"type":"delay","time":"0.01","id":438},{"type":"playsound","key":"$MHR_normalpunch_hit","volume":"1","id":439},{"type":"delay","time":"1.5","id":440},{"type":"charslot","id":441},{"type":"bgeffect","name":"$eb_smock","layer":"1","id":442},{"type":"playsound","key":"$MHR_normalroar1","volume":"1","id":443},{"type":"charslot","slot":"m","name":"avg_npc_2102_1#1$2","focus":"m","id":444},{"type":"delay","time":"1.5","id":445},{"type":"charslot","id":446},{"type":"bgeffect","id":447},{"type":"playsound","key":"$d_avg_clothmovement","id":448},{"type":"camerashake","duration":"1","xstrength":"60","ystrength":"0","vibrato":"60","randomness":"80","fadeout":"true","block":"false","id":449},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#11$1","posfrom":"0,-100","posto":"0,0","afrom":"0","ato":"1","duration":"1","focus":"m","id":450},{"type":"delay","time":"1.5","id":451},{"type":"dialogue","name":"宝巫迦","text":"你果然很强大。","id":452},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#6$1","focus":"m","id":453},{"type":"dialogue","name":"宝巫迦","text":"既然如此——","id":454},{"type":"playsound","key":"$d_avg_purifymagic","volume":"1","channel":"5","id":455},{"type":"dialog","id":456},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"0.1","block":"true","id":457},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"false","id":458},{"type":"bgeffect","name":"$eb_light","x":"-9","y":"-67","layer":"1","id":459},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#8$1","focus":"m","id":460},{"type":"stopsound","channel":"5","fadetime":"2.5","id":461},{"type":"delay","time":"2.5","id":462},{"type":"bgeffect","id":463},{"type":"text","text":"巫女的力量在这一刻完全爆发，光芒在一瞬间将她包裹，并迅速蔓延，将“雷之主”也笼罩其中。","id":464},{"type":"dialog","id":465},{"type":"camerashake","duration":"2","xstrength":"70","ystrength":"70","vibrato":"70","randomness":"95","fadeout":"true","block":"false","id":466},{"type":"bgeffect","name":"$eb_smock","layer":"1","id":467},{"type":"playsound","key":"$MHR_ridedragon_roar","volume":"1","id":468},{"type":"charslot","slot":"m","name":"avg_npc_2102_1#1$2","focus":"m","id":469},{"type":"delay","time":"2","id":470},{"type":"charslot","id":471},{"type":"bgeffect","id":472},{"type":"bgeffect","name":"$eb_light","x":"-9","y":"-67","layer":"1","id":473},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#10$1","focus":"m","id":474},{"type":"dialogue","name":"宝巫迦","text":"咕——","id":475},{"type":"dialogue","name":"宝巫迦","text":"果然，没那么顺利......","id":476},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#8$1","focus":"m","id":477},{"type":"dialogue","name":"宝巫迦","text":"但是，吾早已做好心理准备。","id":478},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#11$1","focus":"m","id":479},{"type":"dialogue","name":"宝巫迦","text":"如果无法夺回你身上属于母亲的力量，那么，至少吾可以......","id":480},{"type":"dialog","id":481},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":482},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1.5","block":"true","id":483},{"type":"bgeffect","id":484},{"type":"background","screenadapt":"coverall","id":485},{"type":"charslot","id":486},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#10$2","focus":"m","id":487},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"false","fadetime":"1.5","block":"true","id":488},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#10$2","focus":"m","id":489},{"type":"dialogue","name":"梓兰","text":"她身上发出的光是怎么回事？！她在使用她的力量吸收“雷之主”身上的“诅咒”吗？","id":490},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#8$2","focus":"m","id":491},{"type":"dialogue","name":"空爆","text":"不......不对！吸收“诅咒”并不是这样！","id":492},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$4","focus":"m","id":493},{"type":"playsound","key":"$MHR_cat_voice2","volume":"1","id":494},{"type":"dialogue","name":"政宗","text":"这是......她正在用自身巫女的力量和雷狼龙身上属于前代陛下的巫女力量共鸣喵！","id":495},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#4$2","focus":"m","id":496},{"type":"dialogue","name":"梓兰","text":"共鸣......？难道说——","id":497},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#5$2","focus":"m","id":498},{"type":"dialogue","name":"梓兰","text":"她想要和“雷之主”同归于尽？！","id":499},{"type":"playsound","key":"$MHR_dog_voice1","volume":"0.8","id":500},{"type":"charslot","slot":"m","name":"avg_4215_buddyD_1#1$5","focus":"m","id":501},{"type":"dialogue","name":"义经","text":"（焦急的吼叫）","id":502},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$4","focus":"m","id":503},{"type":"playsound","key":"$MHR_cat_voice2","volume":"1","id":504},{"type":"dialogue","name":"政宗","text":"不行喵！受到这股力量的牵引，那些从天坑陷落的咒鬼和被“诅咒”侵染的野兽都在往祭坛方向聚集喵！","id":505},{"type":"dialogue","name":"政宗","text":"再这样下去，陛下要被兽潮淹没了喵！","id":506},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#9$2","focus":"m","id":507},{"type":"dialogue","name":"梓兰","text":"必须想办法先阻止兽潮接近宝巫迦。","id":508},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#15$2","focus":"m","id":509},{"type":"dialogue","name":"空爆","text":"但是，怎么办？！这里离那座祭坛太远了！用翔虫也来不及啊！","id":510},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#9$2","focus":"m","id":511},{"type":"dialogue","name":"梓兰","text":"空爆，政宗，你们骑着义经去兽潮的必经之路，那座祭坛的正下方，帮我拖延一点时间！","id":512},{"type":"charslot","slot":"m","name":"avg_4215_buddyC_1#1$4","focus":"m","id":513},{"type":"dialogue","name":"政宗","text":"喵？！但是——","id":514},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#9$2","focus":"m","id":515},{"type":"dialogue","name":"梓兰","text":"没空解释了，相信我！","id":516},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#12$2","focus":"m","id":517},{"type":"dialogue","name":"空爆","text":"我们走，义经，政宗！","id":518},{"type":"dialog","id":519},{"type":"playsound","key":"$rungeneral","volume":"1","channel":"4","id":520},{"type":"stopsound","channel":"4","fadetime":"1.5","id":521},{"type":"charslot","slot":"m","posfrom":"0,0","posto":"150,0","afrom":"1","ato":"0","duration":"1.5","id":522},{"type":"delay","time":"2","id":523},{"type":"charslot","id":524},{"type":"playsound","key":"$rungeneral","volume":"1","channel":"5","id":525},{"type":"stopsound","channel":"5","fadetime":"1.5","id":526},{"type":"charslot","slot":"l","name":"avg_4215_buddyD_1#1$1","id":527},{"type":"charslot","slot":"r","name":"avg_4215_buddyC_1#1$5","id":528},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"150,0","afrom":"1","ato":"0","duration":"1.5","id":529},{"type":"charslot","slot":"r","posfrom":"0,0","posto":"150,0","afrom":"1","ato":"0","duration":"1.5","id":530},{"type":"delay","time":"2","id":531},{"type":"charslot","id":532},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#3$2","focus":"m","id":533},{"type":"dialogue","name":"梓兰","text":"......","id":534},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#8$2","focus":"m","id":535},{"type":"dialogue","name":"梓兰","text":"唉......","id":536},{"type":"dialogue","name":"梓兰","text":"一个两个，都是不让人省心的家伙。","id":537},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#6$2","focus":"m","id":538},{"type":"dialogue","name":"梓兰","text":"这个位置......这个角度......应该还来得及。","id":539},{"type":"dialog","id":540},{"type":"stopmusic","fadetime":"2","id":541},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":542},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":543},{"type":"dialog","id":544},{"type":"charslot","id":545},{"type":"delay","time":"2","id":546},{"type":"effect","name":"$e_spark_01_large","layer":"2","id":547},{"type":"playsound","key":"$MHR_dragonarrow_ground","volume":"1","channel":"ground","id":548},{"type":"delay","time":"0.7","id":549},{"type":"image","image":"71_i06","screenadapt":"coverall","fadetime":"0","id":550},{"type":"image","image":"71_i06","fadetime":"0","xScale":"1.1","yScale":"1.1","id":551},{"type":"imagetween","image":"71_i06","xScaleTo":"1","yScaleTo":"1","duration":"30","id":552},{"type":"delay","time":"0.5","id":553},{"type":"playsound","key":"$MHR_dragonarrow_charge","volume":"1","channel":"charge","id":554},{"type":"delay","time":"0.01","id":555},{"type":"playmusic","intro":"$newhope02_intro","key":"https://static.prts.wiki/music/music/beta3_181101/m_dia_newhope02_loop.mp3","volume":"0.6","id":556,"musicid":3},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":557},{"type":"delay","time":"1","id":558},{"type":"text","text":"在看到这个空间的瞬间，梓兰已经想到了解决方法。","id":559},{"type":"text","text":"她举起弓，对准远处的岩壁，那里有一大片尖锐的岩刺，恰好在那些咒鬼的必经之路上。","id":560},{"type":"text","text":"要击落这些岩刺当然不是一件简单的事，但她敏锐地察觉到了那片岩层的不稳定，只要以足够的力量和足够的精准度击中那里就好。","id":561},{"type":"text","text":"她能做到。","id":562},{"type":"text","text":"连她自己都有些讶异于这份自信，正如在她站出来斥责那些武士和宝巫迦之后，她也很诧异，自己居然会做出那种举动。","id":563},{"type":"text","text":"换作过去的自己，一定不会——吗？","id":564},{"type":"text","text":"她拉开弓，开始蓄力。","id":565},{"type":"text","text":"在这一刻，无数的念头涌上她的脑海，但这些纷乱的念头并没有让她混乱，相反，她感觉自己的精神没有一刻比现在更加集中。","id":566},{"type":"dialog","id":567},{"type":"playsound","key":"$flashback","volume":"0.8","id":568},{"type":"blocker","a":"0","r":"1","g":"1","b":"1","fadetime":"0","block":"true","id":569},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"2","block":"true","id":570},{"type":"charslot","id":571},{"type":"image","id":572},{"type":"background","screenadapt":"coverall","id":573},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":574},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":575},{"type":"delay","time":"1","id":576},{"type":"dialogue","name":"梓兰","text":"一开始，我以为泡影国的他们，是更好的他们。","id":577},{"type":"dialog","id":578},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#1$1","afrom":"0","ato":"1","duration":"1","id":579},{"type":"delay","time":"1","id":580},{"type":"multiline","name":"梓兰","text":"独立自主的泡普卡，","id":581},{"type":"charslot","slot":"l","name":"avg_npc_2103_1#1$1","posfrom":"0,0","posto":"-150,0","afrom":"1","ato":"0","duration":"0","id":582},{"type":"charslot","slot":"l","afrom":"0","ato":"1","duration":"1","id":583},{"type":"delay","time":"1","id":584},{"type":"multiline","name":"梓兰","text":"开朗的斑点，","id":585},{"type":"charslot","slot":"r","name":"avg_npc_2101_1#1$1","posfrom":"0,0","posto":"150,0","afrom":"1","ato":"0","duration":"0","id":586},{"type":"charslot","slot":"r","afrom":"0","ato":"1","duration":"1","id":587},{"type":"delay","time":"1","id":588},{"type":"multiline","name":"梓兰","text":"理性克制的月见夜，","id":589},{"type":"multiline","name":"梓兰","text":"但后来，我发现我错了。","id":590},{"type":"dialogue","name":"梓兰","text":"他们也有各自的问题，而且，本质上和我们认识的他们几乎如出一辙。","id":591},{"type":"dialog","id":592},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":593},{"type":"charslot","id":594},{"type":"background","image":"https://media.prts.wiki/4/48/Avg_bg_bg_room_2.png","screenadapt":"coverall","id":595},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":596},{"type":"dialogue","name":"梓兰","text":"如果泡普卡没有被凯尔希医生带入罗德岛，如果斑点和月见夜没有因为矿石病而加入罗德岛......","id":597},{"type":"dialogue","name":"梓兰","text":"如果他们没有加入A6小队......不，如果我们没有组成A6小队。","id":598},{"type":"dialogue","name":"梓兰","text":"或许他们的性格不会和这里的三个人一样，但他们都会依靠自己坚强地活下去。","id":599},{"type":"dialog","id":600},{"type":"playsound","key":"$flashback","volume":"0.8","id":601},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"1","block":"true","id":602},{"type":"image","image":"71_i06","screenadapt":"coverall","id":603},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":604},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":605},{"type":"dialogue","name":"梓兰","text":"在他们面临困难的时刻，他们能想到的，也只有自己的力量。","id":606},{"type":"dialogue","name":"梓兰","text":"当一个人只有一个选择的时候，这就不是一个选择。","id":607},{"type":"dialogue","name":"梓兰","text":"但我总是告诉自己，你依然要尊重这样的他们。","id":608},{"type":"dialogue","name":"梓兰","text":"所以，我会劝告别人，却不会阻止别人，我只会在他们失败的时候，帮助他们。我把这当做一种尊重。","id":609},{"type":"dialogue","name":"梓兰","text":"但是——","id":610},{"type":"dialogue","name":"梓兰","text":"写给月见夜的那些话，其实也是写给我自己的。","id":611},{"type":"dialog","id":612},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":613},{"type":"image","id":614},{"type":"background","image":"https://media.prts.wiki/8/8a/Avg_bg_bg_black.png","screenadapt":"coverall","id":615},{"type":"delay","time":"2.5","id":616},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":617},{"type":"text","text":"我究竟能为那些我关心的人做些什么？","id":618},{"type":"text","text":"她松开弓弦。","id":619},{"type":"dialog","id":620},{"type":"playsound","key":"$MHR_arrow_skyattack","volume":"1","id":621},{"type":"playsound","key":"$MHR_dragonarrow_shot","volume":"1","channel":"shot","id":622},{"type":"effect","name":"$e_071cg_arrow","roz":"60","layer":"1","id":623},{"type":"delay","time":"2","id":624},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":625},{"type":"dialog","id":626},{"type":"image","id":627},{"type":"charslot","id":628},{"type":"background","screenadapt":"coverall","id":629},{"type":"delay","time":"2","id":630},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":631},{"type":"delay","time":"1","id":632},{"type":"camerashake","duration":"0.4","xstrength":"40","ystrength":"50","vibrato":"60","randomness":"80","fadeout":"true","block":"false","id":633},{"type":"playsound","key":"$MHR_hit_slash_weapon01","volume":"1","id":634},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":635},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"0.05","block":"true","id":636},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.4","block":"true","id":637},{"type":"playsound","key":"$MHR_hit_slash_weapon02","volume":"1","id":638},{"type":"camerashake","duration":"0.4","xstrength":"40","ystrength":"50","vibrato":"60","randomness":"80","fadeout":"true","block":"false","id":639},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":640},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"0.05","block":"true","id":641},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.4","block":"true","id":642},{"type":"delay","time":"0.5","id":643},{"type":"charslot","slot":"l","name":"avg_npc_2105_1#1$1","id":644},{"type":"charslot","slot":"r","name":"avg_npc_2105_1#1$1","id":645},{"type":"delay","time":"0.5","id":646},{"type":"playsound","key":"$bodyfalldown3","channel":"down1","id":647},{"type":"charslot","slot":"l","posfrom":"0,0","posto":"0,-100","duration":"1","afrom":"1","ato":"0","id":648},{"type":"delay","time":"0.3","id":649},{"type":"playsound","key":"$bodyfalldown3","channel":"down2","id":650},{"type":"charslot","slot":"r","posfrom":"0,0","posto":"0,-100","duration":"1","afrom":"1","ato":"0","id":651},{"type":"delay","time":"1.5","id":652},{"type":"charslot","id":653},{"type":"playsound","key":"$d_avg_clothmovement","id":654},{"type":"charslot","slot":"l","name":"avg_4215_buddyC_1#1$3","posfrom":"-150,0","posto":"0,0","afrom":"0","ato":"1","duration":"1.5","id":655},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#6$2","posfrom":"150,0","posto":"0,0","afrom":"0","ato":"1","duration":"1.5","id":656},{"type":"delay","time":"2","id":657},{"type":"charslot","slot":"l","name":"avg_4215_buddyC_1#1$3","focus":"l","id":658},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#6$2","focus":"l","id":659},{"type":"playsound","key":"$MHR_cat_voice3","volume":"1","id":660},{"type":"dialogue","name":"政宗","text":"梓兰怎么了？感觉从进入地下以来，梓兰就有些怪怪的喵！","id":661},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#6$2","focus":"r","id":662},{"type":"dialogue","name":"空爆","text":"梓兰姐......很纠结。","id":663},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#15$2","focus":"r","id":664},{"type":"dialogue","name":"空爆","text":"梓兰姐总是摆出一副事不关己，公事公办的样子，但她其实很关心身边的人。","id":665},{"type":"dialogue","name":"空爆","text":"她太关心了，以至于她不知道怎么去表达这种关心，到最后，她选择用那副样子来伪装自己。","id":666},{"type":"dialogue","name":"空爆","text":"久而久之，她连自己都骗过去了。","id":667},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#6$2","focus":"r","id":668},{"type":"dialogue","name":"空爆","text":"她当然很在意我们小队的情况，但是......","id":669},{"type":"dialogue","name":"空爆","text":"既然她会在那时站出来主持大局，她也一定会在此刻想到办法。","id":670},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#5$2","focus":"r","id":671},{"type":"dialogue","name":"空爆","text":"告诉你一个小秘密，政宗。","id":672},{"type":"dialogue","name":"空爆","text":"虽然我们从来不说，但在我们A6小队的成员遇到麻烦事的时候，我们心里总会浮现出一句话——","id":673},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#11$2","focus":"r","id":674},{"type":"dialogue","name":"空爆","text":"梓兰姐总会有办法的。","id":675},{"type":"dialog","id":676},{"type":"delay","time":"1.5","id":677},{"type":"playsound","key":"$MHR_arrow_skyattack","volume":"1","id":678},{"type":"playsound","key":"$MHR_dragonarrow_shot","volume":"1","id":679},{"type":"charslot","slot":"l","name":"avg_4215_buddyC_1#1$3","focus":"n","id":680},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#11$2","focus":"n","id":681},{"type":"delay","time":"1.5","id":682},{"type":"text","text":"“咻”的一声，一支箭从兽潮头顶飞过，在昏暗的地下遗迹中，如同一道流星划过。","id":683},{"type":"charslot","slot":"l","name":"avg_4215_buddyC_1#1$4","focus":"l","id":684},{"type":"playsound","key":"$MHR_cat_voice2","volume":"1","id":685},{"type":"dialogue","name":"政宗","text":"“龙之箭”喵？！","id":686},{"type":"dialog","id":687},{"type":"charslot","slot":"l","name":"avg_4215_buddyC_1#1$4","focus":"n","id":688},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#11$2","focus":"n","id":689},{"type":"playsound","key":"$d_avg_explosion_stone","id":690},{"type":"playsound","key":"$MHR_dragonarrow_poom","volume":"1","channel":"poom","id":691},{"type":"camerashake","duration":"2","xstrength":"70","ystrength":"70","vibrato":"70","randomness":"95","fadeout":"true","block":"false","id":692},{"type":"text","text":"“流星”撞在岩壁上方，然后，一阵剧烈的震动传来。","id":693},{"type":"charslot","slot":"l","name":"avg_4215_buddyC_1#1$4","focus":"l","id":694},{"type":"playsound","key":"$MHR_cat_voice2","volume":"1","id":695},{"type":"dialogue","name":"政宗","text":"要塌方了喵！","id":696},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#4$2","focus":"r","id":697},{"type":"dialogue","name":"空爆","text":"哈哈！不愧是梓兰姐！","id":698},{"type":"charslot","slot":"r","name":"avg_1049_catap2_1#9$2","focus":"r","id":699},{"type":"dialogue","name":"空爆","text":"兽潮被拦住了！梓兰姐在招呼我们去宝巫迦身边，走吧！","id":700},{"type":"dialog","id":701},{"type":"delay","time":"1","id":702},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":703},{"type":"bgeffect","id":704},{"type":"stopmusic","fadetime":"2","id":705},{"type":"image","id":706},{"type":"charslot","id":707}],"characters":["宝巫迦","梓兰","空爆","政宗","义经","“雷之主”"]}