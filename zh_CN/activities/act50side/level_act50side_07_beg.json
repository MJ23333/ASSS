":"700","id":308},{"type":"subtitle","id":309},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":310},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#3$2","focus":"m","id":311},{"type":"dialogue","name":"梓兰","text":"等等，这段话......","id":312},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#4$2","focus":"m","id":313},{"type":"dialogue","name":"梓兰","text":"难道说——","id":314},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#5$2","focus":"m","id":315},{"type":"dialogue","name":"梓兰","text":"可恶，难道说真相并不是我们想象的那样？","id":316},{"type":"charslot","slot":"m","name":"avg_1049_catap2_1#7$2","focus":"m","id":317},{"type":"dialogue","name":"空爆","text":"梓兰姐，你说什么？！","id":318},{"type":"charslot","slot":"m","name":"avg_1048_orchd2_1#5$2","focus":"m","id":319},{"type":"dialogue","name":"梓兰","text":"我说，必须尽快赶到她的身边！否则，一切就晚了！","id":320},{"type":"dialog","id":321},{"type":"stopmusic","fadetime":"2","id":322},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":323},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":324},{"type":"dialog","id":325},{"type":"charslot","id":326},{"type":"background","screenadapt":"coverall","id":327},{"type":"delay","time":"2","id":328},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":329},{"type":"delay","time":"1","id":330},{"type":"playmusic","intro":"$frontline_intro","key":"https://static.prts.wiki/music/music/act9d0d0/m_avg_frontline_loop.mp3","volume":"0.6","id":331,"musicid":2},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":332},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#8$1","afrom":"0","ato":"1","duration":"1.5","id":333},{"type":"delay","time":"2","id":334},{"type":"dialogue","name":"宝巫迦","text":"终于......找到你了。","id":335},{"type":"charslot","slot":"m","name":"avg_npc_2100_1#9$1","focus":"m","id":336},{"type":"dialogue","name":"宝巫迦","text":"“雷之主”......","id":337},{"type":"dialog"