ack_heavy","volume":"1","id":78},{"type":"camerashake","duration":"0.5","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":79},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":80},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":81},{"type":"playsound","key":"$fightgeneral","volume":"1","text":"","id":82},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.05","block":"true","id":83},{"type":"charslot","slot":"L","action":"jump","posto":"-100,0","power":"5","times":"1","duration":"0.4","id":84},{"type":"dialog","id":85},{"type":"delay","time":"0.4","id":86},{"type":"playsound","key":"$d_avg_broadswordblood","volume":"1","text":"","id":87},{"type":"charslot","slot":"M","action":"jump","posto":"-100,0","power":"5","times":"1","duration":"0.3","id":88},{"type":"delay","time":"0.2","id":89},{"type":"charslot","slot":"L","action":"jump","posto":"-150,0","power":"5","times":"1","duration":"0.4","id":90},{"type":"delay","time":"0.5","id":91},{"type":"playsound","key":"$d_avg_seabornactivity_intense","volume":"1","id":92},{"type":"shake","name":"left","power":"10","times":"100","fadetime":"0.3","block":"false","id":93},{"type":"charslot","slot":"L","afrom":"1","ato":"0","duration":"0.3","id":94},{"type":"dialogue","name":"惩戒军士官","text":"*伊比利亚粗口*没完没了……","id":95},{"type":"dialogue","name":"惩戒军士官","text":"那边的小子！别站着发愣！","id":96},{"type":"dialog","id":97},{"type":"charslot","id":98},{"type":"charslot","slot":"m","name":"avg_npc_2276_1#1$1","id":99},{"type":"charslot","slot":"m","action":"shake","power":"5","times":"60","isblock":"true","duration":"0.2","id":100},{"type":"delay","time":"0.5","id":101},{"type":"dialogue","name":"惩戒军新兵","text":"队长，我已经挥不动手里的戟了……","id":102},{"type":"dialogue","name":"惩戒军新兵","text":"它们源源不断地从城区的缝隙里爬出来，我们需要审判官的灯火！","id":103},{"type":"dialogue","name":"惩戒军新兵","text":"现在我看不清自己的脚下，我不知道自己踩着的是恐鱼的触手还是……","id":104},{"type":"dialog","id":105},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":106},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":107},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":108},{"type":"charslot","slot":"left","name":"avg_4009_irene_1#1$1","action":"jump","posto":"150,0","power":"5","times":"1","duration":"0.05","id":109},{"type":"charslot","slot":"R","name":"avg_npc_457_1#2$1","action":"jump","posto":"-80,0","power":"5","times":"1","duration":"0.05","id":110},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"false","id":111},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":112},{"type":"playsound","key":"$swordtsing1","volume":"1","id":113},{"type":"camerashake","duration":"100","xstrength":"30","ystrength":"5","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":114},{"type":"delay","time":"1","id":115},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":116},{"type":"playsound","key":"$d_avg_attack_heavy","volume":"1","id":117},{"type":"camerashake","duration":"0.3","xstrength":"50","ystrength":"50","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":118},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.05","block":"true","id":119},{"type":"charslot","slot":"left","name":"avg_4009_irene_1#1$1","action":"jump","posto":"-100,0","power":"5","times":"1","duration":"0.05","id":120},{"type":"charslot","slot":"R","name":"avg_npc_457_1#2$1","action":"jump","posto":"0,0","power":"5","times":"1","duration":"0.05","id":121},{"type":"dialog","id":122},{"type":"charslot","id":123},{"type":"charslot","slot":"m","name":"avg_4009_irene_1#4$1","posfrom":"20,20","posto":"0,0","duration":"0.2","id":124},{"type":"delay","time":"0.2","id":125},{"type":"dialogue","name":"艾丽妮","text":"清醒一点，士兵！","id":126,"figure":"https://media.prts.wiki/3/36/Avg_avg_4009_irene_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_2276_1#1$1","id":127},{"type":"dialogue","name":"惩戒军新兵","text":"艾丽妮，谢谢……","id":128,"figure":"https://media.prts.wiki/0/06/Avg_avg_npc_2276_1$1.png"},{"type":"charslot","slot":"m","name":"avg_4009_irene_1#4$1","id":129},{"type":"dialogue","name":"艾丽妮","text":"看那些恐鱼，不要看我和审判官们手中的提灯，一直盯着灯火只会让你越来越无法适应黑暗。","id":130,"figure":"https://media.prts.wiki/3/36/Avg_avg_4009_irene_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4009_irene_1#1$1","id":131},{"type":"dialogue","name":"艾丽妮","text":"十秒，凝视这片黑暗十秒，相信我，你不会成为这些孽物的目标。","id":132,"figure":"https://media.prts.wiki/6/66/Avg_avg_4009_irene_1-1$1.png"},{"type":"dialog","id":133},{"type":"charslot","id":134},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":135},{"type":"blocker","a":"0.9","r":"0","g":"0","b":"0","fadetime":"0.2","block":"true","id":136},{"type":"playsound","key":"$d_avg_seabornattack","volume":"1","channel":"1","id":137},{"type":"delay","time":"1.2","id":138},{"type":"playsound","key":"$d_avg_attack_heavy","volume":"1","channel":"2","id":139},{"type":"delay","time":"0.5","id":140},{"type":"multiline","name":"惩戒军新兵","text":"……三、二、一……","id":141},{"type":"bgeffect","name":"$eb_dim_openeye","layer":"1","id":142},{"type":"delay","time":"1","id":143},{"type":"blocker","a":"0.7","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":144},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.3","block":"true","id":145},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":146},{"type":"multiline","name":"惩戒军新兵","text":"我、我看见了！","id":147},{"type":"charslot","slot":"m","name":"avg_npc_2276_1#1$1","id":148},{"type":"dialogue","name":"惩戒军新兵","text":"天，这么多恐鱼的尸体，都是您……","id":149,"figure":"https://media.prts.wiki/0/06/Avg_avg_npc_2276_1$1.png"},{"type":"dialog","id":150},{"type":"charslot","id":151},{"type":"playsound","key":"$d_avg_attack_heavy","volume":"1","id":152},{"type":"charslot","slot":"m","name":"avg_4009_irene_1#4$1","posfrom":"30,0","posto":"0,0","duration":"0.3","id":153},{"type":"charslot","slot":"r","name":"avg_npc_457_1#2$1","posfrom":"-230,0","posto":"-200,-50","afrom":"1","ato":"0","duration":"0.3","id":154},{"type":"delay","time":"0.2","id":155},{"type":"playsound","key":"$d_avg_seaborndead","volume":"1","id":156},{"type":"delay","time":"0.3","id":157},{"type":"charslot","slot":"m","name":"avg_4009_irene_1#6$1","id":158},{"type":"dialogue","name":"艾丽妮","text":"恭喜你适应了黑暗，士兵。你的同僚足以保护你短短十秒，相信我们。","id":159,"figure":"https://media.prts.wiki/d/d9/Avg_avg_4009_irene_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4009_irene_1#4$1","id":160},{"type":"dialogue","name":"艾丽妮","text":"现在，轮到你为其他人做同样的事了。","id":161,"figure":"https://media.prts.wiki/3/36/Avg_avg_4009_irene_1-4$1.png"},{"type":"dialog","id":162},{"type":"charslot","id":163},{"type":"charslot","slot":"m","name":"avg_npc_2276_1#1$1","id":164},{"type":"charslot","slot":"m","posfrom":"0,0","afrom":"1","ato":"1","posto":"230,0","duration":"0.4","id":165},{"type":"delay","time":"0.25","id":166},{"type":"playsound","key":"$d_avg_broadswordblood","volume":"1","id":167},{"type":"charslot","slot":"r","afrom":"1","ato":"1","name":"avg_npc_1388_1#1$1","posfrom":"200,20","posto":"0,0","duration":"0.15","id":168},{"type":"blocker","a":"0.8","r":"1","g":"1","b":"1","fadetime":"0.3","block":"true","id":169},{"type":"camerashake","duration":"0.5","xstrength":"50","ystrength":"50","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":170},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.1","block":"true","id":171},{"type":"charslot","slot":"m","posfrom":"230,0","afrom":"1","ato":"1","posto":"250,0","duration":"0.3","id":172},{"type":"charslot","slot":"r","afrom":"1","ato":"0","name":"avg_npc_1388_1#1$1","posfrom":"0,0","posto":"-200,0","duration":"0.5","id":173},{"type":"delay","time":"0.2","id":174},{"type":"playsound","key":"$d_avg_seabornf_pain","volume":"1","id":175},{"type":"delay","time":"1","id":176},{"type":"dialogue","name":"惩戒军新兵","text":"明白！","id":177,"figure":"https://media.prts.wiki/3/39/Avg_avg_npc_1388_1$1.png"},{"type":"stopmusic","fadetime":"2","id":178},{"type":"dialog","id":179},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":180},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":181},{"type":"charslot","id":182},{"type":"background","image":"https://media.prts.wiki/f/f3/Avg_bg_74_g6_gdsquare_n.png","screenadapt":"coverall","id":183},{"type":"delay","time":"2","id":184},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":185},{"type":"delay","time":"1","id":186},{"type":"playmusic","key":"https://static.prts.wiki/music/music/act28side/m_avg_wasteland_loop.mp3","volume":"0.6","id":187,"musicid":2},{"type":"playsound","key":"$rungeneral","id":188},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","duration":"1.5","id":189},{"type":"delay","time":"1.5","id":190},{"type":"dialogue","name":"特菲","text":"……从船厂跑出来的这一路上，全是恐鱼……","id":191,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","id":192},{"type":"dialogue","name":"特菲","text":"我到底帮瓦列里奥做了什么……我原本只是想点亮港都的坐标，只是想让萨尔瓦多相信我，我……","id":193,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#14$1","id":194},{"type":"dialogue","name":"特菲","text":"我怎么跑到这儿来了……","id":195,"figure":"https://media.prts.wiki/d/d2/Avg_avg_393_toledo_1-14$1.png"},{"type":"dialog","id":196},{"type":"charslot","id":197},{"type":"backgroundtween","image":"74_g6_gdsquare_n","duration":"8","xScaleFrom":"1","yScaleFrom":"1","xScaleTo":"1.15","yScaleTo":"1.15","xFrom":"0","xTo":"80","yFrom":"0","yTo":"-30","block":"false","id":198},{"type":"delay","time":"2","id":199},{"type":"image","image":"https://media.prts.wiki/9/9e/Avg_74_i04.png","screenadapt":"coverall","xScale":"1.05","yScale":"1.05","fadetime":"4","block":"false","id":200},{"type":"imagetween","xScaleFrom":"1","yScaleFrom":"1","xScaleTo":"1.1","yScaleTo":"1.1","xTo":"-60","yTo":"-30","duration":"20","block":"false","id":201},{"type":"delay","time":"1","id":202},{"type":"text","text":"她对眼前的广场再熟悉不过。","id":203},{"type":"text","text":"两周前，她刚刚来到港都的外围城区，与一座根本不认识的雕像勾肩搭背，像以前那样骗取拥护者的信任，赚取一夜住宿、几顿饱饭。","id":204},{"type":"text","text":"她曾认为自己与瓦列里奥是最佳搭档，他知道许多大静谧之前的知识，也会为她纠正故事里的漏洞，还会在她做得过火时拉她一把。","id":205},{"type":"text","text":"她以为瓦列里奥只是思念自己的家乡，所以才向她提议来到港都，所以才一次次让她唱起那首被封禁的船歌，露出怀念的表情。","id":206},{"type":"dialog","id":207},{"type":"image","fadetime":"3","id":208},{"type":"delay","time":"3.2","id":209},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","id":210},{"type":"dialogue","name":"特菲","text":"今天有一艘船出航……♪","id":211,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","id":212},{"type":"dialogue","name":"特菲","text":"越过灯塔……越过……教堂……♪","id":213,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#13$1","id":214},{"type":"dialogue","name":"特菲","text":"……水汽……吹向海岸……♪","id":215,"figure":"https://media.prts.wiki/2/21/Avg_avg_393_toledo_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#13$1","id":216},{"type":"dialogue","name":"特菲","text":"扬帆……扬帆……♪","id":217,"figure":"https://media.prts.wiki/2/21/Avg_avg_393_toledo_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#13$1","id":218},{"type":"dialogue","name":"特菲","text":"……","id":219,"figure":"https://media.prts.wiki/2/21/Avg_avg_393_toledo_1-13$1.png"},{"type":"charslot","slot":"m","focus":"n","id":220},{"type":"dialogue","name":"沉稳的男声","text":"舵不在风的手上♪","id":221},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#2$1","id":222},{"type":"dialogue","name":"特菲","text":"瓦列里奥！不，您是——","id":223,"figure":"https://media.prts.wiki/b/b1/Avg_avg_393_toledo_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#15$1","id":224},{"type":"dialogue","name":"特菲","text":"圣徒阁下……您怎么会出现在这里！","id":225,"figure":"https://media.prts.wiki/f/f1/Avg_avg_393_toledo_1-15$1.png"},{"type":"dialog","id":226},{"type":"charslot","id":227},{"type":"playsound","key":"$d_gen_walk_n","volume":"1","id":228},{"type":"charslot","slot":"m","name":"avg_npc_447_1#1$1","duration":"1.5","block":"true","id":229},{"type":"delay","time":"2","id":230},{"type":"charslot","id":231},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#9$1","id":232},{"type":"dialogue","name":"特菲","text":"虽然知道您就在外围城区，但这还是我在启动仪式后第一次见到您——当然！作为一名品行端正的公民我本不应该见到您……","id":233,"figure":"https://media.prts.wiki/9/9d/Avg_avg_393_toledo_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#1$1","id":234},{"type":"dialogue","name":"圣徒卡门","text":"我出现在这里，证明已然出现了变故。","id":235,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_447_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","id":236},{"type":"dialogue","name":"特菲","text":"变故，您难道是指船厂的……","id":237,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#8$1","id":238},{"type":"dialogue","name":"圣徒卡门","text":"我认识你。","id":239,"figure":"https://media.prts.wiki/2/2b/Avg_avg_npc_447_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#8$1","id":240},{"type":"dialogue","name":"圣徒卡门","text":"两周前的打捞启动仪式上，你领头唱了这支船歌。百年前，它的作者也在这座广场做过一模一样的举动。","id":241,"figure":"https://media.prts.wiki/2/2b/Avg_avg_npc_447_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#9$1","id":242},{"type":"dialogue","name":"圣徒卡门","text":"自那之后，每当有船只出航，码头上的伊比利亚人就会在岸边唱起这支歌，我有一个已故的同僚很是喜欢。","id":243,"figure":"https://media.prts.wiki/4/4d/Avg_avg_npc_447_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#2$1","id":244},{"type":"dialogue","name":"特菲","text":"圣徒阁下……","id":245,"figure":"https://media.prts.wiki/b/b1/Avg_avg_393_toledo_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#1$1","id":246},{"type":"dialogue","name":"圣徒卡门","text":"我向你的歌声致敬，年轻人。它是伊比利亚不可争辩又正在消亡的历史。","id":247,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_447_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#1$1","id":248},{"type":"dialogue","name":"圣徒卡门","text":"告诉我，你眼中的伊比利亚如今正在发生什么？","id":249,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_447_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#13$1","id":250},{"type":"dialogue","name":"特菲","text":"灾难……","id":251,"figure":"https://media.prts.wiki/2/21/Avg_avg_393_toledo_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#5$1","id":252},{"type":"dialogue","name":"圣徒卡门","text":"与六十三年前相比，不值一提。","id":253,"figure":"https://media.prts.wiki/0/06/Avg_avg_npc_447_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#7$1","id":254},{"type":"dialogue","name":"特菲","text":"可恐惧是没法比较的！","id":255,"figure":"https://media.prts.wiki/a/a2/Avg_avg_393_toledo_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","id":256},{"type":"dialogue","name":"特菲","text":"恐鱼爬上街道，港都的坐标消失，而造成这一切的元凶正是……正是……","id":257,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#13$1","id":258},{"type":"dialogue","name":"特菲","text":"（深吸一口气）","id":259,"figure":"https://media.prts.wiki/2/21/Avg_avg_393_toledo_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#6$1","id":260},{"type":"dialogue","name":"特菲","text":"圣徒阁下，我、我本就打算去审判庭自首！是我恢复了海图系统的功能，是我看着港都的坐标消失！","id":261,"figure":"https://media.prts.wiki/b/b1/Avg_avg_393_toledo_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#14$1","id":262},{"type":"dialogue","name":"特菲","text":"成为“大人物”……我怎么就轻易相信了他的话……","id":263,"figure":"https://media.prts.wiki/d/d2/Avg_avg_393_toledo_1-14$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","id":264},{"type":"dialogue","name":"特菲","text":"我原本就是以欺骗为生的人，哪怕是此刻我对您说的话，我都无法辨认它们到底是真心实意的坦陈，还是为了博得同情的辩解，我——","id":265,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#7$1","id":266},{"type":"dialogue","name":"圣徒卡门","text":"你只需要告诉我，你的同行者是谁。","id":267,"figure":"https://media.prts.wiki/d/da/Avg_avg_npc_447_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#15$1","id":268},{"type":"dialogue","name":"特菲","text":"您、您相信我？","id":269,"figure":"https://media.prts.wiki/f/f1/Avg_avg_393_toledo_1-15$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#1$1","id":270},{"type":"dialogue","name":"圣徒卡门","text":"连自己都怀疑的人，已经骗不了别人了。","id":271,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_447_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#1$1","id":272},{"type":"dialogue","name":"圣徒卡门","text":"你们在哪里相识？","id":273,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_447_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#12$1","id":274},{"type":"dialogue","name":"特菲","text":"鳞脊镇的一家小酒馆。","id":275,"figure":"https://media.prts.wiki/c/c4/Avg_avg_393_toledo_1-12$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#2$1","id":276},{"type":"dialogue","name":"特菲","text":"当时我唱着模糊、残缺的船歌，想从客人手里讨一点住宿费，所有人都走了，只有他还在，我看他可怜，请他吃了顿饭。","id":277,"figure":"https://media.prts.wiki/b/b1/Avg_avg_393_toledo_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#2$1","id":278},{"type":"dialogue","name":"特菲","text":"他告诉我，他的家乡是雷亚-伊比利亚，但我知道这座城市早在六十多年前就沉没了，想着或许他是周边城镇的住民。","id":279,"figure":"https://media.prts.wiki/b/b1/Avg_avg_393_toledo_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","id":280},{"type":"dialogue","name":"特菲","text":"在我们同行的路上，他极少说起自己的事，我只知道他为了帮一个朋友纵身跳入火海，还有……","id":281,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#8$1","id":282},{"type":"dialogue","name":"特菲","text":"他对我唱的船歌很了解，是他填上了被人遗忘的歌词，也是他纠正我的发音和曲调。","id":283,"figure":"https://media.prts.wiki/f/f7/Avg_avg_393_toledo_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#4$1","id":284},{"type":"dialogue","name":"圣徒卡门","text":"……","id":285,"figure":"https://media.prts.wiki/4/40/Avg_avg_npc_447_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#2$1","id":286},{"type":"dialogue","name":"圣徒卡门","text":"唉……","id":287,"figure":"https://media.prts.wiki/6/6b/Avg_avg_npc_447_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#1$1","id":288},{"type":"dialogue","name":"圣徒卡门","text":"我早该想到的。你演绎的曲调，就好像是他曾唱的。","id":289,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_447_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#13$1","id":290},{"type":"dialogue","name":"特菲","text":"圣徒阁下……我会面临审判吗？","id":291,"figure":"https://media.prts.wiki/2/21/Avg_avg_393_toledo_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#1$1","id":292},{"type":"dialogue","name":"圣徒卡门","text":"每个人都逃不过，我亦如此，但，“审判的目的从来不是为了彰显权能”——","id":293,"figure":"https://media.prts.wiki/3/36/Avg_avg_npc_447_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_393_toledo_1#7$1","id":294},{"type":"dialogue","name":"特菲","text":"“而是为了赎罪”。","id":295,"figure":"https://media.prts.wiki/a/a2/Avg_avg_393_toledo_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_447_1#8$1","id":296},{"type":"dialogue","name":"圣徒卡门","text":"去践行你阐释的经义吧，伊比利亚人。","id":297,"figure":"https://media.prts.wiki/2/2b/Avg_avg_npc_447_1-8$1.png"},{"type":"stopmusic","fadetime":"2","id":298},{"type":"dialog","id":299},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":300},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":301},{"type":"charslot","id":302},{"type":"background","image":"https://media.prts.wiki/7/79/Avg_bg_74_g13_underseahall_n.png","screenadapt":"coverall","id":303},{"type":"delay","time":"2","id":304},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":305},{"type":"delay","time":"1","id":306},{"type":"playmusic","intro":"$m_bat_act17side_01_intro","key":"https://static.prts.wiki/music/music/act17side/m_bat_act17side_01_loop.mp3","volume":"0.6","id":307,"musicid":3},{"type":"charslot","slot":"m","name":"avg_npc_941_1#7$1","id":308},{"type":"dialogue","name":"奥卢斯","text":"基质，显像。","id":309,"figure":"https://media.prts.wiki/f/f4/Avg_avg_npc_941_1-7$1.png"},{"type":"dialog","id":310},{"type":"charslot","id":311},{"type":"dialog","id":312},{"type":"charslot","id":313},{"type":"playsound","key":"$d_avg_illusionmagic","volume":"1","id":314},{"type":"blocker","a":"0.5","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":315},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":316},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":317},{"type":"bgeffect","name":"$eb_signalInterference","layer":"1","id":318},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":319},{"type":"blocker","a":"0.8","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":320},{"type":"background","image":"https://media.prts.wiki/f/f1/Avg_bg_bg_ibbar.png","screenadapt":"coverall","id":321},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":322},{"type":"charslot","slot":"m","name":"avg_npc_941_1#2$1","id":323},{"type":"dialogue","name":"奥卢斯","text":"太阴森，不合适。","id":324,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"dialog","id":325},{"type":"charslot","id":326},{"type":"playsound","key":"$d_avg_illusionmagic","volume":"1","id":327},{"type":"bgeffect","name":"$eb_signalInterference","layer":"1","id":328},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":329},{"type":"blocker","a":"0.8","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":330},{"type":"background","image":"https://media.prts.wiki/b/b5/Avg_bg_27_g17_lighthouse_alley.png","screenadapt":"coverall","id":331},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":332},{"type":"charslot","slot":"m","name":"avg_npc_941_1#2$1","id":333},{"type":"dialogue","name":"奥卢斯","text":"又太明媚。","id":334,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"dialog","id":335},{"type":"charslot","id":336},{"type":"playsound","key":"$d_avg_illusionmagic","volume":"1","id":337},{"type":"bgeffect","name":"$eb_signalInterference","layer":"1","id":338},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":339},{"type":"blocker","a":"0.8","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":340},{"type":"background","image":"https://media.prts.wiki/b/b2/Avg_bg_74_g14_ibchurch_2.png","screenadapt":"coverall","id":341},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":342},{"type":"dialogue","name":"？？？","text":"岛民们说，允许他们倾吐离经叛道之言的“互助会”，总在一座老教堂举办，但港都不该还有属于深海教会的教堂。","id":343},{"type":"dialogue","name":"？？？","text":"现在看来，所谓的老教堂，不过是你用炼金术炮制的幻景。","id":344},{"type":"charslot","slot":"m","name":"avg_npc_941_1#1$1","id":345},{"type":"dialogue","name":"奥卢斯","text":"……我很好奇，他们之中是谁如此好心地邀请了你，克莱门莎执政官？","id":346,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"dialog","id":347},{"type":"charslot","id":348},{"type":"effect","name":"$e_bladeline_01_large","x":"0","y":"-26","rox":"0","roy":"0","roz":"-58","layer":"2","id":349},{"type":"bgeffect","name":"$eb_sound_wave_01","layer":"1","id":350},{"type":"blocker","a":"1","r":"1","g":"1","b":"1","fadetime":"0.2","block":"true","id":351},{"type":"playsound","key":"$d_avg_swordsplitair","volume":"1","id":352},{"type":"background","image":"https://media.prts.wiki/7/79/Avg_bg_74_g13_underseahall_n.png","screenadapt":"coverall","id":353},{"type":"camerashake","duration":"2","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":354},{"type":"delay","time":"1","id":355},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"false","id":356},{"type":"bgeffect","name":"$eb_sound_wave_01","layer":"2","y":"-80","id":357},{"type":"delay","time":"0.5","id":358},{"type":"playsound","key":"$d_avg_higheldshosfts","volume":"1","id":359},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#4$1","duration":"1.5","id":360},{"type":"delay","time":"1.6","id":361},{"type":"dialogue","name":"克莱门莎","text":"总得有人自觉给这场已经空无一人的“互助会”捧个场。","id":362,"figure":"https://media.prts.wiki/6/68/Avg_avg_4231_clemnt_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#6$1","id":363},{"type":"dialogue","name":"奥卢斯","text":"……","id":364,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_941_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#1$1","id":365},{"type":"dialogue","name":"克莱门莎","text":"我也很好奇，你刚刚在试验的其他那些幻景，又是为谁准备的？","id":366,"figure":"https://media.prts.wiki/7/79/Avg_avg_4231_clemnt_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#5$1","id":367},{"type":"dialogue","name":"克莱门莎","text":"不如说，港都中心城区已经不在此处，你还留在这里，是要等谁？","id":368,"figure":"https://media.prts.wiki/3/37/Avg_avg_4231_clemnt_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#2$1","id":369},{"type":"dialogue","name":"奥卢斯","text":"中心城区正在驶向一处绝对安全的港湾，它会作为筹码在那儿等待，直到审判庭同意满足岛民的诉求。","id":370,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#1$1","id":371},{"type":"dialogue","name":"奥卢斯","text":"我留下来，自然是为了给这场谈判作见证。","id":372,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"dialogue","name":"奥卢斯","text":"毕竟，如果只是教人吐些苦水，我怎么敢大言不惭地称自己组织的是“互助会”？","id":373,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#2$1","id":374},{"type":"dialogue","name":"克莱门莎","text":"袭击灯塔、挟持中心城区，就是所谓的“互助”？","id":375,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#1$1","id":376},{"type":"dialogue","name":"奥卢斯","text":"我还以为你身为阿戈尔人，最能理解这些事。","id":377,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"dialogue","name":"奥卢斯","text":"你应该也在港都见过不少炼金设施的残骸了。说实话，见到它们的时候，我几乎没能认出那是我自己的作品。","id":378,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"dialogue","name":"奥卢斯","text":"我不习惯它们七零八落地躺在地上。最开始设计的时候我就无数次设想过它们落成时的模样，但从没想象过它们损毁之后的事。","id":379,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#2$1","id":380},{"type":"dialogue","name":"克莱门莎","text":"阿戈尔人总是太珍爱自己的作品。","id":381,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#6$1","id":382},{"type":"dialogue","name":"奥卢斯","text":"但岛民同胞们袭击的灯塔，乃至他们袭击的每一处设施，都是由他们的父辈亲手建造，又由他们自己亲手打捞上来的。","id":383,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_941_1-6$1.png"},{"type":"dialogue","name":"奥卢斯","text":"那也是他们自己的作品。","id":384,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_941_1-6$1.png"},{"type":"dialogue","name":"奥卢斯","text":"除了绝望，我想不到别的解释。","id":385,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_941_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#2$1","id":386},{"type":"dialogue","name":"克莱门莎","text":"通过摧毁自己的价值来证明自己的价值，本就是个伪命题。","id":387,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#4$1","id":388},{"type":"dialogue","name":"克莱门莎","text":"袭击自己亲手修复的灯塔，挟持自己亲身参与打捞的港都中心城区，也不会让伊比利亚人意识到他们有多重要。","id":389,"figure":"https://media.prts.wiki/6/68/Avg_avg_4231_clemnt_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#4$1","id":390},{"type":"dialogue","name":"克莱门莎","text":"就好像一个自杀的人，证明不了自己能掌控自己的生死。","id":391,"figure":"https://media.prts.wiki/6/68/Avg_avg_4231_clemnt_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#2$1","id":392},{"type":"dialogue","name":"奥卢斯","text":"当然，当然。但要求一群走投无路的人选择最理智最有效的办法，是不是太高高在上了，执政官？","id":393,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#11$1","id":394},{"type":"dialogue","name":"克莱门莎","text":"够了，奥卢斯，不是所有人都有耐心陪你玩文字游戏。那些岛民同胞确实已经走投无路，但你不是。","id":395,"figure":"https://media.prts.wiki/4/46/Avg_avg_4231_clemnt_1-11$1.png"},{"type":"dialogue","name":"克莱门莎","text":"你从最开始就知道，一如袭击灯塔就只能换来大规模的追捕，挟持港都中心城区，也不可能换来一次谈判的机会。","id":396,"figure":"https://media.prts.wiki/4/46/Avg_avg_4231_clemnt_1-11$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#2$1","id":397},{"type":"dialogue","name":"克莱门莎","text":"但你还是推着他们走到了这一步。","id":398,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"dialogue","name":"克莱门莎","text":"所谓的“帮助岛民”，就是让他们为了一场你知道不可能成立的谈判，挟持一座只有你知道会驶向哪里的城市？","id":399,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"dialogue","name":"克莱门莎","text":"这是在帮他们，还是在帮你自己？","id":400,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#2$1","id":401},{"type":"dialogue","name":"奥卢斯","text":"有什么区别呢？港都只有在我手里，才能重新成为那座包容万物的庇护所，这才是它存在的意义。","id":402,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"dialogue","name":"奥卢斯","text":"当初给这座城市设计炼金能源管线的时候，我就时常会想起自己原本是个源石技艺适应性极差的阿戈尔人。","id":403,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"dialogue","name":"奥卢斯","text":"我能掌握伊比利亚最艰深的炼金秘术，本就堪称一种奇迹。","id":404,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#2$1","id":405},{"type":"dialogue","name":"奥卢斯","text":"有时候，路过造船厂的巨型展缸，看到里面那只海嗣好奇地模仿着我的动作，我也会有同样的感受。","id":406,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"dialogue","name":"奥卢斯","text":"那是一种奇迹，只属于那个时代的一种奇迹。","id":407,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"dialogue","name":"奥卢斯","text":"无所谓种族、国别，甚至无所谓物种，所有生命都可以在这里互相学习。","id":408,"figure":"https://media.prts.wiki/2/22/Avg_avg_npc_941_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#5$1","id":409},{"type":"dialogue","name":"奥卢斯","text":"港都沉没之后，我再也没见过那样的景象。","id":410,"figure":"https://media.prts.wiki/9/95/Avg_avg_npc_941_1-5$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#10$1","id":411},{"type":"dialogue","name":"克莱门莎","text":"所有这些周折，连带阿奎拉的死，和盖乌斯他们的变异，都只是为了取回一件令你引以为傲的作品？","id":412,"figure":"https://media.prts.wiki/3/3e/Avg_avg_4231_clemnt_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#1$1","id":413},{"type":"dialogue","name":"奥卢斯","text":"那可确实是件好作品啊。","id":414,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#4$1","id":415},{"type":"dialogue","name":"克莱门莎","text":"你要把它带去哪里？","id":416,"figure":"https://media.prts.wiki/6/68/Avg_avg_4231_clemnt_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#1$1","id":417},{"type":"dialogue","name":"奥卢斯","text":"很遗憾，我实在不希望在港都中心城区的终点迎接它的，是一支全副武装的军团舰队。不论你有多么想找回它，我都爱莫能助。","id":418,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"dialogue","name":"奥卢斯","text":"不过，你总是可以请求弥利亚留姆执行全域扫描的，克莱门莎执政官。","id":419,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#4$1","id":420},{"type":"dialogue","name":"克莱门莎","text":"……如果只是想夸耀自己办事有多周全，你选错了场合。","id":421,"figure":"https://media.prts.wiki/6/68/Avg_avg_4231_clemnt_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#1$1","id":422},{"type":"dialogue","name":"奥卢斯","text":"但你确实联系不上弥利亚留姆了，不是吗？","id":423,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#2$1","id":424},{"type":"dialogue","name":"克莱门莎","text":"……","id":425,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#1$1","id":426},{"type":"dialogue","name":"奥卢斯","text":"阿戈尔的防线固然坚不可摧，但不知是因为他们太信任你，还是太不在乎你……那道防线与陆地之间的信号网，脆弱无比。","id":427,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"dialogue","name":"奥卢斯","text":"只有寥寥几个无人机矩阵在维系着它，同胞们甚至没费多大力气，就将它切断了。","id":428,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"dialogue","name":"奥卢斯","text":"直到港都中心城区顺利抵达它的终点，都不会有人知晓它的所在。那个终点位处何方，也只有我一人清楚。","id":429,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#7$1","id":430},{"type":"dialogue","name":"奥卢斯","text":"而我没有理由告诉你，不是吗？","id":431,"figure":"https://media.prts.wiki/f/f4/Avg_avg_npc_941_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#6$1","id":432},{"type":"dialogue","name":"奥卢斯","text":"这场毫无意义的审问，我也配合得够久了，而你也知道得太多了。","id":433,"figure":"https://media.prts.wiki/7/70/Avg_avg_npc_941_1-6$1.png"},{"type":"dialog","id":434},{"type":"charslot","slot":"m","focus":"n","id":435},{"type":"stopmusic","fadetime":"2","id":436},{"type":"playsound","key":"$d_avg_seabornbacklair","volume":"0","channel":"f","loop":"true","id":437},{"type":"soundvolume","volume":"0.8","channel":"f","fadetime":"1.5","id":438},{"type":"delay","time":"3","id":439},{"type":"charslot","id":440},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#2$1","id":441},{"type":"dialogue","name":"克莱门莎","text":"……大约三十只软体海嗣，就在我身后的廊道里。盖乌斯也在其中吗？","id":442,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_941_1#1$1","id":443},{"type":"dialogue","name":"奥卢斯","text":"如果我说是，会让你挣扎的时候，多一分犹疑吗？","id":444,"figure":"https://media.prts.wiki/4/4a/Avg_avg_npc_941_1-1$1.png"},{"type":"dialog","id":445},{"type":"charslot","id":446},{"type":"text","text":"克莱门莎没有答话。有那么一瞬间，奥卢斯瞥到她的手指在细微地颤动。","id":447},{"type":"stopsound","channel":"f","fadetime":"2","id":448},{"type":"text","text":"一声震响。","id":449},{"type":"dialog","id":450},{"type":"playsound","key":"$d_avg_controlmetal_Clementia","id":451},{"type":"camerashake","duration":"0.3","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":452},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":453},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":454},{"type":"delay","time":"1","id":455},{"type":"playsound","key":"$d_avg_tear","id":456},{"type":"delay","time":"0.5","id":457},{"type":"playsound","key":"$blooddrop","volume":"0","channel":"f","loop":"true","id":458},{"type":"soundvolume","volume":"0.9","channel":"f","fadetime":"2","id":459},{"type":"delay","time":"2","id":460},{"type":"text","text":"滴答、滴答、滴答。","id":461},{"type":"text","text":"厚重的海水隔绝了廊道之外的一切，萦绕在两人耳边的只有海嗣组织液滴落的声音。","id":462},{"type":"dialog","id":463},{"type":"playsound","key":"$d_avg_exsheath","id":464},{"type":"image","image":"https://media.prts.wiki/e/e6/Avg_74_i10.png","screenadapt":"coverall","xScale":"1.15","yScale":"1.15","x":"-80","y":"-40","fadetime":"0","id":465},{"type":"imagetween","xTo":"80","yTo":"-40","duration":"30","block":"false","id":466},{"type":"stopsound","channel":"f","fadetime":"2","id":467},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":468},{"type":"delay","time":"1","id":469},{"type":"playmusic","intro":"$m_bat_act52side_intro","key":"https://static.prts.wiki/music/music/act52side/m_bat_act52side_loop.mp3","volume":"0.6","id":470,"musicid":4},{"type":"text","text":"刚刚还有十几只海嗣爬行着的位置，连接观测厅与外界的唯一一处通道口，被凭空出现的金属巨构彻底封死。","id":471},{"type":"dialogue","name":"克莱门莎","text":"我为什么要犹疑？仁慈是分对象的，盖乌斯已经被你杀了，说我刚刚碾碎的是他的遗骸，都是对他的亵渎。","id":472},{"type":"text","text":"奥卢斯抬起头。他看见克莱门莎手上连接着神经缆线的指套几乎有些变形。","id":473},{"type":"text","text":"他忽然意识到，自己已经无路可退。","id":474},{"type":"dialogue","name":"奥卢斯","text":"……靠神经信号操控工程舰船的重型设备，要达到这样的速度和力度……难以想象这会给你带来怎样的负担。","id":475},{"type":"dialogue","name":"奥卢斯","text":"我还以为你只是急于找回港都中心城区，没想到，你会为了困住我而这么拼命。","id":476},{"type":"dialogue","name":"克莱门莎","text":"你或许没有说错，我当下确实没有办法定位它，更妄谈把它找回来。","id":477},{"type":"dialogue","name":"克莱门莎","text":"如果站在我面前的是玛利图斯，我或许会感到绝望，他的计划一定在中心城区消失的那一刻就已经完成。","id":478},{"type":"dialogue","name":"克莱门莎","text":"不论我再做什么，他都还会有万千同胞，在别处推动着他的“伟业”。","id":479},{"type":"dialogue","name":"克莱门莎","text":"所幸，我面前是你，奥卢斯。","id":480},{"type":"dialogue","name":"克莱门莎","text":"你以一副处处为岛民着想的面貌现身，但你甚至不愿多费一点力气去维护这副面貌。","id":481},{"type":"dialogue","name":"克莱门莎","text":"我提起岛民的死时，你甚至不愿稍稍收敛一下自己的笑容，那副陶醉于自己的理想和杰作的笑容。","id":482},{"type":"dialogue","name":"克莱门莎","text":"“那可确实是件好作品啊。”你说。好像岛民此时此刻的处境，全然无关紧要。","id":483},{"type":"dialogue","name":"奥卢斯","text":"实事求是罢了。","id":484},{"type":"dialog","id":485},{"type":"image","image":"https://media.prts.wiki/8/8d/Avg_74_i10_1.png","screenadapt":"coverall","xScale":"1.02","yScale":"1.02","x":"-10","y":"5","fadetime":"1.5","id":486},{"type":"imagetween","yTo":"-25","xTo":"40","xScaleFrom":"1.01","yScaleFrom":"1.01","xScaleTo":"1.08","yScaleTo":"1.08","duration":"20","block":"false","id":487},{"type":"delay","time":"2","id":488},{"type":"dialogue","name":"克莱门莎","text":"我听过很多岛民说起那些曾经属于他们，本该属于他们的事物。他们听起来或是遗憾，或是欣慰。","id":489},{"type":"dialogue","name":"克莱门莎","text":"但没有谁像你这样，言语间满是自傲。","id":490},{"type":"dialogue","name":"克莱门莎","text":"像你这般看重自己的人，我想，不论酝酿着怎样的宏图，都一定把自己放在了至关重要的位置。","id":491},{"type":"dialogue","name":"克莱门莎","text":"所以，不论你要用港都中心城区做什么，想必都只会是由你亲手操作，也只能由你亲自完成。","id":492},{"type":"dialogue","name":"奥卢斯","text":"这不是什么值得大肆批判的事吧？","id":493},{"type":"dialogue","name":"克莱门莎","text":"当然。我只是很想知道——","id":494},{"type":"dialogue","name":"克莱门莎","text":"如果我在这里杀死你，会怎样？","id":495},{"type":"dialogue","name":"奥卢斯","text":"克莱门莎执政官……我得提醒你。","id":496},{"type":"dialogue","name":"奥卢斯","text":"好好想想，自己上次入睡，是几天之前？上次注射过量的神经活性剂，又是几小时前？","id":497},{"type":"dialogue","name":"奥卢斯","text":"你真的认为自己在这样的状态下，可以取胜？","id":498},{"type":"dialogue","name":"克莱门莎","text":"我可以死在这里。","id":499},{"type":"dialogue","name":"克莱门莎","text":"而你呢？","id":500},{"type":"dialogue","name":"奥卢斯","text":"……","id":501},{"type":"dialog","id":502},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":503},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":504},{"type":"delay","time":"1","id":505},{"type":"image","id":506},{"type":"charslot","id":507},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":508},{"type":"delay","time":"1","id":509},{"type":"playsound","key":"$d_avg_swordsheath","id":510},{"type":"text","text":"奥卢斯沉默地将剑收入鞘中。","id":511},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#4$1","id":512},{"type":"dialogue","name":"克莱门莎","text":"知晓港都中心城区去向的，仍然只有你一人。","id":513,"figure":"https://media.prts.wiki/6/68/Avg_avg_4231_clemnt_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#4$1","id":514},{"type":"dialogue","name":"克莱门莎","text":"但现在，我相信，我们终于可以平等地对话了。","id":515,"figure":"https://media.prts.wiki/6/68/Avg_avg_4231_clemnt_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_4231_clemnt_1#2$1","id":516},{"type":"dialogue","name":"克莱门莎","text":"而奥卢斯，你会开口。","id":517,"figure":"https://media.prts.wiki/9/94/Avg_avg_4231_clemnt_1-2$1.png"},{"type":"dialog","id":518},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":519},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":520},{"type":"stopmusic","fadetime":"2","id":521},{"type":"charslot","id":522},{"type":"background","id":523},{"type":"image","id":524}],"characters":["塔西塔","克莱门莎","惩戒军士官","惩戒军新兵","艾丽妮","特菲","沉稳的男声","圣徒卡门","奥卢斯","？？？"]}