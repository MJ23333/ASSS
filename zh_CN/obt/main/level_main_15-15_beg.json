{"storyMeta":{"storyReviewType":"NONE","storyId":"main_15_level_main_15-15_beg","storyGroup":"main_15","storySort":229,"storyDependence":"main_15_level_main_15-15_beg","storyCanShow":0,"storyCode":"15-17","storyName":"“她”","storyPic":null,"storyInfo":"在众人跨入Abyss的瞬间，普瑞赛斯将博士、凯尔希、阿米娅转移到了甲板，并留下了其他人面对PRTS的攻击。","storyCanEnter":1,"storyTxt":"obt/main/level_main_15-15_beg","avgTag":"行动前","unLockType":"STAGE_CLEAR","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"main_15-15","minState":"PLAYED","maxState":"COMPLETE"}],"prev":17,"next":19,"characters":["阿米娅","普瑞赛斯","凯尔希","Mechanist","Misery","Raidian","Logos","阿斯卡纶","Mantra","Pith","Touch","Stormeye","煌","迷迭香","Sharp","Mon3tr"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"stopmusic","id":1},{"type":"dialog","id":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":3},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":4},{"type":"charslot","id":5},{"type":"playmusic","key":"https://static.prts.wiki/music/music/beta1_180603/m_dia_babel_loop.mp3","volume":"0.6","id":6,"musicid":0},{"type":"text","text":"我相信我们之间的联系会超越时间与空间。","id":7},{"type":"text","text":"就算是海洋沸腾、大气消失，就算我们的卫星接连坠入重力的漩涡，就算我们的太阳凶恶地膨胀、无情地吃掉它的孩子直至万籁俱寂......","id":8},{"type":"dialog","id":9},{"type":"curtain","direction":"0","fillfrom":"0.01","fillto":"0.2","fadetime":"0.1","id":10},{"type":"curtain","direction":"4","fillfrom":"0.01","fillto":"0.2","fadetime":"0.1","id":11},{"type":"delay","time":"1","id":12},{"type":"bgeffect","name":"$eb_tvnoise","layer":"1","id":13},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":14},{"type":"image","image":"https://media.prts.wiki/d/d5/Avg_avg_ac8mi_Pre.png","screenadapt":"coverall","id":15},{"type":"playsound","key":"$d_avg_filmprojection","id":16},{"type":"playsound","key":"$d_avg_filmprojection_loop","loop":"true","channel":"bgs","delay":"0.5","id":17},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"false","id":18},{"type":"delay","time":"0.5","id":19},{"type":"image","image":"https://media.prts.wiki/b/b6/Avg_avg_9_2.png","screenadapt":"coverall","id":20},{"type":"delay","time":"0.5","id":21},{"type":"image","image":"https://media.prts.wiki/c/c3/Avg_avg_31_3.png","screenadapt":"coverall","id":22},{"type":"delay","time":"0.5","id":23},{"type":"image","image":"https://media.prts.wiki/f/ff/Avg_avg_8_7_1.png","screenadapt":"coverall","id":24},{"type":"delay","time":"0.5","id":25},{"type":"image","image":"https://media.prts.wiki/a/ae/Avg_avg_ac8mi_sidebyside_dusk.png","screenadapt":"coverall","id":26},{"type":"delay","time":"0.5","id":27},{"type":"image","image":"https://media.prts.wiki/3/38/Avg_avg_8_7_2.png","screenadapt":"coverall","id":28},{"type":"delay","time":"0.5","id":29},{"type":"image","image":"https://media.prts.wiki/4/4d/Avg_avg_6_10.png","screenadapt":"coverall","id":30},{"type":"delay","time":"0.5","id":31},{"type":"image","image":"https://media.prts.wiki/f/fc/Avg_50_i02_2.png","screenadapt":"coverall","id":32},{"type":"delay","time":"0.5","id":33},{"type":"cameraeffect","effect":"Grayscale","fadetime":"0.5","keep":"true","initamount":"1","amount":"0","id":34},{"type":"image","image":"https://media.prts.wiki/4/41/Avg_50_i16.png","screenadapt":"coverall","id":35},{"type":"delay","time":"0.5","id":36},{"type":"image","image":"https://media.prts.wiki/4/41/Avg_50_i16.png","screenadapt":"coverall","xScale":"1.5","yScale":"1.5","id":37},{"type":"delay","time":"1","id":38},{"type":"image","image":"https://media.prts.wiki/4/41/Avg_50_i16.png","screenadapt":"coverall","xScale":"2.5","yScale":"2.5","y":"-200","id":39},{"type":"delay","time":"0.2","id":40},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.2","block":"true","id":41},{"type":"image","id":42},{"type":"dialog","id":43},{"type":"text","text":"我们也一样能再见面。在那用黑暗与星点光芒装饰过的文明尽头，我们也一样会再见面。一定。","id":44},{"type":"text","text":"我会等到那一天。我肯定会等到那一天。等我。你也要等我。","id":45},{"type":"dialog","id":46},{"type":"curtain","direction":"0","fillfrom":"0.01","fillto":"0.2","fadetime":"0.1","id":47},{"type":"curtain","direction":"4","fillfrom":"0.01","fillto":"0.2","fadetime":"0.1","id":48},{"type":"image","image":"https://media.prts.wiki/b/bc/Avg_avg_0_2.png","screenadapt":"coverall","xScale":"1.3","yScale":"1.3","id":49},{"type":"imagetween","xFrom":"180","yFrom":"150","xTo":"-100","yTo":"-100","duration":"4","block":"false","id":50},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"false","id":51},{"type":"delay","time":"2","id":52},{"type":"image","image":"https://media.prts.wiki/6/69/Avg_avg_0_1.png","screenadapt":"coverall","xScale":"1.3","yScale":"1.3","fadetime":"1","id":53},{"type":"imagetween","xFrom":"-50","yFrom":"-50","xTo":"-100","yTo":"-100","duration":"2","block":"false","id":54},{"type":"playsound","key":"$d_avg_signlntrfrnc","volume":"1","id":55},{"type":"bgeffect","name":"$eb_signalInterference","layer":"3","id":56},{"type":"delay","time":"0.5","id":57},{"type":"image","image":"https://media.prts.wiki/2/20/Avg_avg_8_9.png","screenadapt":"coverall","xScale":"1.3","yScale":"1.3","x":"-100","y":"-100","fadetime":"0.5","id":58},{"type":"imagetween","xFrom":"40","yFrom":"25","xTo":"-100","yTo":"-100","duration":"2","block":"false","id":59},{"type":"delay","time":"2","id":60},{"type":"stopmusic","fadetime":"0.2","id":61},{"type":"playsound","key":"$d_avg_filmprojection","id":62},{"type":"stopsound","channel":"bgs","fadetime":"0.2","id":63},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.2","block":"true","id":64},{"type":"image","id":65},{"type":"bgeffect","id":66},{"type":"text","text":"......不准忘记我。","id":67},{"type":"dialog","id":68},{"type":"image","id":69},{"type":"curtain","id":70},{"type":"playmusic","intro":"$loneliness_intro","key":"https://static.prts.wiki/music/music/static/m_avg/m_avg_loneliness_loop.mp3","volume":"0.6","id":71,"musicid":1},{"type":"image","image":"https://media.prts.wiki/d/d5/Avg_cg_rhodes_ceiling.png","screenadapt":"coverall","xScale":"1.1","yScale":"1.1","fadetime":"0","id":72},{"type":"imagetween","yFrom":"40","yTo":"-40","duration":"20","block":"false","id":73},{"type":"delay","time":"1","id":74},{"type":"playsound","key":"$d_avg_stonegateopen","volume":"1","loop":"true","channel":"st","id":75},{"type":"stopsound","channel":"st","fadetime":"4","id":76},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"4","block":"true","id":77},{"type":"text","text":"到时间了吗......？","id":78},{"type":"text","text":"我应该还活着，这不会是错觉。","id":79},{"type":"text","text":"这里还是我熟悉的罗德岛，看上去还在维持基本的运转，那么可以确定的是，祂还没有来过。","id":80},{"type":"text","text":"她还在沉睡吗？还有源石现在的状态......","id":81},{"type":"text","text":"至于这颗星球的变化......","id":82},{"type":"dialog","id":83},{"type":"playsound","key":"$d_avg_mechafault","volume":"0.6","id":84},{"type":"delay","time":"1.5","id":85},{"type":"text","text":"你还在这里，AMa-10。","id":86},{"type":"text","text":"正好......陪我去外面走走吧。","id":87},{"type":"dialog","id":88},{"type":"musicvolume","volume":"0.2","fadetime":"2","id":89},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":90},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":91},{"type":"image","id":92},{"type":"text","text":"身着白色外套的黑发女性站在稍远处的甲板上，专注地眺望着天空。","id":93},{"type":"text","text":"直到她注意到了你们的到来，她回过头看着你，脸上带着晴朗的笑容。","id":94},{"type":"dialog","id":95},{"type":"curtain","direction":"0","fillfrom":"0.01","fillto":"0.2","fadetime":"0.1","id":96},{"type":"curtain","direction":"4","fillfrom":"0.01","fillto":"0.2","fadetime":"0.1","id":97},{"type":"background","image":"https://media.prts.wiki/f/fa/Avg_bg_60_g14_rhodesdeck_glow.png","screenadapt":"coverall","xScale":"1.5","yScale":"1.5","id":98},{"type":"backgroundtween","yFrom":"300","yTo":"0","duration":"40","block":"false","id":99},{"type":"avgdisplay","id":100,"style":"bg","name":"bg_black","afrom":"1","ato":"0.2","duration":"1","slot":"bgover","layer":"2"},{"type":"bg","id":101,"from":"0","to":"1","duration":"0","block":"false"},{"type":"charslot","slot":"l","name":"avg_npc_1718_1#1$1","id":102},{"type":"charslot","slot":"l","posfrom":"200,250","posto":"200,-50","duration":"40","id":103},{"type":"charslot","slot":"l","action":"zoom","poszoom":"0.5,0.5","scale":"1.5","duration":"0","id":104},{"type":"delay","time":"1","id":105},{"type":"musicvolume","volume":"0.6","fadetime":"2","id":106},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":107},{"type":"text","text":"你很确信你曾经见过这张面孔。","id":108},{"type":"text","text":"在你梦境中的梦境，或是沉睡记忆最深处的角落。","id":109},{"type":"text","text":"但此时绝不是梦。","id":110},{"type":"text","text":"你能清晰感受到她就站在你身前，你的每一个感官，都能清楚地感知到她的存在。","id":111},{"type":"dialog","id":112},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":113},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":114},{"type":"charslot","id":115},{"type":"curtain","id":116},{"type":"avgdisplay","id":117},{"type":"background","image":"https://media.prts.wiki/f/fa/Avg_bg_60_g14_rhodesdeck_glow.png","screenadapt":"coverall","id":118},{"type":"bg","id":119,"from":"1","to":"0","duration":"0","block":"false"},{"type":"delay","time":"1","id":120},{"type":"playsound","key":"$d_avg_drkcludsthdr","volume":"1","loop":"true","channel":"dr","id":121},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":122},{"type":"delay","time":"1","id":123},{"type":"playsound","key":"$d_gen_walk_n","id":124},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#8$1","duration":"1.5","isblock":"true","id":125},{"type":"delay","time":"1","id":126},{"type":"charslot","slot":"m","focus":"n","id":127},{"type":"decision","options":{"1":{"id":"129","text":"普瑞赛斯......"}},"values":[],"id":128},{"type":"predicate","references":["1"],"id":129,"end":153},{"type":"charslot","slot":"m","name":"avg_1037_amiya3_1#6$3","id":130},{"type":"dialogue","name":"阿米娅","text":"博士，这个人......就是普瑞赛斯？","id":131,"figure":"https://media.prts.wiki/a/a6/Avg_avg_1037_amiya3_1-6$3.png"},{"type":"dialogue","name":"阿米娅","text":"这就是凯尔希医生一直在戒备的敌人......","id":132,"figure":"https://media.prts.wiki/a/a6/Avg_avg_1037_amiya3_1-6$3.png"},{"type":"charslot","id":133},{"type":"text","text":"尽管不明白即将面对的危险，阿米娅还是习惯性地挡在了你的身前，做好了迎战的准备。","id":134},{"type":"text","text":"可你的确无法对当下的局势做出准确的判断，但你很清楚的是，这不同于你们以往面对的任何一个强敌，或是任何一次危机。","id":135},{"type":"text","text":"眼前的女性看上去没有任何敌意，尽管如此，你的直觉还是在告诉你——这是无可估量的危险。","id":136},{"type":"text","text":"她轻柔地开口。","id":137},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#8$1","id":138},{"type":"dialogue","name":"普瑞赛斯","text":"{@nickname}，是你先我一步呢。","id":139,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-8$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"你没有留在唤醒室等待我，与我一同分享第一次看见这个新世界的喜悦。","id":140,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-8$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"可我又怎么忍心责怪你这一点小小的心急呢？","id":141,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-8$1.png"},{"type":"charslot","slot":"m","focus":"n","id":142},{"type":"text","text":"你也感受到了她纯粹而真挚的目光。","id":143},{"type":"text","text":"远处传来风声和雷鸣，以及若有若无的源石蔓延的窸窣声。","id":144},{"type":"text","text":"在这片嘈杂缭乱的空间中，她只是专注地注视着你，眼中容不下任何其他。","id":145},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#1$1","id":146},{"type":"dialogue","name":"普瑞赛斯","text":"虽然这样的重逢和我们预期的有所不同，不过我也愿意接受这种意外的体验。","id":147,"figure":"https://media.prts.wiki/b/b2/Avg_avg_npc_1718_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#9$1","id":148},{"type":"dialogue","name":"普瑞赛斯","text":"我们无数次一同畅想过，在时间的另一头，我们从休眠中苏醒后第一次见面的情景。","id":149,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-9$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"源石已经完全包裹这颗星球，我们可以在其上自由地漫步，这是只属于我们的世界。","id":150,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-9$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#1$1","id":151},{"type":"dialogue","name":"普瑞赛斯","text":"这个世界离我们共同的终极愿景只有一步之遥，我们正步向新的希望......","id":152,"figure":"https://media.prts.wiki/b/b2/Avg_avg_npc_1718_1-1$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"而且，那应该是一个明媚的晴天。","id":153,"figure":"https://media.prts.wiki/b/b2/Avg_avg_npc_1718_1-1$1.png","end":true},{"type":"dialog","id":154},{"type":"playsound","key":"$d_avg_magicchange","volume":"1","id":155},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":156},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.5","block":"true","id":157},{"type":"charslot","id":158},{"type":"bgeffect","name":"$eb_sunlight_l","layer":"1","x":"-400","y":"100","id":159},{"type":"background","image":"https://media.prts.wiki/3/3e/Avg_bg_60_g13_rhodesdeck_origin.png","screenadapt":"coverall","fadetime":"3","id":160},{"type":"stopsound","channel":"dr","fadetime":"4","id":161},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"2","block":"true","id":162},{"type":"delay","time":"2","id":163},{"type":"charslot","slot":"m","name":"avg_1037_amiya3_1#5$3","id":164},{"type":"dialogue","name":"阿米娅","text":"博士，快看天上的云层——","id":165,"figure":"https://media.prts.wiki/e/e0/Avg_avg_1037_amiya3_1-5$3.png"},{"type":"charslot","id":166},{"type":"text","text":"阿米娅注意到了天空中的异象，随即向你发出了预警。","id":167},{"type":"text","text":"可你无法想象，甚至无法理解此时此刻亲眼看到的景象。","id":168},{"type":"text","text":"普瑞赛斯的话音刚落，空中厚重的天灾云便开始以一种规则却诡异的姿态收缩折叠，直至完全消失，留下画布般的天空。","id":169},{"type":"text","text":"天灾，这片大地上最可怖的灾难，就这样消弭于无形。","id":170},{"type":"text","text":"你意识到一个可怕的事实。","id":171},{"type":"dialog","id":172},{"type":"decision","options":{"1":{"id":"174","text":"你能够完全“掌控”源石......？"}},"values":[],"id":173},{"type":"predicate","references":["1"],"id":174,"end":178},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#2$1","id":175},{"type":"dialogue","name":"普瑞赛斯","text":"{@nickname}，这样的问题令我感到陌生。","id":176,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"这是我们共同的创造，只属于你我二人的结晶，是希望的种子。","id":177,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"但是很可惜......你已经不记得了，对吗？","id":178,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png","end":true},{"type":"dialog","id":179},{"type":"charslot","slot":"m","focus":"n","id":180},{"type":"decision","options":{"1":{"id":"182","text":"源石......是我们的创造？"},"2":{"id":"182","text":"我不记得......"}},"values":[],"id":181},{"type":"predicate","references":["1","2"],"id":182,"end":189},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#2$1","id":183},{"type":"dialogue","name":"普瑞赛斯","text":"我知道，因为一些遗憾的意外，你失去了一部分记忆。","id":184,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"虽然遗憾，但我相信，只是一部分记忆的缺失不会改变你的本性，我们之间的联系无可动摇。","id":185,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"我并不想对你有任何苛待，但是我希望你能理解——时间很紧张，我们还有许多事要做。","id":186,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#8$1","id":187},{"type":"dialogue","name":"普瑞赛斯","text":"不过，我们总还是可以享受共事的时光，对吗？","id":188,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-8$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"回到我的身边，Dr.{@nickname}......","id":189,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-8$1.png","end":true},{"type":"dialog","id":190},{"type":"playsound","key":"$d_avg_humanchange","volume":"1","id":191},{"type":"delay","time":"0.4","id":192},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":193},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.5","block":"true","id":194},{"type":"charslot","id":195},{"type":"background","image":"https://media.prts.wiki/c/c6/Avg_bg_bg_white.png","screenadapt":"coverall","id":196},{"type":"bgeffect","id":197},{"type":"sticker","id":198,"multi":"true","text":"<color=#000000>让泰拉变成源石的结晶。</color>","x":"250","y":"300","alignment":"center","duration":"1","size":"24","delay":"0.04","width":"800"},{"type":"sticker","id":199,"multi":"true","text":"<color=#000000>\\n\\n铸造成通往未来的阶梯。</color>","block":"true"},{"type":"sticker","id":200,"duration":"2","block":"false"},{"type":"delay","time":"2","id":201},{"type":"text","text":"温柔的呼唤仿佛突然在耳边响起，你感受到无比地亲切。","id":202},{"type":"text","text":"你很确信，你无法从记忆中打捞起任何与她相关的片段，但是自己与这个人的联系超越了记忆，或是语言承载的信息。","id":203},{"type":"text","text":"那是近乎本能的反应。","id":204},{"type":"text","text":"你不由自主地向前走了一步。","id":205},{"type":"dialog","id":206},{"type":"playsound","key":"$d_avg_tinnitus","volume":"1","loop":"true","channel":"ti","id":207},{"type":"background","image":"https://media.prts.wiki/3/3e/Avg_bg_60_g13_rhodesdeck_origin.png","screenadapt":"coverall","id":208},{"type":"delay","time":"0.4","id":209},{"type":"stopsound","channel":"ti","fadetime":"3","id":210},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"3","block":"true","id":211},{"type":"camerashake","duration":"0.3","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":212},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#4$1","id":213},{"type":"dialogue","name":"凯尔希","text":"Dr.{@nickname}！","id":214,"figure":"https://media.prts.wiki/1/10/Avg_avg_003_kalts_1-4$1.png"},{"type":"charslot","id":215},{"type":"text","text":"凯尔希在你身后，紧紧地抓住了你的手臂，虚弱的颤抖通过她的手心传来。","id":216},{"type":"text","text":"你注意到，从刚才起，凯尔希便一言不发。离开石棺时她就已经无比虚弱，现在更是连站立都需要勉力维持。","id":217},{"type":"text","text":"你感到迷惑。","id":218},{"type":"text","text":"你期待能如往常一样，凯尔希会给你一些引导，或者是更简单明了的答案。","id":219},{"type":"text","text":"而此时的她看上去正遭受着巨大的煎熬。她的表情挣扎又痛苦。","id":220},{"type":"text","text":"经过了漫长的刹那，她松开了手。","id":221},{"type":"text","text":"她把选择完全交给了你。","id":222},{"type":"dialog","id":223},{"type":"decision","options":{"1":{"id":"225","text":"不......"},"2":{"id":"225","text":"不。"},"3":{"id":"225","text":"......不。"}},"values":[],"id":224},{"type":"predicate","references":["1","2","3"],"id":225},{"type":"decision","options":{"1":{"id":"227","text":"我不会让源石毁灭泰拉。"}},"values":[],"id":226},{"type":"predicate","references":["1"],"id":227,"end":249},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#2$1","id":228},{"type":"dialogue","name":"普瑞赛斯","text":"......","id":229,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"charslot","slot":"m","focus":"n","id":230},{"type":"text","text":"你看到她的目光蒙上了一层阴翳，那是明显的失落。不知为何，你的心脏狠狠收紧了一下。","id":231},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#10$1","id":232},{"type":"dialogue","name":"普瑞赛斯","text":"是你啊......AMa-10。同样好久不见了。","id":233,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"虽然你现在的模样和诞生之初相去甚远，可我怎会不认识自己倾注了情感的造物呢？","id":234,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#6$1","id":235},{"type":"dialogue","name":"凯尔希","text":"......","id":236,"figure":"https://media.prts.wiki/6/6c/Avg_avg_003_kalts_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#10$1","id":237},{"type":"dialogue","name":"普瑞赛斯","text":"这四百多万个自然日的时间里，你似乎做了许多努力，但你行为的准则似乎并不符合你诞生时被预设的目标。","id":238,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"我想知道，到底是什么让你改变了主意。","id":239,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#7$1","id":240},{"type":"dialogue","name":"凯尔希","text":"和你卑劣的骗局不同......","id":241,"figure":"https://media.prts.wiki/4/45/Avg_avg_003_kalts_1-7$1.png"},{"type":"dialogue","name":"凯尔希","text":"......我的目标，从来没有改变过。","id":242,"figure":"https://media.prts.wiki/4/45/Avg_avg_003_kalts_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#1$1","id":243},{"type":"dialogue","name":"普瑞赛斯","text":"是啊......是你将那个人的命令，当做了不可动摇的目标。","id":244,"figure":"https://media.prts.wiki/b/b2/Avg_avg_npc_1718_1-1$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"所以你阻碍了源石的计划，浪费了本就已寥寥无几的时间。","id":245,"figure":"https://media.prts.wiki/b/b2/Avg_avg_npc_1718_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#9$1","id":246},{"type":"dialogue","name":"普瑞赛斯","text":"所以，{@nickname}，我该怎么让你明白......","id":247,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-9$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"我有多么失望。","id":248,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-9$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"我又该如何原谅你的背叛？","id":249,"figure":"https://media.prts.wiki/f/f7/Avg_avg_npc_1718_1-9$1.png","end":true},{"type":"dialog","id":250},{"type":"charslot","id":251},{"type":"decision","options":{"1":{"id":"253","text":"背叛？"}},"values":[],"id":252},{"type":"predicate","references":["1"],"id":253},{"type":"decision","options":{"1":{"id":"255","text":"凯尔希，这是什么意思......"}},"values":[],"id":254},{"type":"predicate","references":["1"],"id":255,"end":263},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#6$1","id":256},{"type":"dialogue","name":"凯尔希","text":"......","id":257,"figure":"https://media.prts.wiki/6/6c/Avg_avg_003_kalts_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#10$1","id":258},{"type":"dialogue","name":"普瑞赛斯","text":"我注意到了，AMa-10。","id":259,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"你已经打破了我设下的语言的禁令，对吗？","id":260,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"这样的防备并不足以完全限制你的活动，你总是有办法......","id":261,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"既然如此，为什么不说出来？","id":262,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"这么长时间以来，那些你想说却没有办法告诉{@nickname}的一切？","id":263,"figure":"https://media.prts.wiki/5/50/Avg_avg_npc_1718_1-10$1.png","end":true},{"type":"dialog","id":264},{"type":"charslot","id":265},{"type":"stopmusic","fadetime":"2","id":266},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#7$1","duration":"1.5","isblock":"true","id":267},{"type":"dialogue","name":"凯尔希","text":"普瑞赛斯......","id":268,"figure":"https://media.prts.wiki/4/45/Avg_avg_003_kalts_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#15$1","id":269},{"type":"dialogue","name":"凯尔希","text":"*未知语言粗口*。","id":270,"figure":"https://media.prts.wiki/3/3e/Avg_avg_003_kalts_1-15$1.png"},{"type":"dialog","id":271},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":272},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":273},{"type":"charslot","id":274},{"type":"background","image":"https://media.prts.wiki/0/03/Avg_bg_60_g4_rhodesabyss_w.png","screenadapt":"coverall","id":275},{"type":"delay","time":"1","id":276},{"type":"bgeffect","name":"$eb_dim_openeye","layer":"1","id":277},{"type":"playmusic","intro":"$suspenseful_intro","key":"https://static.prts.wiki/music/music/act15d0d0/m_avg_suspenseful_loop.mp3","volume":"0.6","id":278,"musicid":2},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":279},{"type":"delay","time":"1","id":280},{"type":"text","text":"精英干员和阿斯卡纶跨入那道裂缝之后，一时有些晃神。","id":281},{"type":"charslot","slot":"m","name":"avg_npc_521_1#1$1","id":282},{"type":"dialogue","name":"Mechanist","text":"这就是Abyss？！","id":283,"figure":"https://media.prts.wiki/d/db/Avg_avg_npc_521_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_235","id":284},{"type":"dialogue","name":"Misery","text":"Raidian，能确定我们还在罗德岛本舰内吗？","id":285,"figure":"https://media.prts.wiki/2/23/Avg_avg_npc_235.png"},{"type":"charslot","slot":"m","name":"avg_npc_1730_1#3$1","id":286},{"type":"dialogue","name":"Raidian","text":"无法感知到这个空间之外的电磁信号，唔，没法判断。","id":287,"figure":"https://media.prts.wiki/1/12/Avg_avg_npc_1730_1-3$1.png"},{"type":"charslot","id":288},{"type":"text","text":"所有人陷入了片刻的沉默，下意识地等待着指挥官的进一步指挥。","id":289},{"type":"charslot","slot":"m","name":"avg_4133_logos_1#8$1","id":290},{"type":"dialogue","name":"Logos","text":"......","id":291,"figure":"https://media.prts.wiki/d/d3/Avg_avg_4133_logos_1-8$1.png"},{"type":"dialogue","name":"Logos","text":"博士，在何处？","id":292,"figure":"https://media.prts.wiki/d/d3/Avg_avg_4133_logos_1-8$1.png"},{"type":"charslot","slot":"m","name":"avg_4132_ascln_1#4$1","id":293},{"type":"dialogue","name":"阿斯卡纶","text":"还有凯尔希医生和阿米娅。","id":294,"figure":"https://media.prts.wiki/3/3e/Avg_avg_4132_ascln_1-4$1.png"},{"type":"dialogue","name":"阿斯卡纶","text":"进入裂隙的一瞬间，我就失去了对她们和博士的位置的把握。","id":295,"figure":"https://media.prts.wiki/3/3e/Avg_avg_4132_ascln_1-4$1.png"},{"type":"charslot","id":296},{"type":"text","text":"巨大的白色空间内充斥着一成不变的白噪，还有最中央机械的运作声。","id":297},{"type":"charslot","slot":"m","name":"avg_npc_1300_1#1$1","id":298},{"type":"dialogue","name":"Mantra","text":"如果这里的确是Abyss，那显然它扭曲了我们对物理空间的感知。","id":299,"figure":"https://media.prts.wiki/1/16/Avg_avg_npc_1300_1-1$1.png"},{"type":"charslot","id":300},{"type":"text","text":"Mantra的声音浮现在所有人脑海中的同时，他们都注意到了这一点。","id":301},{"type":"charslot","slot":"m","name":"avg_npc_235","id":302},{"type":"dialogue","name":"Misery","text":"无法识别构成墙面的物质。","id":303,"figure":"https://media.prts.wiki/2/23/Avg_avg_npc_235.png"},{"type":"charslot","slot":"m","focus":"n","id":304},{"type":"text","text":"他回头看去，来时的裂缝已经消失了。","id":305},{"type":"charslot","slot":"m","name":"avg_npc_235","id":306},{"type":"dialogue","name":"Misery","text":"暂时没办法直接划开这些诡异的墙面，无法确认博士一行人的下落。","id":307,"figure":"https://media.prts.wiki/2/23/Avg_avg_npc_235.png"},{"type":"charslot","slot":"m","name":"avg_npc_1310_1#1$1","id":308},{"type":"dialogue","name":"Pith","text":"有阿米娅和凯尔希医生在，相信她们可以保护博士的安全。","id":309,"figure":"https://media.prts.wiki/1/12/Avg_avg_npc_1310_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_249_1$1","id":310},{"type":"dialogue","name":"Touch","text":"随机应变即可。","id":311,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_249_1$1.png"},{"type":"dialogue","name":"Touch","text":"没有接收到任何新的指令，那就继续执行原任务。","id":312,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_249_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_167","id":313},{"type":"dialogue","name":"Stormeye","text":"那就不耽搁了。","id":314,"figure":"https://media.prts.wiki/e/ef/Avg_avg_npc_167.png"},{"type":"dialogue","name":"Stormeye","text":"Mechanist，我和Sharp掩护你靠近那个未知机械，先确认是否和PRTS核心有关。","id":315,"figure":"https://media.prts.wiki/e/ef/Avg_avg_npc_167.png"},{"type":"charslot","slot":"m","name":"avg_4132_ascln_1#1$1","id":316},{"type":"multiline","name":"阿斯卡纶","text":"我们随时可以支援——","id":317},{"type":"charslot","slot":"m","name":"avg_4132_ascln_1#4$1","id":318},{"type":"multiline","name":"阿斯卡纶","end":"true","text":"不对劲，这里没有看到任何高威胁目标。","id":319},{"type":"charslot","slot":"m","name":"avg_017_huang_1#4$2","id":320},{"type":"dialogue","name":"煌","text":"这很反常。","id":321,"figure":"https://media.prts.wiki/c/c0/Avg_avg_017_huang_1-4$2.png"},{"type":"dialogue","name":"煌","text":"按照凯尔希医生和博士的推测，我们遭遇的源石结晶体都是来源于Abyss......","id":322,"figure":"https://media.prts.wiki/c/c0/Avg_avg_017_huang_1-4$2.png"},{"type":"dialogue","name":"煌","text":"但这里就好像不存在任何的防御措施——","id":323,"figure":"https://media.prts.wiki/c/c0/Avg_avg_017_huang_1-4$2.png"},{"type":"charslot","slot":"m","name":"avg_391_rosmon_1#2$2","id":324},{"type":"dialogue","name":"迷迭香","text":"我听到了......疼痛。","id":325,"figure":"https://media.prts.wiki/d/d2/Avg_avg_391_rosmon_1-2$2.png"},{"type":"charslot","slot":"m","name":"avg_017_huang_1#9$2","id":326},{"type":"dialogue","name":"煌","text":"小猫？","id":327,"figure":"https://media.prts.wiki/8/89/Avg_avg_017_huang_1-9$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_249_1$1","id":328},{"type":"dialogue","name":"Touch","text":"迷迭香，你还感知到身体的其他异常了吗？","id":329,"figure":"https://media.prts.wiki/9/99/Avg_avg_npc_249_1$1.png"},{"type":"charslot","slot":"m","name":"avg_391_rosmon_1#1$2","id":330},{"type":"dialogue","name":"迷迭香","text":"不，不是我自己......","id":331,"figure":"https://media.prts.wiki/0/05/Avg_avg_391_rosmon_1-1$2.png"},{"type":"charslot","id":332},{"type":"text","text":"透明地板下，庞大的黑色漩涡的转动缓缓变快。","id":333},{"type":"text","text":"漩涡的正上方，那台无法识别的仪器也开始闪烁红色光芒。","id":334},{"type":"charslot","slot":"m","name":"avg_npc_1730_1#9$1","id":335},{"type":"dialogue","name":"Raidian","text":"识别到大量干扰信号产生。","id":336,"figure":"https://media.prts.wiki/a/a3/Avg_avg_npc_1730_1-9$1.png"},{"type":"dialogue","name":"Raidian","text":"那边的仪器正在进行海量的数据传输——","id":337,"figure":"https://media.prts.wiki/a/a3/Avg_avg_npc_1730_1-9$1.png"},{"type":"dialogue","name":"Raidian","text":"难道它下方的黑色漩涡......只是数据的可视化显示？","id":338,"figure":"https://media.prts.wiki/a/a3/Avg_avg_npc_1730_1-9$1.png"},{"type":"dialog","id":339},{"type":"playsound","key":"$d_avg_spotlightc","volume":"1","id":340},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":341},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.01","block":"true","id":342},{"type":"charslot","id":343},{"type":"bgeffect","id":344},{"type":"background","image":"https://media.prts.wiki/2/22/Avg_bg_60_g15_rhodesabyss_off.png","screenadapt":"coverall","id":345},{"type":"delay","time":"2","id":346},{"type":"playsound","key":"$d_avg_activation","volume":"1","id":347},{"type":"avgdisplay","id":348,"style":"bgeffect","name":"$eb_glow_s","slot":"bgover","x":"342","y":"-337","layer":"1"},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":349},{"type":"delay","time":"2","id":350},{"type":"charslot","slot":"m","name":"avg_npc_252","id":351},{"type":"dialogue","name":"Sharp","text":"——？！","id":352,"figure":"https://media.prts.wiki/c/c9/Avg_avg_npc_252.png"},{"type":"dialog","id":353},{"type":"charslot","id":354},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":355},{"type":"blocker","a":"0.6","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":356},{"type":"sticker","id":357,"multi":"true","text":"PRTS防御系统已启动。","x":"180","y":"170","alignment":"left","size":"24","delay":"0.04","width":"700","block":"true"},{"type":"sticker","id":358,"multi":"true","text":"\\n\\n威胁目标识别中......身份已确认。","block":"true"},{"type":"sticker","id":359,"multi":"true","text":"\\n\\n载入威胁目标数据档案，针对性对抗策略生成中......","block":"true"},{"type":"sticker","id":360,"multi":"true","text":"\\n\\n演算完毕。","block":"true"},{"type":"sticker","id":361,"duration":"0.5","block":"false"},{"type":"delay","time":"0.5","id":362},{"type":"playsound","key":"$alarmenter","volume":"0.8","id":363},{"type":"blocker","a":"0.3","r":"1","g":"0.2","b":"0.2","fadetime":"0.7","block":"true","id":364},{"type":"blocker","a":"0.6","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":365},{"type":"sticker","id":366,"multi":"true","text":"这是来自PRTS的最后一次警告。","x":"180","y":"170","alignment":"left","size":"24","delay":"0.04","width":"700","block":"true"},{"type":"sticker","id":367,"multi":"true","text":"\\n\\n入侵者，离开Abyss。","block":"true"},{"type":"sticker","id":368,"multi":"true","text":"\\n\\n倒计时启动——","block":"true"},{"type":"sticker","id":369,"duration":"1","block":"false"},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":370},{"type":"playsound","key":"$d_avg_enemyappear_weird","volume":"1","id":371},{"type":"charslot","slot":"r","name":"avg_npc_1727_1#1$1","duration":"1","id":372},{"type":"charslot","slot":"l","name":"avg_npc_1728_1#1$1","duration":"1","id":373},{"type":"delay","time":"3","id":374},{"type":"charslot","id":375},{"type":"charslot","slot":"m","name":"avg_017_huang_1#4$2","id":376},{"type":"dialogue","name":"煌","text":"啧，我们成入侵者了？","id":377,"figure":"https://media.prts.wiki/c/c0/Avg_avg_017_huang_1-4$2.png"},{"type":"dialogue","name":"煌","text":"不过看上去你也没有给我们撤退的选项嘛。","id":378,"figure":"https://media.prts.wiki/c/c0/Avg_avg_017_huang_1-4$2.png"},{"type":"dialogue","name":"煌","text":"怎么说，阿斯卡纶？","id":379,"figure":"https://media.prts.wiki/c/c0/Avg_avg_017_huang_1-4$2.png"},{"type":"charslot","slot":"m","name":"avg_4132_ascln_1#4$1","id":380},{"type":"dialogue","name":"阿斯卡纶","text":"清扫罗德岛的垃圾。","id":381,"figure":"https://media.prts.wiki/3/3e/Avg_avg_4132_ascln_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_017_huang_1#1$2","id":382},{"type":"dialogue","name":"煌","text":"说得好，我喜欢。","id":383,"figure":"https://media.prts.wiki/b/bf/Avg_avg_017_huang_1-1$2.png"},{"type":"charslot","slot":"m","name":"avg_017_huang_1#11$2","id":384},{"type":"dialogue","name":"煌","text":"不管这些东西到底是从哪里跑出来的，就让它们知道，这到底是谁的罗德岛。","id":385,"figure":"https://media.prts.wiki/9/9e/Avg_avg_017_huang_1-11$2.png"},{"type":"dialog","id":386},{"type":"charslot","id":387},{"type":"playsound","key":"$alarmenter","volume":"0.8","id":388},{"type":"avgdisplay","id":389,"style":"bgeffect","name":"$eb_glow_l","slot":"bgover","x":"-400","y":"-295","layer":"2"},{"type":"blocker","a":"0.3","r":"1","g":"0.2","b":"0.2","fadetime":"0.7","block":"true","id":390},{"type":"blocker","a":"0.6","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":391},{"type":"sticker","id":392,"multi":"true","text":"倒计时结束。","x":"180","y":"170","alignment":"left","size":"24","delay":"0.04","width":"700","block":"true"},{"type":"sticker","id":393,"multi":"true","text":"\\n\\n清除协议启动——","block":"true"},{"type":"sticker","id":394,"duration":"0.5","block":"false"},{"type":"stopmusic","fadetime":"2","id":395},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":396},{"type":"avgdisplay","id":397},{"type":"avgdisplay","id":398},{"type":"charslot","id":399},{"type":"background","image":"https://media.prts.wiki/3/3e/Avg_bg_60_g13_rhodesdeck_origin.png","screenadapt":"coverall","id":400},{"type":"playmusic","key":"https://static.prts.wiki/music/music/avg/m_avg_memory_loop.mp3","volume":"0.6","id":401,"musicid":3},{"type":"delay","time":"1","id":402},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":403},{"type":"delay","time":"1","id":404},{"type":"decision","options":{"1":{"id":"406","text":"凯尔希？"},"2":{"id":"406","text":"这一切，到底是怎么回事......"}},"values":[],"id":405},{"type":"predicate","references":["1","2"],"id":406,"end":417},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#1$1","id":407},{"type":"dialogue","name":"凯尔希","text":"Dr.{@nickname}，从你在切尔诺伯格醒来开始，我一直没有向你坦白过去的所有真相。","id":408,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"附加在我身上的禁令，只是其中一部分原因。","id":409,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#2$1","id":410},{"type":"dialogue","name":"凯尔希","text":"而更多的原因......我说过，你的过去，不应该由任何人来告诉你。","id":411,"figure":"https://media.prts.wiki/4/4f/Avg_avg_003_kalts_1-2$1.png"},{"type":"dialogue","name":"凯尔希","text":"语言无法还原客观事实，情感会曲解表达。","id":412,"figure":"https://media.prts.wiki/4/4f/Avg_avg_003_kalts_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#1$1","id":413},{"type":"dialogue","name":"凯尔希","text":"所以我需要你自己去看，自己去判断，自己去重新认识这片大地。","id":414,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"然后你才能得出自己的答案，关于你对这片大地的看法，关于你自身。","id":415,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"我至今依然相信......这样是有意义的。","id":416,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"就像曾经，有人对我做过的事一样。","id":417,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png","end":true},{"type":"dialog","id":418},{"type":"charslot","slot":"m","focus":"n","id":419},{"type":"decision","options":{"1":{"id":"421","text":"我已经找到了我的答案。"}},"values":[],"id":420},{"type":"predicate","references":["1"],"id":421},{"type":"decision","options":{"1":{"id":"423","text":"我是Dr.{@nickname}。"},"2":{"id":"423","text":"我是罗德岛的博士。"},"3":{"id":"423","text":"我是这片大地上的一个生灵。"}},"values":[],"id":422},{"type":"predicate","references":["1","2","3"],"id":423,"end":439},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#13$1","id":424},{"type":"dialogue","name":"凯尔希","text":"......","id":425,"figure":"https://media.prts.wiki/5/5f/Avg_avg_003_kalts_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#4$1","id":426},{"type":"dialogue","name":"凯尔希","text":"但是现在，或许是最后告诉你这些信息的机会。","id":427,"figure":"https://media.prts.wiki/1/10/Avg_avg_003_kalts_1-4$1.png"},{"type":"dialogue","name":"凯尔希","text":"也只有现在，在你与罗德岛共同经历过这些事之后，我才有信心，将这些事告诉你。","id":428,"figure":"https://media.prts.wiki/1/10/Avg_avg_003_kalts_1-4$1.png"},{"type":"dialogue","name":"凯尔希","text":"请你相信，这只是你的过去，却无关你的未来。","id":429,"figure":"https://media.prts.wiki/1/10/Avg_avg_003_kalts_1-4$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#2$1","id":430},{"type":"dialogue","name":"普瑞赛斯","text":"......","id":431,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"charslot","id":432},{"type":"text","text":"凯尔希走到了你的身前，面对着你和阿米娅。","id":433},{"type":"text","text":"她缓缓开口。","id":434},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#1$1","id":435},{"type":"dialogue","name":"凯尔希","text":"Dr.{@nickname}，你应当已经知道，为泰拉同时带来生机与威胁的源石，是上一个时代的遗产。","id":436,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"它是那时的文明，为了应对终极的威胁，所尝试的无数办法中的一种。","id":437,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"在经历了无数人的努力与牺牲后，源石，在预言家和普瑞赛斯的手中，终于得以完成。","id":438,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"“预言家”，是你曾经的代号。","id":439,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png","end":true},{"type":"dialog","id":440},{"type":"charslot","slot":"m","focus":"n","id":441},{"type":"decision","options":{"1":{"id":"443","text":"我和普瑞赛斯......创造了源石？"}},"values":[],"id":442},{"type":"predicate","references":["1"],"id":443},{"type":"decision","options":{"1":{"id":"445","text":"......是我为这片大地带来了苦难？"}},"values":[],"id":444},{"type":"predicate","references":["1"],"id":445,"end":456},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#1$1","id":446},{"type":"dialogue","name":"凯尔希","text":"......请相信，这并非你的本意。","id":447,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"源石指向了这片大地的两种未来......预言家希望将源石当做留给后来文明的礼物、指引他们前进的信标。","id":448,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"希望源石能帮助他们走入文明的下一阶段。","id":449,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"在过去一万年的时间，源石为泰拉文明的发展带来了助力，但随之而来的矿石病的苦难，却是预料之外的状况。","id":450,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"dialogue","name":"凯尔希","text":"曾经的你，也的确为此痛苦过。","id":451,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_1037_amiya3_1#1$3","id":452},{"type":"dialogue","name":"阿米娅","text":"我还记得......那时的博士......","id":453,"figure":"https://media.prts.wiki/c/cb/Avg_avg_1037_amiya3_1-1$3.png"},{"type":"dialogue","name":"阿米娅","text":"无论什么时候，博士从来没有放弃过治愈矿石病的可能。","id":454,"figure":"https://media.prts.wiki/c/cb/Avg_avg_1037_amiya3_1-1$3.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#1$1","id":455},{"type":"dialogue","name":"凯尔希","text":"但是有人，将对另一种未来的认同强加于你。也因此......你做出了那个违背本心的选择。","id":456,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png","end":true},{"type":"dialog","id":457},{"type":"playsound","key":"$flashback","volume":"0.8","id":458},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":459},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.5","block":"true","id":460},{"type":"charslot","id":461},{"type":"background","id":462},{"type":"image","image":"https://media.prts.wiki/e/ef/Avg_49_i21_2.png","screenadapt":"coverall","id":463},{"type":"cameraeffect","effect":"Grayscale","amount":"0.8","keep":"true","id":464},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":465},{"type":"delay","time":"2","id":466},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":467},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.5","block":"true","id":468},{"type":"image","id":469},{"type":"background","image":"https://media.prts.wiki/3/3e/Avg_bg_60_g13_rhodesdeck_origin.png","screenadapt":"coverall","id":470},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#3$1","id":471},{"type":"cameraeffect","effect":"Grayscale","amount":"0","keep":"true","id":472},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":473},{"type":"delay","time":"1","id":474},{"type":"dialogue","name":"普瑞赛斯","text":"......","id":475,"figure":"https://media.prts.wiki/9/9e/Avg_avg_npc_1718_1-3$1.png"},{"type":"dialog","id":476},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#1$1","id":477},{"type":"dialogue","name":"凯尔希","text":"曾有人告诉我，要去相信你的本性，寻找你超越记忆塑造的本来面目。对我来说，这是一条无比困难的道路。","id":478,"figure":"https://media.prts.wiki/a/ae/Avg_avg_003_kalts_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#13$1","id":479},{"type":"dialogue","name":"凯尔希","text":"但我很高兴......这是一个正确的选择。","id":480,"figure":"https://media.prts.wiki/5/5f/Avg_avg_003_kalts_1-13$1.png"},{"type":"dialogue","name":"凯尔希","text":"Dr.{@nickname}，这些就是我想要告诉你的所有事情。而这些也只是你的过去，你永远可以决定自己的将来。","id":481,"figure":"https://media.prts.wiki/5/5f/Avg_avg_003_kalts_1-13$1.png"},{"type":"dialog","id":482},{"type":"charslot","slot":"m","focus":"n","id":483},{"type":"decision","options":{"1":{"id":"485","text":"我不会背弃我的承诺。"},"2":{"id":"485","text":"我不会放弃我的使命。"}},"values":[],"id":484},{"type":"predicate","references":["1","2"],"id":485,"end":491},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#13$1","id":486},{"type":"dialogue","name":"凯尔希","text":"......那么我同样，会履行我的誓言。","id":487,"figure":"https://media.prts.wiki/5/5f/Avg_avg_003_kalts_1-13$1.png"},{"type":"dialogue","name":"凯尔希","text":"Dr.{@nickname}，我会保护你和阿米娅到最后一刻。","id":488,"figure":"https://media.prts.wiki/5/5f/Avg_avg_003_kalts_1-13$1.png"},{"type":"dialogue","name":"凯尔希","text":"这并不是一个最好的时机，却是我最后的时机。","id":489,"figure":"https://media.prts.wiki/5/5f/Avg_avg_003_kalts_1-13$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#9$1","id":490},{"type":"dialogue","name":"凯尔希","text":"我很抱歉，要将这样的风险托付给你与阿米娅......但我必须要做出选择。","id":491,"figure":"https://media.prts.wiki/2/25/Avg_avg_003_kalts_1-9$1.png","end":true},{"type":"dialog","id":492},{"type":"charslot","slot":"m","focus":"n","id":493},{"type":"decision","options":{"1":{"id":"495","text":"什么样的风险？"},"2":{"id":"495","text":"什么样的选择？"}},"values":[],"id":494},{"type":"predicate","references":["1","2"],"id":495,"end":497},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#8$1","id":496},{"type":"dialogue","name":"凯尔希","text":"......","id":497,"figure":"https://media.prts.wiki/f/f7/Avg_avg_003_kalts_1-8$1.png","end":true},{"type":"dialog","id":498},{"type":"charslot","id":499},{"type":"text","text":"你看到了凯尔希的嘴型，她最后的嘱托。","id":500},{"type":"charslot","slot":"m","name":"avg_npc_1718_1#2$1","id":501},{"type":"dialogue","name":"普瑞赛斯","text":"要说的话，已经说完了吗？","id":502,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"我诧异于你对过往的认知，也对你的表述并不完全认同......不过，这都不重要了。","id":503,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"dialogue","name":"普瑞赛斯","text":"AMa-10，现在的你，又能做到什么？","id":504,"figure":"https://media.prts.wiki/5/52/Avg_avg_npc_1718_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_003_kalts_1#7$1","id":505},{"type":"dialogue","name":"凯尔希","text":"......Mon3tr！","id":506,"figure":"https://media.prts.wiki/4/45/Avg_avg_003_kalts_1-7$1.png"},{"type":"dialog","id":507},{"type":"camerashake","duration":"0.5","xstrength":"30","ystrength":"30","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":508},{"type":"playsound","key":"$char_Mon3tr","id":509},{"type":"charslot","slot":"m","name":"npc_10002","id":510},{"type":"dialogue","name":"Mon3tr","text":"（兴奋的嘶鸣）","id":511,"figure":"https://media.prts.wiki/5/5c/Avg_npc_10002_1.png"},{"type":"dialog","id":512},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":513},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":514},{"type":"charslot","id":515},{"type":"background","id":516},{"type":"image","image":"https://media.prts.wiki/8/85/Avg_60_i19_2.png","screenadapt":"coverall","id":517},{"type":"bgeffect","name":"$eb_smoke_ptc","layer":"2","id":518},{"type":"delay","time":"1","id":519},{"type":"playsound","key":"$d_avg_lghtmgc","id":520},{"type":"effect","name":"$e_redring","layer":"1","id":521},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":522},{"type":"delay","time":"1","id":523},{"type":"dialogue","name":"凯尔希","text":"摧毁她。","id":524},{"type":"dialogue","name":"凯尔希","text":"她是普瑞赛斯，来自前文明的，源石的缔造者，试图用源石来同化一切的人。","id":525},{"type":"dialogue","name":"凯尔希","text":"也因此，她是泰拉所有生命的敌人。","id":526},{"type":"dialogue","name":"普瑞赛斯","text":"这就是你的选择......","id":527},{"type":"dialogue","name":"凯尔希","text":"我是凯尔希，罗德岛的医生，阿米娅与博士的同伴。","id":528},{"type":"dialog","id":529},{"type":"image","image":"https://media.prts.wiki/8/84/Avg_60_i19_1.png","screenadapt":"coverall","fadetime":"0.5","id":530},{"type":"delay","time":"1","id":531},{"type":"dialogue","name":"凯尔希","text":"你对我而言，早已一文不值。","id":532},{"type":"dialog","id":533},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":534},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"3","block":"true","id":535},{"type":"bgeffect","id":536},{"type":"stopmusic","fadetime":"2","id":537},{"type":"charslot","id":538},{"type":"background","id":539},{"type":"image","id":540}],"characters":["阿米娅","普瑞赛斯","凯尔希","Mechanist","Misery","Raidian","Logos","阿斯卡纶","Mantra","Pith","Touch","Stormeye","煌","迷迭香","Sharp","Mon3tr"]}