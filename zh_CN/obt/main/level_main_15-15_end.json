ScaleFrom":"1.05","yScaleFrom":"1.05","xScaleTo":"1","yScaleTo":"1","duration":"20","block":"false","id":408},{"type":"delay","time":"2","id":409},{"type":"playsound","key":"$d_avg_smkedspte","volume":"1","id":410},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":411},{"type":"delay","time":"1","id":412},{"type":"text","text":"意外发生得无比突然，但已经足以让你理解这个残酷的事实。","id":413},{"type":"text","text":"你们所对抗的，并不是可被常理理解的敌人，她拥有着操控一切源石的权限。","id":414},{"type":"text","text":"凯尔希右肩上的那一点源石结晶，是她生而为人的证据，也是夺走她生命的根源。","id":415},{"type":"text","text":"源石结晶开始扩散，直至吞噬了她整个身躯，然后碎裂，随风消散——你的眼睛来不及捕捉这一完整过程。","id":416},{"type":"text","text":"越是强大，越是脆弱。","id":417},{"type":"text","text":"长生之人的生命在此终结。","id":418},{"type":"text","text":"她已经完成了她的诺言。","id":419,"end":true},{"type":"dialog","id":420},{"type":"stopmusic","fadetime":"4","id":421},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":422},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"4","block":"true","id":423},{"type":"charslot","id":424},{"type":"background","id":425},{"type":"image","id":426}],"characters":["Mon3tr","普瑞赛斯","凯尔希","阿米娅","Mechanist","Logos","煌","Raidian","阿斯卡纶","？？？"]}