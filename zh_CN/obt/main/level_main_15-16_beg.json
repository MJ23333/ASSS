174},{"type":"playmusic","key":"https://static.prts.wiki/music/music/act1mainss/m_bat_theresa_loop.mp3","volume":"0.6","id":175,"musicid":1},{"type":"decision","options":{"1":{"id":"177","text":"阿米娅，公式！"}},"values":[],"id":176},{"type":"predicate","references":["1"],"id":177,"end":180},{"type":"charslot","slot":"m","name":"avg_1037_amiya3_1#5$3","id":178},{"type":"dialogue","name":"阿米娅","text":"公式——？！","id":179,"figure":"https://media.prts.wiki/e/e0/Avg_avg_1037_amiya3_1-5$3.png"},{"type":"dialogue","name":"阿米娅","text":"凯尔希医生提到过，它能用于减少元信息在特殊媒介传输时的损耗……","id":180,"figure":"https://media.prts.wiki/e/e0/Avg_avg_1037_amiya3_1-5$3.png","end":true},{"type":"dialog","id":181},{"type":"charslot","slot":"m","focus":"n","id":182},{"type":"decision","options":{"1":{"id":"184","text":"逆转它。"}},"values":[],"id":183},{"type":"predicate","references":["1"],"id":184},{"type":"decision","options":{"1":{"id":"186","text":"阻碍信息在源石中的传递！"}},"values":[],"id":185},{"type":"predicate","references":["1"],"id":186,"end":188},{"type":"charslot","slot":"m","name":"avg_1037_amiya3_1#6$3","id":187},{"type":"dialogue","name":"阿米娅","text":"我该怎么做？","id":188,"figure":"https://media.prts.wiki/a/a6/Avg_avg_1037_amiya3_1-6$3.png","end":true},{"type":"dialog","id":189},{"type":"charslot","slot":"m","focus":"n","id":190},{"type":"decision","options":{"1":{"id":"192","text":"连接我的思维！"}},"values":[],"id":191},{"type":"predicate","references":["1"],"id":192,"end":204},{"type":"charslot","slot":"m","name":"avg_1037_amiya3_1#3$3","id":193},{"type":"playsound","key":"$d_avg_magic_1","volume":"1","id":194},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":195},{"type":"blocker","a":"0.2","r":"1","g":"1","b":"1","fadetime":"1","block":"true","id":196},{"type":"charslot","duration":"1.5","id":197},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":198},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":199},{"type":"text","text":"没有时间犹豫，阿米娅已经做出了行动。","id":200},{"type":"text","text":"你再一次与阿米娅共享了你的思维，你所研究的一切都重新在你的脑海中浮现。","id":201},{"type":"text","text":"凭借着直觉和已有的研究成果，你开始尝试拆解那些公式，转译，然后逆转……","id":202},{"type":"text","text":"哪怕你清楚，那并不能达到完全的效果。但此时，你只能祈祷这样会有用——","id":203},{"type":"text","text":"为了凯尔希。","id":204,"end":true},{"type":"dialog","id":205},{"type":"decision","options":{"1":{"id":"207","text":"记住我脑海中的东西，阿米娅！"}},"values":[],"id":206},{"type":"predicate","references":["1"],"id":207,"end":214},{"type":"charslot","slot":"m","name":"avg_1037_amiya3_1#6$3","id":208},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":209},{"type":"dialogue","name":"阿米娅","text":"收到了，博士！","id":210,"figure":"https://media.prts.wiki/a/a6/Avg_avg_1037_amiya3_1-6$3.png"},{"type":"dialogue","name":"阿米娅","text":"只要按照Logos教我的那样，将它们编织进我的法术之中——","id":211,"figure":"https://media.prts.wiki/a/a6/Avg_avg_1037_amiya3_1-6$3.png"},{"type":"dialogue","name":"阿米娅","text":"然后——","id":212,"figure":"https://media.prts.wiki/a/a6/Avg_avg_1037_amiya3_1-6$3.png"},{"type":"charslot","slot":"m","name":"avg_1037_amiya3_1#6$3","id":213},{"type":"dialogue","name":"阿米娅","text":"停下！","id":214,"figure":"https://media.prts.wiki/a/a6/Avg_avg_1037_amiya3_1-6$3.png","end":true},{"type":"dialog","id":215},{"type":"charslot","id":216},{"type":"playsound","key":"$d_avg_icecrystlncrse","volume":"1","id":217},{"type":"playsound","key":"$p_skill_chimera","volume":"1","id":218},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":219},{"type":"blocker","a":"0.8","r":"1","g":"1","b":"1","fadetime":"0.1","block":"true","id":220},{"type":"blocker","a":"0.8","r":"0","g":"0","b":"0","fadetime":"0.1","block":"true","id":221},{"type":"blocker","a":"0.8","r":"1","g":"1","b":"1","fadetime":"0.1","block":"true","id":222},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.4","block":"true","id":223},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":224},{"type":"delay","time":"1","id":225},{"type":"playsound","key":"$d_avg_phntsmbrek","volume":"1","id":226},{"type":"playsound","key":"$d_avg_phntsmglsbrek","volume":"1","id":227},{"type":"playsound","key":"$d_avg_erthshkng","volume":"1","loop":"true","channel":"e","id":228},{"type":"camerashake","duration":"4","xstrength":"5","ystrength":"5","vibrato":"90","randomness":"90","fadeout":"true","block":"false","id":229},{"type":"stopsound","channel":"e","fadetime":"6","id":230},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":231},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.03","block":"true","id":232},{"type":"charslot","id":233},{"type":"background","id":234},{"type":"image","image":"https://media.prts.wiki/8/8f/Avg_60_i13_1.png","screenadapt":"coverall","xScale":"1.1","yScale":"1.1","fadetime":"0","id":235},{"type":"imagetween","xScaleFrom":"1.1","yScaleFrom":"1.1","xScaleTo":"1","yScaleTo":"1","duration":"20","block":"false","id":236},{"type":"playsound","key":"$d_avg_rockfall","volume":"0.6","id":237},{"type":"delay","time":"0.2","id":238},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"3","block":"true","id":239},{"type":"text","text":"阿米娅的法术余波震开了试图封锁你们的源石。","id":240},{"type":"dialogue","name":"普瑞赛斯","text":"这是……？","id":241},{"type":"text","text":"试图重新限制住你们的源石几乎无法继续向你们逼近，无数的棱面中倒映出了阿米娅的身影。","id":242},{"type":"dialog","id":243},{"type":"decision","options":{"1":{"id":"245","text":"奏效了？！"}},"values":[],"id":244},{"type":"predicate","references":["1"],"id":245,"end":253},{"type":"playsound","key":"$d_avg_scrystalroad","volume":"1","loop":"true","channel":"sc","id":246},{"type":"delay","time":"1.5","id":247},{"type":"stopsound","channel":"sc","fadetime":"6","id":248},{"type":"dialogue","name":"阿米娅","text":"……我在尽量坚持——","id":249},{"type":"dialogue","name":"阿米娅","text":"但源石挤压过来的速度正在变快……","id":250},{"type":"dialogue","name":"阿米娅","text":"我需要，更努力一点！我可以做到！","id":251},{"type":"text","text":"你看到了阿米娅坚定的眼神，但你心中仍然有深深的忧虑。","id":252},{"type":"dialogue","name":"普瑞赛斯","text":"你并不明白自己在摆弄什么样的力量。","id":253,"end":true},{"type":"dialog","id":254},{"type":"decision","options":{"1":{"id":"256","text":"……"}},"values":[],"id":255},{"type":"predicate","references":["1"],"id":256,"end":258},{"type":"dialogue","name":"阿米娅","text":"我的法术目前好像不光能挡住它们，也感知到了她的状态……","id":257},{"type":"dialogue","name":"阿米娅","text":"她没有我想象中那样不可战胜——","id":258,"end":true},{"type":"dialog","id":259},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":260},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":261},{"type":"image","id":262},{"type":"playsound","key":"$d_gen_surfacefrozen","volume":"0","loop":"true","channel":"sur","id":263},{"type":"soundvolume","volume":"0.6","channel":"sur","fadetime":"2","id":264},{"type":"image","image":"https://media.prts.wiki/8/8f/Avg_60_i13_1.png","screenadapt":"coverall","xScale":"1.6","yScale":"1.6","y":"-200","id":265},{"type":"imagetween","xFrom":"-300","xTo":"-380","duration":"8","block":"false","id":266},{"type":"delay","time":"0.1","id":267},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":268},{"type":"playsound","key":"$d_avg_stonegrowing","volume":"1","id":269},{"type":"image","image":"https://media.prts.wiki/d/d4/Avg_60_i13_2.png","screenadapt":"coverall","xScale":"1.6","yScale":"1.6","y":"-200","fadetime":"2","id":270},{"type":"imagetween","xFrom":"-320","xTo":"-380","duration":"6","block":"false","id":271},{"type":"delay","time":"1","id":272},{"type":"dialogue","name":"普瑞赛斯","text":"我的确过早地醒来了，源石同化这颗星球的速度并未达到我的预期。","id":273},{"type":"dialogue","name":"普瑞赛斯","text":"加之那两个泰拉人的莽撞行为，我没法如预期那样运用源石……","id":274},{"type":"dialogue","name":"普瑞赛斯","text":"但这不代表你们如此草率地使用我们研发的技术就能改变既定的事实。","id":275},{"type":"dialog","id":276},{"type":"decision","options":{"1":{"id":"278","text":"阿米娅！"}},"values":[],"id":277},{"type":"predicate","references":["1"],"id":278,"end":303},{"type":"playsound","key":"$d_avg_spellattack_1","volume":"1","id":279},{"type":"playsound","key":"$d_avg_crystalmagic_intro","volume":"1","id":280},{"type":"image","image":"https://media.prts.wiki/d/d4/Avg_60_i13_2.png","screenadapt":"coverall","xScale":"1.6","yScale":"1.6","x":"-380","y":"-200","fadetime":"0.5","id":281},{"type":"imagetween","xFrom":"-380","xTo":"100","duration":"0.5","block":"false","id":282},{"type":"delay","time":"0.5","id":283},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0","block":"true","id":284},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":285},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":286},{"type":"blocker","a":"1","r":"255","g":"255","b":"255","fadetime":"0.05","block":"true","id":287},{"type":"playsound","key":"$d_avg_crystalmagic_loop","volume":"1","loop":"true","channel":"a","id":288},{"type":"soundvolume","volume":"1","channel":"sur","fadetime":"2","id":289},{"type":"image","image":"https://media.prts.wiki/d/d4/Avg_60_i13_2.png","screenadapt":"coverall","id":290},{"type":"imagetween","xScaleFrom":"1.2","yScaleFrom":"1.2","xScaleTo":"1","yScaleTo":"1","duration":"30","block":"false","id":291},{"type":"cgitem","image":"cgitem_60_i13_2","style":"cg","sfrom":"1.2","sto":"1","sduration":"30","layer":"1","id":292},{"type":"cgitem","image":"cgitem_60_i13_1","style":"cg","sfrom":"1","sto":"1.5","sduration":"30","layer":"2","id":293},{"type":"camerashake","duration":"1.5","xstrength":"5","ystrength":"5","vibrato":"30","randomness":"90","fadeout":"true","block":"false","id":294},{"type":"playsound","key":"$d_avg_phntsmbrek","volume":"1","channel":"1","id":295},{"type":"playsound","key":"$d_avg_phntsmglsbrek","volume":"1","channel":"2","id":296},{"type":"playsound","key":"$d_avg_land_impact","volume":"1","channel":"3","id":297},{"type":"blocker","a":"0","r":"255","g":"255","b":"255","fadetime":"2","block":"true","id":298},{"type":"text","text":"粉色的丝线从阿米娅法杖中迸发而出，在被源石封闭的空间中飞舞。","id":299},{"type":"text","text":"但你能清楚地意识到，阿米娅正承受着巨大的压力。","id":300},{"type":"text","text":"普瑞赛斯的身形也彻底被源石所遮挡……","id":301},{"type":"text","text":"每一块源石的碎片中，每一个源石的棱面上，你们都能清晰地看到普瑞赛斯的眼睛。","id":302},{"type":"text","text":"就像是……","id":303,"end":true},{"type":"dialog","id":304},{"type":"decision","options":{"1":{"id":"306","text":"她……无处不在。"}},"values":[],"id":305},{"type":"predicate","references":["1"],"id":306,"end":308},{"type":"dialogue","name":"阿米娅","text":"博士，特蕾西娅小姐正指引我怎样用更高的效率来施展这个全新的法术！","id":307},{"type":"dialogue","name":"阿米娅","text":"我确信我已经暂时削弱了普瑞赛斯对源石的掌控，应该能够继续拖住她一段时间——","id":308,"end":true},{"type":"dialog","id":309},{"type":"text","text":"就在阿米娅的法术全力爆发的同时，你的脑海中响起了一个令你振奋的声音。","id":310},{"type":"soundvolume","volume":"0.2","channel":"a","fadetime":"2","id":311},{"type":"soundvolume","volume":"0.2","channel":"sur","fadetime":"2","id":312},{"type":"dialogue","name":"Mantra","text":"博士，阿米娅，我们已进入Abyss，刚刚一瞬间源石对我们的干扰减弱了。","id":313},{"type":"dialogue","name":"阿米娅","text":"……是刚才……","id":314},{"type":"dialogue","name":"Mantra","text":"Raidian迅速重建了我们之间的联系，但情况棘手，我只能勉强用源石技艺来帮助Raidian完成沟通。","id":315},{"type":"dialogue","name":"Mantra","text":"另外，她没有搜索到凯尔希医生的生物信号。","id":316},{"type":"dialogue","name":"Mantra","text":"你们在哪？情况如何？","id":317},{"type":"dialog","id":318},{"type":"decision","options":{"1":{"id":"320","text":"我们在罗德岛的甲板上！"}},"values":[],"id":319},{"type":"predicate","references":["1"],"id":320},{"type":"decision","options":{"1":{"id":"322","text":"我们遭遇了普瑞赛斯！"}},"values":[],"id":321},{"type":"predicate","references":["1"],"id":322},{"type":"decision","options":{"1":{"id":"324","text":"联络华法琳。"}},"values":[],"id":323},{"type":"predicate","references":["1"],"id":324},{"type":"decision","options":{"1":{"id":"326","text":"抓紧时间，立刻撤出所有在舰人员。"}},"values":[],"id":325},{"type":"predicate","references":["1"],"id":326,"end":351},{"type":"stopsound","channel":"sur","fadetime":"2","id":327},{"type":"stopsound","channel":"a","fadetime":"2","id":328},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":329},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":330},{"type":"image","id":331},{"type":"hidecgitem","image":"cgitem_60_i13_2","id":332},{"type":"hidecgitem","image":"cgitem_60_i13_1","id":333},{"type":"charslot","id":334},{"type":"background","image":"https://media.prts.wiki/0/0d/Avg_bg_bg_infirmary.png","screenadapt":"coverall","id":335},{"type":"delay","time":"0.1","id":336},{"type":"charslot","slot":"m","name":"avg_171_bldsk_1#1$1","id":337},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":338},{"type":"dialogue","name":"华法琳","text":"都听到博士说的了。","id":339,"figure":"https://media.prts.wiki/c/cb/Avg_avg_171_bldsk_1-1$1.png"},{"type":"dialogue","name":"华法琳","text":"不用害怕，Lancet-2会协助监测你们的数据。","id":340,"figure":"https://media.prts.wiki/c/cb/Avg_avg_171_bldsk_1-1$1.png"},{"type":"charslot","slot":"m","name":"char_285_medic2_1","id":341},{"type":"dialogue","name":"Lancet-2","text":"OK！我不会让你失望，华法琳医生！","id":342,"figure":"https://media.prts.wiki/6/6b/Avg_char_285_medic2_1.png"},{"type":"charslot","slot":"m","name":"avg_171_bldsk_1#5$1","id":343},{"type":"dialogue","name":"华法琳","text":"记住，撤出之后，按照凯尔希原本的规划在外围建立新隔离带，防止任何鬼东西向外溢出！","id":344,"figure":"https://media.prts.wiki/a/a5/Avg_avg_171_bldsk_1-5$1.png"},{"type":"charslot","slot":"m","name":"char_285_medic2_1","id":345},{"type":"dialogue","name":"Lancet-2","text":"华法琳医生不和我们一起撤离吗？","id":346,"figure":"https://media.prts.wiki/6/6b/Avg_char_285_medic2_1.png"},{"type":"charslot","slot":"m","name":"avg_171_bldsk_1#1$1","id":347},{"type":"dialogue","name":"华法琳","text":"我的病人还在这，我会亲自带他们撤离。","id":348,"figure":"https://media.prts.wiki/c/cb/Avg_avg_171_bldsk_1-1$1.png"},{"type":"dialogue","name":"华法琳","text":"不用担心我。","id":349,"figure":"https://media.prts.wiki/c/cb/Avg_avg_171_bldsk_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_171_bldsk_1#10$1","id":350},{"type":"dialogue","name":"华法琳","text":"（凯尔希，为什么没有听到你的消息……）","id":351,"figure":"https://media.prts.wiki/e/ea/Avg_avg_171_bldsk_1-10$1.png","end":true},{"type":"dialog","id":352},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":353},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1.5","block":"true","id":354},{"type":"charslot","id":355},{"type":"background","image":"https://media.prts.wiki/0/05/Avg_bg_bg_rhodesengineeringroom.png","screenadapt":"coverall","id":356},{"type":"delay","time":"0.5","id":357},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","style":"slider","inverse":"true","fadetime":"1.5","block":"true","id":358},{"type":"playsound","key":"$d_gen_transmissionget","volume":"1","id":359},{"type":"decision","options":{"1":{"id":"361","text":"——滋——准备放弃本舰。"}},"values":[],"id":360},{"type":"predicate","references":["1"],"id":361},{"type":"decision","options":{"1":{"id":"363","text":"备份所有的数据——滋——"}},"values":[],"id":362},{"type":"predicate","references":["1"],"id":363,"end":376},{"type":"charslot","slot":"m","name":"avg_npc_1723_1#6$1","id":364},{"type":"dialogue","name":"可露希尔","text":"已经在做了，只需要最后一点时间！","id":365,"figure":"https://media.prts.wiki/b/bd/Avg_avg_npc_1723_1-6$1.png"},{"type":"dialogue","name":"可露希尔","text":"还有一件更重要的事情，关闭PRTS后必须下载它的核心数据——","id":366,"figure":"https://media.prts.wiki/b/bd/Avg_avg_npc_1723_1-6$1.png"},{"type":"dialogue","name":"可露希尔","text":"凯尔希已经提前在其中布置了后门。","id":367,"figure":"https://media.prts.wiki/b/bd/Avg_avg_npc_1723_1-6$1.png"},{"type":"dialogue","name":"可露希尔","text":"那会是我们彻底断绝本舰威胁的关键。","id":368,"figure":"https://media.prts.wiki/b/bd/Avg_avg_npc_1723_1-6$1.png"},{"type":"charslot","slot":"m","focus":"n","id":369},{"type":"dialogue","name":"Mantra","text":"Mechanist已经收到。","id":370},{"type":"dialogue","name":"Mantra","text":"我们正在Abyss中行动。","id":371},{"type":"charslot","slot":"m","name":"avg_npc_1723_1#6$1","id":372},{"type":"dialogue","name":"可露希尔","text":"拜托你们了！","id":373,"figure":"https://media.prts.wiki/b/bd/Avg_avg_npc_1723_1-6$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1723_1#11$1","id":374},{"type":"dialogue","name":"可露希尔","text":"博士，凯尔希受伤了吗？","id":375,"figure":"https://media.prts.wiki/d/d8/Avg_avg_npc_1723_1-11$1.png"},{"type":"dialogue","name":"可露希尔","text":"怎么没有听到她的动静？","id":376,"figure":"https://media.prts.wiki/d/d8/Avg_avg_npc_1723_1-11$1.png","end":true},{"type":"dialog","id":377},{"type":"charslot","slot":"m","focus":"n","id":378},{"type":"decision","options":{"1":{"id":"380","text":"……"},"2":{"id":"380","text":"她在全力帮助大家拖延时间。"}},"values":[],"id":379},{"type":"predicate","references":["1","2"],"id":380},{"type":"decision","options":{"1":{"id":"382","text":"我和阿米娅也会坚持到最后一刻。"}},"values":[],"id":381},{"type":"predicate","references":["1"],"id":382},{"type":"decision","options":{"1":{"id":"384","text":"罗德岛……"}},"values":[],"id":383},{"type":"predicate","references":["1"],"id":384},{"type":"decision","options":{"1":{"id":"386","text":"拜托你们了。"}},"values":[],"id":385},{"type":"predicate","references":["1"],"id":386,"end":414},{"type":"playsound","key":"$transmission","volume":"1","id":387},{"type":"stopmusic","fadetime":"2","id":388},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":389},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":390},{"type":"charslot","id":391},{"type":"background","id":392},{"type":"background","image":"https://media.prts.wiki/2/22/Avg_bg_60_g15_rhodesabyss_off.png","screenadapt":"coverall","id":393},{"type":"playsound","key":"$d_avg_energywell","volume":"0","loop":"true","channel":"en","id":394},{"type":"soundvolume","volume":"0.8","channel":"en","fadetime":"2","id":395},{"type":"delay","time":"1","id":396},{"type":"blocker","a":"0.5","r":"0","g":"0","b":"0","fadetime":"0.1","block":"true","id":397},{"type":"playsound","key":"$d_avg_footsteps_flock","volume":"1","loop":"true","channel":"f","id":398},{"type":"stopsound","channel":"f","fadetime":"4","id":399},{"type":"animtext","id":400,"name":"group_location_stamp","style":"avg_both","pos":"-400,-200","block":"false","text":"<p=1>Abyss内</><p=2>同一时间</>"},{"type":"delay","time":"3","id":401},{"type":"animtextclean","id":402},{"type":"delay","time":"1","id":403},{"type":"charslot","slot":"m","name":"avg_npc_1730_1#3$1","id":404},{"type":"dialogue","name":"Raidian","text":"已经恢复了和博士的联系。","id":405,"figure":"https://media.prts.wiki/1/12/Avg_avg_npc_1730_1-3$1.png"},{"type":"dialogue","name":"Raidian","text":"我们按照原定计划继续行动。","id":406,"figure":"https://media.prts.wiki/1/12/Avg_avg_npc_1730_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_391_rosmon_1#1$2","id":407},{"type":"dialogue","name":"迷迭香","text":"没有感知到更多的敌人。","id":408,"figure":"https://media.prts.wiki/0/05/Avg_avg_391_rosmon_1-1$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_1730_1#2$1","id":409},{"type":"dialogue","name":"Raidian","text":"我也没有捕捉到PRTS核心产生任何新的数据传输。","id":410,"figure":"https://media.prts.wiki/c/cb/Avg_avg_npc_1730_1-2$1.png"},{"type":"charslot","slot":"m","name":"avg_4133_logos_1#7$1","id":411},{"type":"dialogue","name":"Logos","text":"太安静了。","id":412,"figure":"https://media.prts.wiki/0/0a/Avg_avg_4133_logos_1-7$1.png"},{"type":"charslot","slot":"m","name":"avg_4132_ascln_1#1$1","id":413},{"type":"dialogue","name":"阿斯卡纶","text":"Raidian，麻烦共享核心的位置。","id":414,"figure":"https://media.prts.wiki/9/9c/Avg_avg_4132_ascln_1-1$1.png","end":true},{"type":"dialog","id":415},{"type":"charslot","id":416},{"type":"playsound","key":"$transmission","volume":"1","id":417},{"type":"delay","time":"1.5","id":418},{"type":"charslot","slot":"m","name":"avg_npc_1730_1#3$1","id":419},{"type":"dialogue","name":"Raidian","text":"已同步。","id":420,"figure":"https://media.prts.wiki/1/12/Avg_avg_npc_1730_1-3$1.png"},{"type":"charslot","slot":"m","name":"avg_4132_ascln_1#1$1","id":421},{"type":"dialogue","name":"阿斯卡纶","text":"继续向核心方位推进，尝试解除核心的运作。","id":422,"figure":"https://media.prts.wiki/9/9c/Avg_avg_4132_ascln_1-1$1.png"},{"type":"charslot","slot":"m","name":"avg_017_huang_1#11$2","id":423},{"type":"dialogue","name":"煌","text":"我走前面！PRTS一定会安排新一波次的敌人拦截我们。","id":424,"figure":"https://media.prts.wiki/9/9e/Avg_avg_017_huang_1-11$2.png"},{"type":"charslot","slot":"m","name":"avg_npc_521_1#1$1","id":425},{"type":"dialogue","name":"Mechanist","text":"解析核心的工作交给我。","id":426,"figure":"https://media.prts.wiki/d/db/Avg_avg_npc_521_1$1.png"},{"type":"charslot","slot":"m","name":"avg_4133_logos_1#3$1","id":427},{"type":"dialogue","name":"Logos","text":"“极光”。","id":428,"figure":"https://media.prts.wiki/6/65/Avg_avg_4133_logos_1-3$1.png"},{"type":"dialogue","name":"Logos","text":"微光指引前路——","id":429,"figure":"https://media.prts.wiki/6/65/Avg_avg_4133_logos_1-3$1.png"},{"type":"dialog","id":430},{"type":"playsound","key":"$d_avg_magic_2","volume":"1","id":431},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":432},{"type":"background","id":433},{"type":"charslot","id":434},{"type":"delay","time":"1","id":435},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0.1","block":"true","id":436},{"type":"dialogue","name":"Logos","text":"——？","id":437},{"type":"dialogue","name":"Mechanist","text":"怎么了，Logos？","id":438},{"type":"dialogue","name":"Logos","text":"那并非我的光……","id":439},{"type":"dialog","id":440},{"type":"playmusic","intro":"$lab_intro","key":"https://static.prts.wiki/music/music/beta3_181101/m_sys_lab_loop.mp3","volume":"0.6","id":441,"musicid":2},{"type":"cgitem","image":"cgitem_60_i16","style":"cg","sfrom":"1","sto":"1.5","sduration":"0.01","pfrom":"0,0","pto":"-55,-300","pduration":"0.01","rfrom":"-11","rto":"-11","rduration":"0.1","afrom":"0","ato":"1","aduration":"0.5","layer":"1","id":442},{"type":"delay","time":"2","id":443},{"type":"text","text":"黑暗中，高悬的菱形光环微微晃动着。","id":444},{"type":"text","text":"如同一只冰冷的眼睛俯瞰着在场的所有人。","id":445},{"type":"dialogue","name":"阿斯卡纶","text":"戒备……","id":446},{"type":"dialogue","name":"煌","text":"……是凯尔希医生提到的“普瑞赛斯”吗？","id":447},{"type":"dialogue","name":"Raidian","text":"恐怕不是。","id":448},{"type":"dialogue","name":"Raidian","text":"我探测到突然出现了大量杂乱但熟悉的信号。","id":449},{"type":"dialogue","name":"Raidian","text":"那些信号来自罗德岛本身。","id":450},{"type":"dialog","id":451},{"type":"stopsound","channel":"en","fadetime":"4","id":452},{"type":"cgitem","image":"cgitem_60_i16","style":"cg","sfrom":"1.5","sto":"1.2","sduration":"4","pfrom":"-55,-300","pto":"-70,-45","pduration":"4","rfrom":"-11","rto":"0","rduration":"4","layer":"1","id":453},{"type":"delay","time":"3","id":454},{"type":"playsound","key":"$d_avg_systemstart_weird","volume":"1","id":455},{"type":"delay","time":"1","id":456},{"type":"cgitem","image":"cgitem_60_i16","style":"cg","sfrom":"1.2","sto":"1","sduration":"22","pfrom":"-70,-45","pto":"-55,0","pduration":"22","layer":"1","id":457},{"type":"image","image":"https://media.prts.wiki/5/5a/Avg_60_i16.png","screenadapt":"coverall","xScale":"1.2","yScale":"1.2","y":"-50","fadetime":"0.5","id":458},{"type":"imagetween","xScaleFrom":"1.2","yScaleFrom":"1.2","xScaleTo":"1","yScaleTo":"1","yFrom":"-50","yTo":"0","duration":"20","block":"false","id":459},{"type":"delay","time":"1","id":460},{"type":"dialogue","name":"Misery","text":"这是……什么东西？","id":461},{"type":"text","text":"庞大的机械构造物在无尽的白噪中缓缓浮现在了所有人的面前——","id":462},{"type":"text","text":"构成其主体的部件，在场之人都很熟悉。","id":463},{"type":"text","text":"可露希尔曾许多次向大家展示这些她对罗德岛不同模块改造时所用的部件，甚至一些特殊部件就出自精英干员之手。","id":464},{"type":"dialogue","name":"Touch","text":"PRTS重组了罗德岛的设备作为武器。","id":465},{"type":"dialogue","name":"Touch","text":"可……这些部件是从哪冒出来的？Abyss里明明没有……","id":466},{"type":"dialogue","name":"阿斯卡纶","text":"源石。","id":467},{"type":"text","text":"源石的晶簇不规则地遍布在这尊造型独特的机械上。","id":468},{"type":"text","text":"它们不再仅仅吞噬，而是开始了创造。","id":469},{"type":"dialogue","name":"Misery","text":"等等，源石能做到复现罗德岛的东西？","id":470},{"type":"text","text":"Logos想起了内化宇宙中那座高塔，也想起了殿下。","id":471},{"type":"dialogue","name":"Logos","text":"没这么简单。","id":472},{"type":"dialogue","name":"Logos","text":"PRTS并没有解码源石数据的能力，其中必然有他人介入。","id":473},{"type":"dialogue","name":"阿斯卡纶","text":"普瑞赛斯。","id":474},{"type":"dialogue","name":"Raidian","text":"它的数据正通过我无法理解的方式和PRTS的核心相连，这东西和之前那些源石结晶体不一样！","id":475},{"type":"dialogue","name":"煌","text":"无论如何，看上去怎么都得打一架了。","id":476},{"type":"dialogue","name":"Stormeye","text":"的确没有其他办法了。","id":477},{"type":"dialogue","name":"Stormeye","text":"各位？","id":478},{"type":"dialog","id":479},{"type":"playsound","key":"$d_avg_attack_ready","volume":"1","id":480},{"type":"delay","time":"1.5","id":481},{"type":"dialogue","name":"迷迭香","text":"可以动手。","id":482},{"type":"text","text":"此时，菱形的眼睛光芒更甚。","id":483},{"type":"text","text":"由PRTS控制形成的拟态机械开始蓄积能量……","id":484},{"type":"dialog","id":485},{"type":"playsound","key":"$d_avg_energygather","volume":"1","id":486},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":487},{"type":"blocker","a":"0.6","r":"0","g":"0","b":"0","fadetime":"0.5","block":"true","id":488},{"type":"sticker","id":489,"multi":"true","text":"目标，不限。战斗风格已破解。","x":"180","y":"170","alignment":"left","size":"24","delay":"0.04","width":"700","block":"true"},{"type":"sticker","id":490,"multi":"true","text":"\\n\\n调用能源，无限制。","block":"true"},{"type":"sticker","id":491,"multi":"true","text":"\\n\\nPRTS最终清除协议已载入——","block":"true"},{"type":"sticker","id":492,"duration":"0.5","block":"false"},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":493},{"type":"stopmusic","fadetime":"2","id":494},{"type":"charslot","id":495},{"type":"background","id":496},{"type":"image","id":497}],"characters":["Mon3tr","普瑞赛斯","阿米娅","凯尔希","预言家","Mantra","华法琳","Lancet-2","可露希尔","Raidian","迷迭香","Logos","阿斯卡纶","煌","Mechanist","Misery","Touch","Stormeye"]}