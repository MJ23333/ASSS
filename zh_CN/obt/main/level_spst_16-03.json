{"storyMeta":{"storyReviewType":"NONE","storyId":"main_16_level_spst_16-03","storyGroup":"main_16","storySort":259,"storyDependence":"main_16_level_spst_16-03","storyCanShow":0,"storyCode":"EG-9","storyName":"归乡","storyPic":null,"storyInfo":"等炮火止歇，痛呼沉寂，我要回到我母亲的身旁，就像出生时那样。","storyCanEnter":1,"storyTxt":"obt/main/level_spst_16-03","avgTag":"幕间","unLockType":"STAGE_CLEAR","costItemType":"NONE","costItemId":null,"costItemCount":0,"stageCount":1,"requiredStages":[{"stageId":"spst_16-03","minState":"PASS","maxState":"COMPLETE"}],"prev":22,"next":24,"characters":["军官","通讯兵","士兵","冷漠的士兵","愤怒的士兵"]},"lines":[{"type":"header","key":"title_test","skippable":"true","mode":"BLACK_MASK","id":0},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"0","block":"true","id":1},{"type":"stopmusic","id":2},{"type":"dialog","id":3},{"type":"delay","time":"1","id":4},{"type":"background","image":"https://media.prts.wiki/8/84/Avg_bg_50_g13_warshipcommandroom.png","screenadapt":"coverall","id":5},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"1","block":"true","id":6},{"type":"playmusic","intro":"$darkness01_intro","key":"https://static.prts.wiki/music/music/beta1_180603/m_dia_darkness01_loop.mp3","volume":"0.6","id":7,"musicid":0},{"type":"delay","time":"2","id":8},{"type":"playsound","key":"$d_avg_telegraph_loop","loop":"true","channel":"bgs","id":9},{"type":"delay","time":"1","id":10},{"type":"text","text":"“各单位注意，这里是调度中心。”","id":11},{"type":"text","text":"“应圣骏堡急电要求，各单位立即停火。”","id":12},{"type":"text","text":"“重复，各单位立即停火。”","id":13},{"type":"text","text":"“收到回复。”","id":14},{"type":"dialog","id":15},{"type":"delay","time":"1","id":16},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","duration":"1","id":17},{"type":"delay","time":"2","id":18},{"type":"dialogue","name":"军官","text":"呼......","id":19,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialogue","name":"军官","text":"停火范围？","id":20,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","focus":"n","id":21},{"type":"dialogue","name":"通讯兵","text":"所有出战单位。","id":22},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":23},{"type":"dialogue","name":"军官","text":"（点头）","id":24,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","focus":"n","id":25},{"type":"text","text":"“收到。”","id":26},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":27},{"type":"dialogue","name":"军官","text":"通知伊尔钦中尉，尽快核实第二师下辖所有兵团的停火情况。","id":28,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","focus":"n","id":29},{"type":"text","text":"“各单位原地待命，保持战斗警戒。”","id":30},{"type":"text","text":"“在威胁被彻底清除之前，我们将继续践行拱卫圣骏堡、保护人民的誓言。”","id":31},{"type":"dialog","id":32},{"type":"playsound","key":"$p_imp_funnel_end_h","id":33},{"type":"stopsound","channel":"bgs","fadetime":"1","id":34},{"type":"delay","time":"2","id":35},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":36},{"type":"dialogue","name":"军官","text":"......去把军需官叫来。","id":37,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","id":38},{"type":"dialogue","name":"士兵","text":"报告长官，这次我们没有军需官随战。","id":39,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"士兵","text":"您对这场行动的预期只是一次快速响应——把那些制造暴乱的感染者都消灭不会花费太多的时间。","id":40,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":41},{"type":"dialogue","name":"军官","text":"......","id":42,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialogue","name":"军官","text":"士兵，先照常回复调度中心。","id":43,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialogue","name":"军官","text":"然后，你。你叫什么名字？","id":44,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","id":45},{"type":"dialogue","name":"士兵","text":"报告长官，我是列兵维亚切·季诺夫。","id":46,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":47},{"type":"dialogue","name":"军官","text":"好，列兵维亚切，去通知中尉吧，这里暂时不需要你的服务了。","id":48,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialog","id":49},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":50},{"type":"charslot","id":51},{"type":"delay","time":"1","id":52},{"type":"background","image":"https://media.prts.wiki/5/57/Avg_bg_bg_warehouse_2.png","screenadapt":"coverall","id":53},{"type":"blocker","a":"0","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":54},{"type":"delay","time":"1","id":55},{"type":"charslot","slot":"m","name":"avg_npc_1978_1#1$1","duration":"1","id":56},{"type":"delay","time":"2","id":57},{"type":"dialogue","name":"冷漠的士兵","text":"......就这么件小事，值得让我擅离职守过来找你？","id":58,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"dialogue","name":"冷漠的士兵","text":"我看你是疯了。","id":59,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"dialog","id":60},{"type":"charslot","id":61},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","duration":"0.5","id":62},{"type":"delay","time":"1","id":63},{"type":"dialogue","name":"愤怒的士兵","text":"帕季亚，瞧瞧你，穿着盾卫的制服，多么威风......！","id":64,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"愤怒的士兵","text":"戴着那头盔难道真让你什么也瞧不见了？","id":65,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"愤怒的士兵","text":"那些军粮里的蛆虫、一折就断的弩箭——甚至还有哑弹！","id":66,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"愤怒的士兵","text":"我们就用这种东西出去送死！","id":67,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1978_1#1$1","id":68},{"type":"dialogue","name":"冷漠的士兵","text":"军粮里有虫，那就吃带虫的军粮；武器难以使用，那就用身体去填上。","id":69,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"dialogue","name":"冷漠的士兵","text":"我们是士兵，我们战斗，然后胜利。结局只有继续战斗或死去。","id":70,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","id":71},{"type":"dialogue","name":"愤怒的士兵","text":"我看你才是疯了！","id":72,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1978_1#1$1","id":73},{"type":"dialogue","name":"冷漠的士兵","text":"发现他人职责上的失误，你应该报告给上级，而不是在这里向我抱怨。","id":74,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"dialogue","name":"冷漠的士兵","text":"我不是军需官——","id":75,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"dialog","id":76},{"type":"charslot","id":77},{"type":"playsound","key":"$d_avg_armyboots_walk","loop":"true","channel":"bgs","id":78},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","duration":"1","id":79},{"type":"delay","time":"1.5","id":80},{"type":"stopsound","channel":"bgs","fadetime":"0.3","id":81},{"type":"delay","time":"0.5","id":82},{"type":"dialogue","name":"军官","text":"我记得重装兵团应该在甲板上驻守。","id":83,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1978_1#1$1","id":84},{"type":"dialogue","name":"冷漠的士兵","text":"......抱歉长官，我的确擅离职守了。","id":85,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"dialogue","name":"冷漠的士兵","text":"我会将这一失职行为上报给督战官。","id":86,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"dialogue","name":"冷漠的士兵","text":"（敬礼）","id":87,"figure":"https://media.prts.wiki/6/6A/Avg_avg_npc_1978_1$1.png"},{"type":"dialog","id":88},{"type":"playsound","key":"$d_avg_armour","id":89},{"type":"charslot","duration":"1","id":90},{"type":"delay","time":"2.5","id":91},{"type":"charslot","id":92},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":93},{"type":"dialogue","name":"军官","text":"......","id":94,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","id":95},{"type":"dialogue","name":"愤怒的士兵","text":"长、长官！","id":96,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":97},{"type":"dialogue","name":"军官","text":"你发现了什么，士兵？","id":98,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialogue","name":"军官","text":"告诉我使你愤怒的缘由。","id":99,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","id":100},{"type":"dialogue","name":"愤怒的士兵","text":"......这次行动，我们的军需用品质量非常低劣。","id":101,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"愤怒的士兵","text":"军粮偷工减料，配给的罐头全都破损，里面长满了蛆虫......","id":102,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"愤怒的士兵","text":"还有弩箭......箭头有不少都不是钢制的，而是用生铁以次充好。","id":103,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"愤怒的士兵","text":"甚至备用的源石炸弹都是能量含量极低的版本，几乎和哑弹没有区别。","id":104,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"愤怒的士兵","text":"就这样......这样我们要怎么进行下一步行动？","id":105,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":106},{"type":"dialogue","name":"军官","text":"......士兵，你应征入伍是为了什么？","id":107,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","id":108},{"type":"dialogue","name":"愤怒的士兵","text":"为......","id":109,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":110},{"type":"dialogue","name":"军官","text":"大声回答我。","id":111,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","id":112},{"type":"dialogue","name":"愤怒的士兵","text":"为——为了证明自己！我想让自己的名字被更多人知道——","id":113,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"dialogue","name":"愤怒的士兵","text":"像您一样！","id":114,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":115},{"type":"dialogue","name":"军官","text":"当军队送回你的军牌，你的母亲把你的名字刻在白桦树上，同样是一种众人皆知。","id":116,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1976_1#1$1","id":117},{"type":"dialogue","name":"愤怒的士兵","text":"不，不是那种......","id":118,"figure":"https://media.prts.wiki/9/94/Avg_avg_npc_1976_1$1.png"},{"type":"charslot","slot":"m","name":"avg_npc_1977_1#1$1","id":119},{"type":"dialogue","name":"军官","text":"如果集体已经身处一场战争，那个人就不会有太多选择自己结局的余地。","id":120,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialogue","name":"军官","text":"但......","id":121,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialogue","name":"军官","text":"保持这种希望吧，孩子，然后把你的“发现”记在心里。","id":122,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialogue","name":"军官","text":"为了让更多的乌萨斯人能够活下去，为了乌萨斯的存续，事到如今，留给我们的选择只有一个了......","id":123,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialog","id":124},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":125},{"type":"delay","time":"1","id":126},{"type":"dialogue","name":"军官","text":"用一把火点燃这片大地。","id":127,"figure":"https://media.prts.wiki/C/C5/Avg_avg_npc_1977_1$1.png"},{"type":"dialog","id":128},{"type":"delay","time":"2","id":129},{"type":"blocker","a":"1","r":"0","g":"0","b":"0","fadetime":"2","block":"true","id":130},{"type":"stopmusic","fadetime":"2","id":131},{"type":"hidecgitem","id":132},{"type":"image","id":133},{"type":"charslot","text":"","id":134}],"characters":["军官","通讯兵","士兵","冷漠的士兵","愤怒的士兵"]}